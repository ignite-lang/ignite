package examples.terminal

import std.console.{Console, Reply, first_word, rest_after_word}
import std.protocol.telnet.Telnet

// The terminal's commands, design section 3.5. The Telnet session, line
// handling and option refusal come from std.protocol.telnet.

enum Command {
  Help,
  Echo(Text),
  Status,
  Quit
}

const PROMPT: Text = "terminal> "
const MAXIMUM_LINE: Int = 4096

fn respond(command: Command) -> Reply = match command {
  Help => Reply { lines = ["help", "echo <text>", "status", "quit"] }
  Echo(text) => Reply { lines = [text] }
  Status => Reply { lines = ["ready"] }
  Quit => Reply { lines = ["bye"], action = Close }
}

fn parse(line: Text) -> Option<Command> = match first_word(line) {
  "help" => Some(Help)
  "status" => Some(Status)
  "quit" => Some(Quit)
  "echo" => Some(Echo(rest_after_word(line)))
  _ => None
}

fn execute(line: Text) -> Reply {
  let trimmed = line.trim()
  if trimmed.is_empty() {
    Reply { lines = [] }
  } else {
    match parse(trimmed) {
      Some(command) => respond(command)
      None => Reply { lines = ["unknown command: {first_word(trimmed)}"] }
    }
  }
}

test "parse reads the four commands by their first word" {
  assert parse("help") == Some(Help)
  assert parse("status") == Some(Status)
  assert parse("quit") == Some(Quit)
  assert parse("quit now") == Some(Quit)
  assert parse("echo hello world") == Some(Echo("hello world"))
  assert parse("echo") == Some(Echo(""))
  assert parse("echo  two") == Some(Echo(" two"))
  assert parse("echo\tgrüß") == Some(Echo("grüß"))
  assert parse("HELP") == None
  assert parse("helpme") == None
  assert parse("") == None
}

test "respond answers each command" {
  assert respond(Help) == Reply { lines = ["help", "echo <text>", "status", "quit"] }
  assert respond(Echo("hi")) == Reply { lines = ["hi"] }
  assert respond(Echo("")) == Reply { lines = [""] }
  assert respond(Status) == Reply { lines = ["ready"] }
  assert respond(Quit) == Reply { lines = ["bye"], action = Close }
}

test "execute trims the line and names unknown commands" {
  assert execute("  status \r") == Reply { lines = ["ready"] }
  assert execute("echo  a  b ") == Reply { lines = [" a  b"] }
  assert execute("quit") == Reply { lines = ["bye"], action = Close }
  assert execute("") == Reply { lines = [] }
  assert execute(" \t ") == Reply { lines = [] }
  assert execute("frobnicate now") == Reply { lines = ["unknown command: frobnicate"] }
  assert execute(" Status") == Reply { lines = ["unknown command: Status"] }
}

system Terminal {
  resource ingress: TcpListener {
    address = "127.0.0.1"
    port = 2323
  }

  component server: Service {
    listener = ingress
    protocol = Telnet
    application = Console { prompt = PROMPT, respond = execute, maximum_line = MAXIMUM_LINE }
    executable = "terminald"
  }

  component client: Client {
    target = ingress
    protocol = Telnet
    executable = "tn"
  }
}
