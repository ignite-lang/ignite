package examples.terminal.commands

import std.console.{Console, Reply, Action, first_word, rest_after_word}
import std.protocol.telnet.{Telnet, SessionLimits}

// The terminal's commands, design section 3.5: the module the console of
// `terminal.ignite` names with `module("examples.terminal.commands")`. Its
// public `respond` fills `std.console.ConsoleCommands`. The Telnet
// session, line handling and option refusal come from std.protocol.telnet.

enum Command {
  Help,
  Echo(Text),
  Status,
  Quit
}

fn answer(command: Command) -> Reply = match command {
  Help => Reply { lines = ["help", "echo <text>", "status", "quit"] }
  Echo(text) => Reply { lines = [text] }
  Status => Reply { lines = ["ready"] }
  Quit => Reply { lines = ["bye"], action = Close }
}

fn parse(line: Text) -> Option<Command> = match first_word(line) {
  "help" => Some(Help)
  "status" => Some(Status)
  "quit" => Some(Quit)
  "echo" => Some(Echo(rest_after_word(line)))
  _ => None
}

// The reply to one input line: the command's answer, nothing for a blank
// line, a note for an unknown command.
fn respond(line: Text) -> Reply {
  let trimmed = line.trim()
  if trimmed.is_empty() {
    Reply { lines = [] }
  } else {
    match parse(trimmed) {
      Some(command) => answer(command)
      None => Reply { lines = ["unknown command: {first_word(trimmed)}"] }
    }
  }
}

test "parse reads the four commands by their first word" {
  assert parse("help") == Some(Help)
  assert parse("status") == Some(Status)
  assert parse("quit") == Some(Quit)
  assert parse("quit now") == Some(Quit)
  assert parse("echo hello world") == Some(Echo("hello world"))
  assert parse("echo") == Some(Echo(""))
  assert parse("echo  two") == Some(Echo(" two"))
  assert parse("echo\tgrüß") == Some(Echo("grüß"))
  assert parse("HELP") == None
  assert parse("helpme") == None
  assert parse("") == None
}

test "answer replies to each command" {
  assert answer(Help) == Reply { lines = ["help", "echo <text>", "status", "quit"] }
  assert answer(Echo("hi")) == Reply { lines = ["hi"] }
  assert answer(Echo("")) == Reply { lines = [""] }
  assert answer(Status) == Reply { lines = ["ready"] }
  assert answer(Quit) == Reply { lines = ["bye"], action = Close }
}

test "respond trims the line and names unknown commands" {
  assert respond("  status \r") == Reply { lines = ["ready"] }
  assert respond("echo  a  b ") == Reply { lines = [" a  b"] }
  assert respond("quit") == Reply { lines = ["bye"], action = Close }
  assert respond("") == Reply { lines = [] }
  assert respond(" \t ") == Reply { lines = [] }
  assert respond("frobnicate now") == Reply { lines = ["unknown command: frobnicate"] }
  assert respond(" Status") == Reply { lines = ["unknown command: Status"] }
}

// One read of `stream`: its bytes, none at the end of the stream (a `Data`
// read is never empty).
test fn read_once(stream: PipeStream) -> Result<Bytes, IoError> = match stream.read(4096)? {
  Eof => Ok(Bytes.empty())
  Data(bytes) => Ok(bytes)
}

// Slice 9 item 4's transcript (`docs/slice.md` 18.0 row 3) over a pipe:
// the console of `terminal.ignite` served by `Telnet.serve`, one line at a
// time, each answer and the next prompt read as one batch; every prompt is
// followed by IAC GA (RFC 854 p5).
test "the terminal transcript over a pipe" {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  spawn Telnet.serve(server, SessionLimits {}, Console { prompt = "terminal> ", respond = respond, maximum_line = 4096 })
  assert read_once(client)? == b"terminal> \xff\xf9"
  client.write_all(b"help\r\n")?
  assert read_once(client)? == b"help\r\necho <text>\r\nstatus\r\nquit\r\nterminal> \xff\xf9"
  client.write_all(b"echo hello\r\n")?
  assert read_once(client)? == b"hello\r\nterminal> \xff\xf9"
  client.write_all(b"status\r\n")?
  assert read_once(client)? == b"ready\r\nterminal> \xff\xf9"
  client.write_all(b"frobnicate x\r\n")?
  assert read_once(client)? == b"unknown command: frobnicate\r\nterminal> \xff\xf9"
  client.write_all(b"quit\r\n")?
  assert read_once(client)? == b"bye\r\n"
  assert read_once(client)? == Bytes.empty()
}
