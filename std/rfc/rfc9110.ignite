  rfc = 9110
  section = "9.3.2"
  ordinal = 6
  level = May
  party = Proxy
  text = "The response to a HEAD request is cacheable; a cache MAY use it to satisfy subsequent HEAD requests unless otherwise indicated by the Cache-Control header field (Section 5.2 of [CACHING])."
