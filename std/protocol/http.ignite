package std.protocol.http

import std.net.{ByteStream, Pipe, PipeStream, TcpStream}
import std.io.IoError
import std.text.*
import std.option.unwrap_or
import std.json.{Json, encode}
import std.rfc.rfc9112.{RFC9112}
import std.rfc.rfc9110.{RFC9110}
import std.policy.{Restart, DrainRollout}
import std.control.{Machine, Supervisor}

// HTTP/1.1 server (RFC 9112) over one byte stream (a `TcpStream`, or a
// `PipeStream` in tests): requests with a `Content-Length` body, keep-alive
// until the client asks to close, and the limits of `HttpLimits`. By
// default a head over 8 KiB is answered 431, a body over 1 MiB 413, a
// malformed request 400 and any `Transfer-Encoding` 501 (only
// `Content-Length` framing is implemented, RFC 9112 section 6.1). Each of
// those closes the connection after a lingering close: the reply is
// written, the write half shut down, and up to 64 KiB of input drained for
// at most 1 s, so the client reads the reply instead of a reset. A
// connection idle for 30 s is closed.
//
// The head is parsed strictly, so a proxy in front cannot frame a request
// differently (RFC 9112 sections 2.2, 5 and 6.3): a bare CR or LF, a
// header name that is not a token (whitespace before the colon, a line
// starting with whitespace), a control byte in a value, a repeated
// `Content-Length` or one that is not 1 to 18 digits are all 400. The
// application's response is replaced by 500 when one of its header fields
// would break RFC 9112 or RFC 9110 (`checked`): a name that is not a token,
// a value holding CR or LF, a `Transfer-Encoding` or `Content-Length` (Http
// frames every response itself), a repeated field that is not a list, an
// empty list element, BWS, an HTTP-date that is not an IMF-fixdate.

type IoResult<T> = Result<T, IoError>

// One request. `path` is the target without its query, `query` the text
// after `?`; header names are in lower case, values without the SP and
// HTAB around them (OWS, RFC 9110 section 5.6.3).
type Request {
  method: Text
  path: Text
  query: Text
  version: Text
  headers: List<(Text, Text)>
  body: Text
}

type Response {
  status: Int
  headers: List<(Text, Text)> = []
  body: Text = ""
}

// What a server runs: shared state, and the handler called once per
// request with that state.
type HttpApp<S> {
  state: S
  handle: fn(state: S, request: Request) -> Response requires [state.*]
}

// The limits of a server's connections (`docs/slice.md` 18.5): the
// longest head (request line and fields, else 431) and body (else 413),
// the idle time after which a connection is closed, and how much input a
// lingering close drains, each read waiting at most `drain_timeout`.
type HttpLimits {
  head: ByteSize = 8 KiB
  body: ByteSize = 1 MiB
  idle_timeout: Duration = 30 seconds
  drain: ByteSize = 64 KiB
  drain_timeout: Duration = 1 second
}

// Framing facts, not limits: the size of one read and the longest
// `Content-Length` value.
const READ_SIZE: Int = 65536
const MAXIMUM_LENGTH_DIGITS: Int = 18

// Claims (`docs/slice.md` 19.7, D4): RFC 9112 sections 2 to 9 and the
// server subset of RFC 9110, for the parties a server is; client and proxy
// requirements are out of scope. The statuses below are the MUST-class
// requirements no declaration satisfies; the `satisfies` clauses are on the
// parsing and framing fns, the `verifies` clauses on the tests.
protocol Http conforms [RFC9112, RFC9110] scope { parties = [Server, Sender, Recipient, Any] } {
  unsupported RFC9112.R2_2_1 "the head is decoded to text before it is parsed: an obs-text octet that is not UTF-8 reaches the application as U+FFFD"
  unsupported RFC9112.R3_3 "a request-target is bounded only by HttpLimits.head; a longer head is 431, not 414"
  unsupported RFC9112.R3_2_6 "Host is not checked"
  unsupported RFC9112.R3_2_2_5 "only the origin-form is accepted; an absolute-form request-target is 400"
  unsupported RFC9112.R3_2_2_6 "only the origin-form is accepted; an absolute-form request-target is 400"
  unsupported RFC9112.R6_1_1 "only Content-Length framing; any Transfer-Encoding is 501"
  unsupported RFC9112.R6_3_3 "any Transfer-Encoding is 501, also when chunked is not the final coding, where 400 is required"
  unsupported RFC9112.R7_1_2 "only Content-Length framing; any Transfer-Encoding is 501"
  not_applicable RFC9112.R7_1_3 "no chunked message is decoded: any Transfer-Encoding is 501"
  not_applicable RFC9112.R7_1_1_1 "no chunked message is decoded: any Transfer-Encoding is 501"
  not_applicable RFC9112.R7_1_2_2 "no chunked message is decoded, so no trailer is received: any Transfer-Encoding is 501"
  not_applicable RFC9112.R7_1_2_3 "no chunked message is decoded, so no trailer is received: any Transfer-Encoding is 501"
  not_applicable RFC9112.R7_3_1 "addresses the registration of transfer codings; Http registers none"
  not_applicable RFC9112.R7_3_2 "addresses the registration of transfer codings; Http registers none"
  not_applicable RFC9112.R7_3_4 "addresses the registration of transfer codings; Http registers none"
  not_applicable RFC9112.R9_3_3 "Http supports persistent connections"
  not_applicable RFC9112.R9_7_1 "Http runs over a plain byte stream; HTTP over TLS is not implemented"
  not_applicable RFC9112.R9_8_6 "Http runs over a plain byte stream; HTTP over TLS is not implemented"
  not_applicable RFC9110.R5_6_3_5 "Http interprets no field whose grammar allows BWS: of a request it reads Connection, Content-Length and whether Transfer-Encoding is present"
  not_applicable RFC9110.R5_6_4_1 "Http interprets no quoted-string: of a request it reads Connection, Content-Length and whether Transfer-Encoding is present"
  not_applicable RFC9110.R5_6_7_1 "Http parses no timestamp"
  not_applicable RFC9110.R5_6_7_4 "Http parses no timestamp"
  unsupported RFC9110.R6_2_5 "every response says HTTP/1.1, while the chunked coding (RFC9112.R7_1_2) and the Host check (RFC9112.R3_2_6) are not implemented"
  not_applicable RFC9110.R6_5_1_1 "a response framed by Content-Length has no trailer section"
  not_applicable RFC9110.R6_5_1_2 "no trailer is received: any Transfer-Encoding is 501"
  not_applicable RFC9110.R6_5_2_1 "addresses the definition of trailer fields; Http defines none"
  unsupported RFC9110.R6_6_1_2 "no Date header is generated"
  not_applicable RFC9110.R6_6_1_3 "applies to an origin server without a clock; the host has one, see RFC9110.R6_6_1_2"
  unsupported RFC9110.R9_1_1 "HEAD is passed to the application like any other method; Http does not answer it as GET without content"
  not_applicable RFC9110.R9_2_1_2 "addresses the resource owner: the application's handler decides what a method does"
  unsupported RFC9110.R9_3_2_1 "a response to HEAD carries the application's body"

  fn serve<T: ByteStream, S>(stream: T, limits: HttpLimits, application: HttpApp<S>) -> IoResult<Unit> requires [
    stream.read, stream.write, application.*
  ] {
    stream.set_idle_timeout(limits.idle_timeout.to_ms())?
    let result = session(stream, limits, application)
    _ = stream.close()
    result
  }
}

// An HTTP server over a listener (`docs/slice.md` section 14.5): the
// executable binds the listener, accepts connections and runs `Http.serve`
// under `limits` in one task per connection; a connection whose handler
// fails ends its task and the server goes on accepting.
type HttpServer<S> {
  listener: TcpListener
  application: HttpApp<S>
  executable: Text
  limits: HttpLimits = HttpLimits {}
  recovery: Restart = Restart {}
  rollout: DrainRollout = DrainRollout {}
}

fn HttpServer.main<S>(self: HttpServer<S>) -> IoResult<Unit> {
  loop {
    let stream = self.listener.accept()?
    spawn Http.serve(stream, self.limits, self.application)
  }
}

// The supervisor of a server under `ignite run` (`docs/slice.md` 16.7), as
// `TelnetServer.machine`: restarts under `recovery`; the `rollout` policy
// gives the member its rollout machine through `std.control.companions`
// (16.12). With it the standard `Deployment` hosts an `HttpServer` as a
// `nativeProcess` (E129 without it).
fn HttpServer.machine<S>(self: HttpServer<S>, id: Text) -> Machine = Machine.Supervise(Supervisor {
  id = "{id}.supervisor"
  member = id
  restart = self.recovery
  rollout = Some(self.rollout)
})

// The declaration rules of a server (E120): limits that admit a request.
// The policies are validated as declarations of their own.
fn HttpServer.validate<S>(self: HttpServer<S>) -> List<Text> = limit_reasons(self.limits)

fn limit_reasons(limits: HttpLimits) -> List<Text> {
  var reasons = []
  if limits.head < 1 byte {
    reasons.push("limits.head must be at least 1 byte, found {limits.head.to_int()} bytes")
  }
  if limits.idle_timeout <= 0 ms {
    reasons.push("limits.idle_timeout must be positive, found {limits.idle_timeout.debug()}")
  }
  if limits.drain_timeout <= 0 ms {
    reasons.push("limits.drain_timeout must be positive, found {limits.drain_timeout.debug()}")
  }
  reasons
}

test "a server refuses limits that admit no request" {
  assert limit_reasons(HttpLimits {}) == []
  assert limit_reasons(HttpLimits { head = 0 bytes }) == ["limits.head must be at least 1 byte, found 0 bytes"]
  assert limit_reasons(HttpLimits { idle_timeout = 0 ms }) == ["limits.idle_timeout must be positive, found 0 ns"]
  assert limit_reasons(HttpLimits { drain_timeout = 0 ms }) == ["limits.drain_timeout must be positive, found 0 ns"]
}

// ---- responses ----------------------------------------------------------

fn reason(status: Int) -> Text = match status {
  200 => "OK"
  201 => "Created"
  204 => "No Content"
  400 => "Bad Request"
  404 => "Not Found"
  405 => "Method Not Allowed"
  413 => "Content Too Large"
  431 => "Request Header Fields Too Large"
  500 => "Internal Server Error"
  501 => "Not Implemented"
  _ => "Unknown"
}

// A JSON response: `Response.json(201, value)`.
fn Response.json(status: Int, value: Json) -> Response =
  Response { status, headers = [("Content-Type", "application/json")], body = encode(value) }

// A plain-text response.
fn Response.plain(status: Int, body: Text) -> Response =
  Response { status, headers = [("Content-Type", "text/plain; charset=utf-8")], body }

// A response whose body is the reason phrase; 204 has no body.
fn status_response(status: Int) -> Response =
  if status == 204 { Response { status } } else { Response.plain(status, reason(status) + "\n") }

// 405 with the `Allow` header listing the methods the target supports.
fn method_not_allowed(allow: Text) -> Response {
  var response = status_response(405)
  response.headers.push(("Allow", allow))
  response
}

fn has_line_break(text: Text) -> Bool = text.contains("\r") || text.contains("\n")

// The fields of RFC 9110 and RFC 9111 defined as a list (`#rule`, RFC 9110
// section 5.6.1), by lower-case name: a response may repeat them (section
// 5.3) and none of their elements may be empty (section 5.6.1.1).
fn is_list_field(name: Text) -> Bool = match name {
  "accept" | "accept-charset" | "accept-encoding" | "accept-language" | "accept-ranges" => true
  "allow" | "authentication-info" | "cache-control" | "connection" | "content-encoding" => true
  "content-language" | "expect" | "if-match" | "if-none-match" | "proxy-authenticate" => true
  "proxy-authentication-info" | "te" | "trailer" | "upgrade" | "vary" | "via" | "www-authenticate" => true
  _ => false
}

// The fields whose grammar has BWS (RFC 9110 section 5.6.3): the
// `auth-param`s of the authentication fields (section 11).
fn is_auth_field(name: Text) -> Bool = match name {
  "www-authenticate" | "proxy-authenticate" | "authentication-info" | "proxy-authentication-info" => true
  _ => false
}

// The fields defined as an HTTP-date (RFC 9110 sections 5.6.7, 6.6.1,
// 8.8.2 and 10.2.3; RFC 9111 section 5.3).
fn is_date_field(name: Text) -> Bool = match name {
  "date" | "last-modified" | "expires" | "retry-after" => true
  _ => false
}

// The elements of a list field value (RFC 9110 section 5.6.1): the parts
// between the commas outside a quoted-string, each without its OWS.
fn list_elements(value: Text) -> List<Text> {
  let bytes = value.to_bytes()
  var out = []
  var start = 0
  var quoted = false
  var escaped = false
  var at = 0
  while at < bytes.len() {
    let b = bytes.at(at)
    if escaped {
      escaped = false
    } else if quoted && b == b'\\' {
      escaped = true
    } else if b == b'"' {
      quoted = !quoted
    } else if !quoted && b == b',' {
      out.push(trim_ows(bytes.slice(start, at).to_text()))
      start = at + 1
    }
    at = at + 1
  }
  out.push(trim_ows(bytes.slice(start, bytes.len()).to_text()))
  out
}

// Whether a list field value holds an empty element; an empty value is
// the empty list, not an empty element.
fn has_empty_element(value: Text) -> Bool {
  if trim_ows(value).is_empty() {
    return false
  }
  for element in list_elements(value) {
    if element.is_empty() {
      return true
    }
  }
  false
}

// Whether `value` has whitespace beside an `=` outside a quoted-string:
// BWS of an `auth-param` (`token BWS "=" BWS value`). After the `=`
// padding of a `token68`, whitespace before a comma or the end is OWS.
fn has_bws(value: Text) -> Bool {
  let bytes = value.to_bytes()
  var quoted = false
  var escaped = false
  var at = 0
  while at < bytes.len() {
    let b = bytes.at(at)
    if escaped {
      escaped = false
    } else if quoted && b == b'\\' {
      escaped = true
    } else if b == b'"' {
      quoted = !quoted
    } else if !quoted && b == b'=' {
      if at > 0 && is_ows(bytes.at(at - 1)) {
        return true
      }
      var next = at + 1
      while next < bytes.len() && is_ows(bytes.at(next)) {
        next = next + 1
      }
      if next > at + 1 && next < bytes.len() && bytes.at(next) != b',' {
        return true
      }
    }
    at = at + 1
  }
  false
}

fn is_digits(bytes: Bytes) -> Bool {
  for b in bytes {
    if !is_digit(b) {
      return false
    }
  }
  !bytes.is_empty()
}

// An IMF-fixdate (RFC 9110 section 5.6.7), the one form a sender
// generates, with no whitespace beyond its single SPs:
// `Sun, 06 Nov 1994 08:49:37 GMT`.
fn is_imf_fixdate(value: Text) -> Bool {
  let bytes = value.to_bytes()
  if bytes.len() != 29 {
    return false
  }
  let day = match bytes.slice(0, 3).to_text() {
    "Mon" | "Tue" | "Wed" | "Thu" | "Fri" | "Sat" | "Sun" => true
    _ => false
  }
  let month = match bytes.slice(8, 11).to_text() {
    "Jan" | "Feb" | "Mar" | "Apr" | "May" | "Jun" | "Jul" | "Aug" | "Sep" | "Oct" | "Nov" | "Dec" => true
    _ => false
  }
  let spaces = bytes.slice(3, 5).to_text() == ", " && bytes.at(7) == b' ' && bytes.at(11) == b' ' && bytes.at(16) == b' '
  let marks = bytes.at(19) == b':' && bytes.at(22) == b':' && bytes.slice(25, 29).to_text() == " GMT"
  let date = is_digits(bytes.slice(5, 7)) && is_digits(bytes.slice(12, 16))
  let time = is_digits(bytes.slice(17, 19)) && is_digits(bytes.slice(20, 22)) && is_digits(bytes.slice(23, 25))
  day && month && spaces && marks && date && time
}

// Whether the application may send field `name` (lower case) with
// `value`. Http frames every response by its own `Content-Length` and
// applies no transfer coding, so `Transfer-Encoding` and `Content-Length`
// are its own (RFC 9112 sections 6.1 and 6.2; RFC 9110 section 5.3).
fn is_allowed_field(name: Text, value: Text) -> Bool {
  if name == "transfer-encoding" || name == "content-length" {
    return false
  }
  if is_list_field(name) && has_empty_element(value) {
    return false
  }
  if is_auth_field(name) && has_bws(value) {
    return false
  }
  if is_date_field(name) {
    return is_imf_fixdate(value) || name == "retry-after" && is_digits(value.to_bytes())
  }
  true
}

// `response`, or 500 when one of the application's header fields would
// make the message break RFC 9112 or RFC 9110: a name that is not a token
// (also one starting with whitespace) or a value holding CR or LF, which
// would split the head; a `Transfer-Encoding` or `Content-Length`, which
// are Http's; a name repeated that is neither a list field nor
// `Set-Cookie`; an empty list element; BWS; an HTTP-date that is not an
// IMF-fixdate.
fn checked(response: Response) -> Response satisfies [
  RFC9112.R2_2_3, RFC9112.R2_2_8, RFC9112.R5_2_1, RFC9112.R6_1_2, RFC9112.R6_1_4, RFC9112.R6_1_7,
  RFC9112.R6_1_8, RFC9112.R6_1_11, RFC9112.R6_2_1, RFC9110.R5_3_3, RFC9110.R5_6_1_1_1,
  RFC9110.R5_6_3_4, RFC9110.R5_6_7_2, RFC9110.R5_6_7_3
] {
  var names = []
  for header in response.headers {
    let name = header.0.to_lower()
    if !is_token(header.0) || has_line_break(header.1) || !is_allowed_field(name, header.1) {
      return status_response(500)
    }
    if !is_list_field(name) && name != "set-cookie" {
      for seen in names {
        if seen == name {
          return status_response(500)
        }
      }
    }
    names.push(name)
  }
  response
}

// The head and body of `response`. A 204 has neither `Content-Length` nor
// a body (RFC 9110 sections 8.6 and 15.3.5).
fn render(response: Response, keep_alive: Bool) -> Bytes satisfies [RFC9112.R2_2_3, RFC9112.R4_4] {
  var head = "HTTP/1.1 {response.status} {reason(response.status)}\r\n"
  for header in response.headers {
    head = head + "{header.0}: {header.1}\r\n"
  }
  let body = if response.status == 204 { "" } else { response.body }
  if response.status != 204 {
    head = head + "Content-Length: {body.len()}\r\n"
  }
  let connection = if keep_alive { "keep-alive" } else { "close" }
  head = head + "Connection: {connection}\r\n\r\n"
  var out = head.to_bytes()
  out.append(body.to_bytes())
  out
}

test "responses carry their reason, type and body" {
  assert reason(200) == "OK"
  assert reason(431) == "Request Header Fields Too Large"
  assert reason(299) == "Unknown"
  assert Response.json(201, Null) == Response { status = 201, headers = [("Content-Type", "application/json")], body = "null" }
  assert Response.plain(200, "hi") == Response { status = 200, headers = [("Content-Type", "text/plain; charset=utf-8")], body = "hi" }
  assert status_response(404).body == "Not Found\n"
  assert status_response(204) == Response { status = 204 }
  let allowed = method_not_allowed("GET, POST")
  assert allowed.status == 405
  assert allowed.headers == [("Content-Type", "text/plain; charset=utf-8"), ("Allow", "GET, POST")]
}

test "a header holding CR or LF turns the response into 500" verifies [RFC9112.R2_2_3, RFC9112.R5_2_1] {
  let fine = Response.plain(200, "line\r\nbreaks in the body are fine")
  assert checked(fine) == fine
  assert checked(Response { status = 200, headers = [("X", "a\r\nSet-Cookie: b")] }) == status_response(500)
  assert checked(Response { status = 200, headers = [("X", "a\nb")] }).status == 500
  assert checked(Response { status = 200, headers = [("X\r", "a")] }).status == 500
  assert checked(Response { status = 200, headers = [("X", "a\tb")] }).status == 200
}

// The status `checked` leaves of a 200 with `headers`.
test fn checked_status(headers: List<(Text, Text)>) -> Int = checked(Response { status = 200, headers }).status

test "a response header name that is not a token is 500" verifies [RFC9112.R2_2_8] {
  assert checked_status([(" X", "a")]) == 500
  assert checked_status([("\tX", "a")]) == 500
  assert checked_status([("X Y", "a")]) == 500
  assert checked_status([("X:", "a")]) == 500
  assert checked_status([("", "a")]) == 500
  assert checked_status([("é", "a")]) == 500
  assert checked_status([("X-Custom_1", "a")]) == 200
}

test "an application Transfer-Encoding is 500, so Http applies no transfer coding" verifies [
  RFC9112.R6_1_2, RFC9112.R6_1_4, RFC9112.R6_1_7, RFC9112.R6_1_8, RFC9112.R6_1_11, RFC9112.R6_2_1
] {
  for value in ["chunked", "chunked, chunked", "gzip", "gzip, chunked", ""] {
    assert checked_status([("Transfer-Encoding", value)]) == 500
    assert checked(Response { status = 204, headers = [("transfer-encoding", value)] }) == status_response(500)
    assert checked(Response { status = 101, headers = [("TRANSFER-ENCODING", value)] }) == status_response(500)
  }
  let served_gzip = served(b"GET /gzip HTTP/1.1\r\n\r\nGET /a HTTP/1.0\r\n\r\n")?
  assert !served_gzip.to_lower().contains("transfer-encoding")
  assert served_gzip == render(status_response(500), true).to_text() + reply("GET /a? ", "close")
}

test "a response's own Content-Length is 500, Http frames it" verifies [RFC9112.R6_2_1, RFC9110.R5_3_3] {
  assert checked_status([("Content-Length", "2")]) == 500
  assert checked_status([("content-length", "0")]) == 500
  let length = render(checked(Response { status = 200, body = "hi" }), true).to_text()
  assert length.split("\r\n").slice(1, 3) == ["Content-Length: 2", "Connection: keep-alive"]
}

test "a repeated response field is 500 unless it is a list or Set-Cookie" verifies [RFC9110.R5_3_3] {
  assert checked_status([("Content-Type", "text/plain"), ("content-type", "text/html")]) == 500
  assert checked_status([("X", "1"), ("Y", "2"), ("X", "3")]) == 500
  assert checked_status([("Location", "/a"), ("LOCATION", "/b")]) == 500
  assert checked_status([("Vary", "Accept"), ("vary", "Origin")]) == 200
  assert checked_status([("Allow", "GET"), ("Allow", "POST")]) == 200
  assert checked_status([("Connection", "close"), ("Cache-Control", "no-store"), ("cache-control", "private")]) == 200
  assert checked_status([("Set-Cookie", "a=1"), ("Set-Cookie", "b=2")]) == 200
  assert checked_status([("X", "1"), ("Y", "1")]) == 200
}

test "an empty element of a response list field is 500" verifies [RFC9110.R5_6_1_1_1] {
  assert list_elements("a, b ,c") == ["a", "b", "c"]
  assert list_elements("a, \"b, ,c\", d") == ["a", "\"b, ,c\"", "d"]
  assert list_elements("\"a\\\", ,\", b") == ["\"a\\\", ,\"", "b"]
  for value in [",", "a,", ", a", "a,,b", "a, ,b", "a,\t,b"] {
    assert checked_status([("Vary", value)]) == 500
    assert checked_status([("connection", value)]) == 500
  }
  assert checked_status([("Allow", "")]) == 200
  assert checked_status([("Allow", "GET, HEAD")]) == 200
  assert checked_status([("WWW-Authenticate", "Basic realm=\"a, ,b\"")]) == 200
  assert checked_status([("X", "a,,b")]) == 200
  assert checked(Response { status = 200, headers = [("Connection", "keep-alive")] }).status == 200
}

test "BWS in a response's auth-param is 500" verifies [RFC9110.R5_6_3_4] {
  assert checked_status([("WWW-Authenticate", "Basic realm =\"x\"")]) == 500
  assert checked_status([("WWW-Authenticate", "Basic realm= \"x\"")]) == 500
  assert checked_status([("Proxy-Authenticate", "Basic realm\t=x")]) == 500
  assert checked_status([("Authentication-Info", "nextnonce = \"a\"")]) == 500
  assert checked_status([("WWW-Authenticate", "Basic realm=\"a = b\", charset=\"UTF-8\"")]) == 200
  assert checked_status([("WWW-Authenticate", "Bearer abc== , Basic realm=x")]) == 200
  assert checked_status([("WWW-Authenticate", "Bearer abc= ")]) == 200
  assert checked_status([("X", "a = b")]) == 200
}

test "a response timestamp is an IMF-fixdate with no extra whitespace" verifies [RFC9110.R5_6_7_2, RFC9110.R5_6_7_3] {
  assert is_imf_fixdate("Sun, 06 Nov 1994 08:49:37 GMT")
  for name in ["Date", "last-modified", "Expires", "Retry-After"] {
    assert checked_status([(name, "Sun, 06 Nov 1994 08:49:37 GMT")]) == 200
    assert checked_status([(name, "Sunday, 06-Nov-94 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun Nov  6 08:49:37 1994")]) == 500
    assert checked_status([(name, "Sun,  06 Nov 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nov 1994 08:49:37  GMT")]) == 500
    assert checked_status([(name, " Sun, 06 Nov 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nov 1994 08:49:37 UTC")]) == 500
    assert checked_status([(name, "Sun, 6 Nov 1994 08:49:37 GMT ")]) == 500
    assert checked_status([(name, "Xyz, 06 Nov 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nob 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nov 1994 08-49-37 GMT")]) == 500
  }
  assert checked_status([("Retry-After", "120")]) == 200
  assert checked_status([("Retry-After", "1 20")]) == 500
  assert checked_status([("Expires", "0")]) == 500
}

test "render writes the status line, headers, length and connection" verifies [RFC9112.R2_2_3, RFC9112.R4_4] {
  let created = render(Response.json(201, Object([])), true).to_text()
  assert created == "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\n" + r"{}"
  let utf8 = render(Response { status = 200, body = "é" }, false).to_text()
  assert utf8 == "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\né"
}

test "a 204 response has no Content-Length and no body" {
  let empty = render(status_response(204), true).to_text()
  assert empty == "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\n"
  let stray = render(Response { status = 204, body = "x" }, false).to_text()
  assert stray == "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n"
}

// ---- requests -----------------------------------------------------------

// The value of header `name` (lower case), the first if repeated.
fn header(request: Request, name: Text) -> Option<Text> {
  for header in request.headers {
    if header.0 == name {
      return Some(header.1)
    }
  }
  None
}

// The non-empty segments of the path: "/todos/3" is ["todos", "3"].
fn segments(request: Request) -> List<Text> {
  var out = []
  for segment in request.path.split("/") {
    if !segment.is_empty() {
      out.push(segment)
    }
  }
  out
}

// Whether a `Connection` header of `headers`, its name in any case, lists
// `option` (lower case). Its value is a comma-separated list, and the
// header may be repeated (RFC 9110 section 7.6.1).
fn lists_connection_option(headers: List<(Text, Text)>, option: Text) -> Bool satisfies [RFC9110.R5_6_1_2_1, RFC9110.R5_6_1_2_2] {
  for header in headers {
    if header.0.to_lower() == "connection" {
      for item in header.1.split(",") {
        if trim_ows(item).to_lower() == option {
          return true
        }
      }
    }
  }
  false
}

// Whether the request's `Connection` header lists `option`.
fn has_connection_option(request: Request, option: Text) -> Bool = lists_connection_option(request.headers, option)

// Whether the application's response sends the `close` option, after
// which the server closes the connection (RFC 9112 section 9.6).
fn response_closes(response: Response) -> Bool satisfies [RFC9112.R9_6_6] = lists_connection_option(response.headers, "close")

// HTTP/1.1 keeps the connection unless asked to close, HTTP/1.0 closes it
// unless asked to keep it; `close` wins over `keep-alive`.
fn keep_alive(request: Request) -> Bool satisfies [RFC9112.R9_6_3] {
  if has_connection_option(request, "close") {
    return false
  }
  request.version != "HTTP/1.0" || has_connection_option(request, "keep-alive")
}

// A GET of `/` in `version` with `headers` (names in lower case).
test fn get(version: Text, headers: List<(Text, Text)>) -> Request =
  Request { method = "GET", path = "/", query = "", version, headers, body = "" }

test "header finds the first value of a lower-case name" {
  let request = get("HTTP/1.1", [("host", "a"), ("x", "1"), ("x", "2")])
  assert header(request, "x") == Some("1")
  assert header(request, "host") == Some("a")
  assert header(request, "missing") == None
}

test "segments are the non-empty parts of the path" {
  var request = get("HTTP/1.1", [])
  request.path = "/todos/3"
  assert segments(request) == ["todos", "3"]
  request.path = "//todos//3/"
  assert segments(request) == ["todos", "3"]
  request.path = "/"
  assert segments(request) == []
}

test "HTTP/1.1 keeps the connection unless asked to close" {
  assert keep_alive(get("HTTP/1.1", []))
  assert keep_alive(get("HTTP/1.1", [("connection", "keep-alive")]))
  assert !keep_alive(get("HTTP/1.1", [("connection", "close")]))
  assert !keep_alive(get("HTTP/1.1", [("connection", "Close")]))
  assert keep_alive(get("HTTP/1.1", [("connection", "upgrade")]))
}

test "HTTP/1.0 closes the connection unless asked to keep it" {
  assert !keep_alive(get("HTTP/1.0", []))
  assert keep_alive(get("HTTP/1.0", [("connection", "keep-alive")]))
  assert keep_alive(get("HTTP/1.0", [("connection", "Keep-Alive")]))
  assert !keep_alive(get("HTTP/1.0", [("connection", "close")]))
}

test "Connection is a list of options" verifies [RFC9110.R5_6_1_2_2] {
  assert !keep_alive(get("HTTP/1.1", [("connection", "upgrade, close")]))
  assert !keep_alive(get("HTTP/1.1", [("connection", "keep-alive"), ("connection", "close")]))
  assert keep_alive(get("HTTP/1.0", [("connection", "TE,keep-alive")]))
  assert !keep_alive(get("HTTP/1.0", [("connection", "keep-alive, close")]))
  assert keep_alive(get("HTTP/1.1", [("connection", "closed")]))
}

test "empty elements of a Connection list are ignored" verifies [RFC9110.R5_6_1_2_1, RFC9110.R5_6_1_2_2] {
  assert !keep_alive(get("HTTP/1.1", [("connection", ", ,close,")]))
  assert keep_alive(get("HTTP/1.0", [("connection", ",,keep-alive , ")]))
  assert keep_alive(get("HTTP/1.1", [("connection", ",")]))
  assert has_connection_option(get("HTTP/1.1", [("connection", "a, , b")]), "b")
}

// RFC 9110 `tchar`.
fn is_token_byte(b: Byte) -> Bool = match b {
  b'!' | b'#' | b'$' | b'%' | b'&' | b'\'' | b'*' | b'+' | b'-' | b'.' | b'^' | b'_' | b'`' => true
  b'|' | b'~' | b'0'..=b'9' | b'a'..=b'z' | b'A'..=b'Z' => true
  _ => false
}

fn is_token(text: Text) -> Bool {
  for b in text.to_bytes() {
    if !is_token_byte(b) {
      return false
    }
  }
  !text.is_empty()
}

fn is_ows(b: Byte) -> Bool = b == b' ' || b == b'\t'

// `text` without the SP and HTAB at either end (OWS, RFC 9110 section
// 5.6.3); every other byte stays, a Unicode space too.
fn trim_ows(text: Text) -> Text {
  let bytes = text.to_bytes()
  var start = 0
  var end = bytes.len()
  while start < end && is_ows(bytes.at(start)) {
    start = start + 1
  }
  while end > start && is_ows(bytes.at(end - 1)) {
    end = end - 1
  }
  bytes.slice(start, end).to_text()
}

test "OWS is SP and HTAB only" verifies [RFC9112.R6_3_4, RFC9112.R6_3_5] {
  assert trim_ows(" \t a b \t ") == "a b"
  assert trim_ows("") == ""
  assert trim_ows(" \t") == ""
  assert trim_ows("x") == "x"
  for space in ["\u{a0}", "\u{85}", "\u{3000}", "\r", "\n"] {
    assert trim_ows("3{space}") == "3{space}"
  }
  assert parse_head("POST / HTTP/1.1\r\nContent-Length: 3\u{a0}")?.headers == [("content-length", "3\u{a0}")]
  for space in ["\u{a0}", "\u{85}", "\u{3000}"] {
    assert next_of("POST / HTTP/1.1\r\nContent-Length: 3{space}\r\n\r\nabc".to_bytes())? == Reject(400)
  }
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: \t3 \r\n\r\nabc")? != Reject(400)
}

// A field value: no control byte except tab, so no bare CR or LF.
fn is_field_value(text: Text) -> Bool satisfies [RFC9110.R5_5_4] {
  for b in text.to_bytes() {
    if b < b' ' && b != b'\t' || b == 127 {
      return false
    }
  }
  true
}

// A request target: visible bytes only.
fn is_target(text: Text) -> Bool {
  for b in text.to_bytes() {
    if b <= b' ' || b == 127 {
      return false
    }
  }
  !text.is_empty()
}

// The request line and header lines of a head, without the blank line.
fn parse_head(head: Text) -> Option<Request> satisfies [RFC9112.R2_2_4, RFC9112.R2_2_9, RFC9112.R5_1_1, RFC9112.R5_2_2, RFC9110.R5_5_1, RFC9110.R5_5_4] {
  let lines = head.split("\r\n")
  let parts = lines.at(0).split(" ")
  if parts.len() != 3 || !is_token(parts.at(0)) || !is_target(parts.at(1)) {
    return None
  }
  if parts.at(2) != "HTTP/1.1" && parts.at(2) != "HTTP/1.0" {
    return None
  }
  let (path, query) = parts.at(1).split_once("?").unwrap_or((parts.at(1), ""))
  if !path.starts_with("/") {
    return None
  }
  var headers = []
  for line in lines.slice(1, lines.len()) {
    match line.split_once(":") {
      Some((name, value)) => if is_token(name) && is_field_value(value) {
        headers.push((name.to_lower(), trim_ows(value)))
      } else {
        return None
      }
      None => return None
    }
  }
  Some(Request { method = parts.at(0), path, query, version = parts.at(2), headers, body = "" })
}

test "tokens, field values and targets" verifies [RFC9110.R5_5_4] {
  assert is_token("Content-Length")
  assert is_token("!#$%&'*+-.^_`|~09azAZ")
  assert !is_token("")
  assert !is_token("Host ")
  assert !is_token("a:b")
  assert !is_token("é")
  assert is_field_value("")
  assert is_field_value("a\tb ü")
  assert !is_field_value("a\rb")
  assert !is_field_value("a\nb")
  assert !is_field_value("a\0b")
  assert !is_field_value("a\x7fb")
  assert is_target("/todos?x=1")
  assert !is_target("")
  assert !is_target("/a b")
  assert !is_target("/a\x7f")
}

test "parse_head reads the request line and headers" verifies [RFC9110.R5_5_1] {
  let head = "POST /todos?x=1&y HTTP/1.1\r\nHost: example:80\r\nX-Padded:  a\tb \t\r\nEmpty:"
  let expected = Request {
    method = "POST"
    path = "/todos"
    query = "x=1&y"
    version = "HTTP/1.1"
    headers = [("host", "example:80"), ("x-padded", "a\tb"), ("empty", "")]
    body = ""
  }
  assert parse_head(head) == Some(expected)
  assert parse_head("GET / HTTP/1.0") == Some(get("HTTP/1.0", []))
  assert parse_head("GET /?a?b HTTP/1.1")?.query == "a?b"
  assert parse_head("GET /p? HTTP/1.1")?.path == "/p"
}

test "parse_head refuses a malformed request line" {
  assert parse_head("") == None
  assert parse_head("NONSENSE") == None
  assert parse_head("GET /  HTTP/1.1") == None
  assert parse_head("GET / HTTP/2") == None
  assert parse_head("GET / http/1.1") == None
  assert parse_head("G@T / HTTP/1.1") == None
  assert parse_head("GET todos HTTP/1.1") == None
  assert parse_head("GET * HTTP/1.1") == None
  assert parse_head("GET /\x7f HTTP/1.1") == None
  assert parse_head("GET / HTTP/1.1\nHost: x") == None
  assert parse_head("GET\t/ HTTP/1.1") == None
}

test "parse_head refuses a malformed header line" verifies [RFC9112.R2_2_4, RFC9112.R2_2_9, RFC9112.R5_1_1, RFC9112.R5_2_2, RFC9110.R5_5_4] {
  assert parse_head("GET / HTTP/1.1\r\nHost : x") == None
  assert parse_head("GET / HTTP/1.1\r\nHost\t: x") == None
  assert parse_head("GET / HTTP/1.1\r\n Host: x") == None
  assert parse_head("GET / HTTP/1.1\r\nHost: x\r\n folded") == None
  assert parse_head("GET / HTTP/1.1\r\nNoColon") == None
  assert parse_head("GET / HTTP/1.1\r\n: x") == None
  assert parse_head("GET / HTTP/1.1\r\nX: a\rb") == None
  assert parse_head("GET / HTTP/1.1\r\nX: a\nTransfer-Encoding: chunked") == None
  assert parse_head("GET / HTTP/1.1\r\nX: a\0") == None
}

// How reading a head ended.
enum HeadRead { Complete(Int), Closed, TooLarge }

// Reads until `buffer` holds a whole head: how it ended and the bytes
// read. `Complete` carries the head's length including the blank line.
fn read_head<T: ByteStream>(stream: T, limits: HttpLimits, buffer: Bytes) -> IoResult<(HeadRead, Bytes)> satisfies [RFC9110.R5_3_4, RFC9110.R5_4_1] {
  let maximum = limits.head.to_int()
  var data = buffer
  var from = 0
  loop {
    match bytes_find_from(data, b"\r\n\r\n", from) {
      Some(at) => return Ok((if at + 4 > maximum { TooLarge } else { Complete(at + 4) }, data))
      None => {}
    }
    if data.len() > maximum {
      return Ok((TooLarge, data))
    }
    from = if data.len() > 3 { data.len() - 3 } else { 0 }
    match stream.read(READ_SIZE)? {
      Eof => return Ok((Closed, data))
      Data(more) => data.append(more)
    }
  }
}

// Reads until `data` holds at least `end` bytes; `None` when the peer
// closed first. The length was checked against `limits.body` already.
fn read_body<T: ByteStream>(stream: T, limits: HttpLimits, data: Bytes, end: Int) -> IoResult<Option<Bytes>> satisfies [RFC9112.R6_3_8, RFC9112.R9_3_5] {
  var out = data
  while out.len() < end {
    match stream.read(READ_SIZE)? {
      Eof => return Ok(None)
      Data(more) => out.append(more)
    }
  }
  Ok(Some(out))
}

// What comes next on a connection: a request and the bytes after it, the
// end of the connection, or a status to answer before closing.
enum Next { Got(Request, Bytes), Close, Reject(Int) }

fn next_request<T: ByteStream>(stream: T, limits: HttpLimits, buffer: Bytes) -> IoResult<Next> satisfies [RFC9112.R5_1_1, RFC9112.R6_1_13, RFC9112.R6_1_14, RFC9112.R6_3_4, RFC9112.R6_3_5, RFC9112.R6_3_8, RFC9112.R9_3_5, RFC9110.R5_3_4, RFC9110.R5_4_1] {
  let (outcome, data) = read_head(stream, limits, buffer)?
  let head_end = match outcome {
    Complete(end) => end
    Closed => return Ok(Close)
    TooLarge => return Ok(Reject(431))
  }
  let request = match parse_head(data.slice(0, head_end - 4).to_text()) {
    Some(parsed) => parsed
    None => return Ok(Reject(400))
  }
  if header(request, "transfer-encoding") != None {
    return Ok(Reject(501))
  }
  var lengths = []
  for header in request.headers {
    if header.0 == "content-length" {
      lengths.push(header.1)
    }
  }
  let length = match lengths {
    [] => 0
    [text] => match parse_length(text) {
      Some(n) => n
      None => return Ok(Reject(400))
    }
    _ => return Ok(Reject(400))
  }
  if length > limits.body.to_int() {
    return Ok(Reject(413))
  }
  match read_body(stream, limits, data, head_end + length)? {
    None => Ok(Close)
    Some(all) => {
      var full = request
      full.body = all.slice(head_end, head_end + length).to_text()
      Ok(Got(full, all.slice(head_end + length, all.len())))
    }
  }
}

// A `Content-Length` value: 1 to 18 decimal digits, nothing else.
fn parse_length(text: Text) -> Option<Int> satisfies [RFC9112.R6_3_4] {
  if text.is_empty() || text.len() > MAXIMUM_LENGTH_DIGITS {
    return None
  }
  for b in text.to_bytes() {
    if !is_digit(b) {
      return None
    }
  }
  Int.parse(text)
}

test "a Content-Length is 1 to 18 decimal digits" verifies [RFC9112.R6_3_4] {
  assert parse_length("0") == Some(0)
  assert parse_length("42") == Some(42)
  assert parse_length("007") == Some(7)
  assert parse_length("999999999999999999") == Some(999999999999999999)
  assert parse_length("1000000000000000000") == None
  assert parse_length("") == None
  assert parse_length("+1") == None
  assert parse_length("-1") == None
  assert parse_length(" 1") == None
  assert parse_length("1,1") == None
  assert parse_length("0x10") == None
  assert parse_length("١") == None
}

// Answer a rejected request and close lingering: the reply, the write half
// shut down, then input drained (at most `limits.drain`, each read waiting
// at most `limits.drain_timeout`) so unread input does not turn the close
// into a reset that discards the reply at the client.
fn reject<T: ByteStream>(stream: T, limits: HttpLimits, status: Int) -> IoResult<Unit> satisfies [RFC9112.R6_1_13, RFC9112.R6_1_14, RFC9112.R6_3_5, RFC9112.R9_6_6, RFC9112.R9_6_7] {
  stream.write_all(render(status_response(status), false))?
  _ = stream.close()
  stream.set_idle_timeout(limits.drain_timeout.to_ms())?
  let maximum = limits.drain.to_int()
  var drained = 0
  while drained < maximum {
    match stream.read(READ_SIZE) {
      Ok(Data(more)) => {
        drained = drained + more.len()
      }
      _ => return Ok(())
    }
  }
  Ok(())
}

fn session<T: ByteStream, S>(stream: T, limits: HttpLimits, application: HttpApp<S>) -> IoResult<Unit> satisfies [RFC9112.R9_6_3, RFC9112.R9_6_5, RFC9112.R9_6_6, RFC9112.R9_6_7] {
  var buffer = Bytes.empty()
  loop {
    match next_request(stream, limits, buffer)? {
      Close => return Ok(())
      Reject(status) => return reject(stream, limits, status)
      Got(request, rest) => {
        let response = checked(application.handle(application.state, request))
        let keep = keep_alive(request) && !response_closes(response)
        stream.write_all(render(response, keep))?
        if !keep {
          return Ok(())
        }
        buffer = rest
      }
    }
  }
}

// A connected pair of pipe ends: the client and the server end. Each
// gives up on a peer silent for 5 s, so a session that does not close
// fails the test instead of hanging it.
test fn connected() -> IoResult<(PipeStream, PipeStream)> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  server.set_idle_timeout(5000)?
  Ok((client, server))
}

// What `next_request` makes of `input` under `limits`, sent with the
// write half closed after it.
test fn next_with(input: Bytes, limits: HttpLimits) -> IoResult<Next> {
  let (client, server) = connected()?
  client.write_all(input)?
  _ = client.close()
  next_request(server, limits, Bytes.empty())
}

// What `next_request` makes of `input` under the default limits.
test fn next_of(input: Bytes) -> IoResult<Next> = next_with(input, HttpLimits {})

// `input` with `count` filler bytes in an `X` header before its blank line.
test fn padded(input: Text, count: Int) -> Bytes {
  var out = input.to_bytes()
  out.append(b"X: ")
  while out.len() < count - 4 {
    out.push(b'x')
  }
  out.append(b"\r\n\r\n")
  out
}

test "next_request reads a head, its body and keeps the rest" verifies [RFC9112.R9_3_5] {
  let request = Request {
    method = "POST"
    path = "/todos"
    query = ""
    version = "HTTP/1.1"
    headers = [("content-length", "5")]
    body = "hello"
  }
  assert next_of(b"POST /todos HTTP/1.1\r\nContent-Length: 5\r\n\r\nhelloGET /")? == Got(request, b"GET /")
  assert next_of(b"GET / HTTP/1.0\r\n\r\n")? == Got(get("HTTP/1.0", []), Bytes.empty())
}

test "next_request takes a pipelined request from the buffer" {
  let (client, server) = connected()?
  _ = client.close()
  let buffer = b"GET / HTTP/1.1\r\n\r\nGET / HTTP/1.0\r\n\r\n"
  assert next_request(server, HttpLimits {}, buffer)? == Got(get("HTTP/1.1", []), b"GET / HTTP/1.0\r\n\r\n")
}

test "next_request ends on a connection closed before a whole request" verifies [RFC9112.R6_3_8, RFC9110.R5_3_4] {
  assert next_of(Bytes.empty())? == Close
  assert next_of(b"GET / HTTP/1.1\r\n")? == Close
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhi")? == Close
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 1048576\r\n\r\n")? == Close
}

test "a head over 8 KiB is 431" verifies [RFC9110.R5_4_1] {
  match next_of(padded("GET / HTTP/1.1\r\n", 8192))? {
    Got(request, rest) => {
      assert request.headers.len() == 1 && rest.is_empty()
    }
    _ => {
      assert false, "a head of 8192 bytes is read"
    }
  }
  assert next_of(padded("GET / HTTP/1.1\r\n", 8193))? == Reject(431)
  assert next_of(padded("GET / HTTP/1.1\r\n", 9000).slice(0, 8999))? == Reject(431)
}

test "a body over 1 MiB is 413" {
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 1048577\r\n\r\n")? == Reject(413)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 999999999999999999\r\n\r\n")? == Reject(413)
}

test "a malformed head or Content-Length is 400" verifies [RFC9112.R6_3_4, RFC9112.R6_3_5] {
  assert next_of(b"NONSENSE\r\n\r\n")? == Reject(400)
  assert next_of(b"GET / HTTP/1.1\r\nX: a\nContent-Length: 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 3, 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: -1\r\n\r\n")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length:\r\n\r\n")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 1000000000000000000\r\n\r\n")? == Reject(400)
}

test "any Transfer-Encoding is 501, also with a Content-Length" verifies [RFC9112.R5_1_1, RFC9112.R6_1_13] {
  assert next_of(b"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n")? == Reject(501)
  assert next_of(b"POST / HTTP/1.1\r\nTransfer-Encoding: identity\r\nContent-Length: 3\r\n\r\nabc")? == Reject(501)
  assert next_of(b"POST / HTTP/1.1\r\nContent-Length: 3\r\ntransfer-encoding: chunked\r\n\r\nabc")? == Reject(501)
  assert next_of(b"POST / HTTP/1.1\r\nTransfer-Encoding : chunked\r\n\r\n")? == Reject(400)
}

// Answers `<method> <path>?<query> <body>`; `/bad` gets a header with a
// line break, `/close` the header `Connection: Upgrade, Close`, `/gzip`
// the header `Transfer-Encoding: gzip`.
test fn answer(state: Unit, request: Request) -> Response = if request.path == "/bad" {
  Response { status = 200, headers = [("X", "a\r\nb")] }
} else if request.path == "/gzip" {
  Response { status = 200, headers = [("Transfer-Encoding", "gzip")], body = "gzip" }
} else if request.path == "/close" {
  Response { status = 200, headers = [("connection", "Upgrade,\tClose ")], body = "closing" }
} else {
  Response.plain(200, "{request.method} {request.path}?{request.query} {request.body}")
}

// Everything `client` reads until the end of the stream.
test fn read_to_end<T: ByteStream>(client: T) -> IoResult<Text> requires [client.read] {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out.to_text())
      Data(bytes) => out.append(bytes)
    }
  }
}

// Everything `Http.serve` sends for `input` under `limits` until it
// closes the connection, over a pipe.
test fn served_with(input: Bytes, limits: HttpLimits) -> IoResult<Text> {
  let (client, server) = connected()?
  spawn Http.serve(server, limits, HttpApp { state = (), handle = answer })
  client.write_all(input)?
  read_to_end(client)
}

// `served_with` under the default limits.
test fn served(input: Bytes) -> IoResult<Text> = served_with(input, HttpLimits {})

// The same over loopback TCP, so the test build has the `TcpStream`
// instance of `Http.serve` too (`docs/slice.md` D13).
test fn served_over_tcp(input: Bytes) -> IoResult<Text> {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  client.set_idle_timeout(5000)?
  let server = listener.accept()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = (), handle = answer })
  client.write_all(input)?
  read_to_end(client)
}

test fn reply(body: Text, connection: Text) -> Text {
  let length = body.len()
  "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {length}\r\nConnection: {connection}\r\n\r\n{body}"
}

test "the server answers pipelined requests until one asks to close" verifies [RFC9112.R9_6_3, RFC9112.R9_6_6] {
  let input = b"GET /a?x HTTP/1.1\r\n\r\nPOST /b HTTP/1.1\r\nContent-Length: 2\r\n\r\nhiGET /c HTTP/1.1\r\nConnection: close\r\n\r\n"
  let expected = reply("GET /a?x ", "keep-alive") + reply("POST /b? hi", "keep-alive") + reply("GET /c? ", "close")
  assert served(input)? == expected
  assert served_over_tcp(input)? == expected
  assert served(b"GET /e HTTP/1.0\r\n\r\n")? == reply("GET /e? ", "close")
  assert served_over_tcp(b"GET /e HTTP/1.0\r\n\r\n")? == reply("GET /e? ", "close")
}

test "the server answers a rejected request and closes" verifies [RFC9112.R6_3_5, RFC9112.R9_6_6, RFC9112.R9_6_7] {
  let rejected = "HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 12\r\nConnection: close\r\n\r\nBad Request\n"
  assert served(b"GET /a HTTP/1.1\r\n\r\nBAD\r\n\r\nGET /b HTTP/1.1\r\n\r\n")? == reply("GET /a? ", "keep-alive") + rejected
  let server_error = "HTTP/1.1 500 Internal Server Error\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 22\r\nConnection: close\r\n\r\nInternal Server Error\n"
  assert served(b"GET /bad HTTP/1.1\r\nConnection: close\r\n\r\n")? == server_error
}

// RFC 9112 section 6.1: a request with both framings, and an HTTP/1.0
// request with Transfer-Encoding, are answered 501, and the connection is
// closed without reading the next request.
test "a request with Transfer-Encoding is answered 501 and the connection closed" verifies [RFC9112.R6_1_13, RFC9112.R6_1_14] {
  let not_implemented = render(status_response(501), false).to_text()
  assert served(b"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\nabcGET /n HTTP/1.1\r\n\r\n")? == not_implemented
  assert served(b"POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\nabcGET /n HTTP/1.0\r\n\r\n")? == not_implemented
  assert served(b"POST / HTTP/1.0\r\nTransfer-Encoding: identity\r\n\r\nGET /n HTTP/1.0\r\n\r\n")? == not_implemented
}

test "three pipelined requests over a pipe are answered in one batch" {
  let (client, server) = connected()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = (), handle = answer })
  client.write_all(b"GET /a HTTP/1.1\r\n\r\nGET /b HTTP/1.1\r\n\r\nGET /c HTTP/1.1\r\nConnection: close\r\n\r\n")?
  let out = read_to_end(client)?
  assert out == reply("GET /a? ", "keep-alive") + reply("GET /b? ", "keep-alive") + reply("GET /c? ", "close")
  assert client.received_batches() == 1
}

test "a pipe client gets 400, 413 and 431" {
  assert served(b"NONSENSE\r\n\r\n")? == render(status_response(400), false).to_text()
  assert served(b"POST / HTTP/1.1\r\nContent-Length: 1048577\r\n\r\n")? == render(status_response(413), false).to_text()
  assert served(padded("GET / HTTP/1.1\r\n", 8193))? == render(status_response(431), false).to_text()
  assert render(status_response(431), false).to_text().starts_with("HTTP/1.1 431 Request Header Fields Too Large\r\n")
  assert render(status_response(413), false).to_text().contains("\r\nConnection: close\r\n")
}

test "the limits record bounds the body" {
  let limits = HttpLimits { body = 4 bytes }
  assert next_with(b"POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nabcde", limits)? == Reject(413)
  assert served_with(b"POST /b HTTP/1.1\r\nContent-Length: 5\r\n\r\nabcde", limits)? == render(status_response(413), false).to_text()
  assert served_with(b"POST /b HTTP/1.1\r\nContent-Length: 4\r\nConnection: close\r\n\r\nabcd", limits)? == reply("POST /b? abcd", "close")
}

test "the limits default to 8 KiB, 1 MiB, 30 s, 64 KiB and 1 s" {
  let limits = HttpLimits {}
  assert limits.head.to_int() == 8192
  assert limits.body.to_int() == 1048576
  assert limits.idle_timeout.to_ms() == 30000
  assert limits.drain.to_int() == 65536
  assert limits.drain_timeout.to_ms() == 1000
}

// Flushes the task's pending writes as their own delivery and waits 50 ms,
// so the next write is a separate delivery the server reads on its own.
test fn pause() -> IoResult<Unit> {
  let (a, b) = Pipe.pair()
  a.set_idle_timeout(50)?
  _ = a.read(1)?
  _ = b.close()
  Ok(())
}

// `parts` written as separate deliveries to `Http.serve` under `limits`
// over a pipe, the client closing its write half after the last when
// `close` holds; everything the server sends until it closes.
test fn served_parts(parts: List<Bytes>, limits: HttpLimits, close: Bool) -> IoResult<Text> {
  let (client, server) = connected()?
  spawn Http.serve(server, limits, HttpApp { state = (), handle = answer })
  for part in parts {
    client.write_all(part)?
    pause()?
  }
  if close {
    _ = client.close()
  }
  read_to_end(client)
}

// The status line of a response.
test fn status_line(text: Text) -> Text = text.split("\r\n").at(0)

test "a head of exactly HttpLimits.head is served, one byte more is 431" verifies [RFC9110.R5_4_1] {
  let limits = HttpLimits { head = 64 bytes }
  assert padded("GET / HTTP/1.0\r\n", 64).len() == 64
  assert served_with(padded("GET / HTTP/1.0\r\n", 64), limits)? == reply("GET /? ", "close")
  assert status_line(served_with(padded("GET / HTTP/1.0\r\n", 65), limits)?) == "HTTP/1.1 431 Request Header Fields Too Large"
}

test "the default head of exactly 8192 bytes is served, 8193 is 431" {
  assert served(padded("GET / HTTP/1.0\r\n", 8192))? == reply("GET /? ", "close")
  assert status_line(served(padded("GET / HTTP/1.0\r\n", 8193))?) == "HTTP/1.1 431 Request Header Fields Too Large"
}

test "a request line alone at the head limit" {
  let limits = HttpLimits { head = 64 bytes }
  let at = "/" + repeat("a", 45)
  assert "GET {at} HTTP/1.0\r\n\r\n".len() == 63
  assert served_with("GET {at} HTTP/1.0\r\n\r\n".to_bytes(), limits)? == reply("GET {at}? ", "close")
  let fits = "/" + repeat("a", 46)
  assert served_with("GET {fits} HTTP/1.0\r\n\r\n".to_bytes(), limits)? == reply("GET {fits}? ", "close")
  let over = "/" + repeat("a", 47)
  assert status_line(served_with("GET {over} HTTP/1.0\r\n\r\n".to_bytes(), limits)?) == "HTTP/1.1 431 Request Header Fields Too Large"
}

test "a body of exactly the default 1 MiB is served" {
  let body = repeat("a", 1048576)
  let input = "POST / HTTP/1.0\r\nContent-Length: 1048576\r\n\r\n{body}"
  assert served(input.to_bytes())? == reply("POST /? {body}", "close")
}

test "a body split across three deliveries" {
  let parts = [b"POST /b HTTP/1.0\r\nContent-Length: 5\r\n\r\nab", b"cd", b"e"]
  assert served_parts(parts, HttpLimits { body = 5 bytes }, false)? == reply("POST /b? abcde", "close")
}

test "a head split across deliveries at its blank line" verifies [RFC9110.R5_3_4] {
  let parts = [b"GET /h HTTP/1.0\r\n\r", b"\n"]
  assert served_parts(parts, HttpLimits {}, false)? == reply("GET /h? ", "close")
}

test "a Content-Length longer than the body, then close, gets no answer" verifies [RFC9112.R6_3_8] {
  assert served_parts([b"POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nabc"], HttpLimits {}, true)? == ""
}

test "a Content-Length shorter than the body leaves the rest as the next head" verifies [RFC9112.R9_3_5] {
  let input = b"POST / HTTP/1.1\r\nContent-Length: 2\r\n\r\nabGET /n HTTP/1.0\r\n\r\n"
  assert served(input)? == reply("POST /? ab", "keep-alive") + reply("GET /n? ", "close")
}

test "a response with the close option ends the connection" verifies [RFC9112.R9_6_6, RFC9112.R9_6_7] {
  assert response_closes(Response { status = 200, headers = [("CONNECTION", " Upgrade,\tClose ")] })
  assert !response_closes(Response { status = 200, headers = [("Connection", "keep-alive")] })
  assert !response_closes(Response { status = 200, headers = [("X", "close")] })
  let closing = "HTTP/1.1 200 OK\r\nconnection: Upgrade,\tClose \r\nContent-Length: 7\r\nConnection: close\r\n\r\nclosing"
  assert served(b"GET /a HTTP/1.1\r\n\r\nGET /close HTTP/1.1\r\n\r\nGET /b HTTP/1.1\r\n\r\n")? == reply("GET /a? ", "keep-alive") + closing
}

test "a request after Connection: close is not answered" verifies [RFC9112.R9_6_3, RFC9112.R9_6_5] {
  let input = b"GET /a HTTP/1.1\r\nConnection: close\r\n\r\nGET /b HTTP/1.1\r\n\r\n"
  assert served(input)? == reply("GET /a? ", "close")
}

test "pipelined heads whose total crosses the head limit are each within it" {
  let limits = HttpLimits { head = 64 bytes }
  var input = padded("GET /a HTTP/1.1\r\n", 60)
  input.append(padded("GET /b HTTP/1.1\r\n", 60))
  input.append(padded("GET /c HTTP/1.0\r\n", 60))
  assert served_with(input, limits)? == reply("GET /a? ", "keep-alive") + reply("GET /b? ", "keep-alive") + reply("GET /c? ", "close")
}

test "a pipelined request over the head limit after two within it" {
  let limits = HttpLimits { head = 64 bytes }
  var input = padded("GET /a HTTP/1.1\r\n", 60)
  input.append(padded("GET /b HTTP/1.1\r\n", 64))
  input.append(padded("GET /c HTTP/1.0\r\n", 65))
  let out = served_with(input, limits)?
  assert out.starts_with(reply("GET /a? ", "keep-alive") + reply("GET /b? ", "keep-alive") + "HTTP/1.1 431 ")
}

test "pipelined bodies whose total crosses the body limit are each within it" {
  let limits = HttpLimits { body = 4 bytes }
  let input = b"POST /a HTTP/1.1\r\nContent-Length: 4\r\n\r\nabcdPOST /b HTTP/1.0\r\nContent-Length: 4\r\n\r\nefgh"
  assert served_with(input, limits)? == reply("POST /a? abcd", "keep-alive") + reply("POST /b? efgh", "close")
}

test "an empty write delivers nothing and the closed connection gets no answer" {
  let (a, b) = Pipe.pair()
  a.write_all(Bytes.empty())?
  _ = a.close()
  b.set_idle_timeout(5000)?
  assert b.read(10)? == Eof
  assert b.received_batches() == 0
  assert served_parts([Bytes.empty()], HttpLimits {}, true)? == ""
}

// As the Telnet case: the client has no idle timeout and never closes,
// and the server end has none of its own before `Http.serve` sets one,
// so only `limits.idle_timeout` can end the connection.
test "the HTTP idle timeout alone ends a pipe connection" {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(0)?
  client.write_all(b"GET /i HTTP/1.1\r\n\r\n")?
  spawn Http.serve(server, HttpLimits { idle_timeout = 20 ms }, HttpApp { state = (), handle = answer })
  assert read_to_end(client)? == reply("GET /i? ", "keep-alive")
}
