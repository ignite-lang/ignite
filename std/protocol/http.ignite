package std.protocol.http

import std.net.{ByteStream, Pipe, PipeStream, TcpStream}
import std.io.IoError
import std.text.*
import std.option.unwrap_or
import std.json.{Json, encode}
import std.rfc.rfc9112.{RFC9112}
import std.rfc.rfc9110.{RFC9110}
import std.policy.{Restart, DrainRollout}
import std.control.{Machine, Supervisor}

// HTTP/1.1 server (RFC 9112) over one byte stream (a `TcpStream`, or a
// `PipeStream` in tests): requests with a `Content-Length` or a chunked
// body, responses with a text, binary or streamed body (`Content`),
// keep-alive until the client asks to close, and the limits of
// `HttpLimits`. By default a head over 8 KiB is answered 431 (414 when the
// request line alone is over it), a body over 1 MiB 413, a malformed
// request 400, an HTTP/1.1 request without `Host` or with a repeated or
// invalid one 400, a `Transfer-Encoding` whose final coding is not chunked
// 400 and one with another coding before chunked 501 (RFC 9112 sections
// 6.1 and 6.3). A chunked body is decoded; its trailer fields are checked
// and discarded. Each rejection closes the connection after a lingering
// close: the reply is
// written, the write half shut down, and up to 64 KiB of input drained for
// at most 1 s, so the client reads the reply instead of a reset. A
// connection idle for 30 s is closed.
//
// The head is parsed strictly, so a proxy in front cannot frame a request
// differently (RFC 9112 sections 2.2, 5 and 6.3): a bare CR or LF, a
// header name that is not a token (whitespace before the colon, a line
// starting with whitespace), a control byte in a value, a repeated
// `Content-Length` or one that is not 1 to 18 digits are all 400. The
// application's response is replaced by 500 when one of its header fields
// would break RFC 9112 or RFC 9110 (`checked`): a name that is not a token,
// a value holding CR or LF, a `Transfer-Encoding` or `Content-Length` (Http
// frames every response itself), a repeated field that is not a list, an
// empty list element, BWS, an HTTP-date that is not an IMF-fixdate.
//
// An absolute-form request-target is accepted, its authority replacing
// the received `Host`; HEAD is asked of the application as GET and
// answered without content.

type IoResult<T> = Result<T, IoError>

// One request. `path` is the target without its query, `query` the text
// after `?`; header names are in lower case, values without the SP and
// HTAB around them (OWS, RFC 9110 section 5.6.3).
type Request {
  method: Text
  path: Text
  query: Text
  version: Text
  headers: List<(Text, Text)>
  body: Text
}

// One response. `content` says where its body is: `body` by default.
type Response {
  status: Int
  headers: List<(Text, Text)> = []
  body: Text = ""
  content: Content = Inline
}

// Where a response's body is (`docs/slice.md` 19.23): `Inline` is
// `body`; `Binary` the bytes sent in place of `body`, both framed by
// `Content-Length`; `Streamed` the pieces `HttpApp.piece` returns, sent as
// they come (`send_streamed`).
enum Content { Inline, Binary(Bytes), Streamed }

// What a server runs: shared state, the handler called once per request
// with that state, and `piece`, called with the state and the request
// for the next piece of a `Streamed` body until it returns `Ok(None)`.
type HttpApp<S> {
  state: S
  handle: fn(state: S, request: Request) -> Response requires [state.*]
  piece: fn(state: S, request: Request) -> IoResult<Option<Bytes>> requires [state.*] = no_piece
}

// The default `piece`: every streamed body is empty.
fn no_piece<S>(state: S, request: Request) -> IoResult<Option<Bytes>> = Ok(None)

// The limits of a server's connections (`docs/slice.md` 18.5): the
// longest head (request line and fields, else 431) and body (else 413),
// the idle time after which a connection is closed, and how much input a
// lingering close drains, each read waiting at most `drain_timeout`.
type HttpLimits {
  head: ByteSize = 8 KiB
  body: ByteSize = 1 MiB
  idle_timeout: Duration = 30 seconds
  drain: ByteSize = 64 KiB
  drain_timeout: Duration = 1 second
}

// Framing facts, not limits: the size of one read and the longest
// `Content-Length` value.
const READ_SIZE: Int = 65536
const MAXIMUM_LENGTH_DIGITS: Int = 18

// Claims (`docs/slice.md` 19.7, D4): RFC 9112 sections 2 to 9 and the
// server subset of RFC 9110, for the parties a server is; client and proxy
// requirements are out of scope. The statuses below are the MUST-class
// requirements no declaration satisfies; the `satisfies` clauses are on the
// parsing and framing fns, the `verifies` clauses on the tests.
protocol Http conforms [RFC9112, RFC9110] scope { parties = [Server, Sender, Recipient, Any] } {
  unsupported RFC9112.R2_2_1 "the head is decoded to text before it is parsed: an obs-text octet that is not UTF-8 reaches the application as U+FFFD"
  not_applicable RFC9112.R7_3_1 "addresses the registration of transfer codings; Http registers none"
  not_applicable RFC9112.R7_3_2 "addresses the registration of transfer codings; Http registers none"
  not_applicable RFC9112.R7_3_4 "addresses the registration of transfer codings; Http registers none"
  not_applicable RFC9112.R9_3_3 "Http supports persistent connections"
  not_applicable RFC9112.R9_7_1 "Http runs over a plain byte stream; HTTP over TLS is not implemented"
  not_applicable RFC9112.R9_8_6 "Http runs over a plain byte stream; HTTP over TLS is not implemented"
  not_applicable RFC9110.R5_6_3_5 "Http interprets no field whose grammar allows BWS: of a request it reads Connection, Content-Length and the coding names of Transfer-Encoding, a coding with parameters being refused, not interpreted; chunk extensions are ignored"
  not_applicable RFC9110.R5_6_4_1 "Http interprets no quoted-string: of a request it reads Connection, Content-Length and the coding names of Transfer-Encoding, a coding with parameters being refused, not interpreted; chunk extensions are ignored"
  not_applicable RFC9110.R5_6_7_1 "Http parses no timestamp"
  not_applicable RFC9110.R5_6_7_4 "Http parses no timestamp"
  unsupported RFC9110.R6_2_5 "every response says HTTP/1.1 while RFC9112.R2_2_1, a MUST of that version, is unsupported"
  not_applicable RFC9110.R6_5_1_1 "Http generates no trailer field: a chunked response ends with an empty trailer section"
  not_applicable RFC9110.R6_5_2_1 "addresses the definition of trailer fields; Http defines none"
  unsupported RFC9110.R6_6_1_2 "no Date header is generated"
  not_applicable RFC9110.R6_6_1_3 "applies to an origin server without a clock; the host has one, see RFC9110.R6_6_1_2"
  not_applicable RFC9110.R9_2_1_2 "addresses the resource owner: the application's handler decides what a method does"

  fn serve<T: ByteStream, S>(stream: T, limits: HttpLimits, application: HttpApp<S>) -> IoResult<Unit> requires [
    stream.read, stream.write, application.*
  ] {
    stream.set_idle_timeout(limits.idle_timeout.to_ms())?
    let result = session(stream, limits, application)
    _ = stream.close()
    result
  }
}

// An HTTP server over a listener (`docs/slice.md` section 14.5): the
// executable binds the listener, accepts connections and runs `Http.serve`
// under `limits` in one task per connection; a connection whose handler
// fails ends its task and the server goes on accepting.
type HttpServer<S> {
  listener: TcpListener
  application: HttpApp<S>
  executable: Text
  limits: HttpLimits = HttpLimits {}
  recovery: Restart = Restart {}
  rollout: DrainRollout = DrainRollout {}
}

fn HttpServer.main<S>(self: HttpServer<S>) -> IoResult<Unit> {
  loop {
    let stream = self.listener.accept()?
    spawn Http.serve(stream, self.limits, self.application)
  }
}

// The supervisor of a server under `ignite run` (`docs/slice.md` 16.7), as
// `TelnetServer.machine`: restarts under `recovery`; the `rollout` policy
// gives the member its rollout machine through `std.control.companions`
// (16.12). With it the standard `Deployment` hosts an `HttpServer` as a
// `nativeProcess` (E129 without it).
fn HttpServer.machine<S>(self: HttpServer<S>, id: Text) -> Machine = Machine.Supervise(Supervisor {
  id = "{id}.supervisor"
  member = id
  restart = self.recovery
  rollout = Some(self.rollout)
})

// The declaration rules of a server (E120): limits that admit a request.
// The policies are validated as declarations of their own.
fn HttpServer.validate<S>(self: HttpServer<S>) -> List<Text> = limit_reasons(self.limits)

fn limit_reasons(limits: HttpLimits) -> List<Text> {
  var reasons = []
  if limits.head < 1 byte {
    reasons.push("limits.head must be at least 1 byte, found {limits.head.to_int()} bytes")
  }
  if limits.idle_timeout <= 0 ms {
    reasons.push("limits.idle_timeout must be positive, found {limits.idle_timeout.debug()}")
  }
  if limits.drain_timeout <= 0 ms {
    reasons.push("limits.drain_timeout must be positive, found {limits.drain_timeout.debug()}")
  }
  reasons
}

test "a server refuses limits that admit no request" {
  assert limit_reasons(HttpLimits {}) == []
  assert limit_reasons(HttpLimits { head = 0 bytes }) == ["limits.head must be at least 1 byte, found 0 bytes"]
  assert limit_reasons(HttpLimits { idle_timeout = 0 ms }) == ["limits.idle_timeout must be positive, found 0 ns"]
  assert limit_reasons(HttpLimits { drain_timeout = 0 ms }) == ["limits.drain_timeout must be positive, found 0 ns"]
}

// ---- responses ----------------------------------------------------------

// The reason phrase of every status code RFC 9110 section 15 defines, and
// of the four of RFC 6585; `Unknown` for any other.
fn reason(status: Int) -> Text = match status {
  100 => "Continue"
  101 => "Switching Protocols"
  200 => "OK"
  201 => "Created"
  202 => "Accepted"
  203 => "Non-Authoritative Information"
  204 => "No Content"
  205 => "Reset Content"
  206 => "Partial Content"
  300 => "Multiple Choices"
  301 => "Moved Permanently"
  302 => "Found"
  303 => "See Other"
  304 => "Not Modified"
  305 => "Use Proxy"
  307 => "Temporary Redirect"
  308 => "Permanent Redirect"
  400 => "Bad Request"
  401 => "Unauthorized"
  402 => "Payment Required"
  403 => "Forbidden"
  404 => "Not Found"
  405 => "Method Not Allowed"
  406 => "Not Acceptable"
  407 => "Proxy Authentication Required"
  408 => "Request Timeout"
  409 => "Conflict"
  410 => "Gone"
  411 => "Length Required"
  412 => "Precondition Failed"
  413 => "Content Too Large"
  414 => "URI Too Long"
  415 => "Unsupported Media Type"
  416 => "Range Not Satisfiable"
  417 => "Expectation Failed"
  421 => "Misdirected Request"
  422 => "Unprocessable Content"
  426 => "Upgrade Required"
  428 => "Precondition Required"
  429 => "Too Many Requests"
  431 => "Request Header Fields Too Large"
  500 => "Internal Server Error"
  501 => "Not Implemented"
  502 => "Bad Gateway"
  503 => "Service Unavailable"
  504 => "Gateway Timeout"
  505 => "HTTP Version Not Supported"
  511 => "Network Authentication Required"
  _ => "Unknown"
}

// A JSON response: `Response.json(201, value)`.
fn Response.json(status: Int, value: Json) -> Response =
  Response { status, headers = [("Content-Type", "application/json")], body = encode(value) }

// A plain-text response.
fn Response.plain(status: Int, body: Text) -> Response =
  Response { status, headers = [("Content-Type", "text/plain; charset=utf-8")], body }

// A binary response: `body` sent as it is, of type `content_type`.
fn Response.bytes(status: Int, content_type: Text, body: Bytes) -> Response =
  Response { status, headers = [("Content-Type", content_type)], content = Binary(body) }

// A streamed response: its body is what `HttpApp.piece` returns.
fn Response.streamed(status: Int, headers: List<(Text, Text)>) -> Response =
  Response { status, headers, content = Streamed }

// A response whose body is the reason phrase; 204 has no body.
fn status_response(status: Int) -> Response =
  if status == 204 { Response { status } } else { Response.plain(status, reason(status) + "\n") }

// 405 with the `Allow` header listing the methods the target supports.
fn method_not_allowed(allow: Text) -> Response {
  var response = status_response(405)
  response.headers.push(("Allow", allow))
  response
}

fn has_line_break(text: Text) -> Bool = text.contains("\r") || text.contains("\n")

// The fields of RFC 9110 and RFC 9111 defined as a list (`#rule`, RFC 9110
// section 5.6.1), by lower-case name: a response may repeat them (section
// 5.3) and none of their elements may be empty (section 5.6.1.1).
fn is_list_field(name: Text) -> Bool = match name {
  "accept" | "accept-charset" | "accept-encoding" | "accept-language" | "accept-ranges" => true
  "allow" | "authentication-info" | "cache-control" | "connection" | "content-encoding" => true
  "content-language" | "expect" | "if-match" | "if-none-match" | "proxy-authenticate" => true
  "proxy-authentication-info" | "te" | "trailer" | "upgrade" | "vary" | "via" | "www-authenticate" => true
  _ => false
}

// The fields whose grammar has BWS (RFC 9110 section 5.6.3): the
// `auth-param`s of the authentication fields (section 11).
fn is_auth_field(name: Text) -> Bool = match name {
  "www-authenticate" | "proxy-authenticate" | "authentication-info" | "proxy-authentication-info" => true
  _ => false
}

// The fields defined as an HTTP-date (RFC 9110 sections 5.6.7, 6.6.1,
// 8.8.2 and 10.2.3; RFC 9111 section 5.3).
fn is_date_field(name: Text) -> Bool = match name {
  "date" | "last-modified" | "expires" | "retry-after" => true
  _ => false
}

// The elements of a list field value (RFC 9110 section 5.6.1): the parts
// between the commas outside a quoted-string, each without its OWS.
fn list_elements(value: Text) -> List<Text> {
  let bytes = value.to_bytes()
  var out = []
  var start = 0
  var quoted = false
  var escaped = false
  var at = 0
  while at < bytes.len() {
    let b = bytes.at(at)
    if escaped {
      escaped = false
    } else if quoted && b == b'\\' {
      escaped = true
    } else if b == b'"' {
      quoted = !quoted
    } else if !quoted && b == b',' {
      out.push(trim_ows(bytes.slice(start, at).to_text()))
      start = at + 1
    }
    at = at + 1
  }
  out.push(trim_ows(bytes.slice(start, bytes.len()).to_text()))
  out
}

// Whether a list field value holds an empty element; an empty value is
// the empty list, not an empty element.
fn has_empty_element(value: Text) -> Bool {
  if trim_ows(value).is_empty() {
    return false
  }
  for element in list_elements(value) {
    if element.is_empty() {
      return true
    }
  }
  false
}

// Whether `value` has whitespace beside an `=` outside a quoted-string:
// BWS of an `auth-param` (`token BWS "=" BWS value`). After the `=`
// padding of a `token68`, whitespace before a comma or the end is OWS.
fn has_bws(value: Text) -> Bool {
  let bytes = value.to_bytes()
  var quoted = false
  var escaped = false
  var at = 0
  while at < bytes.len() {
    let b = bytes.at(at)
    if escaped {
      escaped = false
    } else if quoted && b == b'\\' {
      escaped = true
    } else if b == b'"' {
      quoted = !quoted
    } else if !quoted && b == b'=' {
      if at > 0 && is_ows(bytes.at(at - 1)) {
        return true
      }
      var next = at + 1
      while next < bytes.len() && is_ows(bytes.at(next)) {
        next = next + 1
      }
      if next > at + 1 && next < bytes.len() && bytes.at(next) != b',' {
        return true
      }
    }
    at = at + 1
  }
  false
}

fn is_digits(bytes: Bytes) -> Bool {
  for b in bytes {
    if !is_digit(b) {
      return false
    }
  }
  !bytes.is_empty()
}

// An IMF-fixdate (RFC 9110 section 5.6.7), the one form a sender
// generates, with no whitespace beyond its single SPs:
// `Sun, 06 Nov 1994 08:49:37 GMT`.
fn is_imf_fixdate(value: Text) -> Bool {
  let bytes = value.to_bytes()
  if bytes.len() != 29 {
    return false
  }
  let day = match bytes.slice(0, 3).to_text() {
    "Mon" | "Tue" | "Wed" | "Thu" | "Fri" | "Sat" | "Sun" => true
    _ => false
  }
  let month = match bytes.slice(8, 11).to_text() {
    "Jan" | "Feb" | "Mar" | "Apr" | "May" | "Jun" | "Jul" | "Aug" | "Sep" | "Oct" | "Nov" | "Dec" => true
    _ => false
  }
  let spaces = bytes.slice(3, 5).to_text() == ", " && bytes.at(7) == b' ' && bytes.at(11) == b' ' && bytes.at(16) == b' '
  let marks = bytes.at(19) == b':' && bytes.at(22) == b':' && bytes.slice(25, 29).to_text() == " GMT"
  let date = is_digits(bytes.slice(5, 7)) && is_digits(bytes.slice(12, 16))
  let time = is_digits(bytes.slice(17, 19)) && is_digits(bytes.slice(20, 22)) && is_digits(bytes.slice(23, 25))
  day && month && spaces && marks && date && time
}

// Whether the application may send field `name` (lower case) with
// `value`. Http frames every response itself, by its own `Content-Length`
// or, for a streamed body, its own chunked coding, so `Transfer-Encoding`
// and `Content-Length` are its own (RFC 9112 sections 6.1 and 6.2; RFC
// 9110 section 5.3).
fn is_allowed_field(name: Text, value: Text) -> Bool {
  if name == "transfer-encoding" || name == "content-length" {
    return false
  }
  if is_list_field(name) && has_empty_element(value) {
    return false
  }
  if is_auth_field(name) && has_bws(value) {
    return false
  }
  if is_date_field(name) {
    return is_imf_fixdate(value) || name == "retry-after" && is_digits(value.to_bytes())
  }
  true
}

// `response`, or 500 when one of the application's header fields would
// make the message break RFC 9112 or RFC 9110: a name that is not a token
// (also one starting with whitespace) or a value holding CR or LF, which
// would split the head; a `Transfer-Encoding` or `Content-Length`, which
// are Http's; a name repeated that is neither a list field nor
// `Set-Cookie`; an empty list element; BWS; an HTTP-date that is not an
// IMF-fixdate.
fn checked(response: Response) -> Response satisfies [
  RFC9112.R2_2_3, RFC9112.R2_2_8, RFC9112.R5_2_1, RFC9112.R6_1_2, RFC9112.R6_1_4, RFC9112.R6_1_7,
  RFC9112.R6_1_8, RFC9112.R6_1_11, RFC9112.R6_2_1, RFC9110.R5_3_3, RFC9110.R5_6_1_1_1,
  RFC9110.R5_6_3_4, RFC9110.R5_6_7_2, RFC9110.R5_6_7_3
] {
  var names = []
  for header in response.headers {
    let name = header.0.to_lower()
    if !is_token(header.0) || has_line_break(header.1) || !is_allowed_field(name, header.1) {
      return status_response(500)
    }
    if !is_list_field(name) && name != "set-cookie" {
      for seen in names {
        if seen == name {
          return status_response(500)
        }
      }
    }
    names.push(name)
  }
  response
}

// How the body of a response is delimited on the wire: by a
// `Content-Length`, by the chunked coding, by closing the connection, or
// not at all since the response has none.
enum Framing { Length(Int), Chunks, UntilClose, NoBody }

// The status line, the application's header fields, the field `framing`
// needs and `Connection`, then the blank line.
fn render_head(response: Response, framing: Framing, keep_alive: Bool) -> Bytes {
  var head = "HTTP/1.1 {response.status} {reason(response.status)}\r\n"
  for header in response.headers {
    head = head + "{header.0}: {header.1}\r\n"
  }
  match framing {
    Length(length) => {
      head = head + "Content-Length: {length}\r\n"
    }
    Chunks => {
      head = head + "Transfer-Encoding: chunked\r\n"
    }
    _ => {}
  }
  let connection = if keep_alive { "keep-alive" } else { "close" }
  head = head + "Connection: {connection}\r\n\r\n"
  head.to_bytes()
}

// The head and body of `response`, `body` or the bytes of `Binary`. A
// status without content (1xx, 204, 304) has neither `Content-Length` nor
// a body (RFC 9110 sections 8.6, 15.2, 15.3.5 and 15.4.5). A `Streamed`
// response is rendered as `Inline`: its pieces only `Http.serve` sends.
fn render(response: Response, keep_alive: Bool) -> Bytes satisfies [RFC9112.R2_2_3, RFC9112.R4_4] = render_message(response, keep_alive, true)

// `render`, or without the body when `with_body` is false, as the answer
// to HEAD: the `Content-Length` is the one the body would have had (RFC
// 9110 sections 8.6 and 9.3.2).
fn render_message(response: Response, keep_alive: Bool, with_body: Bool) -> Bytes {
  let framing = if has_no_content(response.status) { NoBody } else { Length(inline_body(response).len()) }
  render_framed(response, framing, keep_alive, with_body)
}

// The bytes an `Inline` or `Binary` response carries: `body` or the bytes
// of `Binary`.
fn inline_body(response: Response) -> Bytes = match response.content {
  Binary(bytes) => bytes
  _ => response.body.to_bytes()
}

// The head of `response` framed by `framing`, then its body unless
// `with_body` is false or `framing` is `NoBody`.
fn render_framed(response: Response, framing: Framing, keep_alive: Bool, with_body: Bool) -> Bytes {
  var out = render_head(response, framing, keep_alive)
  if with_body && framing != NoBody {
    out.append(inline_body(response))
  }
  out
}

// How an `Inline` or `Binary` response to `request` is framed: none for a
// status without content; a 2xx answer to CONNECT has no `Content-Length`
// and ends by closing the connection (RFC 9110 section 9.3.6), as its
// streamed form does; otherwise its own `Content-Length`.
fn inline_framing(request: Request, response: Response) -> Framing {
  if has_no_content(response.status) {
    return NoBody
  }
  if is_connect_success(request, response.status) {
    return UntilClose
  }
  Length(inline_body(response).len())
}

// Whether a response with `status` is a 2xx answer to a CONNECT `request`.
fn is_connect_success(request: Request, status: Int) -> Bool = request.method == "CONNECT" && status >= 200 && status < 300

// Whether a response with `status` has no content: 1xx, 204 and 304 (RFC
// 9110 sections 15.2, 15.3.5 and 15.4.5).
fn has_no_content(status: Int) -> Bool = status < 200 || status == 204 || status == 304

// How a streamed response to `request` with `status` is framed: none for a
// status without content; the chunked coding only for an HTTP/1.1 request,
// and not for a 2xx answer to CONNECT, which ends by closing the
// connection, as does every answer to HTTP/1.0 (RFC 9112 sections 6.1 and
// 6.3).
fn streamed_framing(request: Request, status: Int) -> Framing satisfies [RFC9112.R6_1_7, RFC9112.R6_1_8, RFC9112.R6_1_11] {
  if has_no_content(status) {
    return NoBody
  }
  if request.version != "HTTP/1.1" || is_connect_success(request, status) {
    return UntilClose
  }
  Chunks
}

const HEX_DIGITS: Text = "0123456789abcdef"

// `n` in lower-case hexadecimal, the chunk-size of RFC 9112 section 7.1.
fn hex(n: Int) -> Text {
  let digits = HEX_DIGITS.to_bytes()
  var out = Bytes.empty()
  var rest = n
  loop {
    out.push(digits.at(rest % 16))
    rest = rest / 16
    if rest == 0 {
      break
    }
  }
  var reversed = Bytes.empty()
  var at = out.len()
  while at > 0 {
    at = at - 1
    reversed.push(out.at(at))
  }
  reversed.to_text()
}

// `piece` as one chunk: its size in hexadecimal, CRLF, the piece, CRLF.
fn chunk(piece: Bytes) -> Bytes {
  var out = "{hex(piece.len())}\r\n".to_bytes()
  out.append(piece)
  out.append(b"\r\n")
  out
}

// Sends the `Streamed` `response` to `request` (`asked` for the
// application): the head at once, then each non-empty piece
// `application.piece` returns as it comes, framed by `streamed_framing`;
// with the chunked coding, applied once, the last chunk and an empty
// trailer section follow. A response without content or to HEAD is the
// head only and `piece` is not called. Whether the connection stays open:
// not after a body that ends by closing it. An `Err` of `piece` is
// returned at once and the session closes the connection: a chunked body
// then lacks its last chunk, which a client sees as incomplete; a body
// that ends by closing looks complete to the client.
fn send_streamed<T: ByteStream, S>(stream: T, application: HttpApp<S>, request: Request, response: Response, keep_alive: Bool) -> IoResult<Bool> satisfies [RFC9112.R6_1_2] {
  let framing = streamed_framing(request, response.status)
  let keep = keep_alive && framing != UntilClose
  stream.write_all(render_head(response, framing, keep))?
  if framing == NoBody || request.method == "HEAD" {
    return Ok(keep)
  }
  let asked_request = asked(request)
  loop {
    match application.piece(application.state, asked_request)? {
      None => break
      Some(piece) => if !piece.is_empty() {
        stream.write_all(if framing == Chunks { chunk(piece) } else { piece })?
      }
    }
  }
  if framing == Chunks {
    stream.write_all(b"0\r\n\r\n")?
  }
  Ok(keep)
}

test "responses carry their reason, type and body" {
  assert reason(200) == "OK"
  assert reason(431) == "Request Header Fields Too Large"
  assert reason(299) == "Unknown"
  assert Response.json(201, Null) == Response { status = 201, headers = [("Content-Type", "application/json")], body = "null" }
  assert Response.plain(200, "hi") == Response { status = 200, headers = [("Content-Type", "text/plain; charset=utf-8")], body = "hi" }
  assert status_response(404).body == "Not Found\n"
  assert status_response(204) == Response { status = 204 }
  let allowed = method_not_allowed("GET, POST")
  assert allowed.status == 405
  assert allowed.headers == [("Content-Type", "text/plain; charset=utf-8"), ("Allow", "GET, POST")]
}

test "a header holding CR or LF turns the response into 500" verifies [RFC9112.R2_2_3, RFC9112.R5_2_1] {
  let fine = Response.plain(200, "line\r\nbreaks in the body are fine")
  assert checked(fine) == fine
  assert checked(Response { status = 200, headers = [("X", "a\r\nSet-Cookie: b")] }) == status_response(500)
  assert checked(Response { status = 200, headers = [("X", "a\nb")] }).status == 500
  assert checked(Response { status = 200, headers = [("X\r", "a")] }).status == 500
  assert checked(Response { status = 200, headers = [("X", "a\tb")] }).status == 200
}

// The status `checked` leaves of a 200 with `headers`.
test fn checked_status(headers: List<(Text, Text)>) -> Int = checked(Response { status = 200, headers }).status

test "a response header name that is not a token is 500" verifies [RFC9112.R2_2_8] {
  assert checked_status([(" X", "a")]) == 500
  assert checked_status([("\tX", "a")]) == 500
  assert checked_status([("X Y", "a")]) == 500
  assert checked_status([("X:", "a")]) == 500
  assert checked_status([("", "a")]) == 500
  assert checked_status([("é", "a")]) == 500
  assert checked_status([("X-Custom_1", "a")]) == 200
}

test "an application Transfer-Encoding is 500" verifies [
  RFC9112.R6_1_2, RFC9112.R6_1_4, RFC9112.R6_1_7, RFC9112.R6_1_8, RFC9112.R6_1_11, RFC9112.R6_2_1
] {
  for value in ["chunked", "chunked, chunked", "gzip", "gzip, chunked", ""] {
    assert checked_status([("Transfer-Encoding", value)]) == 500
    assert checked(Response { status = 204, headers = [("transfer-encoding", value)] }) == status_response(500)
    assert checked(Response { status = 101, headers = [("TRANSFER-ENCODING", value)] }) == status_response(500)
  }
  let served_gzip = served(b"GET /gzip HTTP/1.1\r\nHost: h\r\n\r\nGET /a HTTP/1.0\r\n\r\n")?
  assert !served_gzip.to_lower().contains("transfer-encoding")
  assert served_gzip == render(status_response(500), true).to_text() + reply("GET /a? ", "close")
}

test "a response's own Content-Length is 500 since Http frames it" verifies [RFC9112.R6_2_1, RFC9110.R5_3_3] {
  assert checked_status([("Content-Length", "2")]) == 500
  assert checked_status([("content-length", "0")]) == 500
  let length = render(checked(Response { status = 200, body = "hi" }), true).to_text()
  assert length.split("\r\n").slice(1, 3) == ["Content-Length: 2", "Connection: keep-alive"]
}

test "a repeated response field is 500 unless it is a list or Set-Cookie" verifies [RFC9110.R5_3_3] {
  assert checked_status([("Content-Type", "text/plain"), ("content-type", "text/html")]) == 500
  assert checked_status([("X", "1"), ("Y", "2"), ("X", "3")]) == 500
  assert checked_status([("Location", "/a"), ("LOCATION", "/b")]) == 500
  assert checked_status([("Vary", "Accept"), ("vary", "Origin")]) == 200
  assert checked_status([("Allow", "GET"), ("Allow", "POST")]) == 200
  assert checked_status([("Connection", "close"), ("Cache-Control", "no-store"), ("cache-control", "private")]) == 200
  assert checked_status([("Set-Cookie", "a=1"), ("Set-Cookie", "b=2")]) == 200
  assert checked_status([("X", "1"), ("Y", "1")]) == 200
}

test "an empty element of a response list field is 500" verifies [RFC9110.R5_6_1_1_1] {
  assert list_elements("a, b ,c") == ["a", "b", "c"]
  assert list_elements("a, \"b, ,c\", d") == ["a", "\"b, ,c\"", "d"]
  assert list_elements("\"a\\\", ,\", b") == ["\"a\\\", ,\"", "b"]
  for value in [",", "a,", ", a", "a,,b", "a, ,b", "a,\t,b"] {
    assert checked_status([("Vary", value)]) == 500
    assert checked_status([("connection", value)]) == 500
  }
  assert checked_status([("Allow", "")]) == 200
  assert checked_status([("Allow", "GET, HEAD")]) == 200
  assert checked_status([("WWW-Authenticate", "Basic realm=\"a, ,b\"")]) == 200
  assert checked_status([("X", "a,,b")]) == 200
  assert checked(Response { status = 200, headers = [("Connection", "keep-alive")] }).status == 200
}

test "BWS in a response's auth-param is 500" verifies [RFC9110.R5_6_3_4] {
  assert checked_status([("WWW-Authenticate", "Basic realm =\"x\"")]) == 500
  assert checked_status([("WWW-Authenticate", "Basic realm= \"x\"")]) == 500
  assert checked_status([("Proxy-Authenticate", "Basic realm\t=x")]) == 500
  assert checked_status([("Authentication-Info", "nextnonce = \"a\"")]) == 500
  assert checked_status([("WWW-Authenticate", "Basic realm=\"a = b\", charset=\"UTF-8\"")]) == 200
  assert checked_status([("WWW-Authenticate", "Bearer abc== , Basic realm=x")]) == 200
  assert checked_status([("WWW-Authenticate", "Bearer abc= ")]) == 200
  assert checked_status([("X", "a = b")]) == 200
}

test "a response timestamp is an IMF-fixdate with no extra whitespace" verifies [RFC9110.R5_6_7_2, RFC9110.R5_6_7_3] {
  assert is_imf_fixdate("Sun, 06 Nov 1994 08:49:37 GMT")
  for name in ["Date", "last-modified", "Expires", "Retry-After"] {
    assert checked_status([(name, "Sun, 06 Nov 1994 08:49:37 GMT")]) == 200
    assert checked_status([(name, "Sunday, 06-Nov-94 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun Nov  6 08:49:37 1994")]) == 500
    assert checked_status([(name, "Sun,  06 Nov 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nov 1994 08:49:37  GMT")]) == 500
    assert checked_status([(name, " Sun, 06 Nov 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nov 1994 08:49:37 UTC")]) == 500
    assert checked_status([(name, "Sun, 6 Nov 1994 08:49:37 GMT ")]) == 500
    assert checked_status([(name, "Xyz, 06 Nov 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nob 1994 08:49:37 GMT")]) == 500
    assert checked_status([(name, "Sun, 06 Nov 1994 08-49-37 GMT")]) == 500
  }
  assert checked_status([("Retry-After", "120")]) == 200
  assert checked_status([("Retry-After", "1 20")]) == 500
  assert checked_status([("Expires", "0")]) == 500
}

test "render writes the status line, headers, length and connection" verifies [RFC9112.R2_2_3, RFC9112.R4_4] {
  let created = render(Response.json(201, Object([])), true).to_text()
  assert created == "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\n" + r"{}"
  let utf8 = render(Response { status = 200, body = "é" }, false).to_text()
  assert utf8 == "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\né"
}

test "a 204 response has no Content-Length and no body" {
  let empty = render(status_response(204), true).to_text()
  assert empty == "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\n"
  let stray = render(Response { status = 204, body = "x" }, false).to_text()
  assert stray == "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n"
}

// ---- requests -----------------------------------------------------------

// The value of header `name` (lower case), the first if repeated.
fn header(request: Request, name: Text) -> Option<Text> {
  for header in request.headers {
    if header.0 == name {
      return Some(header.1)
    }
  }
  None
}

// The non-empty segments of the path: "/todos/3" is ["todos", "3"].
fn segments(request: Request) -> List<Text> {
  var out = []
  for segment in request.path.split("/") {
    if !segment.is_empty() {
      out.push(segment)
    }
  }
  out
}

// Whether a `Connection` header of `headers`, its name in any case, lists
// `option` (lower case). Its value is a comma-separated list, and the
// header may be repeated (RFC 9110 section 7.6.1).
fn lists_connection_option(headers: List<(Text, Text)>, option: Text) -> Bool satisfies [RFC9110.R5_6_1_2_1, RFC9110.R5_6_1_2_2] {
  for header in headers {
    if header.0.to_lower() == "connection" {
      for item in header.1.split(",") {
        if trim_ows(item).to_lower() == option {
          return true
        }
      }
    }
  }
  false
}

// Whether the request's `Connection` header lists `option`.
fn has_connection_option(request: Request, option: Text) -> Bool = lists_connection_option(request.headers, option)

// Whether the application's response sends the `close` option, after
// which the server closes the connection (RFC 9112 section 9.6).
fn response_closes(response: Response) -> Bool satisfies [RFC9112.R9_6_6] = lists_connection_option(response.headers, "close")

// HTTP/1.1 keeps the connection unless asked to close, HTTP/1.0 closes it
// unless asked to keep it; `close` wins over `keep-alive`.
fn keep_alive(request: Request) -> Bool satisfies [RFC9112.R9_6_3] {
  if has_connection_option(request, "close") {
    return false
  }
  request.version != "HTTP/1.0" || has_connection_option(request, "keep-alive")
}

// A GET of `/` in `version` with `headers` (names in lower case).
test fn get(version: Text, headers: List<(Text, Text)>) -> Request =
  Request { method = "GET", path = "/", query = "", version, headers, body = "" }

test "header finds the first value of a lower-case name" {
  let request = get("HTTP/1.1", [("host", "a"), ("x", "1"), ("x", "2")])
  assert header(request, "x") == Some("1")
  assert header(request, "host") == Some("a")
  assert header(request, "missing") == None
}

test "segments are the non-empty parts of the path" {
  var request = get("HTTP/1.1", [])
  request.path = "/todos/3"
  assert segments(request) == ["todos", "3"]
  request.path = "//todos//3/"
  assert segments(request) == ["todos", "3"]
  request.path = "/"
  assert segments(request) == []
}

test "HTTP/1.1 keeps the connection unless asked to close" {
  assert keep_alive(get("HTTP/1.1", []))
  assert keep_alive(get("HTTP/1.1", [("connection", "keep-alive")]))
  assert !keep_alive(get("HTTP/1.1", [("connection", "close")]))
  assert !keep_alive(get("HTTP/1.1", [("connection", "Close")]))
  assert keep_alive(get("HTTP/1.1", [("connection", "upgrade")]))
}

test "HTTP/1.0 closes the connection unless asked to keep it" {
  assert !keep_alive(get("HTTP/1.0", []))
  assert keep_alive(get("HTTP/1.0", [("connection", "keep-alive")]))
  assert keep_alive(get("HTTP/1.0", [("connection", "Keep-Alive")]))
  assert !keep_alive(get("HTTP/1.0", [("connection", "close")]))
}

test "Connection is a list of options" verifies [RFC9110.R5_6_1_2_2] {
  assert !keep_alive(get("HTTP/1.1", [("connection", "upgrade, close")]))
  assert !keep_alive(get("HTTP/1.1", [("connection", "keep-alive"), ("connection", "close")]))
  assert keep_alive(get("HTTP/1.0", [("connection", "TE,keep-alive")]))
  assert !keep_alive(get("HTTP/1.0", [("connection", "keep-alive, close")]))
  assert keep_alive(get("HTTP/1.1", [("connection", "closed")]))
}

test "empty elements of a Connection list are ignored" verifies [RFC9110.R5_6_1_2_1, RFC9110.R5_6_1_2_2] {
  assert !keep_alive(get("HTTP/1.1", [("connection", ", ,close,")]))
  assert keep_alive(get("HTTP/1.0", [("connection", ",,keep-alive , ")]))
  assert keep_alive(get("HTTP/1.1", [("connection", ",")]))
  assert has_connection_option(get("HTTP/1.1", [("connection", "a, , b")]), "b")
}

// RFC 9110 `tchar`.
fn is_token_byte(b: Byte) -> Bool = match b {
  b'!' | b'#' | b'$' | b'%' | b'&' | b'\'' | b'*' | b'+' | b'-' | b'.' | b'^' | b'_' | b'`' => true
  b'|' | b'~' | b'0'..=b'9' | b'a'..=b'z' | b'A'..=b'Z' => true
  _ => false
}

fn is_token(text: Text) -> Bool {
  for b in text.to_bytes() {
    if !is_token_byte(b) {
      return false
    }
  }
  !text.is_empty()
}

fn is_ows(b: Byte) -> Bool = b == b' ' || b == b'\t'

// `text` without the SP and HTAB at either end (OWS, RFC 9110 section
// 5.6.3); every other byte stays, a Unicode space too.
fn trim_ows(text: Text) -> Text {
  let bytes = text.to_bytes()
  var start = 0
  var end = bytes.len()
  while start < end && is_ows(bytes.at(start)) {
    start = start + 1
  }
  while end > start && is_ows(bytes.at(end - 1)) {
    end = end - 1
  }
  bytes.slice(start, end).to_text()
}

test "OWS is SP and HTAB only" verifies [RFC9112.R6_3_4, RFC9112.R6_3_5] {
  assert trim_ows(" \t a b \t ") == "a b"
  assert trim_ows("") == ""
  assert trim_ows(" \t") == ""
  assert trim_ows("x") == "x"
  for space in ["\u{a0}", "\u{85}", "\u{3000}", "\r", "\n"] {
    assert trim_ows("3{space}") == "3{space}"
  }
  assert parse_head("POST / HTTP/1.1\r\nContent-Length: 3\u{a0}")?.headers == [("content-length", "3\u{a0}")]
  for space in ["\u{a0}", "\u{85}", "\u{3000}"] {
    assert next_of("POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 3{space}\r\n\r\nabc".to_bytes())? == Reject(400)
  }
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: \t3 \r\n\r\nabc")? != Reject(400)
}

// A field value: no control byte except tab, so no bare CR or LF.
fn is_field_value(text: Text) -> Bool satisfies [RFC9110.R5_5_4] {
  for b in text.to_bytes() {
    if b < b' ' && b != b'\t' || b == 127 {
      return false
    }
  }
  true
}

// A request target: visible bytes only.
fn is_target(text: Text) -> Bool {
  for b in text.to_bytes() {
    if b <= b' ' || b == 127 {
      return false
    }
  }
  !text.is_empty()
}

// An absolute-form request-target (RFC 9112 section 3.2.2) of the `http`
// or `https` scheme, in any case: its authority and the rest as an
// origin-form target, `/` when the path is empty. `None` for any other
// form.
fn absolute_form(target: Text) -> Option<(Text, Text)> {
  let lower = target.to_lower()
  var scheme = 8
  if lower.starts_with("http://") {
    scheme = 7
  } else if !lower.starts_with("https://") {
    return None
  }
  let bytes = target.to_bytes()
  var end = scheme
  while end < bytes.len() && bytes.at(end) != b'/' && bytes.at(end) != b'?' {
    end = end + 1
  }
  let rest = bytes.slice(end, bytes.len()).to_text()
  let origin = if rest.starts_with("/") { rest } else { "/" + rest }
  Some((bytes.slice(scheme, end).to_text(), origin))
}

// RFC 3986 `unreserved`, `sub-delims` and `%`: the bytes of a `reg-name`.
fn is_reg_name_byte(b: Byte) -> Bool = match b {
  b'-' | b'.' | b'_' | b'~' | b'!' | b'$' | b'&' | b'\'' | b'(' | b')' | b'*' | b'+' | b',' | b';' | b'=' | b'%' => true
  b'0'..=b'9' | b'a'..=b'z' | b'A'..=b'Z' => true
  _ => false
}

// A `Host` value (RFC 9110 section 7.2): `uri-host [ ":" port ]`, the host
// a `reg-name`, an IPv4 address or an IP-literal in brackets, the port
// digits. Empty is valid: the target URI has no authority.
fn is_host(value: Text) -> Bool {
  let bytes = value.to_bytes()
  if bytes.is_empty() {
    return true
  }
  var at = 0
  if bytes.at(0) == b'[' {
    at = 1
    while at < bytes.len() && bytes.at(at) != b']' {
      if !is_reg_name_byte(bytes.at(at)) && bytes.at(at) != b':' {
        return false
      }
      at = at + 1
    }
    if at == bytes.len() || at == 1 {
      return false
    }
    at = at + 1
  } else {
    while at < bytes.len() && bytes.at(at) != b':' {
      if !is_reg_name_byte(bytes.at(at)) {
        return false
      }
      at = at + 1
    }
    if at == 0 {
      return false
    }
  }
  if at == bytes.len() {
    return true
  }
  bytes.at(at) == b':' && (at + 1 == bytes.len() || is_digits(bytes.slice(at + 1, bytes.len())))
}

// `request` once its `Host` is checked: `None` (400) when an HTTP/1.1
// request has none, when it is repeated or its value is not a host. For an
// absolute-form target, the received `Host` is replaced by the target's
// `authority`, which must be a host and not empty.
fn resolve_host(request: Request, authority: Option<Text>) -> Option<Request> satisfies [RFC9112.R3_2_6, RFC9112.R3_2_2_5] {
  var hosts = []
  var others = []
  for header in request.headers {
    if header.0 == "host" {
      hosts.push(header.1)
    } else {
      others.push(header)
    }
  }
  if hosts.len() > 1 || hosts.len() == 0 && request.version == "HTTP/1.1" {
    return None
  }
  for value in hosts {
    if !is_host(value) {
      return None
    }
  }
  match authority {
    None => Some(request)
    Some(host) => if host.is_empty() || !is_host(host) {
      None
    } else {
      var resolved = request
      others.push(("host", host))
      resolved.headers = others
      Some(resolved)
    }
  }
}

// Whether the request line of a head over the limit is itself longer than
// `maximum` bytes and starts with a method: its request-target is longer
// than Http parses, 414 rather than 431 (RFC 9112 section 3).
fn target_too_long(data: Bytes, maximum: Int) -> Bool satisfies [RFC9112.R3_3] {
  let line_end = match bytes_find_from(data, b"\r\n", 0) {
    Some(at) => at
    None => data.len()
  }
  if line_end <= maximum {
    return false
  }
  match bytes_find_from(data, b" ", 0) {
    Some(at) => at < line_end && is_token(data.slice(0, at).to_text())
    None => false
  }
}

// The request line and header lines of a head, without the blank line.
fn parse_head(head: Text) -> Option<Request> satisfies [RFC9112.R2_2_4, RFC9112.R2_2_9, RFC9112.R5_1_1, RFC9112.R5_2_2, RFC9110.R5_5_1, RFC9110.R5_5_4] {
  let lines = head.split("\r\n")
  let parts = lines.at(0).split(" ")
  if parts.len() != 3 || !is_token(parts.at(0)) || !is_target(parts.at(1)) {
    return None
  }
  if parts.at(2) != "HTTP/1.1" && parts.at(2) != "HTTP/1.0" {
    return None
  }
  let target = match absolute_form(parts.at(1)) {
    Some((_, rest)) => rest
    None => parts.at(1)
  }
  let (path, query) = target.split_once("?").unwrap_or((target, ""))
  if !path.starts_with("/") {
    return None
  }
  var headers = []
  for line in lines.slice(1, lines.len()) {
    match line.split_once(":") {
      Some((name, value)) => if is_token(name) && is_field_value(value) {
        headers.push((name.to_lower(), trim_ows(value)))
      } else {
        return None
      }
      None => return None
    }
  }
  Some(Request { method = parts.at(0), path, query, version = parts.at(2), headers, body = "" })
}

test "tokens, field values and targets" verifies [RFC9110.R5_5_4] {
  assert is_token("Content-Length")
  assert is_token("!#$%&'*+-.^_`|~09azAZ")
  assert !is_token("")
  assert !is_token("Host ")
  assert !is_token("a:b")
  assert !is_token("é")
  assert is_field_value("")
  assert is_field_value("a\tb ü")
  assert !is_field_value("a\rb")
  assert !is_field_value("a\nb")
  assert !is_field_value("a\0b")
  assert !is_field_value("a\x7fb")
  assert is_target("/todos?x=1")
  assert !is_target("")
  assert !is_target("/a b")
  assert !is_target("/a\x7f")
}

test "parse_head reads the request line and headers" verifies [RFC9110.R5_5_1] {
  let head = "POST /todos?x=1&y HTTP/1.1\r\nHost: example:80\r\nX-Padded:  a\tb \t\r\nEmpty:"
  let expected = Request {
    method = "POST"
    path = "/todos"
    query = "x=1&y"
    version = "HTTP/1.1"
    headers = [("host", "example:80"), ("x-padded", "a\tb"), ("empty", "")]
    body = ""
  }
  assert parse_head(head) == Some(expected)
  assert parse_head("GET / HTTP/1.0") == Some(get("HTTP/1.0", []))
  assert parse_head("GET /?a?b HTTP/1.1")?.query == "a?b"
  assert parse_head("GET /p? HTTP/1.1")?.path == "/p"
}

test "parse_head refuses a malformed request line" {
  assert parse_head("") == None
  assert parse_head("NONSENSE") == None
  assert parse_head("GET /  HTTP/1.1") == None
  assert parse_head("GET / HTTP/2") == None
  assert parse_head("GET / http/1.1") == None
  assert parse_head("G@T / HTTP/1.1") == None
  assert parse_head("GET todos HTTP/1.1") == None
  assert parse_head("GET * HTTP/1.1") == None
  assert parse_head("GET /\x7f HTTP/1.1") == None
  assert parse_head("GET / HTTP/1.1\nHost: x") == None
  assert parse_head("GET\t/ HTTP/1.1") == None
}

test "parse_head refuses a malformed header line" verifies [RFC9112.R2_2_4, RFC9112.R2_2_9, RFC9112.R5_1_1, RFC9112.R5_2_2, RFC9110.R5_5_4] {
  assert parse_head("GET / HTTP/1.1\r\nHost : x") == None
  assert parse_head("GET / HTTP/1.1\r\nHost\t: x") == None
  assert parse_head("GET / HTTP/1.1\r\n Host: x") == None
  assert parse_head("GET / HTTP/1.1\r\nHost: x\r\n folded") == None
  assert parse_head("GET / HTTP/1.1\r\nNoColon") == None
  assert parse_head("GET / HTTP/1.1\r\n: x") == None
  assert parse_head("GET / HTTP/1.1\r\nX: a\rb") == None
  assert parse_head("GET / HTTP/1.1\r\nX: a\nTransfer-Encoding: chunked") == None
  assert parse_head("GET / HTTP/1.1\r\nX: a\0") == None
}

// How reading a head ended.
enum HeadRead { Complete(Int), Closed, TooLarge }

// Reads until `buffer` holds a whole head: how it ended and the bytes
// read. `Complete` carries the head's length including the blank line.
fn read_head<T: ByteStream>(stream: T, limits: HttpLimits, buffer: Bytes) -> IoResult<(HeadRead, Bytes)> satisfies [RFC9110.R5_3_4, RFC9110.R5_4_1] {
  let maximum = limits.head.to_int()
  var data = buffer
  var from = 0
  loop {
    match bytes_find_from(data, b"\r\n\r\n", from) {
      Some(at) => return Ok((if at + 4 > maximum { TooLarge } else { Complete(at + 4) }, data))
      None => {}
    }
    if data.len() > maximum {
      return Ok((TooLarge, data))
    }
    from = if data.len() > 3 { data.len() - 3 } else { 0 }
    match stream.read(READ_SIZE)? {
      Eof => return Ok((Closed, data))
      Data(more) => data.append(more)
    }
  }
}

// Reads until `data` holds at least `end` bytes; `None` when the peer
// closed first. The length was checked against `limits.body` already.
fn read_body<T: ByteStream>(stream: T, limits: HttpLimits, data: Bytes, end: Int) -> IoResult<Option<Bytes>> satisfies [RFC9112.R6_3_8, RFC9112.R9_3_5] {
  var out = data
  while out.len() < end {
    match stream.read(READ_SIZE)? {
      Eof => return Ok(None)
      Data(more) => out.append(more)
    }
  }
  Ok(Some(out))
}

// What comes next on a connection: a request and the bytes after it, the
// end of the connection, or a status to answer before closing;
// `RejectHead` answers a HEAD request, without content.
enum Next { Got(Request, Bytes), Close, Reject(Int), RejectHead(Int) }

// The rejection of a parsed `request` with `status`.
fn rejected(request: Request, status: Int) -> Next = if request.method == "HEAD" { RejectHead(status) } else { Reject(status) }

fn next_request<T: ByteStream>(stream: T, limits: HttpLimits, buffer: Bytes) -> IoResult<Next> satisfies [RFC9112.R3_3, RFC9112.R3_2_6, RFC9112.R3_2_2_5, RFC9112.R3_2_2_6, RFC9112.R5_1_1, RFC9112.R6_1_13, RFC9112.R6_1_14, RFC9112.R6_3_4, RFC9112.R6_3_5, RFC9112.R6_3_8, RFC9112.R9_3_5, RFC9110.R5_3_4, RFC9110.R5_4_1] {
  let (outcome, data) = read_head(stream, limits, buffer)?
  let head_end = match outcome {
    Complete(end) => end
    Closed => return Ok(Close)
    TooLarge => return Ok(Reject(if target_too_long(data, limits.head.to_int()) { 414 } else { 431 }))
  }
  let head = data.slice(0, head_end - 4).to_text()
  let parsed = match parse_head(head) {
    Some(parsed) => parsed
    None => return Ok(Reject(400))
  }
  let authority = match absolute_form(head.split("\r\n").at(0).split(" ").at(1)) {
    Some((host, _)) => Some(host)
    None => None
  }
  let request = match resolve_host(parsed, authority) {
    Some(resolved) => resolved
    None => return Ok(rejected(parsed, 400))
  }
  if header(request, "transfer-encoding") != None {
    match coding_status(request) {
      Some(status) => return Ok(rejected(request, status))
      None => {}
    }
    return match read_chunked(stream, limits, data, head_end)? {
      Unfinished => Ok(Close)
      Refused(status) => Ok(rejected(request, status))
      Decoded(body, rest) => {
        var full = request
        full.body = body.to_text()
        Ok(Got(full, rest))
      }
    }
  }
  var lengths = []
  for header in request.headers {
    if header.0 == "content-length" {
      lengths.push(header.1)
    }
  }
  let length = match lengths {
    [] => 0
    [text] => match parse_length(text) {
      Some(n) => n
      None => return Ok(rejected(request, 400))
    }
    _ => return Ok(rejected(request, 400))
  }
  if length > limits.body.to_int() {
    return Ok(rejected(request, 413))
  }
  match read_body(stream, limits, data, head_end + length)? {
    None => Ok(Close)
    Some(all) => {
      var full = request
      full.body = all.slice(head_end, head_end + length).to_text()
      Ok(Got(full, all.slice(head_end + length, all.len())))
    }
  }
}

// The value of a hexadecimal digit byte, `None` for any other byte.
fn hex_digit_value(b: Byte) -> Option<Int> = match b {
  b'0'..=b'9' => Some((b - b'0').to_int())
  b'a'..=b'f' => Some((b - b'a').to_int() + 10)
  b'A'..=b'F' => Some((b - b'A').to_int() + 10)
  _ => None
}

// What a chunk-size line says (RFC 9112 section 7.1): the size, a size over
// what the body may still take, or a malformed line.
enum ChunkSize { Size(Int), SizeTooLarge, SizeMalformed }

// The chunk size of `line` (without its CRLF): `1*HEXDIG`, then nothing or
// chunk extensions after optional SP or HTAB and a `;`, which are ignored
// (section 7.1.1) once they hold no control byte but HTAB. The size is
// compared with `remaining`, the most the body may still take, before each
// digit is added, so no number of digits overflows (section 7.1).
fn chunk_size(line: Bytes, remaining: Int) -> ChunkSize satisfies [RFC9112.R7_1_3, RFC9112.R7_1_1_1] {
  var size = 0
  var at = 0
  while at < line.len() {
    match hex_digit_value(line.at(at)) {
      Some(digit) => {
        if size > remaining / 16 || size * 16 + digit > remaining {
          return SizeTooLarge
        }
        size = size * 16 + digit
      }
      None => break
    }
    at = at + 1
  }
  if at == 0 {
    return SizeMalformed
  }
  var rest = at
  while rest < line.len() && is_ows(line.at(rest)) {
    rest = rest + 1
  }
  if rest < line.len() && line.at(rest) != b';' || rest == line.len() && rest > at {
    return SizeMalformed
  }
  if !is_field_value(line.slice(at, line.len()).to_text()) {
    return SizeMalformed
  }
  Size(size)
}

// How reading a line ended: the index of its CRLF, the peer closed first,
// or the line is longer than allowed.
enum LineRead { Line(Int), LineClosed, LineTooLong }

// Reads until `data` holds a CRLF at or after `from` and returns the
// bytes read; a line of more than `maximum` bytes is `LineTooLong`.
fn read_line<T: ByteStream>(stream: T, data: Bytes, from: Int, maximum: Int) -> IoResult<(LineRead, Bytes)> {
  var out = data
  var search = from
  loop {
    match bytes_find_from(out, b"\r\n", search) {
      Some(at) => return Ok((if at - from > maximum { LineTooLong } else { Line(at) }, out))
      None => {}
    }
    if out.len() - from > maximum {
      return Ok((LineTooLong, out))
    }
    search = if out.len() > from + 1 { out.len() - 1 } else { from }
    match stream.read(READ_SIZE)? {
      Eof => return Ok((LineClosed, out))
      Data(more) => out.append(more)
    }
  }
}

// How reading one chunk's data ended: the body with the data appended, the
// input held and the index after the data's CRLF in it; the peer closed
// first; or the data is not followed by CRLF.
enum ChunkData { DataRead(Bytes, Bytes, Int), DataClosed, DataMalformed }

// Appends the `size` bytes of chunk data at `at` of `data` to `body` and
// checks the CRLF after them. Data that `data` does not hold yet is
// appended to `body` read by read, and only the bytes of the last read after
// it are kept as input, so a chunk is never held twice.
fn read_chunk_data<T: ByteStream>(stream: T, limits: HttpLimits, data: Bytes, at: Int, size: Int, body: Bytes) -> IoResult<ChunkData> {
  var out = body
  var input = data
  var from = at + size
  if input.len() < at + size {
    let end = out.len() + size
    out.append(input.slice(at, input.len()))
    input = Bytes.empty()
    from = 0
    while out.len() < end {
      match stream.read(READ_SIZE)? {
        Eof => return Ok(DataClosed)
        Data(more) => {
          let need = end - out.len()
          if more.len() <= need {
            out.append(more)
          } else {
            out.append(more.slice(0, need))
            input = more.slice(need, more.len())
          }
        }
      }
    }
  } else {
    out.append(input.slice(at, at + size))
  }
  input = match read_body(stream, limits, input, from + 2)? {
    None => return Ok(DataClosed)
    Some(more) => more
  }
  if input.at(from) != b'\r' || input.at(from + 1) != b'\n' {
    return Ok(DataMalformed)
  }
  Ok(DataRead(out, input, from + 2))
}

// How decoding a chunked body ended: the body, the bytes after the message,
// the peer closed first, or a status to answer.
enum Chunked { Decoded(Bytes, Bytes), Unfinished, Refused(Int) }

// Decodes the chunked body that starts at `start` of `buffer` (RFC 9112
// section 7.1): chunks until the last, then the trailer section, whose
// field lines are checked as header field lines and discarded, so none is
// retained or merged into the header section (section 7.1.2; RFC 9110
// section 6.5.1). A body over `limits.body` is 413, a chunk-size line or a
// trailer section over `limits.head` 431, anything malformed 400. The bytes
// consumed are dropped as it goes.
fn read_chunked<T: ByteStream>(stream: T, limits: HttpLimits, buffer: Bytes, start: Int) -> IoResult<Chunked> satisfies [
  RFC9112.R6_1_1, RFC9112.R7_1_2, RFC9112.R7_1_2_2, RFC9112.R7_1_2_3, RFC9110.R6_5_1_2
] {
  let maximum = limits.body.to_int()
  let line_maximum = limits.head.to_int()
  var data = buffer
  var at = start
  var body = Bytes.empty()
  loop {
    if at >= READ_SIZE {
      data = data.slice(at, data.len())
      at = 0
    }
    let (line, read) = read_line(stream, data, at, line_maximum)?
    data = read
    let end = match line {
      Line(end) => end
      LineClosed => return Ok(Unfinished)
      LineTooLong => return Ok(Refused(431))
    }
    let size = match chunk_size(data.slice(at, end), maximum - body.len()) {
      Size(size) => size
      SizeTooLarge => return Ok(Refused(413))
      SizeMalformed => return Ok(Refused(400))
    }
    at = end + 2
    if size == 0 {
      break
    }
    match read_chunk_data(stream, limits, data, at, size, body)? {
      DataRead(decoded, input, next) => {
        body = decoded
        data = input
        at = next
      }
      DataClosed => return Ok(Unfinished)
      DataMalformed => return Ok(Refused(400))
    }
  }
  let trailer = at
  loop {
    let (line, read) = read_line(stream, data, at, line_maximum - (at - trailer))?
    data = read
    let end = match line {
      Line(end) => end
      LineClosed => return Ok(Unfinished)
      LineTooLong => return Ok(Refused(431))
    }
    if end == at {
      return Ok(Decoded(body, data.slice(end + 2, data.len())))
    }
    match data.slice(at, end).to_text().split_once(":") {
      Some((name, value)) => if !is_token(name) || !is_field_value(value) {
        return Ok(Refused(400))
      }
      None => return Ok(Refused(400))
    }
    at = end + 2
  }
}

// The transfer codings of a request in order, in lower case, over all its
// `Transfer-Encoding` lines (RFC 9112 section 6.1); empty list elements
// are ignored (RFC 9110 section 5.6.1.2).
fn transfer_codings(request: Request) -> List<Text> {
  var out = []
  for header in request.headers {
    if header.0 == "transfer-encoding" {
      for coding in list_elements(header.1) {
        if !coding.is_empty() {
          out.push(coding.to_lower())
        }
      }
    }
  }
  out
}

// The status for a request with `Transfer-Encoding`, `None` when its body
// is chunked and Http decodes it (RFC 9112 sections 6.1 and 6.3): 400 for
// an HTTP/1.0 request, one with a `Content-Length` too, one with no coding,
// one whose final coding is not chunked or that names chunked twice; 501
// for a coding other than chunked before the final chunked.
fn coding_status(request: Request) -> Option<Int> satisfies [RFC9112.R6_1_13, RFC9112.R6_1_14, RFC9112.R6_3_3] {
  let codings = transfer_codings(request)
  if request.version == "HTTP/1.0" || header(request, "content-length") != None || codings.is_empty() {
    return Some(400)
  }
  if codings.at(codings.len() - 1) != "chunked" {
    return Some(400)
  }
  var other = false
  for coding in codings.slice(0, codings.len() - 1) {
    if coding == "chunked" {
      return Some(400)
    }
    other = true
  }
  if other { Some(501) } else { None }
}

// A `Content-Length` value: 1 to 18 decimal digits, nothing else.
fn parse_length(text: Text) -> Option<Int> satisfies [RFC9112.R6_3_4] {
  if text.is_empty() || text.len() > MAXIMUM_LENGTH_DIGITS {
    return None
  }
  for b in text.to_bytes() {
    if !is_digit(b) {
      return None
    }
  }
  Int.parse(text)
}

test "a Content-Length is 1 to 18 decimal digits" verifies [RFC9112.R6_3_4] {
  assert parse_length("0") == Some(0)
  assert parse_length("42") == Some(42)
  assert parse_length("007") == Some(7)
  assert parse_length("999999999999999999") == Some(999999999999999999)
  assert parse_length("1000000000000000000") == None
  assert parse_length("") == None
  assert parse_length("+1") == None
  assert parse_length("-1") == None
  assert parse_length(" 1") == None
  assert parse_length("1,1") == None
  assert parse_length("0x10") == None
  assert parse_length("١") == None
}

// Answer a rejected request and close lingering: the reply, the write half
// shut down, then input drained (at most `limits.drain`, each read waiting
// at most `limits.drain_timeout`) so unread input does not turn the close
// into a reset that discards the reply at the client.
// A HEAD request gets the head of the reply only.
fn reject<T: ByteStream>(stream: T, limits: HttpLimits, status: Int, head: Bool) -> IoResult<Unit> satisfies [RFC9112.R6_1_13, RFC9112.R6_1_14, RFC9112.R6_3_5, RFC9112.R9_6_6, RFC9112.R9_6_7, RFC9110.R9_3_2_1] {
  stream.write_all(render_message(status_response(status), false, !head))?
  _ = stream.close()
  stream.set_idle_timeout(limits.drain_timeout.to_ms())?
  let maximum = limits.drain.to_int()
  var drained = 0
  while drained < maximum {
    match stream.read(READ_SIZE) {
      Ok(Data(more)) => {
        drained = drained + more.len()
      }
      _ => return Ok(())
    }
  }
  Ok(())
}

// The request the application is asked: HEAD is asked as GET, and its
// answer is sent without content (RFC 9110 sections 9.1 and 9.3.2).
fn asked(request: Request) -> Request {
  var out = request
  if request.method == "HEAD" {
    out.method = "GET"
  }
  out
}

fn session<T: ByteStream, S>(stream: T, limits: HttpLimits, application: HttpApp<S>) -> IoResult<Unit> satisfies [RFC9112.R9_6_3, RFC9112.R9_6_5, RFC9112.R9_6_6, RFC9112.R9_6_7, RFC9110.R9_1_1, RFC9110.R9_3_2_1] {
  var buffer = Bytes.empty()
  loop {
    match next_request(stream, limits, buffer)? {
      Close => return Ok(())
      Reject(status) => return reject(stream, limits, status, false)
      RejectHead(status) => return reject(stream, limits, status, true)
      Got(request, rest) => {
        let response = checked(application.handle(application.state, asked(request)))
        var keep = keep_alive(request) && !response_closes(response)
        if response.content == Streamed {
          keep = send_streamed(stream, application, request, response, keep)?
        } else {
          let framing = inline_framing(request, response)
          keep = keep && framing != UntilClose
          stream.write_all(render_framed(response, framing, keep, request.method != "HEAD"))?
        }
        if !keep {
          return Ok(())
        }
        buffer = rest
      }
    }
  }
}

// A connected pair of pipe ends: the client and the server end. Each
// gives up on a peer silent for 5 s, so a session that does not close
// fails the test instead of hanging it.
test fn connected() -> IoResult<(PipeStream, PipeStream)> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  server.set_idle_timeout(5000)?
  Ok((client, server))
}

// What `next_request` makes of `input` under `limits`, sent with the
// write half closed after it.
test fn next_with(input: Bytes, limits: HttpLimits) -> IoResult<Next> {
  let (client, server) = connected()?
  client.write_all(input)?
  _ = client.close()
  next_request(server, limits, Bytes.empty())
}

// What `next_request` makes of `input` under the default limits.
test fn next_of(input: Bytes) -> IoResult<Next> = next_with(input, HttpLimits {})

// `input` with `count` filler bytes in an `X` header before its blank line.
test fn padded(input: Text, count: Int) -> Bytes {
  var out = input.to_bytes()
  out.append(b"X: ")
  while out.len() < count - 4 {
    out.push(b'x')
  }
  out.append(b"\r\n\r\n")
  out
}

test "next_request reads a head, its body and keeps the rest" verifies [RFC9112.R9_3_5] {
  let request = Request {
    method = "POST"
    path = "/todos"
    query = ""
    version = "HTTP/1.1"
    headers = [("host", "h"), ("content-length", "5")]
    body = "hello"
  }
  assert next_of(b"POST /todos HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhelloGET /")? == Got(request, b"GET /")
  assert next_of(b"GET / HTTP/1.0\r\n\r\n")? == Got(get("HTTP/1.0", []), Bytes.empty())
}

test "next_request takes a pipelined request from the buffer" {
  let (client, server) = connected()?
  _ = client.close()
  let buffer = b"GET / HTTP/1.1\r\nHost: h\r\n\r\nGET / HTTP/1.0\r\n\r\n"
  assert next_request(server, HttpLimits {}, buffer)? == Got(get("HTTP/1.1", [("host", "h")]), b"GET / HTTP/1.0\r\n\r\n")
}

test "next_request ends on a connection closed before a whole request" verifies [RFC9112.R6_3_8, RFC9110.R5_3_4] {
  assert next_of(Bytes.empty())? == Close
  assert next_of(b"GET / HTTP/1.1\r\nHost: h\r\n")? == Close
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhi")? == Close
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1048576\r\n\r\n")? == Close
}

test "a head over 8 KiB is 431" verifies [RFC9110.R5_4_1] {
  match next_of(padded("GET / HTTP/1.1\r\nHost: h\r\n", 8192))? {
    Got(request, rest) => {
      assert request.headers.len() == 2 && rest.is_empty()
    }
    _ => {
      assert false, "a head of 8192 bytes is read"
    }
  }
  assert next_of(padded("GET / HTTP/1.1\r\nHost: h\r\n", 8193))? == Reject(431)
  assert next_of(padded("GET / HTTP/1.1\r\nHost: h\r\n", 9000).slice(0, 8999))? == Reject(431)
}

test "a body over 1 MiB is 413" {
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1048577\r\n\r\n")? == Reject(413)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 999999999999999999\r\n\r\n")? == Reject(413)
}

test "a malformed head or Content-Length is 400" verifies [RFC9112.R6_3_4, RFC9112.R6_3_5] {
  assert next_of(b"NONSENSE\r\n\r\n")? == Reject(400)
  assert next_of(b"GET / HTTP/1.1\r\nHost: h\r\nX: a\nContent-Length: 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 3, 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: -1\r\n\r\n")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length:\r\n\r\n")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1000000000000000000\r\n\r\n")? == Reject(400)
}

// Answers `<method> <path>?<query> <body>`; `/bad` gets a header with a
// line break, `/close` the header `Connection: Upgrade, Close`, `/gzip`
// the header `Transfer-Encoding: gzip`, `/forbidden` 403, `/bytes` the
// bytes 0 to 255.
test fn answer(state: Unit, request: Request) -> Response = if request.path == "/bad" {
  Response { status = 200, headers = [("X", "a\r\nb")] }
} else if request.path == "/forbidden" {
  status_response(403)
} else if request.path == "/bytes" {
  Response.bytes(200, "application/octet-stream", every_byte())
} else if request.path == "/gzip" {
  Response { status = 200, headers = [("Transfer-Encoding", "gzip")], body = "gzip" }
} else if request.path == "/close" {
  Response { status = 200, headers = [("connection", "Upgrade,\tClose ")], body = "closing" }
} else {
  Response.plain(200, "{request.method} {request.path}?{request.query} {request.body}")
}

// Everything `client` reads until the end of the stream.
test fn read_to_end<T: ByteStream>(client: T) -> IoResult<Text> requires [client.read] {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out.to_text())
      Data(bytes) => out.append(bytes)
    }
  }
}

// Everything `Http.serve` sends for `input` under `limits` until it
// closes the connection, over a pipe.
test fn served_with(input: Bytes, limits: HttpLimits) -> IoResult<Text> {
  let (client, server) = connected()?
  spawn Http.serve(server, limits, HttpApp { state = (), handle = answer })
  client.write_all(input)?
  read_to_end(client)
}

// `served_with` under the default limits.
test fn served(input: Bytes) -> IoResult<Text> = served_with(input, HttpLimits {})

// The same over loopback TCP, so the test build has the `TcpStream`
// instance of `Http.serve` too (`docs/slice.md` D13).
test fn served_over_tcp(input: Bytes) -> IoResult<Text> {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  client.set_idle_timeout(5000)?
  let server = listener.accept()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = (), handle = answer })
  client.write_all(input)?
  read_to_end(client)
}

test fn reply(body: Text, connection: Text) -> Text {
  let length = body.len()
  "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {length}\r\nConnection: {connection}\r\n\r\n{body}"
}

test "the server answers pipelined requests until one asks to close" verifies [RFC9112.R9_6_3, RFC9112.R9_6_6] {
  let input = b"GET /a?x HTTP/1.1\r\nHost: h\r\n\r\nPOST /b HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n\r\nhiGET /c HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
  let expected = reply("GET /a?x ", "keep-alive") + reply("POST /b? hi", "keep-alive") + reply("GET /c? ", "close")
  assert served(input)? == expected
  assert served_over_tcp(input)? == expected
  assert served(b"GET /e HTTP/1.0\r\n\r\n")? == reply("GET /e? ", "close")
  assert served_over_tcp(b"GET /e HTTP/1.0\r\n\r\n")? == reply("GET /e? ", "close")
}

test "the server answers a rejected request and closes" verifies [RFC9112.R6_3_5, RFC9112.R9_6_6, RFC9112.R9_6_7] {
  let rejected = "HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 12\r\nConnection: close\r\n\r\nBad Request\n"
  assert served(b"GET /a HTTP/1.1\r\nHost: h\r\n\r\nBAD\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n")? == reply("GET /a? ", "keep-alive") + rejected
  let server_error = "HTTP/1.1 500 Internal Server Error\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 22\r\nConnection: close\r\n\r\nInternal Server Error\n"
  assert served(b"GET /bad HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")? == server_error
}

test "three pipelined requests over a pipe are answered in one batch" {
  let (client, server) = connected()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = (), handle = answer })
  client.write_all(b"GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\nGET /c HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  let out = read_to_end(client)?
  assert out == reply("GET /a? ", "keep-alive") + reply("GET /b? ", "keep-alive") + reply("GET /c? ", "close")
  assert client.received_batches() == 1
}

test "a pipe client gets 400, 413 and 431" {
  assert served(b"NONSENSE\r\n\r\n")? == render(status_response(400), false).to_text()
  assert served(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1048577\r\n\r\n")? == render(status_response(413), false).to_text()
  assert served(padded("GET / HTTP/1.1\r\nHost: h\r\n", 8193))? == render(status_response(431), false).to_text()
  assert render(status_response(431), false).to_text().starts_with("HTTP/1.1 431 Request Header Fields Too Large\r\n")
  assert render(status_response(413), false).to_text().contains("\r\nConnection: close\r\n")
}

test "the limits record bounds the body" {
  let limits = HttpLimits { body = 4 bytes }
  assert next_with(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nabcde", limits)? == Reject(413)
  assert served_with(b"POST /b HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nabcde", limits)? == render(status_response(413), false).to_text()
  assert served_with(b"POST /b HTTP/1.1\r\nHost: h\r\nContent-Length: 4\r\nConnection: close\r\n\r\nabcd", limits)? == reply("POST /b? abcd", "close")
}

test "the limits default to 8 KiB, 1 MiB, 30 s, 64 KiB and 1 s" {
  let limits = HttpLimits {}
  assert limits.head.to_int() == 8192
  assert limits.body.to_int() == 1048576
  assert limits.idle_timeout.to_ms() == 30000
  assert limits.drain.to_int() == 65536
  assert limits.drain_timeout.to_ms() == 1000
}

// Flushes the task's pending writes as their own delivery and waits 50 ms,
// so the next write is a separate delivery the server reads on its own.
test fn pause() -> IoResult<Unit> {
  let (a, b) = Pipe.pair()
  a.set_idle_timeout(50)?
  _ = a.read(1)?
  _ = b.close()
  Ok(())
}

// `parts` written as separate deliveries to `Http.serve` under `limits`
// over a pipe, the client closing its write half after the last when
// `close` holds; everything the server sends until it closes.
test fn served_parts(parts: List<Bytes>, limits: HttpLimits, close: Bool) -> IoResult<Text> {
  let (client, server) = connected()?
  spawn Http.serve(server, limits, HttpApp { state = (), handle = answer })
  for part in parts {
    client.write_all(part)?
    pause()?
  }
  if close {
    _ = client.close()
  }
  read_to_end(client)
}

// The status line of a response.
test fn status_line(text: Text) -> Text = text.split("\r\n").at(0)

test "a head of exactly HttpLimits.head is served, one byte more is 431" verifies [RFC9110.R5_4_1] {
  let limits = HttpLimits { head = 64 bytes }
  assert padded("GET / HTTP/1.0\r\n", 64).len() == 64
  assert served_with(padded("GET / HTTP/1.0\r\n", 64), limits)? == reply("GET /? ", "close")
  assert status_line(served_with(padded("GET / HTTP/1.0\r\n", 65), limits)?) == "HTTP/1.1 431 Request Header Fields Too Large"
}

test "the default head of exactly 8192 bytes is served, 8193 is 431" {
  assert served(padded("GET / HTTP/1.0\r\n", 8192))? == reply("GET /? ", "close")
  assert status_line(served(padded("GET / HTTP/1.0\r\n", 8193))?) == "HTTP/1.1 431 Request Header Fields Too Large"
}

test "a request line alone at the head limit" {
  let limits = HttpLimits { head = 64 bytes }
  let at = "/" + repeat("a", 45)
  assert "GET {at} HTTP/1.0\r\n\r\n".len() == 63
  assert served_with("GET {at} HTTP/1.0\r\n\r\n".to_bytes(), limits)? == reply("GET {at}? ", "close")
  let fits = "/" + repeat("a", 46)
  assert served_with("GET {fits} HTTP/1.0\r\n\r\n".to_bytes(), limits)? == reply("GET {fits}? ", "close")
  let over = "/" + repeat("a", 47)
  assert status_line(served_with("GET {over} HTTP/1.0\r\n\r\n".to_bytes(), limits)?) == "HTTP/1.1 431 Request Header Fields Too Large"
}

test "a body of exactly the default 1 MiB is served" {
  let body = repeat("a", 1048576)
  let input = "POST / HTTP/1.0\r\nContent-Length: 1048576\r\n\r\n{body}"
  assert served(input.to_bytes())? == reply("POST /? {body}", "close")
}

test "a body split across three deliveries" {
  let parts = [b"POST /b HTTP/1.0\r\nContent-Length: 5\r\n\r\nab", b"cd", b"e"]
  assert served_parts(parts, HttpLimits { body = 5 bytes }, false)? == reply("POST /b? abcde", "close")
}

test "a head split across deliveries at its blank line" verifies [RFC9110.R5_3_4] {
  let parts = [b"GET /h HTTP/1.0\r\n\r", b"\n"]
  assert served_parts(parts, HttpLimits {}, false)? == reply("GET /h? ", "close")
}

test "a Content-Length longer than the body, then close, gets no answer" verifies [RFC9112.R6_3_8] {
  assert served_parts([b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nabc"], HttpLimits {}, true)? == ""
}

test "a Content-Length shorter than the body leaves the rest as the next head" verifies [RFC9112.R9_3_5] {
  let input = b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n\r\nabGET /n HTTP/1.0\r\n\r\n"
  assert served(input)? == reply("POST /? ab", "keep-alive") + reply("GET /n? ", "close")
}

test "a response with the close option ends the connection" verifies [RFC9112.R9_6_6, RFC9112.R9_6_7] {
  assert response_closes(Response { status = 200, headers = [("CONNECTION", " Upgrade,\tClose ")] })
  assert !response_closes(Response { status = 200, headers = [("Connection", "keep-alive")] })
  assert !response_closes(Response { status = 200, headers = [("X", "close")] })
  let closing = "HTTP/1.1 200 OK\r\nconnection: Upgrade,\tClose \r\nContent-Length: 7\r\nConnection: close\r\n\r\nclosing"
  assert served(b"GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /close HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n")? == reply("GET /a? ", "keep-alive") + closing
}

test "a request after Connection: close is not answered" verifies [RFC9112.R9_6_3, RFC9112.R9_6_5] {
  let input = b"GET /a HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n"
  assert served(input)? == reply("GET /a? ", "close")
}

test "pipelined heads whose total crosses the head limit are each within it" {
  let limits = HttpLimits { head = 64 bytes }
  var input = padded("GET /a HTTP/1.1\r\nHost: h\r\n", 60)
  input.append(padded("GET /b HTTP/1.1\r\nHost: h\r\n", 60))
  input.append(padded("GET /c HTTP/1.0\r\n", 60))
  assert served_with(input, limits)? == reply("GET /a? ", "keep-alive") + reply("GET /b? ", "keep-alive") + reply("GET /c? ", "close")
}

test "a pipelined request over the head limit after two within it" {
  let limits = HttpLimits { head = 64 bytes }
  var input = padded("GET /a HTTP/1.1\r\nHost: h\r\n", 60)
  input.append(padded("GET /b HTTP/1.1\r\nHost: h\r\n", 64))
  input.append(padded("GET /c HTTP/1.0\r\n", 65))
  let out = served_with(input, limits)?
  assert out.starts_with(reply("GET /a? ", "keep-alive") + reply("GET /b? ", "keep-alive") + "HTTP/1.1 431 ")
}

test "pipelined bodies whose total crosses the body limit are each within it" {
  let limits = HttpLimits { body = 4 bytes }
  let input = b"POST /a HTTP/1.1\r\nHost: h\r\nContent-Length: 4\r\n\r\nabcdPOST /b HTTP/1.0\r\nContent-Length: 4\r\n\r\nefgh"
  assert served_with(input, limits)? == reply("POST /a? abcd", "keep-alive") + reply("POST /b? efgh", "close")
}

test "an empty write delivers nothing and the closed connection gets no answer" {
  let (a, b) = Pipe.pair()
  a.write_all(Bytes.empty())?
  _ = a.close()
  b.set_idle_timeout(5000)?
  assert b.read(10)? == Eof
  assert b.received_batches() == 0
  assert served_parts([Bytes.empty()], HttpLimits {}, true)? == ""
}

// As the Telnet case: the client has no idle timeout and never closes,
// and the server end has none of its own before `Http.serve` sets one,
// so only `limits.idle_timeout` can end the connection.
test "the HTTP idle timeout alone ends a pipe connection" {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(0)?
  client.write_all(b"GET /i HTTP/1.1\r\nHost: h\r\n\r\n")?
  spawn Http.serve(server, HttpLimits { idle_timeout = 20 ms }, HttpApp { state = (), handle = answer })
  assert read_to_end(client)? == reply("GET /i? ", "keep-alive")
}

// The head of `reply(body, connection)`, without its body.
test fn reply_head(body: Text, connection: Text) -> Text = reply(body, connection).split("\r\n\r\n").at(0) + "\r\n\r\n"

test "a request-target longer than the head limit is 414" verifies [RFC9112.R3_3] {
  let limits = HttpLimits { head = 64 bytes }
  let long = "/" + repeat("a", 80)
  assert next_with("GET {long} HTTP/1.0\r\n\r\n".to_bytes(), limits)? == Reject(414)
  assert next_with("GET {long}".to_bytes(), limits)? == Reject(414)
  assert status_line(served_with("GET {long} HTTP/1.1\r\nHost: h\r\n\r\n".to_bytes(), limits)?) == "HTTP/1.1 414 URI Too Long"
  let huge = "/" + repeat("b", 9000)
  assert status_line(served("GET {huge} HTTP/1.1\r\nHost: h\r\n\r\n".to_bytes())?) == "HTTP/1.1 414 URI Too Long"
  assert next_with(padded("GET / HTTP/1.0\r\n", 65), limits)? == Reject(431)
  assert next_with(repeat("x", 80).to_bytes(), limits)? == Reject(431)
  assert next_with("G@T {long}".to_bytes(), limits)? == Reject(431)
}

test "an HTTP/1.1 request has exactly one valid Host or is 400" verifies [RFC9112.R3_2_6] {
  assert next_of(b"GET / HTTP/1.1\r\n\r\n")? == Reject(400)
  assert next_of(b"GET / HTTP/1.1\r\nHost: a\r\nHost: a\r\n\r\n")? == Reject(400)
  assert next_of(b"GET / HTTP/1.0\r\nHost: a\r\nhost: b\r\n\r\n")? == Reject(400)
  for value in ["a b", "x@y", "a/b", "a:b:c", "a:8x", ":80", "[::1", "[]", "[::1]x", "a?"] {
    assert next_of("GET / HTTP/1.1\r\nHost: {value}\r\n\r\n".to_bytes())? == Reject(400)
  }
  for value in ["", "example.com", "example.com:8080", "h:", "127.0.0.1:80", "[::1]:8080", "[v1.x]", "a%20b"] {
    assert next_of("GET / HTTP/1.1\r\nHost: {value}\r\n\r\n".to_bytes())? == Got(get("HTTP/1.1", [("host", value)]), Bytes.empty())
  }
  assert next_of(b"GET / HTTP/1.0\r\n\r\n")? == Got(get("HTTP/1.0", []), Bytes.empty())
  assert served(b"GET /n HTTP/1.1\r\n\r\n")? == render(status_response(400), false).to_text()
}

test "an absolute-form target is accepted and its authority replaces Host" verifies [RFC9112.R3_2_2_5, RFC9112.R3_2_2_6] {
  var expected = get("HTTP/1.1", [("x", "1"), ("host", "example.com:8080")])
  expected.path = "/p/q"
  expected.query = "a=1"
  assert next_of(b"GET http://example.com:8080/p/q?a=1 HTTP/1.1\r\nHost: other\r\nX: 1\r\n\r\n")? == Got(expected, Bytes.empty())
  assert next_of(b"GET HTTPS://e HTTP/1.1\r\nHost: e\r\n\r\n")? == Got(get("HTTP/1.1", [("host", "e")]), Bytes.empty())
  var query = get("HTTP/1.0", [("host", "e")])
  query.query = "q"
  assert next_of(b"GET http://e?q HTTP/1.0\r\n\r\n")? == Got(query, Bytes.empty())
  assert next_of(b"GET http:///p HTTP/1.1\r\nHost: e\r\n\r\n")? == Reject(400)
  assert next_of(b"GET http://a b/ HTTP/1.1\r\nHost: e\r\n\r\n")? == Reject(400)
  assert next_of(b"GET http://u@e/ HTTP/1.1\r\nHost: e\r\n\r\n")? == Reject(400)
  assert next_of(b"GET http://e/ HTTP/1.1\r\n\r\n")? == Reject(400)
  assert next_of(b"GET ftp://e/ HTTP/1.1\r\nHost: e\r\n\r\n")? == Reject(400)
  assert served(b"GET http://e/x?y HTTP/1.0\r\n\r\n")? == reply("GET /x?y ", "close")
}

test "HEAD is answered as GET without content" verifies [RFC9110.R9_1_1, RFC9110.R9_3_2_1] {
  assert asked(Request { method = "HEAD", path = "/", query = "", version = "HTTP/1.1", headers = [], body = "" }).method == "GET"
  assert asked(get("HTTP/1.1", [])).method == "GET"
  let input = b"HEAD /h?q HTTP/1.1\r\nHost: h\r\n\r\nGET /g HTTP/1.1\r\nHost: h\r\n\r\nHEAD /e HTTP/1.0\r\n\r\n"
  let expected = reply_head("GET /h?q ", "keep-alive") + reply("GET /g? ", "keep-alive") + reply_head("GET /e? ", "close")
  assert served(input)? == expected
  assert expected.contains("Content-Length: 9\r\n")
  assert served(b"HEAD / HTTP/1.1\r\n\r\n")? == render_message(status_response(400), false, false).to_text()
  assert served(b"HEAD / HTTP/1.1\r\nHost: h\r\nContent-Length: 1048577\r\n\r\n")? == render_message(status_response(413), false, false).to_text()
  assert next_of(b"HEAD / HTTP/1.1\r\n\r\n")? == RejectHead(400)
  assert render_message(status_response(204), true, false) == render(status_response(204), true)
}

// A chunked POST of `/c` in HTTP/1.1 whose body after the head is `chunks`.
test fn chunked(chunks: Text) -> Bytes = "POST /c HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n{chunks}".to_bytes()

// The request `chunked` sends, with `body`.
test fn chunked_request(body: Text) -> Request =
  Request { method = "POST", path = "/c", query = "", version = "HTTP/1.1", headers = [("host", "h"), ("transfer-encoding", "chunked")], body }

test "a chunked request body is decoded" verifies [RFC9112.R6_1_1, RFC9112.R7_1_2] {
  assert next_of(chunked("5\r\nhello\r\n6\r\n world\r\n0\r\n\r\nGET /"))? == Got(chunked_request("hello world"), b"GET /")
  assert next_of(chunked("A\r\n0123456789\r\na\r\nabcdefghij\r\n0000\r\n\r\n"))? == Got(chunked_request("0123456789abcdefghij"), Bytes.empty())
  assert next_of(chunked("0\r\n\r\n"))? == Got(chunked_request(""), Bytes.empty())
  var mixed = chunked_request("hi")
  mixed.headers = [("host", "h"), ("transfer-encoding", "Chunked")]
  assert next_of(b"POST /c HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: Chunked\r\n\r\n2\r\nhi\r\n0\r\n\r\n")? == Got(mixed, Bytes.empty())
  for value in ["chunked,", ", chunked", " , chunked , "] {
    var listed = chunked_request("hi")
    listed.headers = [("host", "h"), ("transfer-encoding", trim_ows(value))]
    assert next_of("POST /c HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: {value}\r\n\r\n2\r\nhi\r\n0\r\n\r\n".to_bytes())? == Got(listed, Bytes.empty())
  }
  var input = chunked("3\r\nabc\r\n0\r\n\r\n")
  input.append(b"GET /n HTTP/1.0\r\n\r\n")
  let answered = served(input)?
  assert answered == reply("POST /c? abc", "keep-alive") + reply("GET /n? ", "close")
  assert answered.starts_with("HTTP/1.1 200 OK\r\n")
  assert served_over_tcp(input)? == answered
  let parts = [b"POST /c HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n4\r", b"\nab", b"cd\r\n0\r", b"\n\r\n"]
  assert served_parts(parts, HttpLimits {}, false)? == reply("POST /c? abcd", "close")
  let body = repeat("a", 1048576)
  var whole = chunked("100000\r\n{body}\r\n0\r\n\r\n")
  whole.append(b"GET /n HTTP/1.0\r\n\r\n")
  assert served(whole)? == reply("POST /c? {body}", "keep-alive") + reply("GET /n? ", "close")
}

test "a chunked body over the body limit is 413 however many digits its size has" verifies [RFC9112.R7_1_3] {
  assert chunk_size(b"ffffffffffffffffffffffffffffffff", 1048576) == SizeTooLarge
  assert chunk_size(b"10000000000000000", 9223372036854775807) == SizeTooLarge
  assert chunk_size(b"7fffffffffffffff", 9223372036854775807) == Size(9223372036854775807)
  assert chunk_size(b"8000000000000000", 9223372036854775807) == SizeTooLarge
  assert chunk_size(b"100000", 1048576) == Size(1048576)
  assert chunk_size(b"100001", 1048576) == SizeTooLarge
  assert chunk_size(b"0", 0) == Size(0)
  assert chunk_size(b"1", 0) == SizeTooLarge
  assert chunk_size(b"1f;x", 100) == Size(31)
  assert next_of(chunked("ffffffffffffffffffffffffffffffff\r\n"))? == Reject(413)
  assert next_of(chunked("00000000000000000000000000000000000001\r\na\r\n0\r\n\r\n"))? == Got(chunked_request("a"), Bytes.empty())
  assert next_of(chunked("100001\r\n"))? == Reject(413)
  assert next_with(chunked("3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n"), HttpLimits { body = 4 bytes })? == Reject(413)
  assert next_with(chunked("4\r\nabcd\r\n0\r\n\r\n"), HttpLimits { body = 4 bytes })? == Got(chunked_request("abcd"), Bytes.empty())
  assert served_with(chunked("3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n"), HttpLimits { body = 4 bytes })? == render(status_response(413), false).to_text()
}

test "chunk extensions are ignored" verifies [RFC9112.R7_1_1_1] {
  assert next_of(chunked("5;name=value\r\nhello\r\n0;last\r\n\r\n"))? == Got(chunked_request("hello"), Bytes.empty())
  assert next_of(chunked("5 ; a=\"b;c\" ;d\r\nhello\r\n0\r\n\r\n"))? == Got(chunked_request("hello"), Bytes.empty())
  for line in ["", "x", "5x", "5 ", "-5", "+5", " 5", "5;a\x01", "0x5"] {
    assert next_of(chunked("{line}\r\nhello\r\n0\r\n\r\n"))? == Reject(400)
  }
  assert next_of(chunked("5\r\nhelloX\r\n0\r\n\r\n"))? == Reject(400)
  assert next_of(chunked("5\nhello\r\n0\r\n\r\n"))? == Reject(400)
  assert next_of(chunked("5\r\nhel"))? == Close
  assert next_of(chunked("5\r\nhello\r\n"))? == Close
  let limits = HttpLimits { head = 64 bytes }
  assert next_with(chunked("1;" + repeat("x", 80) + "\r\na\r\n0\r\n\r\n"), limits)? == Reject(431)
}

test "trailer fields are checked and discarded and never merged into the header section" verifies [RFC9112.R7_1_2_2, RFC9112.R7_1_2_3, RFC9110.R6_5_1_2] {
  assert next_of(chunked("2\r\nhi\r\n0\r\nX-Trailer: 1\r\nContent-Length: 9\r\n\r\nGET /"))? == Got(chunked_request("hi"), b"GET /")
  assert next_of(chunked("0\r\nbad line\r\n\r\n"))? == Reject(400)
  assert next_of(chunked("0\r\n X: 1\r\n\r\n"))? == Reject(400)
  assert next_of(chunked("0\r\nX: a\x01\r\n\r\n"))? == Reject(400)
  assert next_of(chunked("0\r\nX: 1\r\n"))? == Close
  let limits = HttpLimits { head = 64 bytes }
  assert next_with(chunked("0\r\nX: " + repeat("x", 80) + "\r\n\r\n"), limits)? == Reject(431)
  assert next_with(chunked("0\r\nA: " + repeat("x", 30) + "\r\nB: " + repeat("x", 30) + "\r\n\r\n"), limits)? == Reject(431)
}

test "a Transfer-Encoding Http cannot frame is 400 and an unknown coding 501" verifies [RFC9112.R5_1_1, RFC9112.R6_1_13, RFC9112.R6_1_14, RFC9112.R6_3_3] {
  for value in ["gzip", "chunked, gzip", "chunked, chunked", "", " , ", "chunked;a=b", "identity"] {
    assert next_of("POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: {value}\r\n\r\n".to_bytes())? == Reject(400)
  }
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip, chunked\r\n\r\n")? == Reject(501)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n")? == Reject(501)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\ntransfer-encoding: chunked\r\n\r\nabc")? == Reject(400)
  assert next_of(b"POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")? == Reject(400)
  assert next_of(b"HEAD / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip\r\n\r\n")? == RejectHead(400)
  assert next_of(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding : chunked\r\n\r\n")? == Reject(400)
  let bad_request = render(status_response(400), false).to_text()
  assert served(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\nabcGET /n HTTP/1.1\r\nHost: h\r\n\r\n")? == bad_request
  assert served(b"POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\nabcGET /n HTTP/1.0\r\n\r\n")? == bad_request
  assert served(b"POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET /n HTTP/1.0\r\n\r\n")? == bad_request
  assert served(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\n\r\n")? == bad_request
  assert served(b"POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip, chunked\r\n\r\n0\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\n\r\n")? == render(status_response(501), false).to_text()
}

test "every status of RFC 9110 has its reason phrase" {
  let phrases = [
    (100, "Continue"), (101, "Switching Protocols"),
    (200, "OK"), (201, "Created"), (202, "Accepted"), (203, "Non-Authoritative Information"), (204, "No Content"),
    (205, "Reset Content"), (206, "Partial Content"),
    (300, "Multiple Choices"), (301, "Moved Permanently"), (302, "Found"), (303, "See Other"), (304, "Not Modified"),
    (305, "Use Proxy"), (307, "Temporary Redirect"), (308, "Permanent Redirect"),
    (400, "Bad Request"), (401, "Unauthorized"), (402, "Payment Required"), (403, "Forbidden"), (404, "Not Found"),
    (405, "Method Not Allowed"), (406, "Not Acceptable"), (407, "Proxy Authentication Required"), (408, "Request Timeout"),
    (409, "Conflict"), (410, "Gone"), (411, "Length Required"), (412, "Precondition Failed"), (413, "Content Too Large"),
    (414, "URI Too Long"), (415, "Unsupported Media Type"), (416, "Range Not Satisfiable"), (417, "Expectation Failed"),
    (421, "Misdirected Request"), (422, "Unprocessable Content"), (426, "Upgrade Required"),
    (500, "Internal Server Error"), (501, "Not Implemented"), (502, "Bad Gateway"), (503, "Service Unavailable"),
    (504, "Gateway Timeout"), (505, "HTTP Version Not Supported")
  ]
  for (status, phrase) in phrases {
    assert reason(status) == phrase, "the reason phrase of {status}"
  }
  assert reason(431) == "Request Header Fields Too Large"
  assert reason(306) == "Unknown"
  assert reason(418) == "Unknown"
  assert status_line(served(b"GET /forbidden HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?) == "HTTP/1.1 403 Forbidden"
}

// The bytes 0 to 255 in order.
test fn every_byte() -> Bytes {
  var out = Bytes.empty()
  var value = 0
  while value < 256 {
    match value.to_byte() {
      Some(b) => out.push(b)
      None => {}
    }
    value = value + 1
  }
  out
}

// Everything `client` reads until the end of the stream, as bytes.
test fn read_bytes_to_end<T: ByteStream>(client: T) -> IoResult<Bytes> requires [client.read] {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
}

test "a binary body is sent as its bytes" {
  assert every_byte().len() == 256
  let (client, server) = connected()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = (), handle = answer })
  client.write_all(b"GET /bytes HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  let out = read_bytes_to_end(client)?
  var expected = b"HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: 256\r\nConnection: close\r\n\r\n"
  expected.append(every_byte())
  assert out == expected
  let head = render_message(Response.bytes(200, "application/octet-stream", every_byte()), true, false).to_text()
  assert head == "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: 256\r\nConnection: keep-alive\r\n\r\n"
  assert render(Response { status = 204, content = Binary(b"x") }, true).to_text() == "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\n"
}

// Answers `/stream` with a body streamed from the pipe `state`, `/empty`
// likewise with 204, `/continue` with 100, and every other path as
// `answer`.
test fn stream_answer(state: PipeStream, request: Request) -> Response = if request.path == "/stream" {
  Response.streamed(200, [("Content-Type", "text/plain")])
} else if request.path == "/empty" {
  Response.streamed(204, [])
} else if request.path == "/continue" {
  Response.streamed(100, [])
} else {
  answer((), request)
}

// The next piece of a streamed body: what the test wrote to `state`, `None`
// once the test closed it.
test fn stream_piece(state: PipeStream, request: Request) -> IoResult<Option<Bytes>> requires [state.read] = match state.read(READ_SIZE)? {
  Eof => Ok(None)
  Data(bytes) => Ok(Some(bytes))
}

// Reads from `client` until it holds at least `length` bytes.
test fn read_at_least<T: ByteStream>(client: T, length: Int) -> IoResult<Text> requires [client.read] {
  var out = Bytes.empty()
  while out.len() < length {
    match client.read(4096)? {
      Eof => return Ok(out.to_text())
      Data(bytes) => out.append(bytes)
    }
  }
  Ok(out.to_text())
}

// Everything `Http.serve` sends for `input` when the streamed body's pieces
// are `pieces`, written before the request and the pipe then closed.
test fn streamed_with(input: Bytes, pieces: Bytes) -> IoResult<Text> {
  let (client, server) = connected()?
  let (control, source) = connected()?
  control.write_all(pieces)?
  _ = control.close()
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = source, handle = stream_answer, piece = stream_piece })
  client.write_all(input)?
  read_to_end(client)
}

test "a streamed response is sent in chunks as its pieces come" {
  let (client, server) = connected()?
  let (control, source) = connected()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = source, handle = stream_answer, piece = stream_piece })
  control.write_all(b"first")?
  client.write_all(b"GET /stream HTTP/1.1\r\nHost: h\r\n\r\nGET /after HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  let head = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n"
  let first = head + "5\r\nfirst\r\n"
  assert read_at_least(client, first.len())? == first
  control.write_all(b"second piece")?
  _ = control.close()
  assert read_to_end(client)? == "c\r\nsecond piece\r\n0\r\n\r\n" + reply("GET /after? ", "close")
}

test "Http chunks only an HTTP/1.1 response with content" verifies [RFC9112.R6_1_7, RFC9112.R6_1_8, RFC9112.R6_1_11] {
  let close_delimited = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\nabc"
  assert streamed_with(b"GET /stream HTTP/1.0\r\n\r\n", b"abc")? == close_delimited
  assert streamed_with(b"GET /stream HTTP/1.0\r\nConnection: keep-alive\r\n\r\nGET /n HTTP/1.0\r\n\r\n", b"abc")? == close_delimited
  assert streamed_with(b"CONNECT /stream HTTP/1.1\r\nHost: h\r\n\r\n", b"abc")? == close_delimited
  let after = reply("GET /n? ", "close")
  let no_content = "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\n"
  assert streamed_with(b"GET /empty HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"abc")? == no_content + after
  let informational = "HTTP/1.1 100 Continue\r\nConnection: keep-alive\r\n\r\n"
  assert streamed_with(b"GET /continue HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"abc")? == informational + after
  let head = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n"
  assert streamed_with(b"HEAD /stream HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"abc")? == head + after
  assert streamed_with(b"HEAD /stream HTTP/1.0\r\n\r\n", b"abc")? == "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n"
  assert streamed_with(b"GET /stream HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"abc")? == "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert streamed_with(b"GET /stream HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", Bytes.empty())? == "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n0\r\n\r\n"
}

// Answers `/streamed` with a streamed 200, `/redirect` a streamed 302,
// `/not-modified` a streamed 304, `/inline-304` `status_response(304)`,
// and every other path as `answer`.
test fn edge_answer(state: PipeStream, request: Request) -> Response = if request.path == "/streamed" {
  Response.streamed(200, [])
} else if request.path == "/redirect" {
  Response.streamed(302, [])
} else if request.path == "/not-modified" {
  Response.streamed(304, [])
} else if request.path == "/inline-304" {
  status_response(304)
} else {
  answer((), request)
}

// One byte of `state` per piece: `.` an empty piece, `!` an error, any
// other byte itself; `None` once the test closed it.
test fn byte_piece(state: PipeStream, request: Request) -> IoResult<Option<Bytes>> requires [state.read] = match state.read(1)? {
  Eof => Ok(None)
  Data(bytes) => if bytes == b"." {
    Ok(Some(Bytes.empty()))
  } else if bytes == b"!" {
    Err(IoError.new("piece failed"))
  } else {
    Ok(Some(bytes))
  }
}

// Everything `Http.serve` sends for `input` under `edge_answer` when the
// pieces are the bytes of `pieces`, one per call of `byte_piece`.
test fn edge_served(input: Bytes, pieces: Bytes) -> IoResult<Text> {
  let (client, server) = connected()?
  let (control, source) = connected()?
  control.write_all(pieces)?
  _ = control.close()
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = source, handle = edge_answer, piece = byte_piece })
  client.write_all(input)?
  read_to_end(client)
}

test "an empty piece is skipped and does not end a chunked body" {
  let head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
  assert edge_served(b"GET /streamed HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"a.b")? == head + "1\r\na\r\n1\r\nb\r\n0\r\n\r\n"
  assert edge_served(b"GET /streamed HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"..")? == head + "0\r\n\r\n"
}

test "a streamed 304 is the head only and the connection goes on" {
  let after = reply("GET /n? ", "close")
  assert edge_served(b"GET /not-modified HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"abc")? == "HTTP/1.1 304 Not Modified\r\nConnection: keep-alive\r\n\r\n" + after
}

test "a streamed 3xx answer to CONNECT is chunked" {
  assert edge_served(b"CONNECT /redirect HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"ab")? == "HTTP/1.1 302 Found\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n1\r\na\r\n1\r\nb\r\n0\r\n\r\n"
}

test "a chunk size over 15 has its hexadecimal digits most significant first" {
  assert hex(0) == "0"
  assert hex(16) == "10"
  assert hex(256) == "100"
  assert hex(4095) == "fff"
  assert hex(4096) == "1000"
  var expected = b"100\r\n"
  expected.append(every_byte())
  expected.append(b"\r\n")
  assert chunk(every_byte()) == expected
}

test "an error of piece ends a chunked body before its last chunk and the connection with it" {
  let head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n"
  assert edge_served(b"GET /streamed HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", b"a!b")? == head + "1\r\na\r\n"
}

test "a 304 answered inline sends no content, so a pipelined response is not misread" {
  let out = edge_served(b"GET /inline-304 HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", Bytes.empty())?
  let after_head = out.split("\r\n\r\n").at(1)
  assert after_head.split("\r\n").at(0) == "HTTP/1.1 200 OK", "the bytes after the 304 head: {after_head}"
  assert render(Response.bytes(304, "application/octet-stream", b"x"), true).to_text().ends_with("\r\n\r\n")
}

test "a 1xx response answered inline has no Content-Length" {
  assert !render(Response { status = 100 }, true).to_text().contains("Content-Length")
  assert !render(Response.bytes(103, "application/octet-stream", b"x"), true).to_text().contains("Content-Length")
}

test "a 2xx answer to CONNECT answered inline has no Content-Length" {
  let out = served(b"CONNECT /x HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert status_line(out) == "HTTP/1.1 200 OK"
  assert !out.contains("Content-Length"), out
}

test "a 2xx answer to CONNECT answered inline ends by closing the connection" {
  let out = served(b"CONNECT /x HTTP/1.1\r\nHost: h\r\n\r\nGET /n HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert out == "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nCONNECT /x? ", out
  assert served(b"CONNECT /forbidden HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?.contains("Content-Length: 10\r\n")
}

test "a chunk whose data ends in CR and another byte instead of CR LF is 400" {
  assert next_of(chunked("5\r\nhello\rX0\r\n\r\n"))? == Reject(400)
  assert next_of(chunked("2\r\nhi\r\r\n0\r\n\r\n"))? == Reject(400)
}

test "an unterminated chunk-size line or trailer over the head limit is 431, not read until the peer closes" {
  let limits = HttpLimits { head = 64 bytes }
  assert next_with(chunked("1;" + repeat("x", 80)), limits)? == Reject(431)
  assert next_with(chunked("1\r\na\r\n1;" + repeat("x", 80)), limits)? == Reject(431)
  assert next_with(chunked("0\r\nX: " + repeat("x", 80)), limits)? == Reject(431)
}

test "one chunk of the whole body limit is decoded holding at most one read besides the body" {
  let limits = HttpLimits {}
  let size = limits.body.to_int()
  let (client, server) = connected()?
  var sent = repeat("a", size).to_bytes()
  sent.append(b"\r\n0\r\n\r\n")
  client.write_all(sent)?
  _ = client.close()
  match read_chunk_data(server, limits, b"100000\r\n", 8, size, Bytes.empty())? {
    DataRead(body, input, at) => {
      assert body.len() == size
      assert input.len() <= READ_SIZE, "the decoder holds {input.len()} bytes of input besides the body"
      assert input.slice(at, input.len()) == b"0\r\n\r\n"
    }
    _ => {
      assert false, "one chunk of the body limit is read"
    }
  }
  assert next_of(chunked("100000\r\n" + repeat("a", size) + "\r\n0\r\n\r\n"))? == Got(chunked_request(repeat("a", size)), Bytes.empty())
}

// Adversary (story http-chunked-adversary-findings, pass 1). `read_chunked`
// compacts only once `at >= READ_SIZE`, so it can hand `read_chunk_data` an
// input holding READ_SIZE - 1 consumed bytes; a chunk-size line and a chunk
// that one read delivered whole but for its LF; the CRLF check then appends
// one more read. 19.22: "input of less than three reads and the chunk-size line".
test "adversary: a chunk read whole but for its LF keeps less than three reads of input and the line" {
  let limits = HttpLimits {}
  let (client, server) = connected()?
  let line = "FFF0\r\n"
  let data = (repeat("p", READ_SIZE - 1) + line + repeat("a", 65520) + "\r").to_bytes()
  client.write_all(("\n0\r\n\r\n" + repeat("x", READ_SIZE - 6)).to_bytes())?
  _ = client.close()
  match read_chunk_data(server, limits, data, READ_SIZE - 1 + line.len(), 65520, Bytes.empty())? {
    DataRead(body, input, _) => {
      assert body.len() == 65520
      assert input.len() < 3 * READ_SIZE + line.len(), "the decoder holds {input.len()} bytes of input besides the body"
    }
    _ => {
      assert false, "the chunk is read"
    }
  }
}

// Adversary (story http-chunked-adversary-findings, pass 1). The body limit
// in one-byte chunks, the worst case 19.22 names. `read_chunk_data` takes
// `data` by reference and copies it into `input` for every chunk, so each
// one-byte chunk costs a copy of up to two reads. At b23f827e this took
// 0.66 s (Rust) and 1.15 s (LLVM); at 54cbcadc 3.1 s and 20.9 s.
test "adversary: the body limit in one-byte chunks is decoded in under 8 s" {
  let size = HttpLimits {}.body.to_int()
  let input = chunked(repeat("1\r\na\r\n", size) + "0\r\n\r\n")
  let started = Clock.monotonic()
  let got = next_of(input)?
  let took = Clock.monotonic() - started
  assert got == Got(chunked_request(repeat("a", size)), Bytes.empty())
  assert took < 8000 ms, "{size} one-byte chunks took {took.to_ms()} ms"
}
