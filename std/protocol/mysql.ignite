package std.protocol.mysql

import std.net.{ByteStream, Pipe, PipeStream, TcpStream, Endpoint}
import std.io.IoError
import std.digest.{sha1, sha256}
import std.encoding.{hex}
import std.result.{map_err}
import std.text.{contains}
import std.tls.{TlsOptions}
import std.protocol.mysql.binary.{double_text, float_text, unsigned_text, date_text, time_text}

// A client of the MySQL wire protocol (protocol 41, handshake version 10)
// over any `ByteStream`: a `TcpStream` or a `TlsStream` in programs, a
// `PipeStream` in tests.

type Outcome<T> = Result<T, MysqlError>

// ---- limits and errors ------------------------------------------------------

// What one reply may hold. `packet`: the payload of one packet, its 16 MiB
// frames joined. `row`: the packet of one row. `rows`: the rows of one
// result set. `columns`: its columns.
type MysqlLimits {
  packet: ByteSize = 64 MiB
  row: ByteSize = 16 MiB
  rows: Int = 1000000
  columns: Int = 4096
}

// The server's error packet: its code, the five characters of its SQL
// state (empty when the server sent none) and its message. The message is
// the server's text and may quote the statement or name the account, so
// `describe` leaves it out.
type ServerError {
  code: Int
  sql_state: Text
  message: Text
}

// Why a call failed.
//
// - `Server`: the server answered with an error packet; the connection
//   stays usable.
// - `Io`: the stream failed, with the substrate's message.
// - `Closed`: the stream ended, or its idle timeout passed, before or
//   inside a packet.
// - `OutOfOrder(expected, got)`: a packet with another sequence number than
//   the next one.
// - `PacketTooLarge`, `RowTooLarge`, `TooManyRows`, `TooManyColumns`: one
//   past a limit of `MysqlLimits`.
// - `Malformed`: bytes that are no packet of the protocol, with the reason.
// - `Unsupported`: a part of the protocol this client does not speak.
// - `UnsupportedPlugin`: the server asked for an authentication plugin
//   other than `mysql_native_password` and `caching_sha2_password`, named.
// - `FullAuthenticationNeedsTls`: `caching_sha2_password` asked for the
//   password itself on a stream that is not TLS.
// - `TlsNotOffered`: the server's handshake offers no TLS.
// - `WrongParameterCount(expected, got)`: `execute` with another number of
//   parameters than the statement has.
// - `NoConnection`: a pool had no connection within its wait.
enum MysqlError {
  Server(ServerError),
  Io(Text),
  Closed,
  OutOfOrder(Int, Int),
  PacketTooLarge,
  RowTooLarge,
  TooManyRows,
  TooManyColumns,
  Malformed(Text),
  Unsupported(Text),
  UnsupportedPlugin(Text),
  FullAuthenticationNeedsTls,
  TlsNotOffered,
  WrongParameterCount(Int, Int),
  NoConnection
}

// ---- the session ------------------------------------------------------------

// The account, the session and the transport of one connection.
type MysqlOptions {
  user: Text
  password: Text = ""
  database: Text = ""
  read_only: Bool = false
  charset: Int = 45
  limits: MysqlLimits = MysqlLimits {}
  connect_timeout: Duration = 10 seconds
  read_timeout: Duration = 30 seconds
  server_name: Text = ""
  tls: TlsOptions = TlsOptions {}
}

// The server's first packet.
type Greeting {
  version: Text
  connection: Int
  capabilities: Int
  charset: Int
  status: Int
  scramble: Bytes
  plugin: Text
}

// An authenticated connection.
type Client<T> {
  stream: T
  limits: MysqlLimits = MysqlLimits {}
  version: Text = ""
  connection: Int = 0
  secure: Bool = false
}

// What a statement without a result set reports.
type Done {
  affected: Int
  last_insert_id: Int
  status: Int
  warnings: Int
}

// One value of a row or of a statement's parameter; SQL NULL is `None` in
// its place.
//
// - `Int`: TINYINT, SMALLINT, MEDIUMINT, INT, BIGINT, YEAR, signed or
//   unsigned, when it fits an `Int`.
// - `Decimal`: the exact decimal text of a DECIMAL, of a FLOAT or a DOUBLE
//   (the language has no floating-point type) and of a BIGINT UNSIGNED
//   above the largest `Int`.
// - `Bool`: TINYINT(1) and BIT(1).
// - `Text`: character columns (CHAR, VARCHAR, TEXT, ENUM, SET), JSON, and
//   DATE, TIME, DATETIME and TIMESTAMP as the server prints them
//   (`2024-02-29 23:59:58.123456`). Bytes that are no UTF-8 become U+FFFD.
// - `Bytes`: binary columns (BINARY, VARBINARY, BLOB, GEOMETRY) and a BIT
//   wider than one.
enum MysqlValue {
  Int(Int),
  Decimal(Text),
  Bool(Bool),
  Text(Text),
  Bytes(Bytes)
}

// One column of a result set: where it comes from, its name, its
// character set (63 is binary), its display length, its type (the
// protocol's number), its flags (32 is UNSIGNED) and its decimals.
type Column {
  schema: Text
  table: Text
  name: Text
  charset: Int
  length: Int
  kind: Int
  flags: Int
  decimals: Int
}

// What a statement gives: the columns and rows of its result set, each row
// one value per column, or for a statement without one the rows it
// affected and the id it inserted.
type ResultSet {
  columns: List<Column> = []
  rows: List<List<Option<MysqlValue>>> = []
  affected: Int = 0
  last_insert_id: Int = 0
  warnings: Int = 0
}

// A prepared statement of one connection: the server's id for it and how
// many parameters and columns it has.
type Statement {
  id: Int
  parameters: Int
  columns: Int
}

const MAX_FRAME: Int = 16777215
const READ_SIZE: Int = 65536

const CLIENT_LONG_PASSWORD: Int = 1
const CLIENT_LONG_FLAG: Int = 4
const CLIENT_CONNECT_WITH_DB: Int = 8
const CLIENT_PROTOCOL_41: Int = 512
const CLIENT_SSL: Int = 2048
const CLIENT_TRANSACTIONS: Int = 8192
const CLIENT_SECURE_CONNECTION: Int = 32768
const CLIENT_PLUGIN_AUTH: Int = 524288
const CLIENT_PLUGIN_AUTH_LENENC: Int = 2097152

const NATIVE: Text = "mysql_native_password"
const CACHING_SHA2: Text = "caching_sha2_password"
const READ_ONLY: Text = "SET SESSION TRANSACTION READ ONLY"

const SHORT: Text = "a packet shorter than its fields"
const TRAILING: Text = "bytes after the reply"

// What `error` is, in words that hold neither a statement nor a
// credential: of the server's error the code and the SQL state only.
fn describe(error: MysqlError) -> Text = match error {
  Server(failed) => if failed.sql_state == "" { "server error {failed.code}" } else { "server error {failed.code} ({failed.sql_state})" }
  Io(message) => message
  Closed => "the connection ended or its read timed out"
  OutOfOrder(expected, got) => "packet {got} where packet {expected} was expected"
  PacketTooLarge => "a packet larger than the limit"
  RowTooLarge => "a row larger than the limit"
  TooManyRows => "a result set with more rows than the limit"
  TooManyColumns => "a result set with more columns than the limit"
  Malformed(what) => what
  Unsupported(what) => "{what} is not supported"
  UnsupportedPlugin(plugin) => "authentication plugin {plugin} is not supported"
  FullAuthenticationNeedsTls => "the server asks for the password itself (caching_sha2_password full authentication), which is sent over TLS only"
  TlsNotOffered => "the server offers no TLS"
  WrongParameterCount(expected, got) => "{got} parameters for a statement with {expected}"
  NoConnection => "no connection of the pool was free in time"
}

// `error` for a caller whose errors are `IoError`s: `mysql: ` and its
// description.
fn io_error(error: MysqlError) -> IoError = IoError.new("mysql: {describe(error)}")

fn io(error: IoError) -> MysqlError = Io(error.message)

// Whether the connection is in step after `error`: the server refused a
// command, or the client refused a call before it sent anything.
fn reusable(error: MysqlError) -> Bool = match error {
  Server(_) => true
  WrongParameterCount(_, _) => true
  _ => false
}

// ---- integers and strings ---------------------------------------------------

// `out` with the low `width` bytes of `value`, least significant first.
fn put_int(out: Bytes, value: Int, width: Int) -> Bytes {
  var buffer = out
  var i = 0
  while i < width {
    buffer.push((value >> i * 8 & 255).wrap_byte())
    i = i + 1
  }
  buffer
}

// The `width` bytes of `data` at `at` as an integer, least significant
// first; eight bytes are the two's complement of an `Int`.
fn int_at(data: Bytes, at: Int, width: Int) -> Int {
  var value = 0
  var i = 0
  while i < width {
    value = value | data[at + i].to_int() << i * 8
    i = i + 1
  }
  value
}

// `out` with `n` as a length-encoded integer.
fn put_lenenc(out: Bytes, n: Int) -> Bytes {
  var buffer = out
  if n < 251 {
    buffer.push(n.wrap_byte())
    return buffer
  }
  if n < 65536 {
    buffer.push(252)
    return put_int(buffer, n, 2)
  }
  if n < 16777216 {
    buffer.push(253)
    return put_int(buffer, n, 3)
  }
  buffer.push(254)
  put_int(buffer, n, 8)
}

// `out` with `bytes` behind their length.
fn put_lenenc_bytes(out: Bytes, bytes: Bytes) -> Bytes {
  var buffer = put_lenenc(out, bytes.len())
  buffer.append(bytes)
  buffer
}

// The integer of `width` bytes at `at` and the offset after it.
fn take_int(data: Bytes, at: Int, width: Int) -> Outcome<(Int, Int)> =
  if width > data.len() - at { Err(Malformed(SHORT)) } else { Ok((int_at(data, at, width), at + width)) }

// The `count` bytes at `at` and the offset after them.
fn take_bytes(data: Bytes, at: Int, count: Int) -> Outcome<(Bytes, Int)> =
  if count < 0 || count > data.len() - at { Err(Malformed(SHORT)) } else { Ok((data.slice(at, at + count), at + count)) }

// The length-encoded integer at `at`, `None` for the NULL mark 0xFB, and
// the offset after it.
fn take_lenenc(data: Bytes, at: Int) -> Outcome<(Option<Int>, Int)> {
  if at >= data.len() {
    return Err(Malformed(SHORT))
  }
  let first = data[at].to_int()
  if first < 251 {
    return Ok((Some(first), at + 1))
  }
  if first == 251 {
    return Ok((None, at + 1))
  }
  if first == 255 {
    return Err(Malformed("a length that starts with 0xFF"))
  }
  let width = if first == 252 { 2 } else if first == 253 { 3 } else { 8 }
  let (value, end) = take_int(data, at + 1, width)?
  if value < 0 {
    return Err(Malformed("a length above the largest integer"))
  }
  Ok((Some(value), end))
}

// A length-encoded integer that may not be NULL.
fn take_count(data: Bytes, at: Int) -> Outcome<(Int, Int)> = match take_lenenc(data, at)? {
  (Some(n), end) => Ok((n, end))
  (None, _) => Err(Malformed("a NULL where a number is expected"))
}

// The length-encoded bytes at `at`, `None` for NULL, and the offset after
// them.
fn take_lenenc_bytes(data: Bytes, at: Int) -> Outcome<(Option<Bytes>, Int)> = match take_lenenc(data, at)? {
  (Some(n), start) => {
    let (bytes, end) = take_bytes(data, start, n)?
    Ok((Some(bytes), end))
  }
  (None, end) => Ok((None, end))
}

// Length-encoded bytes that may not be NULL, as text.
fn take_text(data: Bytes, at: Int) -> Outcome<(Text, Int)> = match take_lenenc_bytes(data, at)? {
  (Some(bytes), end) => Ok((bytes.to_text(), end))
  (None, _) => Err(Malformed("a NULL where a name is expected"))
}

// The bytes from `at` up to a NUL, or to the end when there is none, and
// the offset after the NUL.
fn take_nul(data: Bytes, at: Int) -> Outcome<(Bytes, Int)> {
  if at > data.len() {
    return Err(Malformed(SHORT))
  }
  match data.index_of(b"\x00", at) {
    Some(end) => Ok((data.slice(at, end), end + 1))
    None => Ok((data.slice(at, data.len()), data.len()))
  }
}

// ---- packets ----------------------------------------------------------------

// `payload` as one packet whose first frame has the sequence number
// `sequence`: frames of at most 16 MiB - 1 bytes, each with its length and
// its sequence number modulo 256. A payload that fills its last frame is
// followed by an empty one.
fn frames(payload: Bytes, sequence: Int) -> Bytes {
  var out = Bytes.with_capacity(payload.len() + 4)
  var at = 0
  var number = sequence
  loop {
    let left = payload.len() - at
    let size = if left > MAX_FRAME { MAX_FRAME } else { left }
    out = put_int(out, size, 3)
    out.push((number & 255).wrap_byte())
    out.append(payload.slice(at, at + size))
    at = at + size
    number = number + 1
    if size < MAX_FRAME {
      break
    }
  }
  out
}

// `buffer` from `at` on with at least `need` bytes, read from `stream`,
// and the offset its first byte now has. Bytes before `at` are dropped
// when more are read.
fn fill<T: ByteStream>(stream: T, buffer: Bytes, at: Int, need: Int) -> Outcome<(Bytes, Int)> {
  var data = buffer
  var start = at
  while data.len() - start < need {
    match stream.read(READ_SIZE).map_err(io)? {
      Eof => return Err(Closed)
      Data(more) => {
        if start > 0 {
          data = data.slice(start, data.len())
          start = 0
        }
        data.append(more)
      }
    }
  }
  Ok((data, start))
}

// The next packet from `stream`, starting with the bytes of `buffer` from
// `at` on: its payload (the frames of a packet of 16 MiB - 1 bytes or more
// joined), the bytes read so far, the offset after the packet and the
// sequence number after its last frame. Its first frame must carry
// `sequence`; a payload above `maximum` is refused when its frame header
// is read, before its bytes are.
fn read_packet<T: ByteStream>(stream: T, maximum: Int, buffer: Bytes, at: Int, sequence: Int) -> Outcome<(Bytes, Bytes, Int, Int)> {
  var data = buffer
  var start = at
  var number = sequence
  var joined = Bytes.empty()
  loop {
    let (header, from) = fill(stream, data, start, 4)?
    let size = int_at(header, from, 3)
    let got = header[from + 3].to_int()
    if got != number & 255 {
      return Err(OutOfOrder(number & 255, got))
    }
    if size > maximum - joined.len() {
      return Err(PacketTooLarge)
    }
    let (whole, begin) = fill(stream, header, from, size + 4)?
    data = whole
    start = begin + size + 4
    number = number + 1
    if size < MAX_FRAME && joined.is_empty() {
      return Ok((data.slice(begin + 4, start), data, start, number))
    }
    joined.append(data.slice(begin + 4, start))
    if size < MAX_FRAME {
      return Ok((joined, data, start, number))
    }
  }
}

// The server's error packet `payload` as an error.
fn server_error(payload: Bytes) -> MysqlError {
  if payload.len() < 3 {
    return Malformed("an error packet shorter than its code")
  }
  let code = int_at(payload, 1, 2)
  if payload.len() >= 9 && payload[3] == b'#' {
    return Server(ServerError { code, sql_state = payload.slice(4, 9).to_text(), message = payload.slice(9, payload.len()).to_text() })
  }
  Server(ServerError { code, sql_state = "", message = payload.slice(3, payload.len()).to_text() })
}

// The OK packet `payload`.
fn parse_done(payload: Bytes) -> Outcome<Done> {
  let (affected, a) = take_count(payload, 1)?
  let (last_insert_id, b) = take_count(payload, a)?
  let (status, c) = take_int(payload, b, 2)?
  let (warnings, _) = take_int(payload, c, 2)?
  Ok(Done { affected, last_insert_id, status, warnings })
}

// ---- handshake and authentication -------------------------------------------

// The server's handshake packet `payload` (version 10): an error packet in
// its place is the server's error.
fn parse_greeting(payload: Bytes) -> Outcome<Greeting> {
  if payload.is_empty() {
    return Err(Malformed(SHORT))
  }
  let marker = payload[0].to_int()
  if marker == 255 {
    return Err(server_error(payload))
  }
  if marker != 10 {
    return Err(Unsupported("protocol version {marker}"))
  }
  let (version, a) = take_nul(payload, 1)?
  let (connection, b) = take_int(payload, a, 4)?
  let (first, c) = take_bytes(payload, b, 8)?
  let (lower, d) = take_int(payload, c + 1, 2)?
  if d >= payload.len() {
    return Err(Unsupported("a server without protocol 41"))
  }
  let (charset, e) = take_int(payload, d, 1)?
  let (status, f) = take_int(payload, e, 2)?
  let (upper, g) = take_int(payload, f, 2)?
  let (length, h) = take_int(payload, g, 1)?
  let capabilities = lower | upper << 16
  if capabilities & CLIENT_PROTOCOL_41 == 0 || capabilities & CLIENT_SECURE_CONNECTION == 0 || capabilities & CLIENT_PLUGIN_AUTH == 0 {
    return Err(Unsupported("a server without protocol 41 and authentication plugins"))
  }
  let rest = if length > 21 { length - 8 } else { 13 }
  let (second, i) = take_bytes(payload, h + 10, rest)?
  var scramble = first
  scramble.append(second)
  if scramble[scramble.len() - 1] == 0 {
    scramble = scramble.slice(0, scramble.len() - 1)
  }
  let (plugin, _) = take_nul(payload, i)?
  Ok(Greeting { version = version.to_text(), connection, capabilities, charset, status, scramble, plugin = plugin.to_text() })
}

// `a` with each byte exclusive-ored with the byte of `b` at its place.
fn xor(a: Bytes, b: Bytes) -> Bytes {
  var out = Bytes.with_capacity(a.len())
  var i = 0
  while i < a.len() {
    out.push((a[i].to_int() ^ b[i].to_int()).wrap_byte())
    i = i + 1
  }
  out
}

// The answer of `mysql_native_password`: SHA1(password) xor
// SHA1(scramble, SHA1(SHA1(password))); nothing for an empty password.
fn native_scramble(password: Text, scramble: Bytes) -> Bytes {
  if password == "" {
    return Bytes.empty()
  }
  let once = sha1(password.to_bytes())
  var salted = scramble
  salted.append(sha1(once))
  xor(once, sha1(salted))
}

// The answer of `caching_sha2_password`: SHA256(password) xor
// SHA256(SHA256(SHA256(password)), scramble); nothing for an empty
// password.
fn sha2_scramble(password: Text, scramble: Bytes) -> Bytes {
  if password == "" {
    return Bytes.empty()
  }
  let once = sha256(password.to_bytes())
  var salted = sha256(once)
  salted.append(scramble)
  xor(once, sha256(salted))
}

// The answer `plugin` gives to `scramble`; any plugin but the two is
// refused by name.
fn answer(plugin: Text, password: Text, scramble: Bytes) -> Outcome<Bytes> = if plugin == NATIVE {
  Ok(native_scramble(password, scramble))
} else if plugin == CACHING_SHA2 {
  Ok(sha2_scramble(password, scramble))
} else {
  Err(UnsupportedPlugin(plugin))
}

// The capabilities this client asks for: protocol 41, plugin
// authentication, a database when one is named, TLS when `secure`. It asks
// for no multi-statements, no multi-results, no local files and no
// compression.
fn client_capabilities(options: MysqlOptions, secure: Bool) -> Int {
  var flags = CLIENT_LONG_PASSWORD | CLIENT_LONG_FLAG | CLIENT_PROTOCOL_41 | CLIENT_TRANSACTIONS | CLIENT_SECURE_CONNECTION | CLIENT_PLUGIN_AUTH | CLIENT_PLUGIN_AUTH_LENENC
  if options.database != "" {
    flags = flags | CLIENT_CONNECT_WITH_DB
  }
  if secure {
    flags = flags | CLIENT_SSL
  }
  flags
}

// The 32 bytes the SSLRequest is and the handshake response starts with:
// capabilities, the largest packet, the character set, 23 zero bytes.
fn preamble(options: MysqlOptions, secure: Bool) -> Bytes {
  var out = put_int(Bytes.with_capacity(128), client_capabilities(options, secure), 4)
  out = put_int(out, MAX_FRAME + 1, 4)
  out.push(options.charset.wrap_byte())
  while out.len() < 32 {
    out.push(0)
  }
  out
}

// The SSLRequest packet: the client's capabilities with TLS, sent before
// the TLS handshake.
fn ssl_request(options: MysqlOptions) -> Bytes = preamble(options, true)

// The handshake response (`HandshakeResponse41`): the user, `reply` as the
// answer of `plugin`, the database when one is named, the plugin.
fn handshake_response(options: MysqlOptions, plugin: Text, reply: Bytes, secure: Bool) -> Bytes {
  var out = preamble(options, secure)
  out.append(options.user.to_bytes())
  out.push(0)
  out = put_lenenc_bytes(out, reply)
  if options.database != "" {
    out.append(options.database.to_bytes())
    out.push(0)
  }
  out.append(plugin.to_bytes())
  out.push(0)
  out
}

// `outcome`; a failure closes `stream` first.
fn closing<T: ByteStream, R>(stream: T, outcome: Outcome<R>) -> Outcome<R> = match outcome {
  Ok(value) => Ok(value)
  Err(error) => {
    _ = stream.close()
    Err(error)
  }
}

// Reads the server's handshake from a stream just connected.
fn greet<T: ByteStream>(stream: T, limits: MysqlLimits) -> Outcome<Greeting> {
  let (payload, data, at, _) = read_packet(stream, limits.packet.to_int(), Bytes.empty(), 0, 0)?
  if at != data.len() {
    return Err(Malformed("bytes after the server's handshake"))
  }
  parse_greeting(payload)
}

// Asks the server of `greeting` for TLS: the SSLRequest packet, after
// which the TLS handshake starts on the same stream. Refused when the
// server offers no TLS.
fn request_tls<T: ByteStream>(stream: T, greeting: Greeting, options: MysqlOptions) -> Outcome<Unit> {
  if greeting.capabilities & CLIENT_SSL == 0 {
    return Err(TlsNotOffered)
  }
  stream.write_all(frames(ssl_request(options), 1)).map_err(io)
}

// Answers `greeting` on `stream` and follows the server through its
// plugin: the handshake response goes out as packet `sequence` (1 on a
// plain stream, 2 after an SSLRequest), `secure` says that the stream is
// TLS. An authentication switch is answered with the new plugin's
// scramble. `caching_sha2_password` ends after the scramble when the
// server has the account cached; when it asks for full authentication the
// password is sent on a `secure` stream and the call fails with
// `FullAuthenticationNeedsTls` on any other. With `options.read_only` the
// session's transactions are set read only before the client is returned.
fn authenticate<T: ByteStream>(stream: T, greeting: Greeting, options: MysqlOptions, sequence: Int, secure: Bool) -> Outcome<Client<T>> {
  if options.user.to_bytes().index_of(b"\x00", 0) != None || options.database.to_bytes().index_of(b"\x00", 0) != None {
    return Err(Unsupported("a NUL in the user or the database name"))
  }
  var plugin = greeting.plugin
  let first = answer(plugin, options.password, greeting.scramble)?
  stream.write_all(frames(handshake_response(options, plugin, first, secure), sequence)).map_err(io)?
  let maximum = options.limits.packet.to_int()
  var number = sequence + 1
  var data = Bytes.empty()
  var at = 0
  var packets = 0
  loop {
    packets = packets + 1
    if packets > 8 {
      return Err(Malformed("an authentication of more than 8 packets"))
    }
    let (payload, rest, end, next) = read_packet(stream, maximum, data, at, number)?
    data = rest
    at = end
    number = next
    if payload.is_empty() {
      return Err(Malformed(SHORT))
    }
    let kind = payload[0].to_int()
    if kind == 0 {
      break
    }
    if kind == 255 {
      return Err(server_error(payload))
    }
    if kind == 254 {
      if payload.len() == 1 {
        return Err(UnsupportedPlugin("mysql_old_password"))
      }
      let (name, after) = take_nul(payload, 1)?
      plugin = name.to_text()
      var scramble = payload.slice(after, payload.len())
      if !scramble.is_empty() && scramble[scramble.len() - 1] == 0 {
        scramble = scramble.slice(0, scramble.len() - 1)
      }
      let reply = answer(plugin, options.password, scramble)?
      stream.write_all(frames(reply, number)).map_err(io)?
      number = number + 1
    } else if kind == 1 && plugin == CACHING_SHA2 && payload.len() == 2 && payload[1] == 3 {
      // Fast authentication succeeded: the OK packet follows.
    } else if kind == 1 && plugin == CACHING_SHA2 && payload.len() == 2 && payload[1] == 4 {
      if !secure {
        return Err(FullAuthenticationNeedsTls)
      }
      var clear = options.password.to_bytes()
      clear.push(0)
      stream.write_all(frames(clear, number)).map_err(io)?
      number = number + 1
    } else if kind == 1 {
      return Err(Malformed("authentication data no plugin asked for"))
    } else {
      return Err(Malformed("a packet that is no step of the authentication"))
    }
  }
  if at != data.len() {
    return Err(Malformed("bytes after the authentication"))
  }
  let client = Client { stream, limits = options.limits, version = greeting.version, connection = greeting.connection, secure }
  if options.read_only {
    var body = b"\x03"
    body.append(READ_ONLY.to_bytes())
    _ = simple(client, body)?
  }
  Ok(client)
}

// A client on a stream just connected to a server: reads the handshake and
// authenticates as `options` says, without TLS. A failure closes the
// stream.
fn start<T: ByteStream>(stream: T, options: MysqlOptions) -> Outcome<Client<T>> = closing(stream, open(stream, options))

fn open<T: ByteStream>(stream: T, options: MysqlOptions) -> Outcome<Client<T>> {
  let greeting = greet(stream, options.limits)?
  authenticate(stream, greeting, options, 1, false)
}

// A TCP connection to `endpoint` that gives up after
// `options.connect_timeout`, its reads after `options.read_timeout`.
fn dial(endpoint: Endpoint, options: MysqlOptions) -> Outcome<TcpStream> {
  let stream = TcpStream.connect_within(endpoint.address, endpoint.port, options.connect_timeout).map_err(io)?
  closing(stream, stream.set_idle_timeout(options.read_timeout.to_ms()).map_err(io))?
  Ok(stream)
}

// A client of the server at `endpoint` over plain TCP.
fn connect(endpoint: Endpoint, options: MysqlOptions) -> Outcome<Client<TcpStream>> {
  let stream = dial(endpoint, options)?
  start(stream, options)
}

// A client of the server at `endpoint` over TLS: the server's handshake is
// read on the TCP stream, the SSLRequest sent, the TLS session opened
// with `options.tls` for `options.server_name` (the endpoint's address
// when empty), and the account authenticated inside it. Refused with
// `TlsNotOffered` when the server offers no TLS.
fn connect_tls(endpoint: Endpoint, options: MysqlOptions) -> Outcome<Client<TlsStream>> {
  let stream = dial(endpoint, options)?
  let greeting = closing(stream, greet(stream, options.limits))?
  closing(stream, request_tls(stream, greeting, options))?
  let name = if options.server_name == "" { endpoint.address } else { options.server_name }
  let secure = closing(stream, Tls.client(stream, name, options.tls).map_err(io))?
  closing(secure, authenticate(secure, greeting, options, 2, true))
}

// ---- commands ---------------------------------------------------------------

// `outcome`; a failure after which the connection is out of step closes
// the stream, so the connection is not used again.
fn settle<T: ByteStream, R>(client: Client<T>, outcome: Outcome<R>) -> Outcome<R> = match outcome {
  Ok(value) => Ok(value)
  Err(error) => {
    if !reusable(error) {
      _ = client.stream.close()
    }
    Err(error)
  }
}

// Sends `body` as a command: packet 0 of a new exchange.
fn send<T: ByteStream>(client: Client<T>, body: Bytes) -> Outcome<Unit> = client.stream.write_all(frames(body, 0)).map_err(io)

// Sends `body` and reads the one packet that answers it: OK or the
// server's error.
fn simple<T: ByteStream>(client: Client<T>, body: Bytes) -> Outcome<Done> {
  send(client, body)?
  let (payload, data, at, _) = read_packet(client.stream, client.limits.packet.to_int(), Bytes.empty(), 0, 1)?
  if at != data.len() {
    return Err(Malformed(TRAILING))
  }
  if payload.is_empty() {
    return Err(Malformed(SHORT))
  }
  let kind = payload[0].to_int()
  if kind == 0 {
    return parse_done(payload)
  }
  if kind == 255 {
    return Err(server_error(payload))
  }
  Err(Malformed("a reply that is neither OK nor an error"))
}

// Whether the server answers: `COM_PING`.
fn ping<T: ByteStream>(client: Client<T>) -> Outcome<Unit> {
  _ = settle(client, simple(client, b"\x0e"))?
  Ok(())
}

// Ends the session: `COM_QUIT`, then the stream is closed.
fn quit<T: ByteStream>(client: Client<T>) -> Outcome<Unit> {
  let sent = send(client, b"\x01")
  _ = client.stream.close()
  sent
}

// ---- result sets ------------------------------------------------------------

const BINARY_CHARSET: Int = 63
const UNSIGNED: Int = 32
const MORE_RESULTS: Int = 8
const SECOND_RESULT: Text = "more than one result"

// The column definition packet `payload` (`ColumnDefinition41`).
fn parse_column(payload: Bytes) -> Outcome<Column> {
  let (_, a) = take_text(payload, 0)?
  let (schema, b) = take_text(payload, a)?
  let (table, c) = take_text(payload, b)?
  let (_, d) = take_text(payload, c)?
  let (name, e) = take_text(payload, d)?
  let (_, f) = take_text(payload, e)?
  let (_, g) = take_count(payload, f)?
  let (charset, h) = take_int(payload, g, 2)?
  let (length, i) = take_int(payload, h, 4)?
  let (kind, j) = take_int(payload, i, 1)?
  let (flags, k) = take_int(payload, j, 2)?
  let (decimals, _) = take_int(payload, k, 1)?
  Ok(Column { schema, table, name, charset, length, kind, flags, decimals })
}

// Whether `payload` is the packet that ends definitions and rows.
fn is_eof(payload: Bytes) -> Bool = !payload.is_empty() && payload.len() < 9 && payload[0] == 254

fn is_integer(kind: Int) -> Bool = kind == 1 || kind == 2 || kind == 3 || kind == 8 || kind == 9 || kind == 13

fn is_temporal(kind: Int) -> Bool = kind == 7 || kind == 10 || kind == 11 || kind == 12 || kind == 14

// The bytes of a column that is no number and no date: a BIT(1) is a
// `Bool`, a wider BIT its bytes, JSON and a column with a character set
// text, a binary column its bytes.
fn string_value(column: Column, bytes: Bytes) -> MysqlValue = if column.kind == 16 {
  if column.length == 1 { Bool(bytes == b"\x01") } else { Bytes(bytes) }
} else if column.kind == 245 || column.charset != BINARY_CHARSET {
  Text(bytes.to_text())
} else {
  Bytes(bytes)
}

// The value of `column` that the text protocol sent as `bytes`.
fn text_value(column: Column, bytes: Bytes) -> MysqlValue {
  let kind = column.kind
  if kind == 1 && column.length == 1 {
    return Bool(bytes != b"0")
  }
  if is_integer(kind) {
    let digits = bytes.to_text()
    return match Int.parse(digits) {
      Some(n) => Int(n)
      None => Decimal(digits)
    }
  }
  if kind == 0 || kind == 4 || kind == 5 || kind == 246 {
    return Decimal(bytes.to_text())
  }
  if is_temporal(kind) {
    return Text(bytes.to_text())
  }
  string_value(column, bytes)
}

// The integer of `width` bytes at `at` of a binary row, with its sign
// unless the column is unsigned.
fn whole_value(payload: Bytes, at: Int, width: Int, unsigned: Bool) -> Outcome<(MysqlValue, Int)> {
  let (value, end) = take_int(payload, at, width)?
  let half = 1 << (width * 8 - 1)
  Ok((Int(if unsigned || value < half { value } else { value - half - half }), end))
}

// The value of `column` at `at` of the binary row `payload` and the offset
// after it.
fn binary_value(column: Column, payload: Bytes, at: Int) -> Outcome<(MysqlValue, Int)> {
  let kind = column.kind
  let unsigned = column.flags & UNSIGNED != 0
  if kind == 1 && column.length == 1 {
    let (value, end) = take_int(payload, at, 1)?
    return Ok((Bool(value != 0), end))
  }
  if kind == 1 {
    return whole_value(payload, at, 1, unsigned)
  }
  if kind == 2 || kind == 13 {
    return whole_value(payload, at, 2, unsigned)
  }
  if kind == 3 || kind == 9 {
    return whole_value(payload, at, 4, unsigned)
  }
  if kind == 8 {
    let (value, end) = take_int(payload, at, 8)?
    return Ok((if unsigned && value < 0 { Decimal(unsigned_text(value)) } else { Int(value) }, end))
  }
  if kind == 4 || kind == 5 {
    let (bytes, end) = take_bytes(payload, at, if kind == 4 { 4 } else { 8 })?
    return match if kind == 4 { float_text(bytes) } else { double_text(bytes) } {
      Some(digits) => Ok((Decimal(digits), end))
      None => Err(Malformed("a floating-point value that is no number"))
    }
  }
  if is_temporal(kind) {
    let (count, start) = take_int(payload, at, 1)?
    let (bytes, end) = take_bytes(payload, start, count)?
    return match if kind == 11 { time_text(bytes, column.decimals) } else { date_text(bytes, kind != 10, column.decimals) } {
      Some(printed) => Ok((Text(printed), end))
      None => Err(Malformed("a date or a time of no known length"))
    }
  }
  if kind == 0 || kind == 15 || kind == 16 || kind >= 245 && kind <= 255 {
    return match take_lenenc_bytes(payload, at)? {
      (Some(bytes), end) => Ok((if kind == 0 || kind == 246 { Decimal(bytes.to_text()) } else { string_value(column, bytes) }, end))
      (None, _) => Err(Malformed("a NULL mark inside a binary row"))
    }
  }
  Err(Unsupported("column type {kind}"))
}

// The values of a row of the text protocol: each field behind its length,
// 0xFB for NULL.
fn read_text_row(columns: List<Column>, payload: Bytes) -> Outcome<List<Option<MysqlValue>>> {
  var row: List<Option<MysqlValue>> = []
  var at = 0
  for column in columns {
    let (field, end) = take_lenenc_bytes(payload, at)?
    at = end
    row.push(match field {
      Some(bytes) => Some(text_value(column, bytes))
      None => None
    })
  }
  if at != payload.len() {
    return Err(Malformed("a row longer than its columns"))
  }
  Ok(row)
}

// The values of a row of the binary protocol: a zero byte, the NULL
// bitmap whose first two bits are unused, the values that are not NULL.
fn read_binary_row(columns: List<Column>, payload: Bytes) -> Outcome<List<Option<MysqlValue>>> {
  if payload[0] != 0 {
    return Err(Malformed("a binary row without its header"))
  }
  var at = 1 + (columns.len() + 9) / 8
  if payload.len() < at {
    return Err(Malformed(SHORT))
  }
  var row: List<Option<MysqlValue>> = []
  var bit = 2
  for column in columns {
    if payload[1 + bit / 8].to_int() >> (bit % 8) & 1 == 1 {
      row.push(None)
    } else {
      let (value, end) = binary_value(column, payload, at)?
      at = end
      row.push(Some(value))
    }
    bit = bit + 1
  }
  if at != payload.len() {
    return Err(Malformed("a row longer than its columns"))
  }
  Ok(row)
}

// The next packet of a result set's rows: one above the row limit is
// refused when its frame header is read.
fn read_row<T: ByteStream>(client: Client<T>, buffer: Bytes, at: Int, sequence: Int) -> Outcome<(Bytes, Bytes, Int, Int)> {
  let packet = client.limits.packet.to_int()
  let row = client.limits.row.to_int()
  if row >= packet {
    return read_packet(client.stream, packet, buffer, at, sequence)
  }
  match read_packet(client.stream, row, buffer, at, sequence) {
    Err(PacketTooLarge) => Err(RowTooLarge)
    other => other
  }
}

// Sends the command `body` and reads what answers it: an OK packet, the
// server's error, or a result set (the column count, the definitions, the
// end mark, the rows of the text or the `binary` protocol, the end mark).
// A request for a local file and a second result are refused.
fn results<T: ByteStream>(client: Client<T>, body: Bytes, binary: Bool) -> Outcome<ResultSet> {
  send(client, body)?
  let maximum = client.limits.packet.to_int()
  let (first, begun, offset, following) = read_packet(client.stream, maximum, Bytes.empty(), 0, 1)?
  var data = begun
  var at = offset
  var number = following
  if first.is_empty() {
    return Err(Malformed(SHORT))
  }
  let kind = first[0].to_int()
  if kind == 255 {
    return Err(server_error(first))
  }
  if kind == 0 {
    let done = parse_done(first)?
    if done.status & MORE_RESULTS != 0 {
      return Err(Unsupported(SECOND_RESULT))
    }
    if at != data.len() {
      return Err(Malformed(TRAILING))
    }
    return Ok(ResultSet { affected = done.affected, last_insert_id = done.last_insert_id, warnings = done.warnings })
  }
  if kind == 251 {
    return Err(Unsupported("LOAD DATA LOCAL INFILE"))
  }
  let (count, counted) = take_count(first, 0)?
  if counted != first.len() {
    return Err(Malformed("a column count with bytes after it"))
  }
  if count > client.limits.columns {
    return Err(TooManyColumns)
  }
  var columns: List<Column> = []
  while columns.len() < count {
    let (payload, rest, end, next) = read_packet(client.stream, maximum, data, at, number)?
    data = rest
    at = end
    number = next
    columns.push(parse_column(payload)?)
  }
  let (mark, after, past, then) = read_packet(client.stream, maximum, data, at, number)?
  data = after
  at = past
  number = then
  if !is_eof(mark) {
    return Err(Malformed("a result set without the end of its columns"))
  }
  var rows: List<List<Option<MysqlValue>>> = []
  var warnings = 0
  loop {
    let (payload, rest, end, next) = read_row(client, data, at, number)?
    data = rest
    at = end
    number = next
    if payload.is_empty() {
      return Err(Malformed(SHORT))
    }
    if payload[0] == 255 {
      return Err(server_error(payload))
    }
    if is_eof(payload) {
      if payload.len() >= 5 {
        warnings = int_at(payload, 1, 2)
        if int_at(payload, 3, 2) & MORE_RESULTS != 0 {
          return Err(Unsupported(SECOND_RESULT))
        }
      }
      break
    }
    if rows.len() >= client.limits.rows {
      return Err(TooManyRows)
    }
    rows.push(if binary { read_binary_row(columns, payload)? } else { read_text_row(columns, payload)? })
  }
  if at != data.len() {
    return Err(Malformed(TRAILING))
  }
  Ok(ResultSet { columns, rows, warnings })
}

// Runs the statement `sql` (`COM_QUERY`, the text protocol): its result
// set, or its affected rows when it has none. `sql` is sent as it is; a
// value from outside belongs in a parameter of `execute`. The server's
// error leaves the connection usable; any other failure closes it.
fn query<T: ByteStream>(client: Client<T>, sql: Text) -> Outcome<ResultSet> {
  var body = b"\x03"
  body.append(sql.to_bytes())
  settle(client, results(client, body, false))
}

// ---- prepared statements ----------------------------------------------------

// Reads `count` definitions and the mark that ends them.
fn skip_definitions<T: ByteStream>(client: Client<T>, count: Int, buffer: Bytes, from: Int, sequence: Int) -> Outcome<(Bytes, Int, Int)> {
  let maximum = client.limits.packet.to_int()
  var data = buffer
  var at = from
  var number = sequence
  var left = count
  while left >= 0 {
    let (payload, rest, end, next) = read_packet(client.stream, maximum, data, at, number)?
    data = rest
    at = end
    number = next
    if left > 0 {
      _ = parse_column(payload)?
    } else if !is_eof(payload) {
      return Err(Malformed("definitions without their end"))
    }
    left = left - 1
  }
  Ok((data, at, number))
}

fn prepared<T: ByteStream>(client: Client<T>, sql: Text) -> Outcome<Statement> {
  var body = b"\x16"
  body.append(sql.to_bytes())
  send(client, body)?
  let (first, begun, offset, following) = read_packet(client.stream, client.limits.packet.to_int(), Bytes.empty(), 0, 1)?
  if first.is_empty() {
    return Err(Malformed(SHORT))
  }
  if first[0] == 255 {
    return Err(server_error(first))
  }
  if first[0] != 0 {
    return Err(Malformed("a reply to prepare that is neither a statement nor an error"))
  }
  if first.len() < 12 {
    return Err(Malformed(SHORT))
  }
  let statement = Statement { id = int_at(first, 1, 4), parameters = int_at(first, 7, 2), columns = int_at(first, 5, 2) }
  if statement.columns > client.limits.columns {
    return Err(TooManyColumns)
  }
  var data = begun
  var at = offset
  var number = following
  if statement.parameters > 0 {
    let (rest, end, next) = skip_definitions(client, statement.parameters, data, at, number)?
    data = rest
    at = end
    number = next
  }
  if statement.columns > 0 {
    let (rest, end, _) = skip_definitions(client, statement.columns, data, at, number)?
    data = rest
    at = end
  }
  if at != data.len() {
    return Err(Malformed(TRAILING))
  }
  Ok(statement)
}

// Prepares `sql`, whose values are the `?` marks (`COM_STMT_PREPARE`). The
// statement belongs to this connection until `close`.
fn prepare<T: ByteStream>(client: Client<T>, sql: Text) -> Outcome<Statement> = settle(client, prepared(client, sql))

// `types` and `values` with the type and the bytes of the parameter
// `value`: an `Int` as BIGINT, a `Bool` as TINYINT, a `Decimal` as DECIMAL
// in text, a `Text` as VAR_STRING, `Bytes` as BLOB.
fn bound(types: Bytes, values: Bytes, value: MysqlValue) -> (Bytes, Bytes) {
  var kinds = types
  var out = values
  match value {
    Int(n) => {
      kinds.append(b"\x08\x00")
      out = put_int(out, n, 8)
    }
    Bool(set) => {
      kinds.append(b"\x01\x00")
      out.push(if set { 1 } else { 0 })
    }
    Decimal(digits) => {
      kinds.append(b"\xf6\x00")
      out = put_lenenc_bytes(out, digits.to_bytes())
    }
    Text(text) => {
      kinds.append(b"\xfd\x00")
      out = put_lenenc_bytes(out, text.to_bytes())
    }
    Bytes(bytes) => {
      kinds.append(b"\xfc\x00")
      out = put_lenenc_bytes(out, bytes)
    }
  }
  (kinds, out)
}

// The `COM_STMT_EXECUTE` packet of `statement` with `parameters`: its id,
// no cursor, one iteration, and for parameters the NULL bitmap, the types
// and the values. A parameter is bytes behind a type; none is put into
// the statement's text.
fn execute_body(statement: Statement, parameters: List<Option<MysqlValue>>) -> Bytes {
  var body = put_int(b"\x17", statement.id, 4)
  body.push(0)
  body = put_int(body, 1, 4)
  if parameters.is_empty() {
    return body
  }
  var bitmap = Bytes.with_capacity((parameters.len() + 7) / 8)
  while bitmap.len() < (parameters.len() + 7) / 8 {
    bitmap.push(0)
  }
  var types = Bytes.with_capacity(parameters.len() * 2)
  var values = Bytes.empty()
  var i = 0
  for parameter in parameters {
    match parameter {
      Some(value) => {
        let (kinds, out) = bound(types, values, value)
        types = kinds
        values = out
      }
      None => {
        bitmap[i / 8] = (bitmap[i / 8].to_int() | 1 << (i % 8)).wrap_byte()
        types.append(b"\x06\x00")
      }
    }
    i = i + 1
  }
  body.append(bitmap)
  body.push(1)
  body.append(types)
  body.append(values)
  body
}

// Runs `statement` with `parameters`, one for each of its `?` marks
// (`COM_STMT_EXECUTE`, the binary protocol): its result set, or its
// affected rows when it has none. Another number of parameters is refused
// before anything is sent.
fn execute<T: ByteStream>(client: Client<T>, statement: Statement, parameters: List<Option<MysqlValue>>) -> Outcome<ResultSet> {
  if parameters.len() != statement.parameters {
    return Err(WrongParameterCount(statement.parameters, parameters.len()))
  }
  settle(client, results(client, execute_body(statement, parameters), true))
}

// Releases `statement` on the server (`COM_STMT_CLOSE`), which sends no
// reply.
fn close<T: ByteStream>(client: Client<T>, statement: Statement) -> Outcome<Unit> {
  settle(client, send(client, put_int(b"\x19", statement.id, 4)))?
  Process.flush()
  Ok(())
}

// Runs `sql` once with `parameters` for its `?` marks: prepares it,
// executes it and closes the statement.
fn execute_once<T: ByteStream>(client: Client<T>, sql: Text, parameters: List<Option<MysqlValue>>) -> Outcome<ResultSet> {
  let statement = prepare(client, sql)?
  let outcome = execute(client, statement, parameters)
  match outcome {
    Ok(_) => close(client, statement)?
    Err(error) => {
      if reusable(error) {
        close(client, statement)?
      }
    }
  }
  outcome
}

// ---- several connections ----------------------------------------------------

// Connections of one server for the tasks of a program. A connection
// carries one statement at a time, so each caller takes one out, uses it
// and puts it back; `pool_query` and `pool_execute` do the three. A caller
// waits up to `wait` for a free connection.
type Pool<T> {
  idle: Sender<Client<T>>
  free: Receiver<Client<T>>
  wait: Duration
}

// A pool of `clients`, which holds as many connections as it starts with
// (one when it starts empty).
fn pool_of<T: ByteStream>(clients: List<Client<T>>, wait: Duration) -> Pool<T> {
  let (idle, free) = Channel.bounded(if clients.is_empty() { 1 } else { clients.len() })
  for client in clients {
    _ = idle.try_send(client)
  }
  Pool { idle, free, wait }
}

// Takes a connection out of `pool`: `NoConnection` when none is free
// within the pool's wait.
fn checkout<T: ByteStream>(pool: Pool<T>) -> Outcome<Client<T>> = match pool.free.receive_within(pool.wait) {
  Some(client) => Ok(client)
  None => Err(NoConnection)
}

// Puts `client` into `pool`: a connection taken out before, or a new one
// in the place of one that failed. A pool that is full quits it.
fn checkin<T: ByteStream>(pool: Pool<T>, client: Client<T>) -> Unit {
  if !pool.idle.try_send(client) {
    _ = quit(client)
  }
}

// `outcome` of a call on `client`, which goes back into `pool` unless the
// call failed in a way that closed it: a failed connection is out of the
// pool.
fn release<T: ByteStream, R>(pool: Pool<T>, client: Client<T>, outcome: Outcome<R>) -> Outcome<R> {
  match outcome {
    Ok(_) => checkin(pool, client)
    Err(error) => {
      if reusable(error) {
        checkin(pool, client)
      }
    }
  }
  outcome
}

// `query` on a connection of `pool`.
fn pool_query<T: ByteStream>(pool: Pool<T>, sql: Text) -> Outcome<ResultSet> {
  let client = checkout(pool)?
  release(pool, client, query(client, sql))
}

// `execute_once` on a connection of `pool`.
fn pool_execute<T: ByteStream>(pool: Pool<T>, sql: Text, parameters: List<Option<MysqlValue>>) -> Outcome<ResultSet> {
  let client = checkout(pool)?
  release(pool, client, execute_once(client, sql, parameters))
}

// Quits the connections of `pool` that are free now.
fn quit_idle<T: ByteStream>(pool: Pool<T>) -> Unit {
  loop {
    match pool.free.receive_within(0 ms) {
      Some(client) => {
        _ = quit(client)
      }
      None => break
    }
  }
}

// ---- tests ------------------------------------------------------------------

// A connected pair of pipe ends; each gives up on a peer silent for 5 s,
// so a read that never completes fails the test instead of hanging it.
test fn connected() -> Result<(PipeStream, PipeStream), IoError> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  server.set_idle_timeout(5000)?
  Ok((client, server))
}

// Flushes the task's pending writes as their own delivery and waits 50 ms,
// so the next write is a separate delivery the reader reads on its own.
test fn pause() -> Result<Unit, IoError> {
  let (a, b) = Pipe.pair()
  a.set_idle_timeout(50)?
  _ = a.read(1)?
  _ = b.close()
  Ok(())
}

// The requests of `exchanges` read byte for byte and each answered with
// its reply; an empty request writes the reply at once. A request that
// differs, or a client that stops early, is logged in hex and ends the
// script. Returns the bytes read beyond the script.
test fn play<S: ByteStream>(server: S, exchanges: List<(Bytes, Bytes)>) -> Result<Option<Bytes>, IoError> {
  var data = Bytes.empty()
  for exchange in exchanges {
    let request = exchange.0
    while data.len() < request.len() {
      match server.read(READ_SIZE)? {
        Data(more) => data.append(more)
        Eof => {
          log("script: the client stopped after {hex(data)}, expected {hex(request)}")
          return Ok(None)
        }
      }
    }
    let got = data.slice(0, request.len())
    if got != request {
      log("script: expected {hex(request)}, got {hex(got)}")
      return Ok(None)
    }
    data = data.slice(request.len(), data.len())
    server.write_all(exchange.1)?
  }
  Ok(Some(data))
}

// A scripted server that closes the stream after its last reply.
test fn script<S: ByteStream>(server: S, exchanges: List<(Bytes, Bytes)>) -> Result<Unit, IoError> {
  _ = play(server, exchanges)?
  server.close()
}

// A scripted server that, after its last reply, reads until the client
// closes and sends the number of bytes the client sent beyond the script
// on `extra`; -1 when the script was not followed.
test fn script_counting<S: ByteStream>(server: S, exchanges: List<(Bytes, Bytes)>, extra: Sender<Int>) -> Result<Unit, IoError> {
  match play(server, exchanges)? {
    None => {
      extra.send(0 - 1)
    }
    Some(rest) => {
      var count = rest.len()
      var open = true
      while open {
        match server.read(READ_SIZE)? {
          Data(more) => {
            count = count + more.len()
          }
          Eof => {
            open = false
          }
        }
      }
      extra.send(count)
    }
  }
  server.close()
}

// The client end of a pipe whose other end runs `exchanges`.
test fn scripted(exchanges: List<(Bytes, Bytes)>) -> Result<PipeStream, IoError> {
  let (client, server) = connected()?
  spawn script(server, exchanges)
  Ok(client)
}

// As `scripted`, with the count of bytes sent beyond the script.
test fn counted(exchanges: List<(Bytes, Bytes)>) -> Result<(PipeStream, Receiver<Int>), IoError> {
  let (client, server) = connected()?
  let (extra, counts) = Channel.bounded(1)
  spawn script_counting(server, exchanges, extra)
  Ok((client, counts))
}

test fn nibble(b: Byte) -> Int = if b >= b'a' { (b - b'a').to_int() + 10 } else { (b - b'0').to_int() }

// The bytes lowercase hex `text` spells.
test fn unhex(text: Text) -> Bytes {
  let digits = text.to_bytes()
  var out = Bytes.empty()
  var i = 0
  while i + 1 < digits.len() {
    out.push((nibble(digits[i]) * 16 + nibble(digits[i + 1])).wrap_byte())
    i = i + 2
  }
  out
}

test fn zeros(count: Int) -> Bytes {
  var out = Bytes.with_capacity(count)
  while out.len() < count {
    out.push(0)
  }
  out
}

// `count` bytes that are not all alike, built by doubling.
test fn filled(count: Int) -> Bytes {
  var out = b"0123456789abcdef"
  while out.len() < count {
    let more = out
    out.append(more)
  }
  out.slice(0, count)
}

test fn ok_packet(sequence: Int) -> Bytes = frames(b"\x00\x00\x00\x02\x00\x00\x00", sequence)

test fn eof_packet(sequence: Int) -> Bytes = frames(b"\xfe\x00\x00\x02\x00", sequence)

test fn err_payload(code: Int, state: Text, message: Text) -> Bytes {
  var payload = put_int(b"\xff", code, 2)
  if state != "" {
    payload.push(b'#')
    payload.append(state.to_bytes())
  }
  payload.append(message.to_bytes())
  payload
}

test fn err_packet(sequence: Int, code: Int, state: Text, message: Text) -> Bytes = frames(err_payload(code, state, message), sequence)

// The scramble every scripted handshake sends: the bytes 1 to 20.
test fn nonce() -> Bytes = unhex("0102030405060708090a0b0c0d0e0f1011121314")

// The capabilities of a MySQL 8.0 server, with and without TLS.
test fn with_tls() -> Int = 0xDFFFFFFF
test fn without_tls() -> Int = 0xDFFFF7FF

// The handshake packet of a server "8.0.36", connection 77, whose default
// plugin is `plugin` and whose scramble is `salt`, written field by field
// as the protocol documents it.
test fn greeting_with(plugin: Text, salt: Bytes, capabilities: Int) -> Bytes {
  var payload = b"\x0a8.0.36\x00"
  payload = put_int(payload, 77, 4)
  payload.append(salt.slice(0, 8))
  payload.push(0)
  payload = put_int(payload, capabilities & 65535, 2)
  payload.push(255)
  payload = put_int(payload, 2, 2)
  payload = put_int(payload, capabilities >> 16, 2)
  payload.push(21)
  payload.append(zeros(10))
  payload.append(salt.slice(8, 20))
  payload.push(0)
  payload.append(plugin.to_bytes())
  payload.push(0)
  payload
}

test fn hello(plugin: Text) -> (Bytes, Bytes) = (Bytes.empty(), frames(greeting_with(plugin, nonce(), with_tls()), 0))

// The handshake response a client sends, assembled by hand: the capability
// bytes, 16 MiB as the largest packet, character set 45, 23 zero bytes, the
// user, the answer with its length, the database when given, the plugin.
test fn response(flags: Bytes, user: Text, reply: Bytes, database: Text, plugin: Text) -> Bytes {
  var payload = flags
  payload.append(b"\x00\x00\x00\x01\x2d")
  payload.append(zeros(23))
  payload.append(user.to_bytes())
  payload.push(0)
  payload.push(reply.len().wrap_byte())
  payload.append(reply)
  if database != "" {
    payload.append(database.to_bytes())
    payload.push(0)
  }
  payload.append(plugin.to_bytes())
  payload.push(0)
  payload
}

// The capability bytes of a response on a plain stream without a database.
test fn plain_flags() -> Bytes = b"\x05\xa2\x28\x00"

test fn account() -> MysqlOptions = MysqlOptions { user = "app", password = "secret" }

// The answers to `nonce()` for the password "secret", computed outside
// this module from the plugins' definitions.
test fn native_answer() -> Bytes = unhex("b32bb3a583e1340c0a1108d58b1be49781ad8c2f")
test fn sha2_answer() -> Bytes = unhex("746ebe205d56a0707acb3e796e834e0dd7b1d61743b26bd5202c7a623230c7c9")

test fn native_response() -> Bytes = frames(response(plain_flags(), "app", native_answer(), "", NATIVE), 1)
test fn sha2_response() -> Bytes = frames(response(plain_flags(), "app", sha2_answer(), "", CACHING_SHA2), 1)

// The error of a handshake that must not succeed.
test fn refusal<T>(outcome: Outcome<Client<T>>) -> Option<MysqlError> = match outcome {
  Ok(_) => None
  Err(error) => Some(error)
}

test "integers are little-endian at every width, and a length takes its shortest form" {
  assert put_int(Bytes.empty(), 0x030201, 3) == b"\x01\x02\x03"
  assert put_int(Bytes.empty(), -2, 8) == b"\xfe\xff\xff\xff\xff\xff\xff\xff"
  assert int_at(b"\x00\x01\x02\x03\x04", 1, 4) == 0x04030201
  assert int_at(b"\xfe\xff\xff\xff\xff\xff\xff\xff", 0, 8) == -2
  assert put_lenenc(Bytes.empty(), 0) == b"\x00"
  assert put_lenenc(Bytes.empty(), 250) == b"\xfa"
  assert put_lenenc(Bytes.empty(), 251) == b"\xfc\xfb\x00"
  assert put_lenenc(Bytes.empty(), 65535) == b"\xfc\xff\xff"
  assert put_lenenc(Bytes.empty(), 65536) == b"\xfd\x00\x00\x01"
  assert put_lenenc(Bytes.empty(), 16777215) == b"\xfd\xff\xff\xff"
  assert put_lenenc(Bytes.empty(), 16777216) == b"\xfe\x00\x00\x00\x01\x00\x00\x00\x00"
  for n in [0, 250, 251, 65535, 65536, 16777215, 16777216, 9223372036854775807] {
    var bytes = put_lenenc(Bytes.empty(), n)
    bytes.push(7)
    assert take_lenenc(bytes, 0) == Ok((Some(n), bytes.len() - 1))
  }
}

test "a length-encoded field is read within its packet, NULL told from empty" {
  assert take_lenenc(b"\xfb", 0) == Ok((None, 1))
  assert take_lenenc(b"\xff", 0) == Err(Malformed("a length that starts with 0xFF"))
  assert take_lenenc(b"\xfc\x01", 0) == Err(Malformed(SHORT))
  assert take_lenenc(Bytes.empty(), 0) == Err(Malformed(SHORT))
  assert take_lenenc(b"\xfe\xff\xff\xff\xff\xff\xff\xff\xff", 0) == Err(Malformed("a length above the largest integer"))
  assert take_lenenc_bytes(b"\x03abcd", 0) == Ok((Some(b"abc"), 4))
  assert take_lenenc_bytes(b"\x00", 0) == Ok((Some(Bytes.empty()), 1))
  assert take_lenenc_bytes(b"\xfbx", 0) == Ok((None, 1))
  assert take_lenenc_bytes(b"\x05abc", 0) == Err(Malformed(SHORT))
  assert take_lenenc_bytes(b"\xfe\xff\xff\xff\xff\xff\xff\xff\x7f", 0) == Err(Malformed(SHORT))
  assert take_nul(b"abc\x00def", 0) == Ok((b"abc", 4))
  assert take_nul(b"abc", 1) == Ok((b"bc", 3))
  assert take_int(b"\x01\x02", 1, 2) == Err(Malformed(SHORT))
  assert take_bytes(b"\x01\x02", 1, 1) == Ok((b"\x02", 2))
}

test "a packet is its length, its sequence number and its payload" {
  assert frames(b"\x0e", 0) == b"\x01\x00\x00\x00\x0e"
  assert frames(Bytes.empty(), 3) == b"\x00\x00\x00\x03"
  assert frames(b"abc", 255) == b"\x03\x00\x00\xffabc"
  assert frames(b"abc", 256) == b"\x03\x00\x00\x00abc"
  let (client, server) = connected()?
  server.write_all(b"\x03\x00\x00\xffabc\x00\x00\x00\x00\x01\x00\x00\x01z")?
  let (first, one, at, second) = read_packet(client, 1024, Bytes.empty(), 0, 255)?
  assert first == b"abc" && second == 256
  let (empty, two, after, third) = read_packet(client, 1024, one, at, second)?
  assert empty == Bytes.empty() && third == 257
  let (last, rest, end, fourth) = read_packet(client, 1024, two, after, third)?
  assert last == b"z" && fourth == 258 && end == rest.len()
}

test "a packet split over many small writes is read as one, the next kept" {
  let (client, server) = connected()?
  let parts = [b"\x05\x00", b"\x00\x01he", b"llo\x01", b"\x00\x00\x02", b"!"]
  for part in parts {
    server.write_all(part)?
    pause()?
  }
  let (first, data, at, next) = read_packet(client, 1024, Bytes.empty(), 0, 1)?
  assert first == b"hello"
  let (second, rest, end, after) = read_packet(client, 1024, data, at, next)?
  assert second == b"!" && after == 3 && end == rest.len()
  assert client.received_batches() == 5
}

// A pipe holds 16 MiB of unread bytes, so `wire` goes over it in two
// halves: the first is read into the buffer before the second is written.
test fn read_halves(client: PipeStream, server: PipeStream, wire: Bytes, maximum: Int, sequence: Int) -> Outcome<(Bytes, Int)> {
  let half = wire.len() / 2
  server.write_all(wire.slice(0, half)).map_err(io)?
  let (begun, start) = fill(client, Bytes.empty(), 0, half)?
  server.write_all(wire.slice(half, wire.len())).map_err(io)?
  server.close().map_err(io)?
  let (payload, data, at, next) = read_packet(client, maximum, begun, start, sequence)?
  if at == data.len() { Ok((payload, next)) } else { Err(Malformed(TRAILING)) }
}

// What reading one packet of at most `maximum` bytes from `wire` gives.
test fn read_back(wire: Bytes, maximum: Int, sequence: Int) -> Result<Outcome<(Bytes, Int)>, IoError> {
  let (client, server) = connected()?
  let got = read_halves(client, server, wire, maximum, sequence)
  _ = client.close()
  Ok(got)
}

// Whether `got` is `payload` and the sequence number `next`: a failed
// comparison of 16 MiB is not printed.
test fn carries(got: Outcome<(Bytes, Int)>, payload: Bytes, next: Int) -> Bool = got == Ok((payload, next))

test "a payload of 16 MiB - 1 is followed by an empty frame, and its frames are joined when read" {
  let full = filled(MAX_FRAME)
  let wire = frames(full, 0)
  assert wire.len() == MAX_FRAME + 8
  assert wire.slice(0, 4) == b"\xff\xff\xff\x00"
  assert wire.slice(4, 20) == b"0123456789abcdef"
  assert wire.slice(MAX_FRAME + 4, MAX_FRAME + 8) == b"\x00\x00\x00\x01"
  assert carries(read_back(wire, 67108864, 0)?, full, 2)
  var longer = full
  longer.append(b"tail!")
  let two = frames(longer, 7)
  assert two.len() == MAX_FRAME + 13
  assert two.slice(0, 4) == b"\xff\xff\xff\x07"
  assert two.slice(MAX_FRAME + 4, MAX_FRAME + 13) == b"\x05\x00\x00\x08tail!"
  assert carries(read_back(two, 67108864, 7)?, longer, 9)
  assert frames(filled(MAX_FRAME - 1), 0).len() == MAX_FRAME + 3
  assert carries(read_back(two, MAX_FRAME + 5, 7)?, longer, 9)
  assert read_back(two, MAX_FRAME + 4, 7)? == Err(PacketTooLarge)
  var skipped = wire
  skipped[MAX_FRAME + 7] = 2
  assert read_back(skipped, 67108864, 0)? == Err(OutOfOrder(1, 2))
}

test "a frame out of sequence is refused, naming the number expected and the one read" {
  assert read_back(b"\x01\x00\x00\x02a", 1024, 1)? == Err(OutOfOrder(1, 2))
  assert read_back(b"\x01\x00\x00\x00a", 1024, 1)? == Err(OutOfOrder(1, 0))
  assert read_back(b"\x01\x00\x00\x00a", 1024, 256)? == Ok((b"a", 257))
  assert read_back(b"\x01\x00\x00\x01a", 1024, 256)? == Err(OutOfOrder(0, 1))
}

test "a packet above the limit is refused before its payload is read, and a cut one is closed" {
  let (client, server) = connected()?
  server.write_all(b"\x01\x04\x00\x00")?
  assert read_packet(client, 1024, Bytes.empty(), 0, 0) == Err(PacketTooLarge)
  assert read_back(b"\x03\x00\x00\x00abc", 3, 0)? == Ok((b"abc", 1))
  assert read_back(b"\x03\x00\x00\x00ab", 1024, 0)? == Err(Closed)
  assert read_back(b"\x03\x00", 1024, 0)? == Err(Closed)
  assert read_back(Bytes.empty(), 1024, 0)? == Err(Closed)
}

test "the limits default to 64 MiB packets, 16 MiB rows, a million rows and 4,096 columns" {
  let limits = MysqlLimits {}
  assert limits.packet.to_int() == 67108864
  assert limits.row.to_int() == 16777216
  assert limits.rows == 1000000
  assert limits.columns == 4096
}

test "an error packet is the server's code, SQL state and message" {
  assert server_error(err_payload(1064, "42000", "You have an error in your SQL syntax")) == Server(ServerError { code = 1064, sql_state = "42000", message = "You have an error in your SQL syntax" })
  assert server_error(err_payload(1040, "", "Too many connections")) == Server(ServerError { code = 1040, sql_state = "", message = "Too many connections" })
  assert server_error(b"\xff\x01") == Malformed("an error packet shorter than its code")
  assert parse_done(b"\x00\x03\xfc\x10\x27\x02\x00\x01\x00") == Ok(Done { affected = 3, last_insert_id = 10000, status = 2, warnings = 1 })
  assert parse_done(b"\x00\x03") == Err(Malformed(SHORT))
}

test "no description of an error holds the server's message, and each names its cause" {
  let secret = "SELECT secret FROM vault"
  let failed = Server(ServerError { code = 1064, sql_state = "42000", message = "near '{secret}' for user 'app'" })
  assert describe(failed) == "server error 1064 (42000)"
  assert !describe(failed).contains("secret")
  assert io_error(failed).message == "mysql: server error 1064 (42000)"
  assert describe(Server(ServerError { code = 1040, sql_state = "", message = "Too many connections" })) == "server error 1040"
  assert describe(OutOfOrder(1, 2)) == "packet 2 where packet 1 was expected"
  assert describe(FullAuthenticationNeedsTls).contains("TLS")
  assert describe(UnsupportedPlugin("sha256_password")) == "authentication plugin sha256_password is not supported"
  assert describe(WrongParameterCount(2, 1)) == "1 parameters for a statement with 2"
  assert describe(Io("connect 127.0.0.1:1: connection refused")) == "connect 127.0.0.1:1: connection refused"
}

test "the server's handshake gives its version, connection, capabilities, scramble and plugin" {
  let packet = greeting_with(CACHING_SHA2, nonce(), with_tls())
  assert parse_greeting(packet) == Ok(Greeting {
    version = "8.0.36", connection = 77, capabilities = with_tls(), charset = 255, status = 2, scramble = nonce(), plugin = CACHING_SHA2
  })
  assert parse_greeting(b"\x09" + packet.slice(1, packet.len())) == Err(Unsupported("protocol version 9"))
  assert parse_greeting(err_payload(1040, "08004", "Too many connections")) == Err(Server(ServerError { code = 1040, sql_state = "08004", message = "Too many connections" }))
  assert parse_greeting(greeting_with(NATIVE, nonce(), with_tls() - CLIENT_PLUGIN_AUTH)) == Err(Unsupported("a server without protocol 41 and authentication plugins"))
  assert parse_greeting(packet.slice(0, 23)) == Err(Unsupported("a server without protocol 41"))
  assert parse_greeting(packet.slice(0, 30)) == Err(Malformed(SHORT))
  assert parse_greeting(Bytes.empty()) == Err(Malformed(SHORT))
}

test "both scrambles give the known answers, and an empty password gives none" {
  assert hex(native_scramble("secret", nonce())) == "b32bb3a583e1340c0a1108d58b1be49781ad8c2f"
  assert hex(native_scramble("päss word", nonce())) == "2ef1b5e4183eb62e11383e61f20705a7a3eda4c0"
  assert hex(native_scramble("secret", b"abcdefghijklmnopqrst")) == "8817c50fa779daef010ee7577825b0847df9842e"
  assert hex(sha2_scramble("secret", nonce())) == "746ebe205d56a0707acb3e796e834e0dd7b1d61743b26bd5202c7a623230c7c9"
  assert hex(sha2_scramble("päss word", nonce())) == "97af830f32e8b1f74036bd08fd7c807ec43c055b056f31af2ab700d696566d39"
  assert hex(sha2_scramble("secret", b"abcdefghijklmnopqrst")) == "c76e2898612a4cf042c77fa8c4702c4c64c0c2c557c53c4d75595aaa6abae809"
  assert native_scramble("", nonce()) == Bytes.empty()
  assert sha2_scramble("", nonce()) == Bytes.empty()
  assert answer("mysql_clear_password", "secret", nonce()) == Err(UnsupportedPlugin("mysql_clear_password"))
}

test "the handshake response is the capabilities, the user, the answer, the database and the plugin" {
  let options = MysqlOptions { user = "app", password = "secret", database = "shop" }
  var expected = b"\x0d\xa2\x28\x00\x00\x00\x00\x01\x2d"
  expected.append(zeros(23))
  expected.append(b"app\x00\x14\xb3\x2b\xb3\xa5\x83\xe1\x34\x0c\x0a\x11\x08\xd5\x8b\x1b\xe4\x97\x81\xad\x8c\x2f")
  expected.append(b"shop\x00mysql_native_password\x00")
  assert handshake_response(options, NATIVE, native_answer(), false) == expected
  assert handshake_response(account(), CACHING_SHA2, sha2_answer(), false) == response(plain_flags(), "app", sha2_answer(), "", CACHING_SHA2)
  assert handshake_response(account(), CACHING_SHA2, sha2_answer(), true) == response(b"\x05\xaa\x28\x00", "app", sha2_answer(), "", CACHING_SHA2)
  assert handshake_response(MysqlOptions { user = "app" }, NATIVE, Bytes.empty(), false) == response(plain_flags(), "app", Bytes.empty(), "", NATIVE)
  var request = b"\x0d\xaa\x28\x00\x00\x00\x00\x01\x2d"
  request.append(zeros(23))
  assert ssl_request(options) == request
}

test "mysql_native_password: the SHA-1 scramble answers the handshake" {
  let stream = scripted([hello(NATIVE), (native_response(), ok_packet(2))])?
  let client = start(stream, account())?
  assert client.version == "8.0.36"
  assert client.connection == 77
  assert !client.secure
}

test "caching_sha2_password: the SHA-256 scramble and the fast path" {
  let stream = scripted([hello(CACHING_SHA2), (sha2_response(), frames(b"\x01\x03", 2) + ok_packet(3))])?
  let client = start(stream, account())?
  assert client.connection == 77
}

test "caching_sha2_password: full authentication on a plain stream is the typed error that names TLS, and no password is sent" {
  let (stream, counts) = counted([hello(CACHING_SHA2), (sha2_response(), frames(b"\x01\x04", 2))])?
  assert refusal(start(stream, account())) == Some(FullAuthenticationNeedsTls)
  assert counts.receive() == Some(0)
  assert describe(FullAuthenticationNeedsTls) == "the server asks for the password itself (caching_sha2_password full authentication), which is sent over TLS only"
}

test "the TLS request is the SSLRequest packet, refused when the server offers no TLS" {
  let options = MysqlOptions { user = "app", password = "secret", database = "shop" }
  let (stream, counts) = counted([(frames(ssl_request(options), 1), Bytes.empty())])?
  let offered = parse_greeting(greeting_with(CACHING_SHA2, nonce(), with_tls()))?
  assert request_tls(stream, offered, options) == Ok(())
  _ = stream.close()
  assert counts.receive() == Some(0)
  let (other, none) = counted([])?
  let plain = parse_greeting(greeting_with(CACHING_SHA2, nonce(), without_tls()))?
  assert request_tls(other, plain, options) == Err(TlsNotOffered)
  _ = other.close()
  assert none.receive() == Some(0)
}

test "caching_sha2_password: full authentication after the TLS request sends the password, at sequence 2" {
  let reply = frames(response(b"\x05\xaa\x28\x00", "app", sha2_answer(), "", CACHING_SHA2), 2)
  let stream = scripted([
    (reply, frames(b"\x01\x04", 3)),
    (frames(b"secret\x00", 4), ok_packet(5))
  ])?
  let greeting = parse_greeting(greeting_with(CACHING_SHA2, nonce(), with_tls()))?
  let client = authenticate(stream, greeting, account(), 2, true)?
  assert client.secure
}

test "an authentication switch is answered in either direction with the new scramble" {
  let salt = b"abcdefghijklmnopqrst"
  var to_native = b"\xfemysql_native_password\x00"
  to_native.append(salt)
  to_native.push(0)
  let first = scripted([
    hello(CACHING_SHA2),
    (sha2_response(), frames(to_native, 2)),
    (frames(unhex("8817c50fa779daef010ee7577825b0847df9842e"), 3), ok_packet(4))
  ])?
  assert refusal(start(first, account())) == None
  var to_sha2 = b"\xfecaching_sha2_password\x00"
  to_sha2.append(salt)
  to_sha2.push(0)
  let second = scripted([
    hello(NATIVE),
    (native_response(), frames(to_sha2, 2)),
    (frames(unhex("c76e2898612a4cf042c77fa8c4702c4c64c0c2c557c53c4d75595aaa6abae809"), 3), frames(b"\x01\x03", 4) + ok_packet(5))
  ])?
  assert refusal(start(second, account())) == None
}

test "any other plugin is refused by name, in the handshake and in a switch, and gets no answer" {
  let (first, none) = counted([hello("sha256_password")])?
  assert refusal(start(first, account())) == Some(UnsupportedPlugin("sha256_password"))
  assert none.receive() == Some(0)
  let (second, after) = counted([hello(NATIVE), (native_response(), frames(b"\xfemysql_clear_password\x00", 2))])?
  assert refusal(start(second, account())) == Some(UnsupportedPlugin("mysql_clear_password"))
  assert after.receive() == Some(0)
  let (third, old) = counted([hello(NATIVE), (native_response(), frames(b"\xfe", 2))])?
  assert refusal(start(third, account())) == Some(UnsupportedPlugin("mysql_old_password"))
  assert old.receive() == Some(0)
}

test "a refused account is the server's error, and a handshake that never ends is cut" {
  let denied = scripted([hello(NATIVE), (native_response(), err_packet(2, 1045, "28000", "Access denied for user 'app'@'localhost' (using password: YES)"))])?
  let error = refusal(start(denied, account()))?
  assert error == Server(ServerError { code = 1045, sql_state = "28000", message = "Access denied for user 'app'@'localhost' (using password: YES)" })
  assert describe(error) == "server error 1045 (28000)"
  let odd = scripted([hello(NATIVE), (native_response(), frames(b"\x01\x03", 2))])?
  assert refusal(start(odd, account())) == Some(Malformed("authentication data no plugin asked for"))
  let wrong = scripted([hello(NATIVE), (native_response(), ok_packet(3))])?
  assert refusal(start(wrong, account())) == Some(OutOfOrder(2, 3))
  let silent = scripted([hello(NATIVE), (native_response(), Bytes.empty())])?
  assert refusal(start(silent, account())) == Some(Closed)
  let named = start(scripted([hello(NATIVE)])?, MysqlOptions { user = "a\x00b" })
  assert refusal(named) == Some(Unsupported("a NUL in the user or the database name"))
}

test "a read-only session sets its transactions read only before it is returned, and no other session sends a statement" {
  var set = b"\x03"
  set.append(READ_ONLY.to_bytes())
  assert READ_ONLY == "SET SESSION TRANSACTION READ ONLY"
  let (stream, counts) = counted([hello(NATIVE), (native_response(), ok_packet(2)), (frames(set, 0), ok_packet(1))])?
  let client = start(stream, MysqlOptions { user = "app", password = "secret", read_only = true })?
  _ = client.stream.close()
  assert counts.receive() == Some(0)
  let (plain, none) = counted([hello(NATIVE), (native_response(), ok_packet(2))])?
  let other = start(plain, account())?
  _ = other.stream.close()
  assert none.receive() == Some(0)
  let refused = scripted([hello(NATIVE), (native_response(), ok_packet(2)), (frames(set, 0), err_packet(1, 1227, "42000", "Access denied"))])?
  assert refusal(start(refused, MysqlOptions { user = "app", password = "secret", read_only = true })) == Some(Server(ServerError { code = 1227, sql_state = "42000", message = "Access denied" }))
}

test "ping is answered with OK, and quit sends COM_QUIT and closes" {
  let (stream, counts) = counted([(b"\x01\x00\x00\x00\x0e", ok_packet(1)), (b"\x01\x00\x00\x00\x0e", err_packet(1, 1053, "08S01", "Server shutdown in progress")), (b"\x01\x00\x00\x00\x01", Bytes.empty())])?
  let client = Client { stream }
  assert ping(client) == Ok(())
  assert ping(client) == Err(Server(ServerError { code = 1053, sql_state = "08S01", message = "Server shutdown in progress" }))
  assert quit(client) == Ok(())
  assert counts.receive() == Some(0)
}

test "a reply that is no reply ends the connection: it is closed, not reused" {
  let (stream, counts) = counted([(b"\x01\x00\x00\x00\x0e", frames(b"\x07", 1))])?
  let client = Client { stream }
  assert ping(client) == Err(Malformed("a reply that is neither OK nor an error"))
  assert counts.receive() == Some(0)
  let (late, more) = counted([(b"\x01\x00\x00\x00\x0e", ok_packet(1) + ok_packet(2))])?
  assert ping(Client { stream = late }) == Err(Malformed(TRAILING))
  assert more.receive() == Some(0)
}

// ---- tests: statements -------------------------------------------------------

// A client whose server runs `exchanges`, past its handshake.
test fn session(exchanges: List<(Bytes, Bytes)>) -> Result<Client<PipeStream>, IoError> {
  let stream = scripted(exchanges)?
  Ok(Client { stream })
}

// The command packet of `code` and `text`: packet 0 of an exchange.
test fn command(code: Byte, text: Text) -> Bytes {
  var body = Bytes.empty()
  body.push(code)
  body.append(text.to_bytes())
  frames(body, 0)
}

// The packets of one reply, numbered from 1.
test fn reply(payloads: List<Bytes>) -> Bytes {
  var out = Bytes.empty()
  var number = 1
  for payload in payloads {
    out.append(frames(payload, number))
    number = number + 1
  }
  out
}

// A column definition written field by field as the protocol documents
// it: catalog `def`, schema `shop`, table and original table `t`, the name
// twice, 12 as the length of the fixed fields, the character set, the
// length, the type, the flags, the decimals and two zero bytes.
test fn column_of(name: Text, kind: Int, length: Int, flags: Int, charset: Int, decimals: Int) -> Bytes {
  var out = b"\x03def\x04shop\x01t\x01t"
  out.push(name.len().wrap_byte())
  out.append(name.to_bytes())
  out.push(name.len().wrap_byte())
  out.append(name.to_bytes())
  out.push(12)
  out = put_int(out, charset, 2)
  out = put_int(out, length, 4)
  out.push(kind.wrap_byte())
  out = put_int(out, flags, 2)
  out.push(decimals.wrap_byte())
  out.append(b"\x00\x00")
  out
}

test fn eof() -> Bytes = b"\xfe\x00\x00\x02\x00"

// A row of the text protocol: each field behind its length, 0xFB for NULL.
// The fields of these tests are shorter than 251 bytes.
test fn text_row(fields: List<Option<Bytes>>) -> Bytes {
  var out = Bytes.empty()
  for field in fields {
    match field {
      Some(bytes) => {
        out.push(bytes.len().wrap_byte())
        out.append(bytes)
      }
      None => out.push(251)
    }
  }
  out
}

// A row of the binary protocol: a zero byte, the NULL bitmap whose first
// two bits are unused, and the values that are not NULL.
test fn binary_row(values: List<Option<Bytes>>) -> Bytes {
  var out = zeros(1 + (values.len() + 9) / 8)
  var i = 0
  for value in values {
    match value {
      Some(bytes) => out.append(bytes)
      None => {
        let at = 1 + (i + 2) / 8
        out[at] = (out[at].to_int() | (1 << ((i + 2) % 8))).wrap_byte()
      }
    }
    i = i + 1
  }
  out
}

// One column of every supported type: its definition, a value as the text
// protocol sends it, the same value as the binary protocol sends it, and
// what both decode to.
test fn typed() -> List<(Bytes, Bytes, Bytes, MysqlValue)> = [
  (column_of("flag", 1, 1, 0, 63, 0), b"1", b"\x01", Bool(true)),
  (column_of("tiny", 1, 4, 0, 63, 0), b"-128", b"\x80", Int(-128)),
  (column_of("utiny", 1, 3, 32, 63, 0), b"255", b"\xff", Int(255)),
  (column_of("small", 2, 6, 0, 63, 0), b"-32768", b"\x00\x80", Int(-32768)),
  (column_of("usmall", 2, 5, 32, 63, 0), b"65535", b"\xff\xff", Int(65535)),
  (column_of("medium", 9, 9, 0, 63, 0), b"-8388608", b"\x00\x00\x80\xff", Int(-8388608)),
  (column_of("whole", 3, 11, 0, 63, 0), b"-2147483648", b"\x00\x00\x00\x80", Int(-2147483648)),
  (column_of("uwhole", 3, 10, 32, 63, 0), b"4294967295", b"\xff\xff\xff\xff", Int(4294967295)),
  (column_of("big", 8, 20, 0, 63, 0), b"9223372036854775807", b"\xff\xff\xff\xff\xff\xff\xff\x7f", Int(9223372036854775807)),
  (column_of("minus", 8, 20, 0, 63, 0), b"-2", b"\xfe\xff\xff\xff\xff\xff\xff\xff", Int(-2)),
  (column_of("ubig", 8, 20, 32, 63, 0), b"5", b"\x05\x00\x00\x00\x00\x00\x00\x00", Int(5)),
  (column_of("huge", 8, 20, 32, 63, 0), b"18446744073709551615", b"\xff\xff\xff\xff\xff\xff\xff\xff", Decimal("18446744073709551615")),
  (column_of("year", 13, 4, 96, 63, 0), b"2024", b"\xe8\x07", Int(2024)),
  (column_of("price", 246, 12, 0, 63, 2), b"-1234.50", b"\x08-1234.50", Decimal("-1234.50")),
  (column_of("ratio", 4, 12, 0, 63, 31), b"1.1", b"\xcd\xcc\x8c\x3f", Decimal("1.1")),
  (column_of("exact", 5, 22, 0, 63, 31), b"0.1", b"\x9a\x99\x99\x99\x99\x99\xb9\x3f", Decimal("0.1")),
  (column_of("name", 253, 400, 0, 45, 0), b"Zo\xc3\xab", b"\x04Zo\xc3\xab", Text("Zoë")),
  (column_of("code", 254, 12, 0, 45, 0), b"ab", b"\x02ab", Text("ab")),
  (column_of("note", 252, 262140, 16, 45, 0), b"long text", b"\x09long text", Text("long text")),
  (column_of("empty", 253, 400, 0, 45, 0), b"", b"\x00", Text("")),
  (column_of("raw", 252, 65535, 144, 63, 0), b"\x00\xff", b"\x02\x00\xff", Bytes(b"\x00\xff")),
  (column_of("key", 253, 16, 128, 63, 0), b"\x01\x02", b"\x02\x01\x02", Bytes(b"\x01\x02")),
  (column_of("bit", 16, 1, 32, 63, 0), b"\x01", b"\x01\x01", Bool(true)),
  (column_of("bits", 16, 8, 32, 63, 0), b"\xa5", b"\x01\xa5", Bytes(b"\xa5")),
  (column_of("doc", 245, 4294967295, 144, 63, 0), r#"{"a": 1}"#.to_bytes(), b"\x08" + r#"{"a": 1}"#.to_bytes(), Text(r#"{"a": 1}"#)),
  (column_of("day", 10, 10, 128, 63, 0), b"2024-02-29", b"\x04\xe8\x07\x02\x1d", Text("2024-02-29")),
  (column_of("at", 12, 26, 128, 63, 6), b"2024-02-29 23:59:58.123456", b"\x0b\xe8\x07\x02\x1d\x17\x3b\x3a\x40\xe2\x01\x00", Text("2024-02-29 23:59:58.123456")),
  (column_of("stamp", 7, 19, 128, 63, 0), b"2024-02-29 23:59:58", b"\x07\xe8\x07\x02\x1d\x17\x3b\x3a", Text("2024-02-29 23:59:58")),
  (column_of("span", 11, 10, 128, 63, 0), b"-34:11:12", b"\x08\x01\x01\x00\x00\x00\x0a\x0b\x0c", Text("-34:11:12")),
  (column_of("mood", 254, 12, 256, 45, 0), b"glad", b"\x04glad", Text("glad")),
  (column_of("tags", 254, 12, 2048, 45, 0), b"a,b", b"\x03a,b", Text("a,b"))
]

// The reply of a result set over `typed()`: one row with every value, one
// with every column NULL; `binary` chooses the protocol of the rows.
test fn typed_reply(binary: Bool) -> Bytes {
  let entries = typed()
  var payloads = [put_lenenc(Bytes.empty(), entries.len())]
  var values: List<Option<Bytes>> = []
  var nulls: List<Option<Bytes>> = []
  for entry in entries {
    payloads.push(entry.0)
    values.push(Some(if binary { entry.2 } else { entry.1 }))
    nulls.push(None)
  }
  payloads.push(eof())
  payloads.push(if binary { binary_row(values) } else { text_row(values) })
  payloads.push(if binary { binary_row(nulls) } else { text_row(nulls) })
  payloads.push(eof())
  reply(payloads)
}

// Whether `result` is the two rows of `typed_reply`.
test fn is_typed(result: ResultSet) -> Bool {
  let entries = typed()
  var expected: List<Option<MysqlValue>> = []
  var absent: List<Option<MysqlValue>> = []
  for entry in entries {
    expected.push(Some(entry.3))
    absent.push(None)
  }
  assert result.columns.len() == entries.len()
  assert result.rows.len() == 2
  var i = 0
  while i < expected.len() {
    assert result.rows[0][i] == expected[i], result.columns[i].name
    i = i + 1
  }
  result.rows[1] == absent
}

// Whether the connection of `client` is closed: a command on it fails
// before it is sent.
test fn shut<T: ByteStream>(client: Client<T>) -> Bool = ping(client) == Err(Io("write to a closed stream"))

test "a column definition is its schema, table, name, character set, length, type, flags and decimals" {
  // The packet the protocol's documentation shows for `SELECT @@version_comment`.
  let documented = unhex("0364656600000011404076657273696f6e5f636f6d6d656e74000c08001c000000fd00001f0000")
  assert parse_column(documented) == Ok(Column { schema = "", table = "", name = "@@version_comment", charset = 8, length = 28, kind = 253, flags = 0, decimals = 31 })
  assert parse_column(column_of("price", 246, 12, 32, 63, 2)) == Ok(Column { schema = "shop", table = "t", name = "price", charset = 63, length = 12, kind = 246, flags = 32, decimals = 2 })
  assert parse_column(documented.slice(0, 30)) == Err(Malformed(SHORT))
  assert parse_column(Bytes.empty()) == Err(Malformed(SHORT))
  assert parse_column(b"\x03def\x00\x00\x00\xfb\x00\x0c\x08\x00\x1c\x00\x00\x00\xfd\x00\x00\x1f\x00\x00") == Err(Malformed("a NULL where a name is expected"))
}

test "a text result set gives its columns and decodes every column type, NULL as none" {
  let client = session([(command(3, "SELECT * FROM t"), typed_reply(false))])?
  let result = query(client, "SELECT * FROM t")?
  assert result.columns[0] == Column { schema = "shop", table = "t", name = "flag", charset = 63, length = 1, kind = 1, flags = 0, decimals = 0 }
  assert result.columns[30].name == "tags"
  assert is_typed(result)
  assert result.affected == 0 && result.last_insert_id == 0 && result.warnings == 0
}

test "a text value follows its column: a false flag, a cleared bit, an integer that fits no Int" {
  let flag = parse_column(column_of("flag", 1, 1, 0, 63, 0))?
  assert text_value(flag, b"0") == Bool(false)
  assert text_value(flag, b"1") == Bool(true)
  let bit = parse_column(column_of("bit", 16, 1, 32, 63, 0))?
  assert text_value(bit, b"\x00") == Bool(false)
  let wide = parse_column(column_of("huge", 8, 20, 32, 63, 0))?
  assert text_value(wide, b"9223372036854775807") == Int(9223372036854775807)
  assert text_value(wide, b"9223372036854775808") == Decimal("9223372036854775808")
  // A type this client does not know is read by its character set.
  assert text_value(parse_column(column_of("odd", 99, 4, 0, 45, 0))?, b"abc") == Text("abc")
  assert text_value(parse_column(column_of("odd", 99, 4, 0, 63, 0))?, b"abc") == Bytes(b"abc")
  assert text_value(parse_column(column_of("shape", 255, 4, 144, 63, 0))?, b"\x00\x01") == Bytes(b"\x00\x01")
}

test "a statement without a result set is its affected rows, last insert id and warnings" {
  let client = session([(command(3, "UPDATE t SET a = 1"), reply([b"\x00\xfc\x2c\x01\x07\x02\x00\x03\x00"]))])?
  let result = query(client, "UPDATE t SET a = 1")?
  assert result.columns.is_empty() && result.rows.is_empty()
  assert result.affected == 300 && result.last_insert_id == 7 && result.warnings == 3
}

test "an empty result set has its columns and no row" {
  let client = session([(command(3, "SELECT a FROM t WHERE 1 = 0"), reply([b"\x01", column_of("a", 3, 11, 0, 63, 0), eof(), b"\xfe\x02\x00\x22\x00"]))])?
  let result = query(client, "SELECT a FROM t WHERE 1 = 0")?
  assert result.columns.len() == 1 && result.rows.is_empty() && result.warnings == 2
}

test "a server error in place of a result set and one between its rows keep the connection" {
  let syntax = "You have an error in your SQL syntax near 'SELEC secret'"
  let client = session([
    (command(3, "SELEC secret"), reply([err_payload(1064, "42000", syntax)])),
    (command(3, "SELECT a FROM t"), reply([b"\x01", column_of("a", 3, 11, 0, 63, 0), eof(), text_row([Some(b"1")]), err_payload(1317, "70100", "Query execution was interrupted")])),
    (frames(b"\x0e", 0), ok_packet(1))
  ])?
  let refused = query(client, "SELEC secret")
  assert refused == Err(Server(ServerError { code = 1064, sql_state = "42000", message = syntax }))
  assert describe(Server(ServerError { code = 1064, sql_state = "42000", message = syntax })) == "server error 1064 (42000)"
  assert query(client, "SELECT a FROM t") == Err(Server(ServerError { code = 1317, sql_state = "70100", message = "Query execution was interrupted" }))
  assert ping(client) == Ok(())
}

test "a request for a local file is refused and nothing is sent in answer" {
  let (stream, counts) = counted([(command(3, "LOAD DATA LOCAL INFILE 'x' INTO TABLE t"), reply([b"\xfb/etc/hostname"]))])?
  let client = Client { stream }
  assert query(client, "LOAD DATA LOCAL INFILE 'x' INTO TABLE t") == Err(Unsupported("LOAD DATA LOCAL INFILE"))
  assert describe(Unsupported("LOAD DATA LOCAL INFILE")) == "LOAD DATA LOCAL INFILE is not supported"
  assert shut(client)
  assert counts.receive() == Some(0)
}

test "a second result is refused: after a result set and after a statement without one" {
  let rows = session([(command(3, "CALL p()"), reply([b"\x01", column_of("a", 3, 11, 0, 63, 0), eof(), text_row([Some(b"1")]), b"\xfe\x00\x00\x0a\x00"]))])?
  assert query(rows, "CALL p()") == Err(Unsupported("more than one result"))
  assert shut(rows)
  let none = session([(command(3, "CALL q()"), reply([b"\x00\x00\x00\x0a\x00\x00\x00"]))])?
  assert query(none, "CALL q()") == Err(Unsupported("more than one result"))
  assert shut(none)
}

test "a result set past a limit is refused and its connection closed" {
  let three = reply([b"\x03", column_of("a", 3, 11, 0, 63, 0), column_of("b", 3, 11, 0, 63, 0), column_of("c", 3, 11, 0, 63, 0), eof(), eof()])
  let wide = Client { stream = scripted([(command(3, "S"), three)])?, limits = MysqlLimits { columns = 2 } }
  assert query(wide, "S") == Err(TooManyColumns)
  assert shut(wide)
  let fits = Client { stream = scripted([(command(3, "S"), three)])?, limits = MysqlLimits { columns = 3 } }
  assert query(fits, "S")?.columns.len() == 3
  let two = reply([b"\x01", column_of("a", 253, 40, 0, 45, 0), eof(), text_row([Some(b"1234567")]), text_row([Some(b"12345678")]), eof()])
  let long = Client { stream = scripted([(command(3, "S"), two)])?, limits = MysqlLimits { rows = 1 } }
  assert query(long, "S") == Err(TooManyRows)
  assert shut(long)
  let both = Client { stream = scripted([(command(3, "S"), two)])?, limits = MysqlLimits { rows = 2 } }
  assert query(both, "S")?.rows.len() == 2
  let heavy = Client { stream = scripted([(command(3, "S"), two)])?, limits = MysqlLimits { row = 8 bytes } }
  assert query(heavy, "S") == Err(RowTooLarge)
  assert shut(heavy)
  let light = Client { stream = scripted([(command(3, "S"), two)])?, limits = MysqlLimits { row = 9 bytes } }
  assert query(light, "S")?.rows.len() == 2
  let big = Client { stream = scripted([(command(3, "S"), two)])?, limits = MysqlLimits { packet = 16 bytes } }
  assert query(big, "S") == Err(PacketTooLarge)
  assert shut(big)
}

test "a result set cut short, out of sequence or out of shape is refused and its connection closed" {
  let a = column_of("a", 3, 11, 0, 63, 0)
  let cut = session([(command(3, "S"), reply([b"\x01", a, eof(), text_row([Some(b"1")])]))])?
  assert query(cut, "S") == Err(Closed)
  assert shut(cut)
  let silent = session([(command(3, "S"), Bytes.empty())])?
  assert query(silent, "S") == Err(Closed)
  let open = session([(command(3, "S"), reply([b"\x01", a, text_row([Some(b"1")]), eof()]))])?
  assert query(open, "S") == Err(Malformed("a result set without the end of its columns"))
  assert shut(open)
  let counted_twice = session([(command(3, "S"), reply([b"\x01\x01", a, eof(), eof()]))])?
  assert query(counted_twice, "S") == Err(Malformed("a column count with bytes after it"))
  let short = session([(command(3, "S"), reply([b"\x02", a, a, eof(), text_row([Some(b"1")]), eof()]))])?
  assert query(short, "S") == Err(Malformed(SHORT))
  let wide = session([(command(3, "S"), reply([b"\x01", a, eof(), text_row([Some(b"1"), Some(b"2")]), eof()]))])?
  assert query(wide, "S") == Err(Malformed("a row longer than its columns"))
  assert shut(wide)
  let late = session([(command(3, "S"), reply([b"\x01", a, eof(), eof(), eof()]))])?
  assert query(late, "S") == Err(Malformed(TRAILING))
  assert shut(late)
  let skipped = session([(command(3, "S"), frames(b"\x01", 1) + frames(a, 2) + frames(eof(), 4))])?
  assert query(skipped, "S") == Err(OutOfOrder(3, 4))
  assert shut(skipped)
  let empty = session([(command(3, "S"), reply([Bytes.empty()]))])?
  assert query(empty, "S") == Err(Malformed(SHORT))
}

test "prepare gives the statement's id and counts, and reads its definitions" {
  let sql = "SELECT a FROM t WHERE b = ? AND c = ?"
  let client = session([
    (command(0x16, sql), reply([b"\x00\x07\x00\x00\x00\x01\x00\x02\x00\x00\x00\x00", column_of("?", 253, 0, 0, 63, 0), column_of("?", 253, 0, 0, 63, 0), eof(), column_of("a", 3, 11, 0, 63, 0), eof()])),
    (command(0x16, "DO 1"), reply([b"\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"])),
    (command(0x16, "SELECT ?"), reply([b"\x00\x0a\x00\x00\x00\x01\x00\x01\x00\x00\x00\x00", column_of("?", 253, 0, 0, 63, 0), eof(), column_of("?", 253, 0, 0, 63, 0), eof()])),
    (command(0x16, "SELECT 1"), reply([b"\x00\x0b\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00", column_of("1", 8, 2, 129, 63, 0), eof()])),
    (command(0x16, "SELEC"), reply([err_payload(1064, "42000", "near 'SELEC'")])),
    (frames(b"\x0e", 0), ok_packet(1))
  ])?
  assert prepare(client, sql) == Ok(Statement { id = 7, parameters = 2, columns = 1 })
  assert prepare(client, "DO 1") == Ok(Statement { id = 9, parameters = 0, columns = 0 })
  assert prepare(client, "SELECT ?") == Ok(Statement { id = 10, parameters = 1, columns = 1 })
  assert prepare(client, "SELECT 1") == Ok(Statement { id = 11, parameters = 0, columns = 1 })
  assert prepare(client, "SELEC") == Err(Server(ServerError { code = 1064, sql_state = "42000", message = "near 'SELEC'" }))
  assert ping(client) == Ok(())
}

test "a reply to prepare that is cut, short or followed by bytes is refused and its connection closed" {
  let short = session([(command(0x16, "S"), reply([b"\x00\x07\x00\x00\x00\x01\x00\x02\x00\x00\x00"]))])?
  assert prepare(short, "S") == Err(Malformed(SHORT))
  assert shut(short)
  let other = session([(command(0x16, "S"), reply([b"\x05\x07\x00\x00\x00\x01\x00\x02\x00\x00\x00\x00"]))])?
  assert prepare(other, "S") == Err(Malformed("a reply to prepare that is neither a statement nor an error"))
  let cut = session([(command(0x16, "S"), reply([b"\x00\x07\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00", column_of("?", 253, 0, 0, 63, 0)]))])?
  assert prepare(cut, "S") == Err(Closed)
  let open = session([(command(0x16, "S"), reply([b"\x00\x07\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00", column_of("?", 253, 0, 0, 63, 0), column_of("?", 253, 0, 0, 63, 0)]))])?
  assert prepare(open, "S") == Err(Malformed("definitions without their end"))
  let late = session([(command(0x16, "S"), reply([b"\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00", eof()]))])?
  assert prepare(late, "S") == Err(Malformed(TRAILING))
  assert shut(late)
  let many = Client { stream = scripted([(command(0x16, "S"), reply([b"\x00\x07\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00"]))])?, limits = MysqlLimits { columns = 2 } }
  assert prepare(many, "S") == Err(TooManyColumns)
  assert shut(many)
}

test "execute sends each parameter as a typed value behind the NULL bitmap, never in the statement's text" {
  let sql = "SELECT a FROM t WHERE b = ?"
  let hostile = "x' OR '1'='1"
  // COM_STMT_EXECUTE: statement 7, no cursor, one iteration, no NULL, new
  // types, one VAR_STRING, the 12 bytes of the parameter behind their length.
  let one = b"\x17\x07\x00\x00\x00\x00\x01\x00\x00\x00\x00\x01\xfd\x00\x0cx' OR '1'='1"
  // Six parameters: BIGINT -2, NULL (bit 1 of the bitmap), VAR_STRING,
  // BLOB, TINY 1, NEWDECIMAL.
  let six = b"\x17\x08\x00\x00\x00\x00\x01\x00\x00\x00\x02\x01\x08\x00\x06\x00\xfd\x00\xfc\x00\x01\x00\xf6\x00\xfe\xff\xff\xff\xff\xff\xff\xff\x08O'Reilly\x02\x00\x01\x01\x0512.50"
  // Nine parameters take two bytes of bitmap: the first and the last NULL.
  let nine = b"\x17\x09\x00\x00\x00\x00\x01\x00\x00\x00\x01\x01\x01\x06\x00\x01\x00\x01\x00\x01\x00\x01\x00\x01\x00\x01\x00\x01\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00"
  let none = b"\x17\x0a\x00\x00\x00\x00\x01\x00\x00\x00"
  let client = session([
    (command(0x16, sql), reply([b"\x00\x07\x00\x00\x00\x01\x00\x01\x00\x00\x00\x00", column_of("?", 253, 0, 0, 63, 0), eof(), column_of("a", 3, 11, 0, 63, 0), eof()])),
    (frames(one, 0), reply([b"\x01", column_of("a", 3, 11, 0, 63, 0), eof(), eof()])),
    (frames(six, 0), ok_packet(1)),
    (frames(nine, 0), ok_packet(1)),
    (frames(none, 0), ok_packet(1))
  ])?
  let statement = prepare(client, sql)?
  let found = execute(client, statement, [Some(Text(hostile))])?
  assert found.columns.len() == 1 && found.rows.is_empty()
  let stored = execute(client, Statement { id = 8, parameters = 6, columns = 0 }, [Some(Int(-2)), None, Some(Text("O'Reilly")), Some(Bytes(b"\x00\x01")), Some(Bool(true)), Some(Decimal("12.50"))])?
  assert stored.columns.is_empty() && stored.affected == 0
  let off = Some(Bool(false))
  _ = execute(client, Statement { id = 9, parameters = 9, columns = 0 }, [None, off, off, off, off, off, off, off, None])?
  _ = execute(client, Statement { id = 10, parameters = 0, columns = 0 }, [])?
}

test "a binary result set decodes every column type to the value the text protocol gives" {
  let client = session([(frames(b"\x17\x07\x00\x00\x00\x00\x01\x00\x00\x00", 0), typed_reply(true))])?
  let result = execute(client, Statement { id = 7, parameters = 0, columns = 31 }, [])?
  assert is_typed(result)
}

test "the NULL bitmap of a binary row starts at its third bit" {
  // Two columns, the second NULL: bit 3 of the one bitmap byte.
  let pair = reply([b"\x02", column_of("a", 3, 11, 0, 63, 0), column_of("b", 253, 40, 0, 45, 0), eof(), b"\x00\x08\x2a\x00\x00\x00", eof()])
  // Seven columns take two bytes of bitmap: the seventh is bit 0 of the second.
  let a = column_of("a", 1, 4, 0, 63, 0)
  let seven = reply([b"\x07", a, a, a, a, a, a, a, eof(), b"\x00\x00\x01\x01\x02\x03\x04\x05\x06", eof()])
  let run = b"\x17\x07\x00\x00\x00\x00\x01\x00\x00\x00"
  let client = session([(frames(run, 0), pair), (frames(run, 0), seven)])?
  let statement = Statement { id = 7, parameters = 0, columns = 2 }
  assert execute(client, statement, [])?.rows == [[Some(Int(42)), None]]
  assert execute(client, statement, [])?.rows == [[Some(Int(1)), Some(Int(2)), Some(Int(3)), Some(Int(4)), Some(Int(5)), Some(Int(6)), None]]
  assert binary_row([Some(b"\x2a\x00\x00\x00"), None]) == b"\x00\x08\x2a\x00\x00\x00"
}

test "a binary row out of shape is refused: no header, cut, too long, an unknown type, no number, an odd date" {
  let run = b"\x17\x07\x00\x00\x00\x00\x01\x00\x00\x00"
  let statement = Statement { id = 7, parameters = 0, columns = 1 }
  let whole = column_of("a", 3, 11, 0, 63, 0)
  let headless = session([(frames(run, 0), reply([b"\x01", whole, eof(), b"\x01\x00\x2a\x00\x00\x00", eof()]))])?
  assert execute(headless, statement, []) == Err(Malformed("a binary row without its header"))
  assert shut(headless)
  let cut = session([(frames(run, 0), reply([b"\x01", whole, eof(), b"\x00\x00\x2a\x00\x00", eof()]))])?
  assert execute(cut, statement, []) == Err(Malformed(SHORT))
  let long = session([(frames(run, 0), reply([b"\x01", whole, eof(), b"\x00\x00\x2a\x00\x00\x00\x00", eof()]))])?
  assert execute(long, statement, []) == Err(Malformed("a row longer than its columns"))
  let unknown = session([(frames(run, 0), reply([b"\x01", column_of("a", 99, 4, 0, 63, 0), eof(), b"\x00\x00\x2a", eof()]))])?
  assert execute(unknown, statement, []) == Err(Unsupported("column type 99"))
  assert describe(Unsupported("column type 99")) == "column type 99 is not supported"
  assert shut(unknown)
  let infinite = session([(frames(run, 0), reply([b"\x01", column_of("a", 5, 22, 0, 63, 31), eof(), b"\x00\x00\x00\x00\x00\x00\x00\x00\xf0\x7f", eof()]))])?
  assert execute(infinite, statement, []) == Err(Malformed("a floating-point value that is no number"))
  let odd = session([(frames(run, 0), reply([b"\x01", column_of("a", 10, 10, 128, 63, 0), eof(), b"\x00\x00\x05\xe8\x07\x02\x1d\x17", eof()]))])?
  assert execute(odd, statement, []) == Err(Malformed("a date or a time of no known length"))
  let bare = session([(frames(run, 0), reply([b"\x01", whole, eof(), b"\x00", eof()]))])?
  assert execute(bare, statement, []) == Err(Malformed(SHORT))
}

test "execute with another number of parameters than the statement has sends nothing and keeps the connection" {
  let client = session([(frames(b"\x0e", 0), ok_packet(1))])?
  let statement = Statement { id = 7, parameters = 2, columns = 1 }
  assert execute(client, statement, [Some(Int(1))]) == Err(WrongParameterCount(2, 1))
  assert execute(client, statement, []) == Err(WrongParameterCount(2, 0))
  assert describe(WrongParameterCount(2, 1)) == "1 parameters for a statement with 2"
  assert ping(client) == Ok(())
}

test "a server error answers execute and keeps the connection; close sends the statement's id and reads no reply" {
  let run = b"\x17\x07\x00\x00\x00\x00\x01\x00\x00\x00"
  let (stream, counts) = counted([
    (frames(run, 0), reply([err_payload(1243, "HY000", "Unknown prepared statement handler (7) given to mysqld_stmt_execute")])),
    (b"\x05\x00\x00\x00\x19\x07\x00\x00\x00", Bytes.empty()),
    (frames(b"\x0e", 0), ok_packet(1))
  ])?
  let client = Client { stream }
  let statement = Statement { id = 7, parameters = 0, columns = 1 }
  assert execute(client, statement, []) == Err(Server(ServerError { code = 1243, sql_state = "HY000", message = "Unknown prepared statement handler (7) given to mysqld_stmt_execute" }))
  assert close(client, statement) == Ok(())
  assert ping(client) == Ok(())
  assert quit(client) == Ok(())
  assert counts.receive() == Some(1 + 4)
}

// ---- tests: several connections ----------------------------------------------

// The reply to `SELECT 1`: one BIGINT column, one row.
test fn one_row() -> Bytes = reply([b"\x01", column_of("1", 8, 2, 129, 63, 0), eof(), text_row([Some(b"1")]), eof()])

test fn is_one(outcome: Outcome<ResultSet>) -> Bool = match outcome {
  Ok(result) => result.rows == [[Some(Int(1))]]
  Err(_) => false
}

test fn none_free<T: ByteStream>(pool: Pool<T>) -> Bool = match checkout(pool) {
  Err(NoConnection) => true
  _ => false
}

test fn asks(pool: Pool<PipeStream>, done: Sender<Bool>) -> Result<Unit, IoError> {
  done.send(is_one(pool_query(pool, "SELECT 1")))
  Ok(())
}

test "a pool hands each connection to one caller at a time and waits no longer than its wait" {
  let first = session([(frames(b"\x0e", 0), ok_packet(1)), (frames(b"\x01", 0), Bytes.empty())])?
  let second = session([(frames(b"\x0e", 0), err_packet(1, 1053, "08S01", "Server shutdown in progress"))])?
  let pool = pool_of([first, second], 50 ms)
  let a = checkout(pool)?
  let b = checkout(pool)?
  assert none_free(pool)
  assert describe(NoConnection) == "no connection of the pool was free in time"
  assert ping(a) == Ok(())
  assert ping(b) == Err(Server(ServerError { code = 1053, sql_state = "08S01", message = "Server shutdown in progress" }))
  checkin(pool, a)
  let again = checkout(pool)?
  assert none_free(pool)
  checkin(pool, again)
  checkin(pool, b)
  // A pool that is full quits the connection it is handed.
  let third = session([(frames(b"\x01", 0), Bytes.empty())])?
  checkin(pool, third)
  assert shut(third)
  quit_idle(pool)
  assert shut(a) && shut(b)
  assert none_free(pool)
}

test "a pooled statement returns its connection after a result and after a server error, and a failed connection is taken out" {
  let client = session([
    (command(3, "SELECT 1"), one_row()),
    (command(3, "SELEC"), reply([err_payload(1064, "42000", "near 'SELEC'")])),
    (command(3, "SELECT 1"), frames(b"\x01", 5))
  ])?
  let pool = pool_of([client], 50 ms)
  assert is_one(pool_query(pool, "SELECT 1"))
  assert pool_query(pool, "SELEC") == Err(Server(ServerError { code = 1064, sql_state = "42000", message = "near 'SELEC'" }))
  assert pool_query(pool, "SELECT 1") == Err(OutOfOrder(1, 5))
  assert shut(client)
  assert pool_query(pool, "SELECT 1") == Err(NoConnection)
  // A new connection takes the place of the failed one.
  checkin(pool, session([(command(3, "SELECT 1"), one_row())])?)
  assert is_one(pool_query(pool, "SELECT 1"))
}

test "a pooled statement with parameters is prepared, executed and closed on one connection" {
  let sql = "SELECT a FROM t WHERE b = ?"
  let ready = reply([b"\x00\x07\x00\x00\x00\x01\x00\x01\x00\x00\x00\x00", column_of("?", 253, 0, 0, 63, 0), eof(), column_of("a", 3, 11, 0, 63, 0), eof()])
  let run = frames(b"\x17\x07\x00\x00\x00\x00\x01\x00\x00\x00\x00\x01\x08\x00\x05\x00\x00\x00\x00\x00\x00\x00", 0)
  let closed = b"\x05\x00\x00\x00\x19\x07\x00\x00\x00"
  let client = session([
    (command(0x16, sql), ready),
    (run, reply([b"\x01", column_of("a", 3, 11, 0, 63, 0), eof(), b"\x00\x00\x2a\x00\x00\x00", eof()])),
    (closed, Bytes.empty()),
    (command(0x16, sql), ready),
    (run, reply([err_payload(1317, "70100", "Query execution was interrupted")])),
    (closed, Bytes.empty()),
    (command(0x16, sql), ready),
    (closed, Bytes.empty()),
    (command(0x16, "SELEC ?"), reply([err_payload(1064, "42000", "near 'SELEC'")])),
    (frames(b"\x0e", 0), ok_packet(1))
  ])?
  let pool = pool_of([client], 50 ms)
  assert pool_execute(pool, sql, [Some(Int(5))])?.rows == [[Some(Int(42))]]
  assert pool_execute(pool, sql, [Some(Int(5))]) == Err(Server(ServerError { code = 1317, sql_state = "70100", message = "Query execution was interrupted" }))
  assert pool_execute(pool, sql, []) == Err(WrongParameterCount(1, 0))
  assert pool_execute(pool, "SELEC ?", [Some(Int(5))]) == Err(Server(ServerError { code = 1064, sql_state = "42000", message = "near 'SELEC'" }))
  let back = checkout(pool)?
  assert ping(back) == Ok(())
}

test "tasks share the connections of a pool: with one connection each waits for the one before" {
  let client = session([(command(3, "SELECT 1"), one_row()), (command(3, "SELECT 1"), one_row()), (command(3, "SELECT 1"), one_row())])?
  let pool = pool_of([client], 5 seconds)
  let (done, results) = Channel.bounded(3)
  spawn asks(pool, done)
  spawn asks(pool, done)
  spawn asks(pool, done)
  assert results.receive() == Some(true)
  assert results.receive() == Some(true)
  assert results.receive() == Some(true)
}

test "an empty pool has no connection until one is handed to it" {
  let none: List<Client<PipeStream>> = []
  let pool = pool_of(none, 10 ms)
  assert pool_query(pool, "SELECT 1") == Err(NoConnection)
  checkin(pool, session([(command(3, "SELECT 1"), one_row())])?)
  assert is_one(pool_query(pool, "SELECT 1"))
}
