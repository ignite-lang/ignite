package std.protocol.telnet

import std.net.{ByteStream, Pipe, PipeStream, TcpStream, Endpoint}
import std.io.IoError
import std.console.{Console, Reply, Action, CommandConsole, ConsoleCommands, console_of}
import std.policy.{Restart, DrainRollout}
import std.control.{Machine, Supervisor, ProbeScheduler}
import std.sli.ProbeAttempt
import std.rfc.rfc854.{RFC854}
import std.rfc.rfc855.{RFC855}

// Telnet over one byte stream (RFC 854): a Network Virtual Terminal with
// every option refused. Both roles are generic over the stream
// (`docs/slice.md` 18.6): a `TcpStream` in programs, a `PipeStream` in
// tests. Both decode the incoming byte stream with `decode_within`, one
// byte at a time, so commands split across reads are handled.
// The component kinds `TelnetServer`, `TelnetClient` and `TelnetPrompt`
// (`docs/slice.md` 14.5, 16.8) hold the accept loop, the client's exit codes
// and one probe attempt in their `main` fns. `await_prompt` is the probe's
// side of a session: a protocol has the roles `serve` and `connect` only
// (4.2), so it is a module fn beside the protocol.
//
// Claims (`docs/slice.md` 19.7): RFC 854 and RFC 855 for every party,
// since both roles are implemented. The statuses below are the MUST-class
// requirements no declaration satisfies; the `satisfies` clauses are on
// `decode_within`, `session`, `answer_line`, `render`, `encode_input`,
// `apply_key`, `interrupt` and `edit_input`, the `verifies` clauses on the
// tests. The server sends IAC GA whenever it waits for input after output
// (RFC 854 p5); the Synch (p8 to p10) is IAC DM sent as TCP urgent data
// through the stream's `write_urgent`, and a session that finds urgent
// data pending (`urgent_pending`) discards data up to the Data Mark.

type IoResult<T> = Result<T, IoError>

protocol Telnet conforms [RFC854, RFC855] {
  not_applicable RFC854.RP4_2 "a hope about the design of options; Telnet defines no option"
  not_applicable RFC854.RP6_3 "terminal-to-terminal communication; Telnet connects a server and a client"
  not_applicable RFC855.RP1_2 "addresses the assignment of option codes; Telnet assigns none"
  not_applicable RFC855.RP1_3 "addresses the assignment of option codes; Telnet assigns none"
  not_applicable RFC855.RP2_1 "addresses the documentation of an option; Telnet defines no option"
  not_applicable RFC855.RP3_1 "addresses designers of options with subnegotiation; Telnet defines no option"
  not_applicable RFC855.RP3_2 "Telnet sends no subnegotiation: every option is refused, so no option parameter is sent"

  // Server role: show the console's prompt followed by IAC GA, pass each
  // input line to the console and send its reply, the next prompt and
  // IAC GA. A Synch (urgent data ending in IAC DM) discards the data
  // before its Data Mark. The session ends on the console's Close
  // action, end of input, IAC IP, an overlong line or a subnegotiation
  // longer than `limits.maximum_subnegotiation`. A client silent for
  // `limits.idle_timeout` reads as end of input, so an abandoned
  // connection does not hold its task forever.
  fn serve<S: ByteStream>(stream: S, limits: SessionLimits, application: Console) -> IoResult<Unit> requires [
    stream.read, stream.write
  ] {
    stream.set_idle_timeout(limits.idle_timeout.to_ms())?
    let result = session(stream, limits, application)
    _ = stream.close()
    result
  }

  // Client role: the server's text, with Telnet commands removed, CR NUL
  // as a carriage return and every other line end as LF (`print_byte`),
  // goes to standard output. Standard input goes to the server:
  // from a terminal through the local line editor (`edit_input`), otherwise
  // as NVT lines (`forward_input`). Ends with Ok when the server closes the
  // connection, with Err on an overlong subnegotiation.
  fn connect<S: ByteStream>(stream: S) -> IoResult<Unit> requires [
    stream.read, stream.write, stdin.read, stdin.mode, stdout.write, process.exit
  ] {
    if Stdin.is_terminal()? {
      Stdin.set_raw(true)?
      spawn edit_input(stream)
    } else {
      spawn forward_input(stream)
    }
    var state = Ground
    loop {
      match stream.read(4096)? {
        Eof => {
          if state == CarriageReturn {
            Stdout.write_all(b"\n")?
          }
          Stdin.set_raw(false)?
          return Ok(())
        }
        Data(bytes) => {
          var out = Bytes.empty()
          for b in bytes {
            let (next, event, printed) = print_byte(state, b)
            state = next
            out.append(printed)
            match event {
              Answer(answer) => stream.write_all(answer)?
              SubnegotiationTooLong => {
                Stdout.write_all(out)?
                Stdin.set_raw(false)?
                return Err(IoError.new("subnegotiation longer than {MAXIMUM_SUBNEGOTIATION} bytes"))
              }
              _ => {}
            }
          }
          if !out.is_empty() {
            Stdout.write_all(out)?
          }
        }
      }
    }
  }
}

// Command bytes, RFC 854.
const IAC: Byte = 255
const DONT: Byte = 254
const DO: Byte = 253
const WONT: Byte = 252
const WILL: Byte = 251
const SB: Byte = 250
const GA: Byte = 249
const AYT: Byte = 246
const IP: Byte = 244
const DM: Byte = 242
const SE: Byte = 240

// The longest subnegotiation the client and the probe skip, in bytes. A
// longer one fails them. The server's bound is its session limit
// `maximum_subnegotiation`, 1 KiB by default.
const MAXIMUM_SUBNEGOTIATION: Int = 1024

// The Telnet dialect a server speaks (design section 11.3). Each field is a
// closed set written as text in slice 10; the defaults are what `Telnet`
// implements: a Network Virtual Terminal, Q-method negotiation, every
// option refused, NVT ASCII.
type TelnetProfile {
  baseline: Text = "nvt"
  negotiation: Text = "q_method"
  unsupported_options: Text = "refuse"
  character_encoding: Text = "nvt_ascii"
}

// Limits of a server's sessions, Telnet's limits record (`docs/slice.md`
// 18.5). `Telnet.serve` reads `idle_timeout` and `maximum_subnegotiation`;
// the other fields are declared and validated, without behaviour.
type SessionLimits {
  maximum: Int = 1000
  idle_timeout: Duration = 10 minutes
  input_buffer: ByteSize = 16 KiB
  output_buffer: ByteSize = 64 KiB
  slow_reader_deadline: Duration = 30 seconds
  maximum_subnegotiation: ByteSize = 1 KiB
}

// A Telnet server over a listener, serving a declared console. The
// executable binds the listener, accepts connections and runs
// `Telnet.serve` under `sessions` in one task per connection; a session
// that fails ends its task and the server goes on accepting
// (`docs/slice.md` section 14.8).
type TelnetServer {
  listener: TcpListener
  application: CommandConsole
  executable: Text
  protocol: TelnetProfile = TelnetProfile {}
  sessions: SessionLimits = SessionLimits {}
  recovery: Restart = Restart {}
  rollout: DrainRollout = DrainRollout {}
}

fn TelnetServer.main(self: TelnetServer) -> IoResult<Unit> {
  let console = console_of(self.application)
  loop {
    let stream = self.listener.accept()?
    spawn Telnet.serve(stream, self.sessions, console)
  }
}

// The supervisor of a server under `ignite run` (`docs/slice.md` 16.7):
// restarts under `recovery`; the `rollout` policy gives the member its
// rollout machine through `std.control.companions` (16.12).
fn TelnetServer.machine(self: TelnetServer, id: Text) -> Machine = Machine.Supervise(Supervisor {
  id = "{id}.supervisor"
  member = id
  restart = self.recovery
  rollout = Some(self.rollout)
})

// The declaration rules of a server (E120): session limits that admit a
// session. The policies are validated as declarations of their own.
fn TelnetServer.validate(self: TelnetServer) -> List<Text> = session_reasons(self.sessions)

fn session_reasons(sessions: SessionLimits) -> List<Text> {
  var reasons = []
  if sessions.maximum < 1 {
    reasons.push("sessions.maximum must be at least 1, found {sessions.maximum}")
  }
  if sessions.idle_timeout <= 0 ms {
    reasons.push("sessions.idle_timeout must be positive, found {sessions.idle_timeout.debug()}")
  }
  reasons
}

test "a server refuses session limits that admit no session" {
  assert session_reasons(SessionLimits {}) == []
  assert session_reasons(SessionLimits { maximum = 0 }) == ["sessions.maximum must be at least 1, found 0"]
  assert session_reasons(SessionLimits { idle_timeout = 0 ms }) == ["sessions.idle_timeout must be positive, found 0 ns"]
}

// The probe's side of a session (`docs/slice.md` 16.8): read the server's
// bytes, answer option negotiation as `connect` does, and return the text
// before `expected_prompt` once the text ends with it; line ends arrive as
// LF. `Err` when the server closes the stream first, on an overlong
// subnegotiation, or when a read fails (the stream's idle timeout).
fn await_prompt(stream: TcpStream, expected_prompt: Text) -> IoResult<Text> {
  let prompt = expected_prompt.to_bytes()
  var state = Ground
  var text = Bytes.empty()
  loop {
    match stream.read(4096)? {
      Eof => return Err(IoError.new("connection closed before the prompt"))
      Data(bytes) => {
        for b in bytes {
          let (next, event) = decode(state, b)
          state = next
          match event {
            Literal(c) => text.push(c)
            EndOfLine => text.push(b'\n')
            Answer(answer) => stream.write_all(answer)?
            SubnegotiationTooLong => return Err(IoError.new("subnegotiation longer than {MAXIMUM_SUBNEGOTIATION} bytes"))
            _ => {}
          }
        }
        if ends_with_bytes(text, prompt) {
          return Ok(text.slice(0, text.len() - prompt.len()).to_text())
        }
      }
    }
  }
}

fn ends_with_bytes(bytes: Bytes, suffix: Bytes) -> Bool {
  if suffix.len() > bytes.len() {
    return false
  }
  let start = bytes.len() - suffix.len()
  var i = 0
  while i < suffix.len() {
    if bytes.at(start + i) != suffix.at(i) {
      return false
    }
    i = i + 1
  }
  true
}

test "ends_with_bytes compares the suffix" {
  assert ends_with_bytes(b"terminal> ", b"> ")
  assert ends_with_bytes(b"> ", b"> ")
  assert !ends_with_bytes(b">", b"> ")
  assert !ends_with_bytes(b"terminal>", b"> ")
  assert ends_with_bytes(b"x", Bytes.empty())
}

// A probe of a running Telnet server (design section 11.3), a component
// with two entries for `ignite run` (`docs/slice.md` 16.8): `main` runs one
// attempt as a short-lived process, and `machine` returns the scheduler
// that dispatches one such process per slot. Its outcome type,
// `ProbeAttempt`, and the predicates a contract names in `good`
// (`prompt_received_before_timeout`, `prompt_received_within_threshold`)
// live in `std.sli` (16.6, `docs/slice.md` 22.3).
//
// Connect to the server every `interval`, wait up to `timeout` for
// `expected_prompt`, and report each attempt on `attempts`. `executable`
// defaults to the component name (6.1); `ignite build` emits it like any
// kind with `main` (O42).
type TelnetPrompt {
  target: Ref<TelnetServer>
  interval: Duration = 10 seconds
  timeout: Duration = 2 seconds
  expected_prompt: Text
  close_after_probe: Bool = true
  attempts: Signal<ProbeAttempt>
  executable: Text
}

// One attempt (16.8): resolve the target through the run's `--ref`
// binding, connect, read through the option negotiation until the prompt,
// measure the latency from the start of the attempt, close if asked, and
// print one line, the model encoding of the `ProbeAttempt` (15.4). A
// refused or reset connection, a closed stream before the prompt and a
// read past `timeout` are bad attempts (`received = false`) and exit 0.
// No `--ref` binding for the target, a failed idle-timeout setting or a
// failed write of the line exits 1; a malformed `--ref` exits 2 (16.9).
// The driver's deadline ends an attempt that hangs.
fn TelnetPrompt.main(self: TelnetPrompt) -> IoResult<Unit> {
  let started = Clock.monotonic()
  let endpoint = Endpoint.of(self.target)?
  let attempt = match TcpStream.connect(endpoint.address, endpoint.port) {
    Err(_) => ProbeAttempt { received = false, latency = Clock.monotonic() - started }
    Ok(stream) => {
      stream.set_idle_timeout(self.timeout.to_ms())?
      let received = match await_prompt(stream, self.expected_prompt) {
        Ok(_) => true
        Err(_) => false
      }
      let latency = Clock.monotonic() - started
      if self.close_after_probe {
        _ = stream.close()
      }
      ProbeAttempt { received, latency }
    }
  }
  Stdout.write_all(encode_attempt(attempt).to_bytes())
}

// The scheduler of this probe (16.8): one attempt per `interval` from the
// target's first readiness, each with a deadline of `timeout`.
fn TelnetPrompt.machine(self: TelnetPrompt, id: Text) -> Machine = Machine.Schedule(ProbeScheduler {
  id = "{id}.scheduler"
  member = id
  target = self.target.to_text()
  signal = self.attempts.to_text()
  interval = self.interval
  timeout = self.timeout
})

// The declaration rules of a probe (E120): a prompt to wait for. The
// timing rules (positive `interval` and `timeout`, `timeout < interval`)
// are the compiler's E123.
fn TelnetPrompt.validate(self: TelnetPrompt) -> List<Text> = if self.expected_prompt.is_empty() {
  ["expected_prompt is empty: every connection would count as a received prompt"]
} else {
  []
}

// The model encoding (15.4) of an attempt, keys in byte order, one line:
// what the driver decodes with the signal's element type.
fn encode_attempt(attempt: ProbeAttempt) -> Text =
  "{{\"fields\":{{\"latency\":{{\"ns\":{attempt.latency.to_ns()},\"type\":\"Duration\"}},\"received\":{attempt.received}}},\"type\":\"std.sli.ProbeAttempt\"}}\n"

// Whether `text` starts with the probe's expected prompt.
fn prompt_seen(expected_prompt: Text, text: Text) -> Bool = text.starts_with(expected_prompt)

test "the prompt is seen at the start of the server's text" {
  assert prompt_seen("terminal> ", "terminal> ")
  assert prompt_seen("terminal> ", "terminal> help")
  assert !prompt_seen("terminal> ", "terminal>")
  assert !prompt_seen("terminal> ", "  terminal> ")
}

test "an attempt is printed in the model encoding" {
  assert encode_attempt(ProbeAttempt { received = true, latency = 12 ms }) == "{{\"fields\":{{\"latency\":{{\"ns\":12000000,\"type\":\"Duration\"}},\"received\":true}},\"type\":\"std.sli.ProbeAttempt\"}}\n"
  assert encode_attempt(ProbeAttempt { received = false, latency = 2 seconds }) == "{{\"fields\":{{\"latency\":{{\"ns\":2000000000,\"type\":\"Duration\"}},\"received\":false}},\"type\":\"std.sli.ProbeAttempt\"}}\n"
}

// A Telnet client of `target`: standard input and output become the
// session. Exit status 3 when connecting fails, 4 when the session fails
// (`docs/slice.md` section 6.1).
type TelnetClient {
  target: Endpoint
  executable: Text
}

fn TelnetClient.main(self: TelnetClient) -> IoResult<Unit> {
  let stream = match TcpStream.connect(self.target.address, self.target.port) {
    Ok(stream) => stream
    Err(error) => return Err(error.with_exit_code(3))
  }
  match Telnet.connect(stream) {
    Ok(_) => Ok(())
    Err(error) => Err(error.with_exit_code(4))
  }
}

// The client role as a command handler (`std.cli.SessionHandler`, filled
// by `module("std.protocol.telnet")`).
fn connect(stream: TcpStream) -> IoResult<Unit> requires [
  stream.read, stream.write, stdin.read, stdin.mode, stdout.write, process.exit
] {
  Telnet.connect(stream)
}

test "the profile and the limits default to what Telnet implements" {
  let profile = TelnetProfile {}
  assert profile.baseline == "nvt"
  assert profile.negotiation == "q_method"
  assert profile.unsupported_options == "refuse"
  assert profile.character_encoding == "nvt_ascii"
  let limits = SessionLimits {}
  assert limits.maximum == 1000
  assert limits.idle_timeout == 10 minutes
  assert limits.input_buffer == 16 KiB
  assert limits.output_buffer == 64 KiB
  assert limits.slow_reader_deadline == 30 seconds
  assert limits.maximum_subnegotiation == 1 KiB
  assert SessionLimits { idle_timeout = 15 minutes }.idle_timeout.to_ms() == 900000
}

// Where the decoder is between two bytes.
enum Decoder {
  Ground,
  CarriageReturn,
  Interpret,
  Negotiation(Byte),
  Subnegotiation(Int),
  SubnegotiationInterpret(Int)
}

// What one byte means to the session.
enum Event {
  Nothing,
  Literal(Byte),
  EndOfLine,
  Answer(Bytes),
  AreYouThere,
  DataMark,
  Interrupt,
  SubnegotiationTooLong
}

// One byte of the incoming stream: the decoder's next state and the byte's
// event. CR LF, CR NUL, a lone CR and a lone LF end a line; IAC IAC is the
// data byte 255; IAC DM is the Data Mark of a Synch; DO is answered WONT
// and WILL is answered DONT; subnegotiation is skipped up to
// `MAXIMUM_SUBNEGOTIATION` bytes.
fn decode(state: Decoder, b: Byte) -> (Decoder, Event) = decode_within(state, b, MAXIMUM_SUBNEGOTIATION)

// `decode` with a subnegotiation skipped up to `maximum` bytes, counting
// the IAC of IAC SE; one byte more is `SubnegotiationTooLong`.
fn decode_within(state: Decoder, b: Byte, maximum: Int) -> (Decoder, Event) satisfies [
  RFC854.RP2_2, RFC854.RP2_5, RFC854.RP4_4, RFC854.RP7_1, RFC854.RP11_1, RFC854.RP11_3, RFC854.RP13_3,
  RFC854.RP12_4, RFC854.RP14_1, RFC855.RP2_3, RFC855.RP2_4
] = match (state, b) {
  (Ground, IAC) => (Interpret, Nothing)
  (Ground, b'\r') => (CarriageReturn, EndOfLine)
  (Ground, b'\n') => (Ground, EndOfLine)
  (Ground, _) => (Ground, Literal(b))
  (CarriageReturn, b'\n' | b'\0') => (Ground, Nothing)
  (CarriageReturn, _) => decode_within(Ground, b, maximum)
  (Interpret, IAC) => (Ground, Literal(IAC))
  (Interpret, WILL | WONT | DO | DONT) => (Negotiation(b), Nothing)
  (Interpret, SB) => (Subnegotiation(0), Nothing)
  (Interpret, AYT) => (Ground, AreYouThere)
  (Interpret, IP) => (Ground, Interrupt)
  (Interpret, DM) => (Ground, DataMark)
  (Interpret, _) => (Ground, Nothing)
  (Negotiation(DO), _) => (Ground, Answer([IAC, WONT, b]))
  (Negotiation(WILL), _) => (Ground, Answer([IAC, DONT, b]))
  (Negotiation(_), _) => (Ground, Nothing)
  (Subnegotiation(count), _) => if count + 1 > maximum {
    (Ground, SubnegotiationTooLong)
  } else if b == IAC {
    (SubnegotiationInterpret(count + 1), Nothing)
  } else {
    (Subnegotiation(count + 1), Nothing)
  }
  (SubnegotiationInterpret(_), SE) => (Ground, Nothing)
  (SubnegotiationInterpret(count), _) => (Subnegotiation(count), Nothing)
}

// `bytes` decoded from `state`: the state after them and their events,
// `Nothing` left out.
test fn feed(state: Decoder, bytes: Bytes) -> (Decoder, List<Event>) {
  var at = state
  var events = []
  for b in bytes {
    let (next, event) = decode(at, b)
    at = next
    match event {
      Nothing => {}
      _ => events.push(event)
    }
  }
  (at, events)
}

// The events of `bytes` decoded from `Ground`.
test fn events(bytes: Bytes) -> List<Event> = feed(Ground, bytes).1

// `count` copies of `b`.
test fn filled(count: Int, b: Byte) -> Bytes {
  var out = Bytes.empty()
  while out.len() < count {
    out.push(b)
  }
  out
}

test "data bytes are literals" {
  assert events(b"ab") == [Literal(b'a'), Literal(b'b')]
  assert events("é".to_bytes()) == [Literal(0xC3), Literal(0xA9)]
  assert events(b"") == []
  assert feed(Ground, b"x") == (Ground, [Literal(b'x')])
}

test "CR LF, CR NUL, a lone CR and a lone LF end one line" verifies [RFC854.RP11_3, RFC854.RP13_3] {
  assert events(b"a\r\nb") == [Literal(b'a'), EndOfLine, Literal(b'b')]
  assert events(b"a\r\0b") == [Literal(b'a'), EndOfLine, Literal(b'b')]
  assert events(b"a\nb") == [Literal(b'a'), EndOfLine, Literal(b'b')]
  assert events(b"a\rb") == [Literal(b'a'), EndOfLine, Literal(b'b')]
  assert events(b"\r\r\n") == [EndOfLine, EndOfLine]
  assert events(b"\n\n") == [EndOfLine, EndOfLine]
  assert events(b"\r\n\r\n") == [EndOfLine, EndOfLine]
  assert events([b'\r', IAC, IAC]) == [EndOfLine, Literal(IAC)]
}

test "a CR LF split across reads ends one line" {
  let (state, first) = feed(Ground, b"a\r")
  assert state == CarriageReturn
  assert first == [Literal(b'a'), EndOfLine]
  assert feed(state, b"\nb") == (Ground, [Literal(b'b')])
  assert feed(state, b"\0") == (Ground, [])
}

// One byte of the server's stream as the client role prints it: the
// decoder's next state, the byte's event and the bytes to print. A CR is
// printed once the next byte shows which line end it starts: CR NUL is a
// carriage return alone (RFC 854 p11), CR LF and a lone CR are LF; a CR
// that ends the stream is printed as LF by `connect`.
fn print_byte(state: Decoder, b: Byte) -> (Decoder, Event, Bytes) satisfies [RFC854.RP11_3, RFC854.RP13_3] {
  var out = Bytes.empty()
  if state == CarriageReturn {
    out.push(if b == b'\0' { b'\r' } else { b'\n' })
  }
  let (next, event) = decode(state, b)
  match event {
    Literal(c) => out.push(c)
    EndOfLine => {
      if next != CarriageReturn {
        out.push(b'\n')
      }
    }
    _ => {}
  }
  (next, event, out)
}

// What the client prints for `parts`, read one after another.
test fn printed(parts: List<Bytes>) -> Bytes {
  var state = Ground
  var out = Bytes.empty()
  for part in parts {
    for b in part {
      let (next, _, bytes) = print_byte(state, b)
      state = next
      out.append(bytes)
    }
  }
  if state == CarriageReturn {
    out.push(b'\n')
  }
  out
}

test "the client prints CR NUL as a carriage return and every other line end as LF" verifies [RFC854.RP11_3, RFC854.RP13_3] {
  assert printed([b"a\r\0b"]) == b"a\rb"
  assert printed([b"a\r\nb"]) == b"a\nb"
  assert printed([b"a\rb"]) == b"a\nb"
  assert printed([b"a\nb"]) == b"a\nb"
  assert printed([b"\r\r\n\r\0"]) == b"\n\n\r"
  assert printed([b"a\r"]) == b"a\n"
  assert printed([b"a\r", b"\0b"]) == b"a\rb"
  assert printed([b"a\r", b"\nb"]) == b"a\nb"
  let doubled: Bytes = [b'\r', IAC, IAC, b'x']
  let literal: Bytes = [b'\n', IAC, b'x']
  assert printed([doubled]) == literal
  let negotiation: Bytes = [b'\r', IAC, DO, 1, b'x']
  assert printed([negotiation]) == b"\nx"
}

test "IAC IAC is the data byte 255" verifies [RFC854.RP14_1] {
  assert events([IAC, IAC]) == [Literal(255)]
  assert events([b'a', IAC, IAC, b'b']) == [Literal(b'a'), Literal(255), Literal(b'b')]
  assert events([IAC, IAC, IAC, IAC]) == [Literal(255), Literal(255)]
  let (state, first) = feed(Ground, [IAC])
  assert state == Interpret
  assert first == []
  assert feed(state, [IAC, b'x']) == (Ground, [Literal(255), Literal(b'x')])
}

test "DO is answered WONT and WILL is answered DONT" verifies [RFC854.RP2_2, RFC854.RP2_5, RFC855.RP2_3, RFC855.RP2_4] {
  assert events([IAC, DO, 1]) == [Answer([IAC, WONT, 1])]
  assert events([IAC, WILL, 3]) == [Answer([IAC, DONT, 3])]
  assert events([IAC, DONT, 1]) == []
  assert events([IAC, WONT, 1]) == []
  assert events([IAC, DO, IAC, b'x']) == [Answer([IAC, WONT, IAC]), Literal(b'x')]
  assert events([IAC, WILL, b'\r', b'x']) == [Answer([IAC, DONT, b'\r']), Literal(b'x')]
  // RFC 855: the refused option's parameters are skipped up to IAC SE.
  assert events([IAC, WILL, 24, IAC, SB, 24, 1, IAC, SE, b'a']) == [Answer([IAC, DONT, 24]), Literal(b'a')]
}

test "a negotiation split across reads is answered once complete" {
  let (after_iac, none) = feed(Ground, [b'a', IAC])
  assert none == [Literal(b'a')]
  let (after_do, nothing) = feed(after_iac, [DO])
  assert after_do == Negotiation(DO)
  assert nothing == []
  assert feed(after_do, [24, b'b']) == (Ground, [Answer([IAC, WONT, 24]), Literal(b'b')])
}

test "AYT and IP are reported and other commands ignored" verifies [RFC854.RP7_1, RFC854.RP7_2] {
  assert events([IAC, AYT]) == [AreYouThere]
  assert events([IAC, IP, b'x']) == [Interrupt, Literal(b'x')]
  assert events([IAC, 241, b'x']) == [Literal(b'x')]
  assert events([IAC, SE, b'x']) == [Literal(b'x')]
}

test "a subnegotiation is skipped up to IAC SE" verifies [RFC855.RP2_3, RFC855.RP2_4] {
  let terminal_type = [IAC, SB, 24, 0, b'x', b't', b'e', b'r', b'm', IAC, SE, b'a']
  assert feed(Ground, terminal_type) == (Ground, [Literal(b'a')])
  assert events([IAC, SB, 1, IAC, IAC, 2, IAC, SE, b'a']) == [Literal(b'a')]
  assert events([IAC, SB, b'\r', b'\n', IAC, SE]) == []
  let (state, none) = feed(Ground, [IAC, SB, 1, 2])
  assert state == Subnegotiation(2)
  assert none == []
  assert feed(state, [IAC]) == (SubnegotiationInterpret(3), [])
  assert feed(SubnegotiationInterpret(3), [SE, b'b']) == (Ground, [Literal(b'b')])
  // RFC 855: after a subnegotiation the option is still refused by WON'T.
  assert events([IAC, SB, 24, 1, IAC, SE, IAC, DO, 24, b'a']) == [Answer([IAC, WONT, 24]), Literal(b'a')]
}

test "a subnegotiation is limited to 1024 bytes including the IAC of IAC SE" {
  var longest = [IAC, SB]
  longest.append(filled(1023, b'x'))
  longest.append([IAC, SE, b'a'])
  assert feed(Ground, longest) == (Ground, [Literal(b'a')])
  var full = [IAC, SB]
  full.append(filled(1024, b'x'))
  assert feed(Ground, full) == (Subnegotiation(1024), [])
  assert feed(Subnegotiation(1024), b"x") == (Ground, [SubnegotiationTooLong])
  assert feed(Subnegotiation(1024), [IAC]) == (Ground, [SubnegotiationTooLong])
  var over = [IAC, SB]
  over.append(filled(1025, b'x'))
  over.append(b"ab")
  assert feed(Ground, over) == (Ground, [SubnegotiationTooLong, Literal(b'a'), Literal(b'b')])
}

fn write_text<S: ByteStream>(stream: S, text: Text) -> IoResult<Unit> = stream.write_all(text.to_bytes())

// Each reply line as NVT data (`encode_input`: a line end inside it becomes
// CR LF, a lone CR becomes CR NUL), followed by CR LF.
fn render(reply: Reply) -> Bytes satisfies [RFC854.RP11_3, RFC854.RP11_4, RFC854.RP14_1] {
  var out = Bytes.empty()
  for line in reply.lines {
    out.append(encode_input(line.to_bytes()))
    out.append(b"\r\n")
  }
  out
}

// Standard input as NVT data: LF becomes CR LF, a CR before LF is dropped,
// any other CR becomes CR NUL, and the data byte 255 is doubled.
fn encode_input(bytes: Bytes) -> Bytes satisfies [RFC854.RP11_3, RFC854.RP11_4, RFC854.RP14_1] {
  var out = Bytes.empty()
  var i = 0
  while i < bytes.len() {
    let b = bytes.at(i)
    i = i + 1
    match b {
      b'\n' => out.append(b"\r\n")
      b'\r' => if i >= bytes.len() || bytes.at(i) != b'\n' {
        out.append(b"\r\0")
      }
      IAC => out.append([IAC, IAC])
      _ => out.push(b)
    }
  }
  out
}

test "render ends each reply line with CR LF" verifies [RFC854.RP11_3, RFC854.RP11_4] {
  assert render(Reply { lines = ["a", "", "é"] }) == "a\r\n\r\né\r\n".to_bytes()
  assert render(Reply { lines = [] }) == Bytes.empty()
}

test "a line end inside a reply line is sent as CR LF, a lone CR as CR NUL" verifies [RFC854.RP11_3, RFC854.RP11_4] {
  assert render(Reply { lines = ["a\nb", "c\rd", "e\r\nf"] }) == b"a\r\nb\r\nc\r\0d\r\ne\r\nf\r\n"
  assert render(Reply { lines = ["\r"] }) == b"\r\0\r\n"
}

test "the NVT printer codes BEL, BS, HT, VT and FF are passed as data" verifies [RFC854.RP11_1] {
  assert events([7, 8, 9, 11, 12]) == [Literal(7), Literal(8), Literal(9), Literal(11), Literal(12)]
}

test "encode_input writes NVT line ends and doubles IAC" verifies [RFC854.RP11_3, RFC854.RP11_4, RFC854.RP14_1] {
  assert encode_input(b"a\nb") == b"a\r\nb"
  assert encode_input(b"a\r\nb") == b"a\r\nb"
  assert encode_input(b"a\rb") == b"a\r\0b"
  assert encode_input(b"a\r") == b"a\r\0"
  assert encode_input(b"\r\r\n") == b"\r\0\r\n"
  assert encode_input([IAC]) == [IAC, IAC]
  assert encode_input([1, IAC, 2]) == [1, IAC, IAC, 2]
  assert encode_input(Bytes.empty()) == Bytes.empty()
  assert encode_input("é\n".to_bytes()) == "é\r\n".to_bytes()
}

test "encoded input decodes to the same lines" verifies [RFC854.RP13_3] {
  let input = [b'x', IAC, b'\r', b'y', b'\n', b'\n']
  let expected = [Literal(b'x'), Literal(IAC), EndOfLine, Literal(b'y'), EndOfLine, EndOfLine]
  assert events(encode_input(input)) == expected
}

// The client's input pump for piped standard input: standard input to the
// stream until end of input, then the stream's write half is closed.
fn forward_input<S: ByteStream>(stream: S) -> IoResult<Unit> {
  loop {
    match Stdin.read(4096)? {
      Eof => return stream.close()
      Data(bytes) => stream.write_all(encode_input(bytes))?
    }
  }
}

// Keys of the local line editor; the terminal is in raw mode.
const BACKSPACE: Byte = 8
const DELETE: Byte = 127
const CONTROL_C: Byte = 3
const CONTROL_D: Byte = 4
const ESCAPE: Byte = 29

// The local command prompt, shown after the escape key.
const COMMAND_PROMPT: Text = "\r\ntelnet> "
const COMMAND_HELP: Text = "close    end the session\n" +
  "quit     end the session\n" +
  "help     list these commands\n" +
  "(empty)  return to the session\n"

// What one key does to the line being edited.
enum Edit {
  Unchanged,
  Show(Bytes),
  Enter(Bytes),
  Send(Bytes),
  Interrupt,
  EndOfInput,
  Escape
}

// The line without its last UTF-8 character.
fn erase_last(line: Bytes) -> Bytes {
  var end = line.len() - 1
  while end > 0 && line.at(end) >= 128 && line.at(end) < 192 {
    end = end - 1
  }
  line.slice(0, end)
}

// One key pressed while `line` is being edited: the line after the key and
// what the key does. Printable bytes are added and echoed; backspace (8 or
// 127) erases the last character on screen; Enter (CR or LF) completes the
// line; Ctrl+D on a partial line hands it over to be sent without a line
// end, as a terminal in canonical mode does (RFC 854 p5: a local signal
// that the buffered data be sent at once); Ctrl+C, Ctrl+D on an empty line
// and Ctrl+] are reported; other control bytes are ignored.
fn apply_key(line: Bytes, b: Byte) -> (Bytes, Edit) satisfies [RFC854.RP5_3] = match b {
  b'\r' | b'\n' => (Bytes.empty(), Enter(line))
  BACKSPACE | DELETE => if line.is_empty() {
    (line, Unchanged)
  } else {
    (erase_last(line), Show(b"\x08 \x08"))
  }
  CONTROL_C => (Bytes.empty(), Interrupt)
  CONTROL_D => if line.is_empty() { (line, EndOfInput) } else { (Bytes.empty(), Send(line)) }
  ESCAPE => (line, Escape)
  0..=31 => (line, Unchanged)
  _ => {
    var longer = line
    longer.push(b)
    (longer, Show([b]))
  }
}

test "erase_last removes one UTF-8 character" {
  assert erase_last(b"ab") == b"a"
  assert erase_last(b"a") == Bytes.empty()
  assert erase_last("aé".to_bytes()) == b"a"
  assert erase_last("é".to_bytes()) == Bytes.empty()
  assert erase_last("x€".to_bytes()) == b"x"
  assert erase_last("😀😀".to_bytes()) == "😀".to_bytes()
}

test "apply_key edits the line" verifies [RFC854.RP7_2] {
  assert apply_key(b"ab", b'c') == (b"abc", Show(b"c"))
  assert apply_key(Bytes.empty(), 0xC3) == ([0xC3], Show([0xC3]))
  assert apply_key(b"ab", b'\r') == (Bytes.empty(), Enter(b"ab"))
  assert apply_key(b"ab", b'\n') == (Bytes.empty(), Enter(b"ab"))
  assert apply_key(Bytes.empty(), b'\r') == (Bytes.empty(), Enter(Bytes.empty()))
  assert apply_key(b"ab", BACKSPACE) == (b"a", Show(b"\x08 \x08"))
  assert apply_key("aé".to_bytes(), DELETE) == (b"a", Show(b"\x08 \x08"))
  assert apply_key(Bytes.empty(), BACKSPACE) == (Bytes.empty(), Unchanged)
  assert apply_key(b"ab", CONTROL_C) == (Bytes.empty(), Interrupt)
  assert apply_key(Bytes.empty(), CONTROL_D) == (Bytes.empty(), EndOfInput)
  assert apply_key(b"ab", ESCAPE) == (b"ab", Escape)
  assert apply_key(b"ab", 1) == (b"ab", Unchanged)
  assert apply_key(b"ab", 27) == (b"ab", Unchanged)
}

// The key hands the partial line over and starts an empty one; the editor
// sends it as NVT data with no line end (`partial`), so the server holds
// it until the rest of the line arrives.
test "Ctrl+D on a partial line sends it without a line end" verifies [RFC854.RP5_3] {
  assert apply_key(b"ab", CONTROL_D) == (Bytes.empty(), Send(b"ab"))
  assert apply_key([IAC], CONTROL_D) == (Bytes.empty(), Send([IAC]))
  assert apply_key(Bytes.empty(), CONTROL_D) == (Bytes.empty(), EndOfInput)
  assert partial(b"ab") == b"ab"
  assert partial([b'a', IAC]) == [b'a', IAC, IAC]
  let (_, edit) = apply_key(b"sta", CONTROL_D)
  let sent = match edit {
    Send(bytes) => partial(bytes)
    _ => Bytes.empty()
  }
  var input = sent
  input.append(b"tus\r\nbye\r\n")
  assert exchange(input)? == b"> \xff\xf9status\r\n> \xff\xf9bye\r\n"
}

// End of the client's input: the terminal back in its saved mode, the
// stream's write half closed. The session ends when the server closes.
fn finish_input<S: ByteStream>(stream: S) -> IoResult<Unit> {
  Stdin.set_raw(false)?
  stream.close()
}

// Run one local command. `quit` and `close` end the session at once,
// also when the server keeps the connection open: the stream is closed and
// the process exits with status 0, restoring the terminal.
fn run_command<S: ByteStream>(stream: S, command: Bytes) -> IoResult<Unit> {
  match command.to_text().trim() {
    "quit" | "close" => {
      _ = stream.close()
      Process.exit(0)?
    }
    "help" => Stdout.write_all(COMMAND_HELP.to_bytes())?
    "" => {}
    _ => Stdout.write_all(b"unknown command\n")?
  }
  Ok(())
}

// A partial line as the editor sends it: NVT data with no line end.
fn partial(line: Bytes) -> Bytes = encode_input(line)

// The interrupt of the client's Ctrl+C (RFC 854 p10): IAC IP, then the
// Synch, IAC DM sent as urgent data, so a server that is discarding or
// behind on its input still sees the IP. One send, the DM its urgent byte.
fn interrupt<S: ByteStream>(stream: S) -> IoResult<Unit> satisfies [RFC854.RP10_2] {
  stream.write_all([IAC, IP])?
  stream.write_urgent([IAC, DM])
}

// The client's input pump for a terminal in raw mode: a local line editor.
// Enter echoes LF (shown as CR LF by the terminal's output processing) and
// sends the line as NVT data with CR LF, Ctrl+D on a partial line sends it
// without a line end, Ctrl+C sends IAC IP and the Synch (`interrupt`),
// Ctrl+D on an empty line closes the stream's write half, and Ctrl+] reads
// one local command after the `telnet> ` prompt (`run_command`). Leaving
// the command prompt shows the session line edited so far again.
fn edit_input<S: ByteStream>(stream: S) -> IoResult<Unit> satisfies [RFC854.RP5_3, RFC854.RP7_2, RFC854.RP10_2] {
  var line = Bytes.empty()
  var command = Bytes.empty()
  var commanding = false
  loop {
    match Stdin.read(4096)? {
      Eof => return finish_input(stream)
      Data(bytes) => {
        for b in bytes {
          if commanding {
            let (next, edit) = apply_key(command, b)
            command = next
            match edit {
              Unchanged => {}
              Show(shown) => Stdout.write_all(shown)?
              Enter(entered) => {
                Stdout.write_all(b"\n")?
                run_command(stream, entered)?
                commanding = false
                Stdout.write_all(line)?
              }
              _ => {
                Stdout.write_all(b"\n")?
                command.clear()
                commanding = false
                Stdout.write_all(line)?
              }
            }
          } else {
            let (next, edit) = apply_key(line, b)
            line = next
            match edit {
              Unchanged => {}
              Show(shown) => Stdout.write_all(shown)?
              Enter(entered) => {
                Stdout.write_all(b"\n")?
                var sent = encode_input(entered)
                sent.append(b"\r\n")
                stream.write_all(sent)?
              }
              Send(line_so_far) => stream.write_all(partial(line_so_far))?
              Interrupt => interrupt(stream)?
              EndOfInput => return finish_input(stream)
              Escape => {
                Stdout.write_all(COMMAND_PROMPT.to_bytes())?
                commanding = true
              }
            }
          }
        }
      }
    }
  }
}

// The prompt as the server sends it: NVT data followed by IAC GA, since
// the server then waits for input (RFC 854 p5).
fn prompted(prompt: Text) -> Bytes {
  var out = encode_input(prompt.to_bytes())
  out.append([IAC, GA])
  out
}

// Answer one input line: the reply and, unless the console closed the
// session, the next prompt and IAC GA, in one write. Ok(false) when the
// console closed the session.
fn answer_line<S: ByteStream>(stream: S, application: Console, line: Bytes) -> IoResult<Bool> satisfies [
  RFC854.RP5_4, RFC854.RP11_3
] {
  let reply = application.respond(line.to_text())
  var out = render(reply)
  match reply.action {
    Continue => {
      out.append(prompted(application.prompt))
      stream.write_all(out)?
      Ok(true)
    }
    Close => {
      stream.write_all(out)?
      Ok(false)
    }
  }
}

// The server's side of one session, `Telnet.serve` without the idle
// timeout and the close. The prompt and the answer to AYT are followed by
// IAC GA. Urgent data pending after a read starts a Synch (RFC 854 p9):
// the line so far is dropped, and data is discarded, while commands are
// still obeyed, up to the Data Mark. A read stops before the urgent byte,
// so every byte of a read that finds urgent data pending precedes it.
fn session<S: ByteStream>(stream: S, limits: SessionLimits, application: Console) -> IoResult<Unit> satisfies [
  RFC854.RP2_6, RFC854.RP5_4, RFC854.RP7_2, RFC854.RP11_3, RFC854.RP12_4
] {
  let maximum = limits.maximum_subnegotiation.to_int()
  stream.write_all(prompted(application.prompt))?
  var state = Ground
  var line = Bytes.empty()
  var discarding = false
  loop {
    match stream.read(4096)? {
      Eof => return Ok(())
      Data(bytes) => {
        if !discarding && stream.urgent_pending()? {
          discarding = true
          line.clear()
        }
        for b in bytes {
          let (next, event) = decode_within(state, b, maximum)
          state = next
          match event {
            Nothing => {}
            Literal(c) => if !discarding {
              line.push(c)
              if line.len() > application.maximum_line {
                write_text(stream, "line too long\r\n")?
                return Ok(())
              }
            }
            EndOfLine => if !discarding {
              if !answer_line(stream, application, line)? {
                return Ok(())
              }
              line.clear()
            }
            DataMark => {
              discarding = false
            }
            Answer(answer) => stream.write_all(answer)?
            AreYouThere => {
              var answer = b"[yes]\r\n"
              answer.append([IAC, GA])
              stream.write_all(answer)?
            }
            Interrupt | SubnegotiationTooLong => return Ok(())
          }
        }
      }
    }
  }
}

// A console that echoes each line and closes on `bye`.
test fn echo(line: Text) -> Reply = if line == "bye" {
  Reply { lines = ["bye"], action = Close }
} else {
  Reply { lines = [line] }
}

// Everything the server sends after `input` under `limits`, until it
// closes the stream, from `Telnet.serve` with the echo console and
// `maximum_line` over a pipe. The client gives up on a server silent for
// 5 s, so a session that does not close fails the test instead of hanging
// it.
test fn exchange_over_pipe(input: Bytes, limits: SessionLimits, maximum_line: Int) -> IoResult<Bytes> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  spawn Telnet.serve(server, limits, Console { prompt = "> ", respond = echo, maximum_line })
  client.write_all(input)?
  rest(client)
}

// Everything `client` reads until the end of the stream.
test fn rest(client: PipeStream) -> IoResult<Bytes> {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
}

// At least `count` bytes from `client`, fewer only at the end of the stream.
test fn read_at_least(client: PipeStream, count: Int) -> IoResult<Bytes> {
  var out = Bytes.empty()
  while out.len() < count {
    match client.read(4096)? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
  Ok(out)
}

// Flushes the task's pending writes as their own delivery and waits 50 ms,
// so the next write is a separate delivery the server reads on its own.
test fn pause() -> IoResult<Unit> {
  let (a, b) = Pipe.pair()
  a.set_idle_timeout(50)?
  _ = a.read(1)?
  _ = b.close()
  Ok(())
}

// `parts` written as separate deliveries to the echo console's server
// under `limits` and `maximum_line`, the client closing its write half
// after the last; everything the server sends. The client gives up on a
// server silent for 5 s.
test fn exchange_parts(parts: List<Bytes>, limits: SessionLimits, maximum_line: Int) -> IoResult<Bytes> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  spawn Telnet.serve(server, limits, Console { prompt = "> ", respond = echo, maximum_line })
  for part in parts {
    client.write_all(part)?
    pause()?
  }
  _ = client.close()
  rest(client)
}

// `exchange_over_pipe` with a line of at most 8 bytes.
test fn exchange_with(input: Bytes, limits: SessionLimits) -> IoResult<Bytes> = exchange_over_pipe(input, limits, 8)

// `exchange_with` under the default session limits.
test fn exchange(input: Bytes) -> IoResult<Bytes> = exchange_with(input, SessionLimits {})

test "the server answers each line and ends on the console's close" {
  assert exchange(b"hi\r\n\r\nbye\r\nlost\r\n")? == b"> \xff\xf9hi\r\n> \xff\xf9\r\n> \xff\xf9bye\r\n"
}

test "the server answers options and AYT between lines" verifies [RFC854.RP2_5, RFC854.RP2_6] {
  var input = [b'a', IAC, DO, 1, b'b', IAC, AYT, b'\r', 0, IAC, WILL, 3]
  input.append(b"bye\r\n")
  var expected = b"> \xff\xf9"
  expected.append([IAC, WONT, 1])
  expected.append(b"[yes]\r\n\xff\xf9ab\r\n> \xff\xf9")
  expected.append([IAC, DONT, 3])
  expected.append(b"bye\r\n")
  assert exchange(input)? == expected
}

test "the server closes on an overlong line, IAC IP and an overlong subnegotiation" verifies [RFC854.RP7_2] {
  assert exchange(b"12345678\r\n123456789")? == b"> \xff\xf912345678\r\n> \xff\xf9line too long\r\n"
  assert exchange([b'a', IAC, IP, b'b', b'\n'])? == b"> \xff\xf9"
  var long = [IAC, SB]
  long.append(filled(1025, b'x'))
  long.append(b"a\n")
  assert exchange(long)? == b"> \xff\xf9"
}

test "a pipe session answers IAC DO ECHO with IAC WONT ECHO" verifies [RFC854.RP2_5, RFC854.RP4_4] {
  var input = [IAC, DO, 1]
  input.append(b"hi\r\nbye\r\n")
  var expected = b"> \xff\xf9"
  expected.append([IAC, WONT, 1])
  expected.append(b"hi\r\n> \xff\xf9bye\r\n")
  assert exchange(input)? == expected
}

test "over a pipe IAC IAC is one data byte" verifies [RFC854.RP14_1] {
  let input = [IAC, IAC, IAC, IAC, 13, 10, IAC, IAC, IAC, IAC, IAC, IAC, 13, 10]
  var expected = b"> \xff\xf9"
  expected.append([0xEF, 0xBF, 0xBD, 0xEF, 0xBF, 0xBD, 0x0D, 0x0A])
  expected.append(b"> \xff\xf9line too long\r\n")
  assert exchange_over_pipe(input, SessionLimits {}, 2)? == expected
}

test "a session limit bounds the subnegotiation" {
  let limits = SessionLimits { maximum_subnegotiation = 16 bytes }
  var within = [IAC, SB]
  within.append(filled(15, b'x'))
  within.append([IAC, SE])
  within.append(b"bye\r\n")
  assert exchange_with(within, limits)? == b"> \xff\xf9bye\r\n"
  var over = [IAC, SB]
  over.append(filled(16, b'x'))
  over.append([IAC, SE])
  over.append(b"bye\r\n")
  assert exchange_with(over, limits)? == b"> \xff\xf9"
}

test "a pipe session ends on its idle timeout" {
  assert exchange_with(b"hi\r\n", SessionLimits { idle_timeout = 100 ms })? == b"> \xff\xf9hi\r\n> \xff\xf9"
}

// The client has no idle timeout and never closes, and its input is
// written before the server starts, so only the server's
// `limits.idle_timeout` can end the session: if it is ignored, the test
// hangs until `ignite test` kills it.
test "the Telnet idle timeout alone ends a pipe session" {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(0)?
  client.write_all(b"hi\r\n")?
  spawn Telnet.serve(server, SessionLimits { idle_timeout = 20 ms }, Console { prompt = "> ", respond = echo, maximum_line = 8 })
  assert rest(client)? == b"> \xff\xf9hi\r\n> \xff\xf9"
}

test "an IAC at the end of one delivery, its command in the next" {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  spawn Telnet.serve(server, SessionLimits {}, Console { prompt = "> ", respond = echo, maximum_line = 8 })
  assert read_at_least(client, 4)? == b"> \xff\xf9"
  var first = b"x\r\n"
  first.push(IAC)
  client.write_all(first)?
  assert read_at_least(client, 5)? == b"x\r\n> \xff\xf9"
  client.write_all([DO, 1])?
  assert read_at_least(client, 3)? == [IAC, WONT, 1]
  client.write_all(b"bye\r\n")?
  assert rest(client)? == b"bye\r\n"
}

test "IAC IAC split across deliveries is one data byte" verifies [RFC854.RP14_1] {
  var first = b"a"
  first.push(IAC)
  var second = [IAC]
  second.append(b"\r\nbye\r\n")
  var expected = b"> \xff\xf9a"
  expected.append([0xEF, 0xBF, 0xBD])
  expected.append(b"\r\n> \xff\xf9bye\r\n")
  assert exchange_parts([first, second], SessionLimits {}, 8)? == expected
}

test "CR at the end of one delivery, LF in the next, is one line end" {
  assert exchange_parts([b"hi\r", b"\nbye\r\n"], SessionLimits {}, 8)? == b"> \xff\xf9hi\r\n> \xff\xf9bye\r\n"
}

test "a lone CR ends a line" {
  assert exchange(b"a\rb\rbye\r")? == b"> \xff\xf9a\r\n> \xff\xf9b\r\n> \xff\xf9bye\r\n"
}

// The prompt and the reply each hold a lone CR and an LF; the session
// sends them as NVT data, so no CR is sent outside CR LF and CR NUL.
test "a session sends its prompt and replies as NVT data" verifies [RFC854.RP11_3] {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  let console = Console { prompt = "\r>\n", respond = |line| Reply { lines = ["x\ry"], action = Close }, maximum_line = 8 }
  spawn Telnet.serve(server, SessionLimits {}, console)
  client.write_all(b"hi\r\n")?
  assert rest(client)? == b"\r\0>\r\n\xff\xf9x\r\0y\r\n"
}

test "a subnegotiation at exactly the limit, split across three deliveries" {
  let limits = SessionLimits { maximum_subnegotiation = 16 bytes }
  var first = [IAC, SB]
  first.append(filled(8, b'x'))
  var second = filled(7, b'x')
  second.push(IAC)
  var third = [SE]
  third.append(b"bye\r\n")
  assert exchange_parts([first, second, third], limits, 8)? == b"> \xff\xf9bye\r\n"
  var over = filled(8, b'x')
  over.push(IAC)
  assert exchange_parts([first, over, third], limits, 8)? == b"> \xff\xf9"
}

test "the default subnegotiation limit is 1024 bytes over a pipe" {
  var within = [IAC, SB]
  within.append(filled(1023, b'x'))
  within.append([IAC, SE])
  within.append(b"bye\r\n")
  assert exchange(within)? == b"> \xff\xf9bye\r\n"
  var over = [IAC, SB]
  over.append(filled(1024, b'x'))
  over.append([IAC, SE])
  over.append(b"bye\r\n")
  assert exchange(over)? == b"> \xff\xf9"
}

test "a line of exactly maximum_line 4096 is answered, 4097 is too long" {
  var input = filled(4096, b'a')
  input.append(b"\r\n")
  input.append(filled(4097, b'b'))
  var expected = b"> \xff\xf9"
  expected.append(filled(4096, b'a'))
  expected.append(b"\r\n> \xff\xf9line too long\r\n")
  assert exchange_over_pipe(input, SessionLimits {}, 4096)? == expected
}

test "a client closing mid-line gets no answer for the partial line" {
  assert exchange_parts([b"hi\r\nhal"], SessionLimits {}, 8)? == b"> \xff\xf9hi\r\n> \xff\xf9"
}

test "await_prompt returns the text before each prompt and fails when the server closes" {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  client.set_idle_timeout(5000)?
  let server = listener.accept()?
  spawn Telnet.serve(server, SessionLimits {}, Console { prompt = "> ", respond = echo, maximum_line = 8 })
  assert await_prompt(client, "> ")? == ""
  var input = [IAC, DO, 1]
  input.append(b"hi\r\n")
  client.write_all(input)?
  assert await_prompt(client, "> ")? == "hi\n"
  client.write_all(b"bye\r\n")?
  let closed = match await_prompt(client, "> ") {
    Ok(_) => false
    Err(error) => error.message == "connection closed before the prompt"
  }
  assert closed
}

test "a telnet server runs a declared console, a client its session" {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let server = TelnetServer {
    listener = listener
    application = CommandConsole {
      implementation = ConsoleCommands { respond = echo }
      prompt = "> "
      maximum_line = 8 bytes
    }
    executable = "echod"
    sessions = SessionLimits { idle_timeout = 100 ms }
  }
  assert server.protocol.baseline == "nvt"
  assert server.recovery.maximum_attempts == 10
  assert server.rollout.on_deadline == "disconnect_remaining"
  let client = TelnetClient { target = Endpoint { address = "127.0.0.1", port = listener.local_port() }, executable = "tn" }
  assert client.target.port == listener.local_port()
  assert console_of(server.application).respond("x").lines == ["x"]
}

// RFC 854 p5: whenever the server has sent its output and waits for input
// it sends IAC GA: after the first prompt, after each later prompt and
// after the answer to AYT, never after a reply that closes the session.
test "the server sends IAC GA after each prompt and the AYT answer" verifies [RFC854.RP5_4] {
  var input = b"hi\r\n"
  input.append([IAC, AYT])
  input.append(b"bye\r\n")
  assert exchange(input)? == b"> \xff\xf9hi\r\n> \xff\xf9[yes]\r\n\xff\xf9bye\r\n"
  assert prompted("> ") == [b'>', b' ', IAC, GA]
  assert prompted("a\rb") == [b'a', b'\r', 0, b'b', IAC, GA]
}

// What `server` reads after the client's `interrupt`, read by read, with
// whether urgent data was pending after each read.
test fn after_interrupt_pipe() -> IoResult<List<(Bytes, Bool)>> {
  let (client, server) = Pipe.pair()
  server.set_idle_timeout(5000)?
  interrupt(client)?
  var reads = []
  while reads.len() < 2 {
    match server.read(4096)? {
      Eof => return Ok(reads)
      Data(bytes) => reads.push((bytes, server.urgent_pending()?))
    }
  }
  Ok(reads)
}

// `after_interrupt_pipe` over TCP.
test fn after_interrupt_tcp() -> IoResult<List<(Bytes, Bool)>> {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  let server = listener.accept()?
  server.set_idle_timeout(5000)?
  interrupt(client)?
  var reads = []
  while reads.len() < 2 {
    match server.read(4096)? {
      Eof => return Ok(reads)
      Data(bytes) => reads.push((bytes, server.urgent_pending()?))
    }
  }
  Ok(reads)
}

// RFC 854 p10: IAC IP followed by the Synch, IAC DM as urgent data. The
// first read stops before the urgent DM with urgent data still pending;
// the next read returns the DM and clears it.
test "an interrupt is IAC IP followed by the Synch" verifies [RFC854.RP10_2] {
  let expected: List<(Bytes, Bool)> = [([IAC, IP, IAC], true), ([DM], false)]
  assert after_interrupt_pipe()? == expected
  assert after_interrupt_tcp()? == expected
  assert events([IAC, IP, IAC, DM]) == [Interrupt, DataMark]
}

// The server's answers to `before`, a Synch and `after`, all sent before
// the session starts, over a pipe.
test fn synch_over_pipe(before: Bytes, after: Bytes) -> IoResult<Bytes> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  client.write_all(before)?
  client.write_urgent([IAC, DM])?
  client.write_all(after)?
  spawn Telnet.serve(server, SessionLimits {}, Console { prompt = "> ", respond = echo, maximum_line = 8 })
  rest(client)
}

// `synch_over_pipe` over TCP.
test fn synch_over_tcp(before: Bytes, after: Bytes) -> IoResult<Bytes> {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  client.set_idle_timeout(5000)?
  let server = listener.accept()?
  client.write_all(before)?
  client.write_urgent([IAC, DM])?
  client.write_all(after)?
  spawn Telnet.serve(server, SessionLimits {}, Console { prompt = "> ", respond = echo, maximum_line = 8 })
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
}

// RFC 854 p9 and p12: data before the Data Mark of a Synch is discarded,
// a partial line included, while commands in it are still obeyed (DO is
// refused); the line after the mark is answered. Without urgent data an
// IAC DM is only a mark, and nothing is discarded.
test "a Synch discards the data before its Data Mark" verifies [RFC854.RP12_4] {
  var before = b"lost\r\npar"
  before.append([IAC, DO, 1])
  var expected = b"> \xff\xf9"
  expected.append([IAC, WONT, 1])
  expected.append(b"bye\r\n")
  assert synch_over_pipe(before, b"bye\r\n")? == expected
  assert synch_over_tcp(before, b"bye\r\n")? == expected
  var plain = b"kept\r\n"
  plain.append([IAC, DM])
  plain.append(b"bye\r\n")
  assert exchange(plain)? == b"> \xff\xf9kept\r\n> \xff\xf9bye\r\n"
  assert events([b'a', IAC, DM, b'b']) == [Literal(b'a'), DataMark, Literal(b'b')]
}
