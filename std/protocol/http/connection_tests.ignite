package std.protocol.http.connection_tests

import std.net.{ByteStream, Pipe, PipeStream, TcpStream, TcpListener, Endpoint, Connection}
import std.text.*
import std.protocol.http.*

// The inline tests of `std.protocol.http`'s connection, holds, upgrades and
// oversized bodies (story `http-app-connection`, `docs/slice.md` 37), kept
// beside the module so that `std/protocol/http.ignite` stays under 3,000
// lines. The module declares nothing: its tests reach the server through
// the names `std.protocol.http` exports. None verifies a clause, since a
// clause counts for the protocols of its own module (19.5), and a test-only
// item is not exported (12.2), so the helpers these tests share with the
// tests of `std.protocol.http` are copied below, unchanged.

// ---- helpers shared with the tests of std.protocol.http -----------------

// A connected pair of pipe ends: the client and the server end. Each
// gives up on a peer silent for 5 s, so a session that does not close
// fails the test instead of hanging it.
test fn connected() -> IoResult<(PipeStream, PipeStream)> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  server.set_idle_timeout(5000)?
  Ok((client, server))
}

// Answers `<method> <path>?<query> <body>`; `/bad` gets a header with a
// line break, `/close` the header `Connection: Upgrade, Close`, `/gzip`
// the header `Transfer-Encoding: gzip`, `/forbidden` 403, `/bytes` the
// bytes 0 to 255.
test fn answer(state: Unit, request: Request) -> Response = if request.path == "/bad" {
  Response { status = 200, headers = [("X", "a\r\nb")] }
} else if request.path == "/forbidden" {
  status_response(403)
} else if request.path == "/bytes" {
  Response.bytes(200, "application/octet-stream", every_byte())
} else if request.path == "/gzip" {
  Response { status = 200, headers = [("Transfer-Encoding", "gzip")], body = "gzip" }
} else if request.path == "/close" {
  Response { status = 200, headers = [("connection", "Upgrade,\tClose ")], body = "closing" }
} else {
  Response.plain(200, "{request.method} {request.path}?{request.query} {request.body}")
}

// Everything `client` reads until the end of the stream.
test fn read_to_end<T: ByteStream>(client: T) -> IoResult<Text> requires [client.read] {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out.to_text())
      Data(bytes) => out.append(bytes)
    }
  }
}

// Everything `Http.serve` sends for `input` under `limits` until it
// closes the connection, over a pipe.
test fn served_with(input: Bytes, limits: HttpLimits) -> IoResult<Text> {
  let (client, server) = connected()?
  spawn Http.serve(server, limits, HttpApp { state = (), handle = answer })
  client.write_all(input)?
  read_to_end(client)
}

test fn reply(body: Text, connection: Text) -> Text {
  let length = body.len()
  "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {length}\r\nConnection: {connection}\r\n\r\n{body}"
}

// Flushes the task's pending writes as their own delivery and waits 50 ms,
// so the next write is a separate delivery the server reads on its own.
test fn pause() -> IoResult<Unit> {
  let (a, b) = Pipe.pair()
  a.set_idle_timeout(50)?
  _ = a.read(1)?
  _ = b.close()
  Ok(())
}

// A chunked POST of `/c` in HTTP/1.1 whose body after the head is `chunks`.
test fn chunked(chunks: Text) -> Bytes = "POST /c HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n{chunks}".to_bytes()

// The bytes 0 to 255 in order.
test fn every_byte() -> Bytes {
  var out = Bytes.empty()
  var value = 0
  while value < 256 {
    match value.to_byte() {
      Some(b) => out.push(b)
      None => {}
    }
    value = value + 1
  }
  out
}

// Reads from `client` until it holds at least `length` bytes.
test fn read_at_least<T: ByteStream>(client: T, length: Int) -> IoResult<Text> requires [client.read] {
  var out = Bytes.empty()
  while out.len() < length {
    match client.read(4096)? {
      Eof => return Ok(out.to_text())
      Data(bytes) => out.append(bytes)
    }
  }
  Ok(out.to_text())
}

// ---- tests: the connection, holds, upgrades, oversized bodies ------------
//
// Story `http-app-connection` (`docs/slice.md` "HttpApp sees its
// connection"). Every case runs over `Pipe.pair()`; the thousand held
// requests and the connection of an accepted stream run over TCP.

// A pipe connection from `peer` to 10.0.0.1:80 served by
// `serve_connection` under `limits`; the client end.
test fn connected_from<S>(peer: Endpoint, limits: HttpLimits, application: HttpApp<S, PipeStream>) -> IoResult<PipeStream> {
  let (client, server) = connected()?
  let connection = Connection { peer, local = Endpoint { address = "10.0.0.1", port = 80 } }
  spawn serve_connection(server, connection, limits, application, Holds.none())
  Ok(client)
}

// Everything `Http.serve` sends for `input` under `limits` and
// `application` until it closes the connection, over a pipe.
test fn served_by<S>(input: Bytes, limits: HttpLimits, application: HttpApp<S, PipeStream>) -> IoResult<Text> {
  let (client, server) = connected()?
  spawn Http.serve(server, limits, application)
  client.write_all(input)?
  read_to_end(client)
}

// The allow-list example: a peer whose address `state` lists is told what
// the handler sees of its connection, any other peer gets 403.
test fn allow_listed(state: List<Text>, request: Request) -> Response {
  let seen = request.connection
  for address in state {
    if address == seen.peer.address {
      return Response.plain(200, "{seen.peer.address}:{seen.peer.port} to {seen.local.address}:{seen.local.port}, tls {seen.tls}")
    }
  }
  status_response(403)
}

test "the handler sees its connection and an allow list refuses a peer with 403" {
  let allowed = ["10.0.0.7", "127.0.0.1"]
  let get = b"GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
  let refused = connected_from(Endpoint { address = "10.0.0.8", port = 4000 }, HttpLimits {}, HttpApp { state = allowed, handle = allow_listed })?
  refused.write_all(get)?
  assert read_to_end(refused)? == render(status_response(403), false).to_text()
  let admitted = connected_from(Endpoint { address = "10.0.0.7", port = 4000 }, HttpLimits {}, HttpApp { state = allowed, handle = allow_listed })?
  admitted.write_all(get)?
  assert read_to_end(admitted)? == reply("10.0.0.7:4000 to 10.0.0.1:80, tls false", "close")
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  client.set_idle_timeout(5000)?
  let server = listener.accept()?
  spawn serve_connection(server, Connection.of(server), HttpLimits {}, HttpApp { state = allowed, handle = allow_listed }, Holds.none())
  client.write_all(get)?
  let port = listener.local_port()
  assert read_to_end(client)? == reply("127.0.0.1:{client.local().port} to 127.0.0.1:{port}, tls false", "close")
  assert served_by(get, HttpLimits {}, HttpApp { state = allowed, handle = allow_listed })? == render(status_response(403), false).to_text()
}

// A long-poll: `/now` is answered at once, `/short` held for 50 ms, any
// other path held for 60 s; each held request's sender waits in `state`.
test fn poll<T>(state: Store<Sender<Response>>, request: Request) -> Reply<Store<Sender<Response>>, T> {
  if request.path == "/now" {
    return Respond(Response.plain(200, "now"))
  }
  let (tx, rx) = Channel.bounded(1)
  state.put(state.next_id(), tx)
  let deadline = if request.path == "/short" { 50 ms } else { 60 seconds }
  Hold(rx, deadline, Response.plain(200, "timed out"))
}

// Whether `count` requests wait in `waiters` within `within`.
test fn held(waiters: Store<Sender<Response>>, count: Int, within: Duration) -> Bool {
  let started = Clock.monotonic()
  while waiters.values().len() < count {
    if Clock.monotonic() - started > within {
      return false
    }
    Clock.sleep(5 ms)
  }
  true
}

// Sends `response` to every waiter in `waiters` once `count` wait; how
// many took it (a waiter already answered refuses).
test fn wake(waiters: Store<Sender<Response>>, count: Int, response: Response) -> Int {
  if !held(waiters, count, 30 seconds) {
    return 0
  }
  var sent = 0
  for tx in waiters.values() {
    if tx.send(response) {
      sent = sent + 1
    }
  }
  sent
}

test "a held request is answered by its message and the connection goes on" {
  let waiters: Store<Sender<Response>> = Store.new()
  let (client, server) = connected()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = waiters, reply = Some(poll) })
  client.write_all(b"GET /poll HTTP/1.1\r\nHost: h\r\n\r\nGET /now HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert wake(waiters, 1, Response.plain(200, "news")) == 1
  assert read_to_end(client)? == reply("news", "keep-alive") + reply("now", "close")
}

test "a held request is answered on_timeout at its deadline" {
  let waiters: Store<Sender<Response>> = Store.new()
  let started = Clock.monotonic()
  let out = served_by(b"GET /short HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", HttpLimits {}, HttpApp { state = waiters, reply = Some(poll) })?
  assert out == reply("timed out", "close")
  assert Clock.monotonic() - started >= 50 ms
}

test "a held request does not block another connection" {
  let waiters: Store<Sender<Response>> = Store.new()
  let app: HttpApp<Store<Sender<Response>>, PipeStream> = HttpApp { state = waiters, reply = Some(poll) }
  let (first, first_server) = connected()?
  spawn Http.serve(first_server, HttpLimits {}, app)
  first.write_all(b"GET /poll HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert held(waiters, 1, 5 seconds)
  let (second, second_server) = connected()?
  spawn Http.serve(second_server, HttpLimits {}, app)
  second.write_all(b"GET /now HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert read_to_end(second)? == reply("now", "close")
  assert waiters.values().len() == 1
  assert wake(waiters, 1, Response.plain(200, "news")) == 1
  assert read_to_end(first)? == reply("news", "close")
}

test "the drain answers every held request at once with its on_timeout" {
  let waiters: Store<Sender<Response>> = Store.new()
  let holds = Holds.start()
  let (client, server) = connected()?
  spawn serve_connection(server, Connection.unknown(), HttpLimits {}, HttpApp { state = waiters, reply = Some(poll) }, holds)
  client.write_all(b"GET /poll HTTP/1.1\r\nHost: h\r\n\r\nGET /poll HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert held(waiters, 1, 5 seconds)
  let started = Clock.monotonic()
  drain_holds(holds)
  assert read_to_end(client)? == reply("timed out", "keep-alive") + reply("timed out", "close")
  assert Clock.monotonic() - started < 5 seconds
  for tx in waiters.values() {
    assert !tx.send(Response.plain(200, "late"))
  }
}

// Takes `/echo` over with 101 and `echo_takeover`; `/refused` offers a
// head field with a line break, so `checked` turns it into 500; any other
// path is answered as `answer` answers it.
test fn upgrade_echo<T: ByteStream>(state: Unit, request: Request) -> Reply<Unit, T> = if request.path == "/echo" {
  Upgrade(Response { status = 101, headers = [("Upgrade", "echo"), ("Connection", "upgrade")] }, echo_takeover)
} else if request.path == "/refused" {
  Upgrade(Response { status = 101, headers = [("Upgrade", "a\r\nb")] }, echo_takeover)
} else {
  Respond(answer((), request))
}

// Writes the path and the bytes that came after the request, then echoes
// what it reads until the peer closes.
test fn echo_takeover<T: ByteStream>(state: Unit, request: Request, stream: T, early: Bytes) -> IoResult<Unit> requires [stream.read, stream.write] {
  stream.write_all("{request.path}:".to_bytes())?
  stream.write_all(early)?
  loop {
    match stream.read(READ_SIZE)? {
      Eof => return Ok(())
      Data(bytes) => stream.write_all(bytes)?
    }
  }
}

test "an upgrade writes its response and hands takeover the stream and the bytes after the request" {
  let (client, server) = connected()?
  spawn Http.serve(server, HttpLimits {}, HttpApp { state = (), reply = Some(upgrade_echo) })
  client.write_all(b"GET /echo HTTP/1.1\r\nHost: h\r\nUpgrade: echo\r\nConnection: upgrade\r\n\r\nearly")?
  let head = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: echo\r\nConnection: upgrade\r\n\r\n"
  assert read_at_least(client, head.len() + 11)? == head + "/echo:early"
  client.write_all(b"later")?
  assert read_at_least(client, 5)? == "later"
  _ = client.close()
  assert read_to_end(client)? == ""
}

test "an upgrade whose response is refused is 500 and nothing takes over" {
  let out = served_by(b"GET /refused HTTP/1.1\r\nHost: h\r\n\r\nafter", HttpLimits {}, HttpApp { state = (), reply = Some(upgrade_echo) })?
  assert out == render(status_response(500), false).to_text()
  let plain = served_by(b"GET /p HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", HttpLimits {}, HttpApp { state = (), reply = Some(upgrade_echo) })?
  assert plain == reply("GET /p? ", "close")
}

// Answers a body over the limit itself: 413 naming the request, the limit
// and the body it saw; `/close` with `Connection: close`.
test fn too_large(state: Unit, head: Request, limit: ByteSize) -> Response {
  var response = Response.plain(413, "{head.method} {head.path} over {limit.to_int()} bytes, body [{head.body}]")
  if head.path == "/close" {
    response.headers.push(("Connection", "close"))
  }
  response
}

test fn too_large_reply(body: Text, connection: Text) -> Text = render(Response.plain(413, body), connection == "keep-alive").to_text()

test "on_oversized answers a body over the limit, which is discarded, and the connection goes on" {
  let limits = HttpLimits { body = 4 bytes }
  let app: HttpApp<Unit, PipeStream> = HttpApp { state = (), handle = answer, on_oversized = Some(too_large) }
  let next = b"GET /next HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
  var input = b"POST /big HTTP/1.1\r\nHost: h\r\nContent-Length: 10\r\n\r\n0123456789"
  input.append(next)
  let expected = too_large_reply("POST /big over 4 bytes, body []", "keep-alive") + reply("GET /next? ", "close")
  assert served_by(input, limits, app)? == expected
  let (client, server) = connected()?
  spawn Http.serve(server, limits, app)
  client.write_all(b"POST /big HTTP/1.1\r\nHost: h\r\nContent-Length: 40000\r\n\r\n")?
  pause()?
  client.write_all(repeat("x", 39999).to_bytes())?
  pause()?
  var last = b"x"
  last.append(next)
  client.write_all(last)?
  assert read_to_end(client)? == expected
  assert served_by(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 4\r\nConnection: close\r\n\r\nabcd", limits, app)? == reply("POST /? abcd", "close")
}

test "on_oversized closes the connection when its answer or the request asks to, or the body is chunked" {
  let limits = HttpLimits { body = 4 bytes }
  let app: HttpApp<Unit, PipeStream> = HttpApp { state = (), handle = answer, on_oversized = Some(too_large) }
  let closing = render(Response { status = 413, headers = [("Content-Type", "text/plain; charset=utf-8"), ("Connection", "close")], body = "POST /close over 4 bytes, body []" }, false).to_text()
  assert served_by(b"POST /close HTTP/1.1\r\nHost: h\r\nContent-Length: 10\r\n\r\n0123456789GET / HTTP/1.1\r\nHost: h\r\n\r\n", limits, app)? == closing
  assert served_by(b"POST /old HTTP/1.0\r\nContent-Length: 10\r\n\r\n0123456789GET / HTTP/1.0\r\n\r\n", limits, app)? == too_large_reply("POST /old over 4 bytes, body []", "close")
  assert served_by(chunked("a\r\n0123456789\r\n0\r\n\r\n"), limits, app)? == too_large_reply("POST /c over 4 bytes, body []", "close")
  assert served_with(b"POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nabcde", limits)? == render(status_response(413), false).to_text()
}

// Accepts `count` connections on `listener` and serves each in its own
// task, as `serve_listener` does, without waiting for the drain.
test fn accept_count<S>(listener: TcpListener, count: Int, application: HttpApp<S, TcpStream>, holds: Holds) -> IoResult<Unit> {
  var accepted = 0
  while accepted < count {
    let stream = listener.accept()?
    spawn serve_connection(stream, Connection.of(stream), HttpLimits {}, application, holds)
    accepted = accepted + 1
  }
  Ok(())
}

// One long-poll client over TCP: asks `/poll/<id>` and reports whether
// the answer is the news.
test fn long_poll(port: Int, id: Int, results: Sender<Bool>) -> IoResult<Unit> {
  let client = TcpStream.connect("127.0.0.1", port)?
  client.set_idle_timeout(60000)?
  client.write_all("GET /poll/{id} HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n".to_bytes())?
  let got = read_to_end(client)?
  results.send(got == reply("news", "close"))
  Ok(())
}

test "a thousand requests held over TCP are each answered by their message" {
  let count = 1000
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let port = listener.local_port()
  let waiters: Store<Sender<Response>> = Store.new()
  spawn accept_count(listener, count + 1, HttpApp { state = waiters, reply = Some(poll) }, Holds.start())
  let (results, reported) = Channel.bounded(count)
  // The clients start a hundred at a time, each hundred once the ones
  // before are held, so the listener's queue (backlog 128) never fills: a
  // connect to a full queue blocks its worker through SYN retransmits, and
  // once every worker is blocked so, the accepting task among them, no
  // connection is accepted for minutes.
  var started = 0
  while started < count {
    let batch = started + 100
    while started < batch {
      spawn long_poll(port, started, results)
      started = started + 1
    }
    assert held(waiters, started, 40 seconds), "{waiters.values().len()} of {started} requests held"
  }
  let other = TcpStream.connect("127.0.0.1", port)?
  other.set_idle_timeout(30000)?
  other.write_all(b"GET /now HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")?
  assert read_to_end(other)? == reply("now", "close")
  assert wake(waiters, count, Response.plain(200, "news")) == count
  var answered = 0
  while answered < count {
    assert reported.receive_within(15 seconds) == Some(true), "{answered} of {count} answered"
    answered = answered + 1
  }
}

