package std.json

import std.text.{digit_value, is_digit, repeat}
import std.option.{and_then, unwrap_or}
import std.data.{base64, format_error, DataLimits, FormatError, Value}

// JSON values (RFC 8259): `encode` writes the compact form, `parse` reads
// one value surrounded by optional whitespace, and the accessors read
// object members (`body.text("title")`). A number without fraction or
// exponent that fits the 64-bit `Int` is a `Number(Int)`, except `-0`;
// every other number is a `Decimal` holding the token's exact text, never
// converted, so `encode` writes it back unchanged. `Decimal(text)` built by
// hand is not checked; `decimal(text)` is the checked constructor. Two
// values are equal when their structure is: `Decimal("1.0")` is neither
// `Number(1)` nor `Decimal("1.00")`. Strings
// are decoded completely, `\uXXXX` with surrogate pairs included; a lone
// surrogate is an error.
//
// The bridge to `std.data` (`docs/slice.md` 27): `to_data` and `of_data`
// convert `Json` and `Value` both ways, `read` and `read_with` read a
// document into a `Value` within `DataLimits` (a repeated member name is
// refused there, `parse` keeps it), `write` and `write_pretty` write one.

enum Json {
  Null,
  Bool(Bool),
  Number(Int),
  Decimal(Text),
  Str(Text),
  Array(List<Json>),
  Object(List<(Text, Json)>)
}

// Why `parse` failed and at which byte offset of its input.
type JsonError {
  message: Text
  offset: Int
}

// A value and the offset just after it.
type Parsed = Result<(Json, Int), JsonError>

// The digit count of the longest `Int`: an integer token of more digits is
// a `Decimal`; one of exactly this many is a `Number` when it fits `Int`.
const MAXIMUM_DIGITS: Int = 19
const MAXIMUM_DEPTH: Int = 64

// What one parse refuses: arrays and objects nested deeper than `depth`,
// more than `entries` items or members in one of them, and, when `unique`,
// a member name repeated in one object.
type Bounds {
  depth: Int
  entries: Int
  unique: Bool
}

// `parse`'s bounds: 64 levels, no entry bound, repeated names kept.
const PARSE_BOUNDS: Bounds = Bounds { depth = MAXIMUM_DEPTH, entries = 9223372036854775807, unique = false }

// ---- encoding ---------------------------------------------------------------

fn hex_digit(n: Byte) -> Byte = if n < 10 { b'0' + n } else { b'a' + n - 10 }

// `text` as a JSON string literal: quote, backslash and the control
// characters escaped, every other character as it is.
fn quote(text: Text) -> Text {
  let out = write_quoted(Bytes.with_capacity(text.len() + 2), text)
  out.to_text()
}

// `out` with `text` appended as a JSON string literal (`quote`). The
// encoder writes every value into one buffer this way instead of joining
// the texts of its parts.
fn write_quoted(out: Bytes, text: Text) -> Bytes {
  var buffer = out
  buffer.push(b'"')
  for b in text.to_bytes() {
    match b {
      b'"' => buffer.append(br#"\""#)
      b'\\' => buffer.append(br"\\")
      b'\n' => buffer.append(br"\n")
      b'\r' => buffer.append(br"\r")
      b'\t' => buffer.append(br"\t")
      0x08 => buffer.append(br"\b")
      0x0c => buffer.append(br"\f")
      0..=0x1f => {
        buffer.append(br"\u00")
        buffer.push(hex_digit(b / 16))
        buffer.push(hex_digit(b % 16))
      }
      _ => buffer.push(b)
    }
  }
  buffer.push(b'"')
  buffer
}

// The compact JSON text of `value`: no whitespace, members in their order.
fn encode(value: Json) -> Text {
  let out = write_value(Bytes.with_capacity(128), value)
  out.to_text()
}

// `out` with the compact JSON text of `value` appended (`encode`).
fn write_value(out: Bytes, value: Json) -> Bytes {
  var buffer = out
  match value {
    Null => buffer.append(b"null")
    Bool(b) => if b {
      buffer.append(b"true")
    } else {
      buffer.append(b"false")
    }
    Number(n) => buffer.append(n.to_text().to_bytes())
    Decimal(text) => buffer.append(text.to_bytes())
    Str(text) => {
      buffer = write_quoted(buffer, text)
    }
    Array(items) => {
      buffer.push(b'[')
      var first = true
      for item in items {
        if !first {
          buffer.push(b',')
        }
        first = false
        buffer = write_value(buffer, item)
      }
      buffer.push(b']')
    }
    Object(members) => {
      buffer.push(b'{')
      var first = true
      for member in members {
        if !first {
          buffer.push(b',')
        }
        first = false
        buffer = write_quoted(buffer, member.0)
        buffer.push(b':')
        buffer = write_value(buffer, member.1)
      }
      buffer.push(b'}')
    }
  }
  buffer
}

test "encode writes every kind compactly" {
  assert encode(Null) == "null"
  assert encode(Bool(true)) == "true"
  assert encode(Bool(false)) == "false"
  assert encode(Number(0)) == "0"
  assert encode(Number(-12)) == "-12"
  assert encode(Number(999999999999999999)) == "999999999999999999"
  assert encode(Str("")) == r#""""#
  assert encode(Array([])) == "[]"
  assert encode(Object([])) == r"{}"
  assert encode(Array([Number(1), Array([Null]), Object([("a", Bool(true))])])) == r#"[1,[null],{"a":true}]"#
  let todo = Object([("id", Number(1)), ("title", Str(r#"say "hi""#)), ("done", Bool(false))])
  assert encode(todo) == r#"{"id":1,"title":"say \"hi\"","done":false}"#
}

test "encode escapes quote, backslash and control characters" {
  assert quote(r#"a"b\c/d"#) == r#""a\"b\\c/d""#
  assert quote("\n\r\t\u{8}\u{c}") == r#""\n\r\t\b\f""#
  assert quote("\0\u{1}\u{1f}") == r#""\u0000\u0001\u001f""#
  assert quote(" \u{7f}") == "\" \u{7f}\""
  assert quote("é€\u{1F600}") == "\"é€\u{1F600}\""
  assert encode(Object([(r#"k""#, Str("v"))])) == r#"{"k\"":"v"}"#
}

// ---- parsing ----------------------------------------------------------------

fn error(message: Text, offset: Int) -> JsonError = JsonError { message, offset }

fn smaller(a: Int, b: Int) -> Int = if a < b { a } else { b }

fn is_space(b: Byte) -> Bool = match b {
  b' ' | b'\t' | b'\n' | b'\r' => true
  _ => false
}

fn skip_space(bytes: Bytes, at: Int) -> Int {
  var i = at
  while i < bytes.len() && is_space(bytes.at(i)) {
    i = i + 1
  }
  i
}

// The one JSON value of `text`, with whitespace allowed around it.
fn parse(text: Text) -> Result<Json, JsonError> = parse_bounded(text, PARSE_BOUNDS)

// The one JSON value of `text` within `bounds`.
fn parse_bounded(text: Text, bounds: Bounds) -> Result<Json, JsonError> {
  let bytes = text.to_bytes()
  let (value, end) = parse_value(bytes, skip_space(bytes, 0), 0, bounds)?
  let rest = skip_space(bytes, end)
  if rest < bytes.len() {
    return Err(error("unexpected character after the value", rest))
  }
  Ok(value)
}

// The value starting at `at`, which is not whitespace; `depth` counts the
// arrays and objects around it.
fn parse_value(bytes: Bytes, at: Int, depth: Int, bounds: Bounds) -> Parsed {
  if at >= bytes.len() {
    return Err(error("unexpected end of input", at))
  }
  match bytes.at(at) {
    b'n' => parse_word(bytes, at, "null", Null)
    b't' => parse_word(bytes, at, "true", Bool(true))
    b'f' => parse_word(bytes, at, "false", Bool(false))
    b'"' => {
      let (text, end) = parse_string(bytes, at)?
      Ok((Str(text), end))
    }
    b'[' => parse_array(bytes, at, depth + 1, bounds)
    b'{' => parse_object(bytes, at, depth + 1, bounds)
    b'-' | b'0'..=b'9' => parse_number(bytes, at)
    _ => Err(error("unexpected character", at))
  }
}

fn parse_word(bytes: Bytes, at: Int, word: Text, value: Json) -> Parsed {
  let end = at + word.len()
  if end > bytes.len() || bytes.slice(at, end).to_text() != word {
    return Err(error("unexpected character", at))
  }
  Ok((value, end))
}

// The offset after the digits starting at `at`; `at` when there is none.
fn digits_end(bytes: Bytes, at: Int) -> Int {
  var i = at
  while i < bytes.len() && is_digit(bytes.at(i)) {
    i = i + 1
  }
  i
}

// The offset after one or more digits at `at`, or the error that there is
// none.
fn some_digits(bytes: Bytes, at: Int) -> Result<Int, JsonError> {
  let end = digits_end(bytes, at)
  if end == at {
    return Err(error("expected a digit", at))
  }
  Ok(end)
}

// Whether the digits of `bytes` from `start` to `end`, as many as `limit`
// has and without leading zero, are at most `limit`: a comparison of the
// digit text, so nothing overflows.
fn at_most(bytes: Bytes, start: Int, end: Int, limit: Bytes) -> Bool {
  if end - start != limit.len() {
    return end - start < limit.len()
  }
  var k = 0
  while k < limit.len() {
    let b = bytes.at(start + k)
    if b != limit.at(k) {
      return b < limit.at(k)
    }
    k = k + 1
  }
  true
}

// Whether the integer token with digits from `start` to `end` fits `Int`
// (64 bits): at most 9223372036854775807, at least -9223372036854775808.
fn fits_int(bytes: Bytes, start: Int, end: Int, negative: Bool) -> Bool =
  if negative { at_most(bytes, start, end, b"9223372036854775808") } else { at_most(bytes, start, end, b"9223372036854775807") }

// The number token at `at` (RFC 8259 section 6): `-`, an integer part
// without leading zero, an optional fraction, an optional exponent. An
// integer part alone that fits `Int` is a `Number`, except `-0`; every
// other token is a `Decimal` of its exact text, `-0` included, so `encode`
// writes it back byte-identical.
fn parse_number(bytes: Bytes, at: Int) -> Parsed {
  let negative = bytes.at(at) == b'-'
  let start = if negative { at + 1 } else { at }
  let integer_end = some_digits(bytes, start)?
  if integer_end - start > 1 && bytes.at(start) == b'0' {
    return Err(error("leading zero in a number", start))
  }
  var i = integer_end
  if i < bytes.len() && bytes.at(i) == b'.' {
    i = some_digits(bytes, i + 1)?
  }
  if i < bytes.len() && (bytes.at(i) == b'e' || bytes.at(i) == b'E') {
    var from = i + 1
    if from < bytes.len() && (bytes.at(from) == b'+' || bytes.at(from) == b'-') {
      from = from + 1
    }
    i = some_digits(bytes, from)?
  }
  let minus_zero = negative && bytes.at(start) == b'0'
  if i > integer_end || minus_zero || !fits_int(bytes, start, integer_end, negative) {
    return Ok((Decimal(bytes.slice(at, i).to_text()), i))
  }
  // Accumulated on the token's side of zero, so -9223372036854775808
  // never passes through its positive, which does not fit.
  var value = 0
  var j = start
  while j < integer_end {
    let digit = digit_value(bytes.at(j)).unwrap_or(0)
    value = if negative { value * 10 - digit } else { value * 10 + digit }
    j = j + 1
  }
  Ok((Number(value), i))
}

// The `Json` of `text` when it is exactly one JSON number token, no
// whitespace around it: `Number` or `Decimal` as `parse` gives it. The
// checked way to build a `Decimal`: `Decimal(text)` built by hand is not
// checked, and `encode` writes its text whatever it is.
fn decimal(text: Text) -> Result<Json, JsonError> {
  let bytes = text.to_bytes()
  if bytes.is_empty() {
    return Err(error("unexpected end of input", 0))
  }
  match bytes.at(0) {
    b'-' | b'0'..=b'9' => {}
    _ => return Err(error("unexpected character", 0))
  }
  let (value, end) = parse_number(bytes, 0)?
  if end < bytes.len() {
    return Err(error("unexpected character after the value", end))
  }
  Ok(value)
}

// The string whose opening quote is at `at`: its text and the offset after
// the closing quote.
fn parse_string(bytes: Bytes, at: Int) -> Result<(Text, Int), JsonError> {
  var out = Bytes.empty()
  var i = at + 1
  loop {
    if i >= bytes.len() {
      return Err(error("unterminated string", at))
    }
    match bytes.at(i) {
      b'"' => return Ok((out.to_text(), i + 1))
      b'\\' => match escape(bytes.slice(i, smaller(i + 12, bytes.len()))) {
        Some((decoded, length)) => {
          out.append(decoded)
          i = i + length
        }
        None => return Err(error("invalid escape", i))
      }
      0..=0x1f => return Err(error("control character in a string", i))
      b => {
        out.push(b)
        i = i + 1
      }
    }
  }
}

// The escape at the start of `w` (a backslash and up to 11 more bytes):
// its UTF-8 bytes and its length in `w`.
fn escape(w: Bytes) -> Option<(Bytes, Int)> {
  if w.len() < 2 {
    return None
  }
  match w.at(1) {
    b'"' => Some((b"\"", 2))
    b'\\' => Some((b"\\", 2))
    b'/' => Some((b"/", 2))
    b'b' => Some((b"\x08", 2))
    b'f' => Some((b"\x0c", 2))
    b'n' => Some((b"\n", 2))
    b'r' => Some((b"\r", 2))
    b't' => Some((b"\t", 2))
    b'u' => unicode_escape(w)
    _ => None
  }
}

fn hex_value(b: Byte) -> Option<Byte> = match b {
  b'0'..=b'9' => Some(b - b'0')
  b'a'..=b'f' => Some(b - b'a' + 10)
  b'A'..=b'F' => Some(b - b'A' + 10)
  _ => None
}

// The four hex digits of `w` at `at`, as values 0 to 15.
fn hex4(w: Bytes, at: Int) -> Option<(Byte, Byte, Byte, Byte)> {
  if at + 4 > w.len() {
    return None
  }
  match (hex_value(w.at(at)), hex_value(w.at(at + 1)), hex_value(w.at(at + 2)), hex_value(w.at(at + 3))) {
    (Some(a), Some(b), Some(c), Some(d)) => Some((a, b, c, d))
    _ => None
  }
}

// `\uXXXX` at the start of `w`, followed by a second `\uXXXX` when the
// first is a high surrogate (D800 to DBFF). The code point is never formed
// as a number: its UTF-8 bytes are assembled from the hex digits.
fn unicode_escape(w: Bytes) -> Option<(Bytes, Int)> = match hex4(w, 2) {
  None | Some((13, 12..=15, _, _)) => None
  Some((13, 8..=11, _, _)) => surrogate_escape(w)
  Some((n1, n2, n3, n4)) => Some((basic_plane(n1, n2, n3, n4), 6))
}

// A high surrogate `\uXXXX` at the start of `w` and the low surrogate
// (DC00 to DFFF) `\uXXXX` that must follow it.
fn surrogate_escape(w: Bytes) -> Option<(Bytes, Int)> {
  if w.len() < 12 || w.at(6) != b'\\' || w.at(7) != b'u' {
    return None
  }
  match (hex4(w, 2), hex4(w, 8)) {
    (Some((_, n2, n3, n4)), Some((13, m2, m3, m4))) => if m2 >= 12 {
      Some((surrogate_pair(n2 - 8, n3, n4, m2 - 12, m3, m4), 12))
    } else {
      None
    }
    _ => None
  }
}

// UTF-8 of the code point with hex digits n1 n2 n3 n4 (not a surrogate).
fn basic_plane(n1: Byte, n2: Byte, n3: Byte, n4: Byte) -> Bytes = match (n1, n2, n3) {
  (0, 0, 0..=7) => [n3 * 16 + n4]
  (0, 0..=7, _) => [0xC0 + n2 * 4 + n3 / 4, 0x80 + n3 % 4 * 16 + n4]
  _ => [0xE0 + n1, 0x80 + n2 * 4 + n3 / 4, 0x80 + n3 % 4 * 16 + n4]
}

// UTF-8 of the code point of a surrogate pair. The high surrogate's ten
// bits are a (2), b (4), c (4); the low one's d (2), e (4), f (4). The code
// point is 0x10000 + abcdef, so its plane is 1 + a b/4.
fn surrogate_pair(a: Byte, b: Byte, c: Byte, d: Byte, e: Byte, f: Byte) -> Bytes {
  let plane = 1 + a * 4 + b / 4
  [
    0xF0 + plane / 4,
    0x80 + plane % 4 * 16 + b % 4 * 4 + c / 4,
    0x80 + c % 4 * 16 + d * 4 + e / 4,
    0x80 + e % 4 * 16 + f
  ]
}

fn parse_array(bytes: Bytes, at: Int, depth: Int, bounds: Bounds) -> Parsed {
  if depth > bounds.depth {
    return Err(error("nested deeper than {bounds.depth}", at))
  }
  var items = []
  var i = skip_space(bytes, at + 1)
  if i < bytes.len() && bytes.at(i) == b']' {
    return Ok((Array(items), i + 1))
  }
  loop {
    if items.len() == bounds.entries {
      return Err(error("more than {bounds.entries} entries", i))
    }
    let (item, end) = parse_value(bytes, i, depth, bounds)?
    items.push(item)
    i = skip_space(bytes, end)
    if i >= bytes.len() {
      return Err(error("unexpected end of input", i))
    }
    match bytes.at(i) {
      b',' => {
        i = skip_space(bytes, i + 1)
      }
      b']' => return Ok((Array(items), i + 1))
      _ => return Err(error("expected `,` or `]`", i))
    }
  }
}

fn parse_object(bytes: Bytes, at: Int, depth: Int, bounds: Bounds) -> Parsed {
  if depth > bounds.depth {
    return Err(error("nested deeper than {bounds.depth}", at))
  }
  var members = []
  var names: Map<Text, Bool> = Map.empty()
  var i = skip_space(bytes, at + 1)
  if i < bytes.len() && bytes.at(i) == b'}' {
    return Ok((Object(members), i + 1))
  }
  loop {
    if members.len() == bounds.entries {
      return Err(error("more than {bounds.entries} entries", i))
    }
    if i >= bytes.len() || bytes.at(i) != b'"' {
      return Err(error("expected a member name", i))
    }
    let (name, after_name) = parse_string(bytes, i)?
    if bounds.unique {
      if names.contains(name) {
        return Err(error("duplicate member `{name}`", i))
      }
      names.put(name, true)
    }
    i = skip_space(bytes, after_name)
    if i >= bytes.len() || bytes.at(i) != b':' {
      return Err(error("expected `:`", i))
    }
    let (item, end) = parse_value(bytes, skip_space(bytes, i + 1), depth, bounds)?
    members.push((name, item))
    i = skip_space(bytes, end)
    if i >= bytes.len() {
      return Err(error("unexpected end of input", i))
    }
    match bytes.at(i) {
      b',' => {
        i = skip_space(bytes, i + 1)
      }
      b'}' => return Ok((Object(members), i + 1))
      _ => return Err(error(r"expected `,` or `}`", i))
    }
  }
}

// The error of parsing `input`, `None` when it parses.
test fn failure(input: Text) -> Option<JsonError> = match parse(input) {
  Ok(_) => None
  Err(e) => Some(e)
}

// The bytes of the one string `input` parses to.
test fn string_bytes(input: Text) -> Option<Bytes> = match parse(input) {
  Ok(Str(text)) => Some(text.to_bytes())
  _ => None
}

test fn at(message: Text, offset: Int) -> Option<JsonError> = Some(JsonError { message, offset })

test "parse reads every kind of value" {
  assert parse("null")? == Null
  assert parse("true")? == Bool(true)
  assert parse("false")? == Bool(false)
  assert parse("0")? == Number(0)
  assert parse("42")? == Number(42)
  assert parse("-12")? == Number(-12)
  assert parse(r#""milk""#)? == Str("milk")
  assert parse("[]")? == Array([])
  assert parse(r"{}")? == Object([])
  assert parse(r#"[1, "a", [true], {}]"#)? == Array([Number(1), Str("a"), Array([Bool(true)]), Object([])])
  let body = r#" { "id" : 1, "title":"milk", "done":false, "tags":[ ], "x":null } "#
  let expected = Object([
    ("id", Number(1)),
    ("title", Str("milk")),
    ("done", Bool(false)),
    ("tags", Array([])),
    ("x", Null)
  ])
  assert parse(body)? == expected
  assert parse("\t\r\n 7 \n")? == Number(7)
}

test "parse decodes escapes" {
  assert parse(r#""a\"b\\c\/\n\t\b\f\r""#)? == Str("a\"b\\c/\n\t\u{8}\u{c}\r")
  assert parse(r#""Aé€😀\u0001""#)? == Str("A\u{e9}\u{20AC}\u{1F600}\u{1}")
  assert string_bytes(r#""\u0000""#) == Some(b"\0")
  assert string_bytes(r#""\u007f""#) == Some(b"\x7f")
  assert string_bytes(r#""\u0080""#) == Some(b"\xc2\x80")
  assert string_bytes(r#""߿""#) == Some(b"\xdf\xbf")
  assert string_bytes(r#""ࠀ""#) == Some(b"\xe0\xa0\x80")
  assert string_bytes(r#""￿""#) == Some(b"\xef\xbf\xbf")
  assert string_bytes(r#""𐀀""#) == Some(b"\xf0\x90\x80\x80")
  assert string_bytes(r#""􏿿""#) == Some(b"\xf4\x8f\xbf\xbf")
  assert string_bytes(r#""😀""#) == Some("\u{1F600}".to_bytes())
  assert parse(r#""é€ and 😀 raw""#)? == Str("é€ and 😀 raw")
}

test "a lone or broken surrogate is an invalid escape" {
  let invalid = at("invalid escape", 1)
  assert failure(r#""\ud800""#) == invalid
  assert failure(r#""\udc00""#) == invalid
  assert failure(r#""\udfff\ud800""#) == invalid
  assert failure(r#""\ud800A""#) == invalid
  assert failure(r#""\ud800\ud800""#) == invalid
  assert failure(r#""\ud800x""#) == invalid
  assert failure(r#""\ud800\"#) == invalid
  assert failure(r#""\u12""#) == invalid
  assert failure(r#""\u12G4""#) == invalid
  assert failure(r#""\q""#) == invalid
  assert failure(r#""ab\x""#) == at("invalid escape", 3)
}

test "integers of at most 18 digits are numbers" {
  assert parse("999999999999999999")? == Number(999999999999999999)
  assert parse("-999999999999999999")? == Number(-999999999999999999)
  assert parse("[123456789012345678]")? == Array([Number(123456789012345678)])
  assert failure("0123") == at("leading zero in a number", 0)
  assert failure("-01") == at("leading zero in a number", 1)
  assert failure("-") == at("expected a digit", 1)
  assert failure("-a") == at("expected a digit", 1)
  assert failure("+1") == at("unexpected character", 0)
}

test "a number with a fraction, an exponent or more than 18 digits is a decimal of its exact text" {
  assert parse("0.5")? == Decimal("0.5")
  assert parse("-1.25E-3")? == Decimal("-1.25E-3")
  assert parse("1e2")? == Decimal("1e2")
  assert parse("1E+2")? == Decimal("1E+2")
  assert parse("-0.0")? == Decimal("-0.0")
  assert parse("12345678901234567890")? == Decimal("12345678901234567890")
  assert parse("-12345678901234567890")? == Decimal("-12345678901234567890")
  assert parse(r#"[0.0, {"x": 2e-0}]"#)? == Array([Decimal("0.0"), Object([("x", Decimal("2e-0"))])])
  for token in ["0.5", "-1.25E-3", "1e2", "12345678901234567890", "-0.0", "42", "-7", "[1.50,2E10]"] {
    assert encode(parse(token)?) == token
  }
  assert encode(Decimal("6.02e23")) == "6.02e23"
}

test "an invalid number token is still an error" {
  assert failure("01") == at("leading zero in a number", 0)
  assert failure("1.") == at("expected a digit", 2)
  assert failure(".5") == at("unexpected character", 0)
  assert failure("1e") == at("expected a digit", 2)
  assert failure("1e+") == at("expected a digit", 3)
  assert failure("1.e5") == at("expected a digit", 2)
  assert failure("+1") == at("unexpected character", 0)
  assert failure("-") == at("expected a digit", 1)
  assert failure("-.5") == at("expected a digit", 1)
  assert failure("00.5") == at("leading zero in a number", 0)
  assert failure("1.5.2") == at("unexpected character after the value", 3)
}

test "numbers compare by their structure, not their value" {
  assert Number(1) != Decimal("1.0")
  assert Json.Decimal("1.0") != Decimal("1.00")
  assert Json.Decimal("1e2") == Decimal("1e2")
  assert parse("1")? != parse("1.0")?
  assert parse("1e2")? == parse("1e2")?
}

// The error of `decimal(text)`, `None` when it builds a value.
test fn decimal_failure(text: Text) -> Option<JsonError> = match decimal(text) {
  Ok(_) => None
  Err(e) => Some(e)
}

test "decimal builds what parse gives for one number token and refuses the rest" {
  for token in ["0", "42", "-7", "-0", "0.5", "-1.25E-3", "1e2", "9223372036854775807", "-9223372036854775808", "9223372036854775808"] {
    assert decimal(token)? == parse(token)?
  }
  assert decimal("1.50")? == Decimal("1.50")
  assert decimal("12")? == Number(12)
  assert decimal("-0")? == Decimal("-0")
  assert decimal_failure("") == at("unexpected end of input", 0)
  assert decimal_failure(" 1") == at("unexpected character", 0)
  assert decimal_failure("1 ") == at("unexpected character after the value", 1)
  assert decimal_failure("abc") == at("unexpected character", 0)
  assert decimal_failure(r#""1""#) == at("unexpected character", 0)
  assert decimal_failure("[1]") == at("unexpected character", 0)
  assert decimal_failure("01") == at("leading zero in a number", 0)
  assert decimal_failure("1.") == at("expected a digit", 2)
  assert decimal_failure("1e5x") == at("unexpected character after the value", 3)
  assert decimal_failure("+1") == at("unexpected character", 0)
}

// ---- adversary cases of story json-decimals ---------------------------------

// The rule: a token without fraction or exponent is a `Number` when it fits
// `Int`, not when it has at most 18 digits. Every 19-digit integer in
// i64 range fits; the first ones beyond it stay decimals.
test "an integer of 19 digits that fits Int is a number" {
  assert parse("9223372036854775807")? == Number(9223372036854775807)
  assert parse("-9223372036854775807")? == Number(-9223372036854775807)
  assert parse("-9223372036854775808")? == Number(-9223372036854775807 - 1)
  assert parse("1000000000000000000")? == Number(1000000000000000000)
  assert parse(r#"{"id":4611686018427387904}"#)?.int("id") == Some(4611686018427387904)
  assert parse("9223372036854775808")? == Decimal("9223372036854775808")
  assert parse("-9223372036854775809")? == Decimal("-9223372036854775809")
  assert parse("9999999999999999999")? == Decimal("9999999999999999999")
}

// The rule: a parse/print round trip is byte-identical. `-0` is a valid
// token (RFC 8259 section 6) and must come back as `-0`, also inside a
// container.
test "minus zero round trips byte-identical" {
  for token in ["-0", "[-0]", r#"{"x":-0}"#] {
    assert encode(parse(token)?) == token
  }
}

test "nesting is limited to 64 levels" {
  assert failure("[".repeat(64) + "1" + "]".repeat(64)) == None
  assert failure("[".repeat(65) + "1" + "]".repeat(65)) == at("nested deeper than 64", 64)
  let objects = r#"{"a":"#.repeat(65) + "1" + r"}".repeat(65)
  assert failure(objects) == at("nested deeper than 64", 320)
}

test "malformed input is an error at its offset" {
  assert failure("") == at("unexpected end of input", 0)
  assert failure("   ") == at("unexpected end of input", 3)
  assert failure("[1,]") == at("unexpected character", 3)
  assert failure("[1") == at("unexpected end of input", 2)
  assert failure("[1 2]") == at("expected `,` or `]`", 3)
  assert failure(r#"{"a" 1}"#) == at("expected `:`", 5)
  assert failure(r"{1:2}") == at("expected a member name", 1)
  assert failure(r#"{"a":1,}"#) == at("expected a member name", 7)
  assert failure(r#"{"a":1 "b":2}"#) == at(r"expected `,` or `}`", 7)
  assert failure(r#"{"a":1"#) == at("unexpected end of input", 6)
  assert failure(r#""open"#) == at("unterminated string", 0)
  assert failure("\"tab\there\"") == at("control character in a string", 4)
  assert failure("nul") == at("unexpected character", 0)
  assert failure("nulls") == at("unexpected character after the value", 4)
  assert failure("[1] 2") == at("unexpected character after the value", 4)
  assert failure("True") == at("unexpected character", 0)
}

// ---- access -----------------------------------------------------------------

// The last member `name` of an object, as ECMAScript's `JSON.parse` keeps
// it (`docs/slice.md` 19.20); `None` when there is none or `value` is not
// an object.
fn get(value: Json, name: Text) -> Option<Json> = match value {
  Object(members) => {
    var found: Option<Json> = None
    for member in members {
      if member.0 == name {
        found = Some(member.1)
      }
    }
    found
  }
  _ => None
}

// Every member `name` of an object in document order; empty when there is
// none or `value` is not an object.
fn get_all(value: Json, name: Text) -> List<Json> = match value {
  Object(members) => {
    var found: List<Json> = []
    for member in members {
      if member.0 == name {
        found.push(member.1)
      }
    }
    found
  }
  _ => []
}

fn as_text(value: Json) -> Option<Text> = match value {
  Str(text) => Some(text)
  _ => None
}

fn as_int(value: Json) -> Option<Int> = match value {
  Number(n) => Some(n)
  _ => None
}

fn as_bool(value: Json) -> Option<Bool> = match value {
  Bool(b) => Some(b)
  _ => None
}

fn as_list(value: Json) -> Option<List<Json>> = match value {
  Array(items) => Some(items)
  _ => None
}

// Member `name` when it is a string: `body.text("title")`.
fn text(value: Json, name: Text) -> Option<Text> = value.get(name).and_then(as_text)

// Member `name` when it is a number.
fn int(value: Json, name: Text) -> Option<Int> = value.get(name).and_then(as_int)

// Member `name` when it is `true` or `false`.
fn bool(value: Json, name: Text) -> Option<Bool> = value.get(name).and_then(as_bool)

test "the accessors read members of the right kind" {
  let body = parse(r#"{"title":"milk","done":true,"id":7,"tags":["a"],"id":8}"#)?
  assert body.text("title") == Some("milk")
  assert body.bool("done") == Some(true)
  assert body.int("id") == Some(8)
  assert body.text("id") == None
  assert body.int("title") == None
  assert body.bool("missing") == None
  assert body.get("tags") == Some(Array([Str("a")]))
  assert Array([]).get("tags") == None
  assert text(Str("title"), "title") == None
  assert as_text(Str("x")) == Some("x")
  assert as_text(Null) == None
  assert as_int(Number(-3)) == Some(-3)
  assert as_int(Str("3")) == None
  assert as_bool(Bool(false)) == Some(false)
  assert as_bool(Null) == None
  assert as_list(Array([Null])) == Some([Null])
  assert as_list(Object([])) == None
}

test "get returns the last duplicated member and get_all every one" {
  let g29 = r#"{"channel":"/a","channel":"/meta/handshake"}"#
  let message = parse(g29)?
  assert message.get("channel") == Some(Str("/meta/handshake"))
  assert message.text("channel") == Some("/meta/handshake")
  assert message.get_all("channel") == [Str("/a"), Str("/meta/handshake")]
  assert message.get_all("id") == []
  assert Str("channel").get_all("channel") == []
  assert encode(message) == g29
  let three = parse(r#"{"a":1,"b":true,"a":2,"a":"x"}"#)?
  assert three.get("a") == Some(Str("x"))
  assert three.int("a") == None
  assert three.get_all("a") == [Number(1), Number(2), Str("x")]
  assert three.get_all("b") == [Bool(true)]
}

test "encode and parse round trip" {
  let value = Object([
    ("name", Str("Ä \"q\" \\ \n\u{1} \u{1F600}")),
    ("n", Number(-123456789012345678)),
    ("list", Array([Null, Bool(true), Array([]), Object([("", Str(""))])]))
  ])
  assert parse(encode(value))? == value
  for compact in [
    r#"{"id":1,"title":"milk","done":false,"tags":[],"x":null}"#,
    r#"[-12,0,true,[[]],{},"a\"b\\c/\n\t\b\f\r"]"#,
    r#""\u0001\u001f""#
  ] {
    assert encode(parse(compact)?) == compact
  }
  assert encode(parse(r#""Aé€😀""#)?) == r#""Aé€😀""#
}

// ---- the data bridge --------------------------------------------------------

// `json` as a data value: `Number` is `Int`, `Str` is `Text`, `Array` is
// `List`, `Object` is `Map`.
fn to_data(json: Json) -> Value = match json {
  Null => Value.Null
  Bool(b) => Value.Bool(b)
  Number(n) => Value.Int(n)
  Decimal(text) => Value.Decimal(text)
  Str(text) => Value.Text(text)
  Array(items) => Value.List(items.map(to_data))
  Object(members) => Value.Map(members.map(|m| (m.0, to_data(m.1))))
}

// `value` as JSON: `Bytes` as its base64 text, a `Moment` as its text.
fn of_data(value: Value) -> Json = match value {
  Value.Null => Null
  Value.Bool(b) => Bool(b)
  Value.Int(n) => Number(n)
  Value.Decimal(text) => Decimal(text)
  Value.Text(text) => Str(text)
  Value.Bytes(bytes) => Str(base64(bytes))
  Value.Moment(text) => Str(text)
  Value.List(items) => Array(items.map(of_data))
  Value.Map(members) => Object(members.map(|m| (m.0, of_data(m.1))))
}

// The one JSON value of `text` as a data value, within the default
// `DataLimits`.
fn read(text: Text) -> Result<Value, FormatError> = read_with(text, DataLimits {})

// The one JSON value of `text` as a data value: at most `limits.size`
// bytes, arrays and objects nested at most `limits.depth` deep with at most
// `limits.entries` items or members each, no member name twice in one
// object. An error names the first byte that broke a rule.
fn read_with(text: Text, limits: DataLimits) -> Result<Value, FormatError> {
  let size = limits.size.to_int()
  if text.len() > size {
    return Err(format_error(text, "document larger than {size} bytes", size))
  }
  match parse_bounded(text, Bounds { depth = limits.depth, entries = limits.entries, unique = true }) {
    Ok(json) => Ok(to_data(json))
    Err(e) => Err(format_error(text, e.message, e.offset))
  }
}

// The first `Decimal` in `value` whose text is no JSON number token, as
// the error of a write.
fn number_error(value: Value) -> Option<FormatError> {
  match value {
    Value.Decimal(text) => match decimal(text) {
      Ok(_) => None
      Err(_) => Some(FormatError { message = "decimal `{text}` is not a JSON number", line = 0, column = 0, offset = 0 })
    }
    Value.List(items) => {
      for item in items {
        match number_error(item) {
          Some(e) => return Some(e)
          None => {}
        }
      }
      None
    }
    Value.Map(members) => {
      for member in members {
        match number_error(member.1) {
          Some(e) => return Some(e)
          None => {}
        }
      }
      None
    }
    _ => None
  }
}

// The compact JSON text of `value`, as `encode` writes it.
fn write(value: Value) -> Result<Text, FormatError> = match number_error(value) {
  Some(e) => Err(e)
  None => Ok(encode(of_data(value)))
}

// The JSON text of `value` with one item or member per line, indented by
// two spaces per level; empty arrays and objects stay `[]` and `{}`.
fn write_pretty(value: Value) -> Result<Text, FormatError> = match number_error(value) {
  Some(e) => Err(e)
  None => Ok(pretty(of_data(value), ""))
}

fn pretty(value: Json, indent: Text) -> Text {
  let inner = indent + "  "
  match value {
    Array(items) => if items.is_empty() {
      "[]"
    } else {
      "[\n" + items.map(|item| inner + pretty(item, inner)).join(",\n") + "\n" + indent + "]"
    }
    Object(members) => if members.is_empty() {
      "{{}}"
    } else {
      "{{\n" + members.map(|m| inner + quote(m.0) + ": " + pretty(m.1, inner)).join(",\n") + "\n" + indent + "}}"
    }
    other => encode(other)
  }
}

test "of_data inverts to_data for every kind, nested" {
  let every: List<Json> = [
    Null,
    Bool(true),
    Bool(false),
    Number(-7),
    Decimal("6.02e23"),
    Str("é \"q\""),
    Array([]),
    Object([]),
    Array([Null, Number(1), Array([Str("x")]), Object([("a", Decimal("-0"))])]),
    Object([("id", Number(1)), ("tags", Array([Str("a"), Bool(true)])), ("x", Object([("y", Null)]))])
  ]
  for j in every {
    assert of_data(to_data(j)) == j
  }
  assert to_data(Object([("n", Number(2)), ("s", Str("t"))])) == Value.Map([("n", Value.Int(2)), ("s", Value.Text("t"))])
  assert to_data(Array([Null, Decimal("1.5"), Bool(false)])) == Value.List([Value.Null, Value.Decimal("1.5"), Value.Bool(false)])
}

test "of_data writes bytes as base64 text and a moment as its text" {
  assert of_data(Value.Bytes(b"foobar")) == Str("Zm9vYmFy")
  assert of_data(Value.Bytes(b"")) == Str("")
  assert of_data(Value.Moment("1979-05-27T07:32:00Z")) == Str("1979-05-27T07:32:00Z")
  assert of_data(Value.List([Value.Bytes(b"f"), Value.Moment("07:32:00")])) == Array([Str("Zg=="), Str("07:32:00")])
}

// The error of `read(input)`, `None` when it reads.
test fn read_failure(input: Text) -> Option<FormatError> = match read(input) {
  Ok(_) => None
  Err(e) => Some(e)
}

// The error of `read_with(input, limits)`, `None` when it reads.
test fn bounded_failure(input: Text, limits: DataLimits) -> Option<FormatError> = match read_with(input, limits) {
  Ok(_) => None
  Err(e) => Some(e)
}

test fn located(message: Text, line: Int, column: Int, offset: Int) -> Option<FormatError> =
  Some(FormatError { message, line, column, offset })

test "read gives a value of every kind" {
  let document = r#"{"a": null, "b": [true, false], "n": -3, "d": 1.25, "s": "x\ty", "o": {}}"#
  let expected = Value.Map([
    ("a", Value.Null),
    ("b", Value.List([Value.Bool(true), Value.Bool(false)])),
    ("n", Value.Int(-3)),
    ("d", Value.Decimal("1.25")),
    ("s", Value.Text("x\ty")),
    ("o", Value.Map([]))
  ])
  assert read(document)? == expected
  assert read(" 7 ")? == Value.Int(7)
}

test "a format error names line, column and offset of the first bad byte" {
  assert read_failure("[1,]") == located("unexpected character", 1, 4, 3)
  assert read_failure("{{\n  \"a\": 1,\n  \"b\" 2\n}}") == located("expected `:`", 3, 7, 18)
  assert read_failure("[\"é\", x]") == located("unexpected character", 1, 7, 7)
  assert read_failure("\n\n") == located("unexpected end of input", 3, 1, 2)
  assert read_failure("") == located("unexpected end of input", 1, 1, 0)
}

test "read refuses a duplicate member name, parse keeps it" {
  assert read_failure(r#"{"a": 1, "b": 2, "a": 3}"#) == located("duplicate member `a`", 1, 18, 17)
  assert read_failure(r#"[{"a": 1}, {"a": 2}]"#) == None
  assert parse(r#"{"a": 1, "a": 3}"#)? == Object([("a", Number(1)), ("a", Number(3))])
}

test "read_with bounds the nesting depth" {
  let limits = DataLimits { depth = 3 }
  assert bounded_failure("[[[1]]]", limits) == None
  assert bounded_failure("[[[[1]]]]", limits) == located("nested deeper than 3", 1, 4, 3)
  assert bounded_failure(r#"{"a": {"b": {"c": {}}}}"#, limits) == located("nested deeper than 3", 1, 19, 18)
  assert read_failure("[".repeat(64) + "]".repeat(64)) == None
  assert read_failure("[".repeat(65) + "]".repeat(65)) == located("nested deeper than 64", 1, 65, 64)
}

test "read_with bounds the document size" {
  let limits = DataLimits { size = 8 bytes }
  assert bounded_failure("[1, 2]  ", limits) == None
  assert bounded_failure("[1, 2, 3]", limits) == located("document larger than 8 bytes", 1, 9, 8)
  assert bounded_failure("\"ééééé\"", DataLimits { size = 11 bytes }) == located("document larger than 11 bytes", 1, 7, 11)
}

test "read_with bounds the entries of one list or map" {
  let limits = DataLimits { entries = 2 }
  assert bounded_failure(r#"[[1, 2], {"a": 1, "b": 2}]"#, limits) == None
  assert bounded_failure("[1, 2, 3]", limits) == located("more than 2 entries", 1, 8, 7)
  assert bounded_failure(r#"{"a": 1, "b": 2, "c": 3}"#, limits) == located("more than 2 entries", 1, 18, 17)
}

test "write gives the compact text and read gives the value back" {
  let value = Value.Map([
    ("id", Value.Int(1)),
    ("title", Value.Text("say \"hi\"")),
    ("tags", Value.List([])),
    ("at", Value.Moment("2026-11-08")),
    ("raw", Value.Bytes(b"fo")),
    ("ratio", Value.Decimal("0.5")),
    ("none", Value.Null)
  ])
  let text = write(value)?
  assert text == r#"{"id":1,"title":"say \"hi\"","tags":[],"at":"2026-11-08","raw":"Zm8=","ratio":0.5,"none":null}"#
  assert read(text)? == Value.Map([
    ("id", Value.Int(1)),
    ("title", Value.Text("say \"hi\"")),
    ("tags", Value.List([])),
    ("at", Value.Text("2026-11-08")),
    ("raw", Value.Text("Zm8=")),
    ("ratio", Value.Decimal("0.5")),
    ("none", Value.Null)
  ])
}

test "write refuses a decimal that is no JSON number" {
  assert write_failure(Value.List([Value.Decimal("1.5"), Value.Decimal("NaN")])) == Some("decimal `NaN` is not a JSON number")
  assert write_failure(Value.Map([("p", Value.Decimal("1.5"))])) == None
}

// The message of `write(value)`'s error, `None` when it writes.
test fn write_failure(value: Value) -> Option<Text> = match write(value) {
  Ok(_) => None
  Err(e) => Some(e.message)
}

test "write_pretty indents by two spaces, one member or item per line" {
  let value = Value.Map([
    ("a", Value.List([Value.Int(1), Value.Map([("b", Value.Null)])])),
    ("e", Value.List([])),
    ("o", Value.Map([])),
    ("s", Value.Text("x"))
  ])
  let expected = "{{\n  \"a\": [\n    1,\n    {{\n      \"b\": null\n    }}\n  ],\n  \"e\": [],\n  \"o\": {{}},\n  \"s\": \"x\"\n}}"
  assert write_pretty(value)? == expected
  assert read(write_pretty(value)?)? == value
  assert write_pretty(Value.Int(3))? == "3"
}
