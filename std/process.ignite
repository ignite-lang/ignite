package std.process

// Child processes, random bytes and launch arguments (`docs/slice.md` 21.5
// to 21.7). The module is also the substrate's capabilities `Launcher`,
// `ChildProcess`, `Entropy` and `Setting`, handles a system declares as
// resources (all but `ChildProcess`) and passes in values (21.3):
//
//   resource tools: Launcher { maximum_children = 16 }
//   resource entropy: Entropy
//   resource tool: Setting { flag = "--tool", default = "/bin/sh" }
//
// Builtins of the substrate (effects on the receiver's roots, 21.3):
//
//   launcher.execute(invocation) -> Result<ChildExit, IoError>     effect launch; waits on the calling task
//   launcher.start(invocation) -> Result<ChildProcess, IoError>    effect launch; returns at once
//   child.id() -> Int                                              pure; the process and group id
//   child.wait() -> Result<ChildExit, IoError>                     effect wait; once
//   child.kill() -> Result<Unit, IoError>                          effect kill; SIGKILL to the group
//   entropy.random_bytes(count: Int) -> Result<Bytes, IoError>     effect draw; count in 0..=65536
//   setting.value() -> Text                                        effect argument
//
// A `ChildProcess` that `start` returned has no roots, so the fn that
// started it waits for and kills it without further `requires`. Tests make
// capabilities with the test-only `Launcher.new()` (`maximum_children`
// 16), `Entropy.new()` and `Setting.of(flag, value)`.

// What `Launcher.execute` and `Launcher.start` run: `program` is a bare name
// looked up in the child's `PATH` or an absolute path; `arguments` are
// passed as they are, no shell; `directory` is `""` (the program's own) or
// absolute; `environment` entries `NAME=value` apply over the inherited
// environment, or over an empty one when `inherit_environment` is false;
// on `timeout` the child's group is killed; output past `output_limit` per
// stream (at most 16 MiB) is counted in `dropped`, not kept.
type Invocation {
  program: Text
  arguments: List<Text> = []
  directory: Text = ""
  environment: List<Text> = []
  inherit_environment: Bool = true
  timeout: Duration = 30 seconds
  output_limit: ByteSize = 1 MiB
}

// How a child ended: `ending` 0 exited (`code` the status), 1 signalled
// (`code` the signal), 2 timed out, 3 killed (`code` -1 for both);
// `outcome` gives it as an `Ending`.
type ChildExit {
  ending: Int
  code: Int
  stdout: Bytes
  stderr: Bytes
  dropped: Int
}

enum Ending {
  ExitCode(Int)
  BySignal(Int)
  TimedOut
  Killed
}

// The ending of `exit` as an `Ending`.
fn outcome(exit: ChildExit) -> Ending = match exit.ending {
  0 => ExitCode(exit.code)
  1 => BySignal(exit.code)
  2 => TimedOut
  _ => Killed
}

// Whether the child exited with status 0.
fn succeeded(exit: ChildExit) -> Bool = exit.ending == 0 && exit.code == 0

test "outcome maps each ending" {
  let empty = Bytes.empty()
  let exited = ChildExit { ending = 0, code = 3, stdout = empty, stderr = empty, dropped = 0 }
  assert outcome(exited) == ExitCode(3)
  assert !succeeded(exited)
  assert succeeded(ChildExit { ending = 0, code = 0, stdout = empty, stderr = empty, dropped = 0 })
  assert outcome(ChildExit { ending = 1, code = 15, stdout = empty, stderr = empty, dropped = 0 }) == BySignal(15)
  assert outcome(ChildExit { ending = 2, code = -1, stdout = empty, stderr = empty, dropped = 0 }) == TimedOut
  assert outcome(ChildExit { ending = 3, code = -1, stdout = empty, stderr = empty, dropped = 0 }) == Killed
  assert !succeeded(ChildExit { ending = 1, code = 0, stdout = empty, stderr = empty, dropped = 0 })
}

test "an invocation's defaults" {
  let invocation = Invocation { program = "/bin/true" }
  assert invocation.arguments.is_empty()
  assert invocation.directory == ""
  assert invocation.inherit_environment
  assert invocation.timeout == 30 seconds
  assert invocation.output_limit == 1 MiB
}

