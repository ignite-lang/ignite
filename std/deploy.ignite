package std.deploy

// Where the members of a system run (design section 11.3): an assembly
// binds each resource and component to a place. Slice 10 checks the
// declarations (`ignite build` does not read assemblies, `docs/slice.md`
// section 14.7); slice 11 resolves them through `admits` and `includes`
// (section 15.6): the compiler knows these two fn names and `Member`, not
// the variants of `Binding`.

// The place a member is bound to.
enum Binding {
  LocalSocket,
  NativeProcess(List<Ref>),
  WorkstationExecutable,
  ScheduledProbeHost
}

// A listener bound to a socket on this machine.
fn localSocket() -> Binding = LocalSocket

// A component run as a native process that also hosts `includes`.
fn nativeProcess(includes: List<Ref>) -> Binding = NativeProcess(includes)

// A component installed as an executable on a workstation.
fn workstationExecutable() -> Binding = WorkstationExecutable

// A probe run by the host that schedules probes.
fn scheduledProbeHost() -> Binding = ScheduledProbeHost

// A system and the binding of each of its members.
type Deployment {
  system: SystemRef
  bindings: Map<Ref, Binding>
}

// What the compiler tells `admits` about the member a binding is proposed
// for: its declaration (`resource`, `component`, `contract` or `policy`),
// the qualified name of its kind (`TcpListener`, `std.probe.TelnetPrompt`),
// whether it is an executable (its kind has `main`), and the names of the
// `Signal` outputs it leaves unset.
type Member {
  declaration: Text
  kind: Text
  executable: Bool
  outputs: List<Text>
}

// Why `binding` cannot host `member`, or `None` when it can. A local socket
// hosts a `TcpListener` resource, a native process an executable component,
// a workstation executable any component, a scheduled probe host a
// component with at least one output. The reason is the text E112 prints.
fn admits(binding: Binding, member: Member) -> Option<Text> = match binding {
  LocalSocket => if member.declaration == "resource" && member.kind == "TcpListener" {
    None
  } else {
    Some("a local socket hosts a TcpListener resource, not a {member.declaration} of kind {member.kind}")
  }
  NativeProcess(_) => if member.declaration != "component" {
    Some("a native process hosts an executable component, not a {member.declaration}")
  } else if member.executable {
    None
  } else {
    Some("a native process hosts an executable component; {member.kind} has no main")
  }
  WorkstationExecutable => if member.declaration == "component" {
    None
  } else {
    Some("a workstation executable hosts a component, not a {member.declaration}")
  }
  ScheduledProbeHost => if member.declaration != "component" {
    Some("a scheduled probe host hosts a component with an output signal, not a {member.declaration}")
  } else if member.outputs.len() > 0 {
    None
  } else {
    Some("a scheduled probe host hosts a component with an output signal; {member.kind} has none")
  }
}

// The members a binding hosts beside the one it binds.
fn includes(binding: Binding) -> List<Ref> = match binding {
  NativeProcess(members) => members
  _ => []
}

// Whether the binding runs code of its own.
fn is_process(binding: Binding) -> Bool = match binding {
  NativeProcess(_) | WorkstationExecutable | ScheduledProbeHost => true
  LocalSocket => false
}

test "bindings are built by name" {
  assert is_process(nativeProcess(includes = []))
  assert is_process(workstationExecutable())
  assert is_process(scheduledProbeHost())
  assert !is_process(localSocket())
}

test "only a native process includes other members" {
  assert includes(nativeProcess(includes = [])).len() == 0
  assert includes(localSocket()).len() == 0
  assert includes(workstationExecutable()).len() == 0
  assert includes(scheduledProbeHost()).len() == 0
}

fn listener() -> Member = Member { declaration = "resource", kind = "TcpListener", executable = false, outputs = [] }

fn store() -> Member = Member { declaration = "resource", kind = "Store<Todo>", executable = false, outputs = [] }

fn server() -> Member = Member { declaration = "component", kind = "std.protocol.telnet.TelnetServer", executable = true, outputs = [] }

fn console() -> Member = Member { declaration = "component", kind = "std.console.CommandConsole", executable = false, outputs = [] }

fn probe() -> Member = Member { declaration = "component", kind = "std.probe.TelnetPrompt", executable = false, outputs = ["attempts"] }

fn availability() -> Member = Member { declaration = "contract", kind = "std.contract.Availability", executable = false, outputs = [] }

fn restart() -> Member = Member { declaration = "policy", kind = "std.policy.Restart", executable = false, outputs = [] }

test "a local socket admits a TcpListener resource only" {
  assert admits(localSocket(), listener()) == None
  assert admits(localSocket(), store()) == Some("a local socket hosts a TcpListener resource, not a resource of kind Store<Todo>")
  assert admits(localSocket(), server()) == Some("a local socket hosts a TcpListener resource, not a component of kind std.protocol.telnet.TelnetServer")
  assert admits(localSocket(), probe()) != None
}

test "a native process admits an executable component only" {
  assert admits(nativeProcess(includes = []), server()) == None
  assert admits(nativeProcess(includes = []), console()) == Some("a native process hosts an executable component; std.console.CommandConsole has no main")
  assert admits(nativeProcess(includes = []), probe()) == Some("a native process hosts an executable component; std.probe.TelnetPrompt has no main")
  assert admits(nativeProcess(includes = []), listener()) == Some("a native process hosts an executable component, not a resource")
}

test "a workstation executable admits any component" {
  assert admits(workstationExecutable(), server()) == None
  assert admits(workstationExecutable(), console()) == None
  assert admits(workstationExecutable(), probe()) == None
  assert admits(workstationExecutable(), listener()) == Some("a workstation executable hosts a component, not a resource")
}

test "a scheduled probe host admits a component with an output" {
  assert admits(scheduledProbeHost(), probe()) == None
  assert admits(scheduledProbeHost(), server()) == Some("a scheduled probe host hosts a component with an output signal; std.protocol.telnet.TelnetServer has none")
  assert admits(scheduledProbeHost(), console()) != None
  assert admits(scheduledProbeHost(), listener()) == Some("a scheduled probe host hosts a component with an output signal, not a resource")
}

test "no binding admits a contract or a policy" {
  assert admits(localSocket(), availability()) == Some("a local socket hosts a TcpListener resource, not a contract of kind std.contract.Availability")
  assert admits(nativeProcess(includes = []), availability()) == Some("a native process hosts an executable component, not a contract")
  assert admits(workstationExecutable(), restart()) == Some("a workstation executable hosts a component, not a policy")
  assert admits(scheduledProbeHost(), restart()) == Some("a scheduled probe host hosts a component with an output signal, not a policy")
}
