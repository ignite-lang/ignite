package std.data

// The value model every data format reads into and writes from
// (`docs/serde.md` sections 4 to 6, `docs/slice.md` 27): a format module
// turns text into a `Value` and back, a codec turns a typed value into a
// `Value` and back, so N formats and M types need N plus M functions.
// `Shape` carries the naming rules a codec applies, `DecodeError` the
// first place a codec could not decode, `FormatError` the first byte a
// format could not read. A leaf of the base layer: it imports nothing.

enum Value {
  Null,
  Bool(Bool),
  Int(Int),
  // Any number `Int` cannot hold, as its exact text.
  Decimal(Text),
  Text(Text),
  Bytes(Bytes),
  // A date, a time or a date-time, as RFC 3339 text.
  Moment(Text),
  List(List<Value>),
  // Members in document order; a format refuses a duplicate key.
  Map(List<(Text, Value)>)
}

// The spelling of field or variant names on the wire. `Same` keeps the
// declared name.
enum Case {
  Same,
  Camel,
  Pascal,
  Kebab,
  ScreamingSnake
}

// Where an enum's variant tag goes: `External`, a map with one member named
// by the tag; `Internal(member)`, a member of the payload map.
enum Tagging {
  External,
  Internal(Text)
}

// What decoding does with a map member no field names.
enum Unknown {
  Ignore,
  Deny
}

// The bounds of one document a format reads: nesting depth of lists and
// maps, size in bytes, entries of one list or map.
type DataLimits {
  depth: Int = 64
  size: ByteSize = 16 MiB
  entries: Int = 1000000
}

// The wire names and rules a codec applies; the defaults are the
// declared names, external tags, unknown members ignored.
type Shape {
  keys: Case = Same
  variants: Case = Same
  tagging: Tagging = External
  unknown: Unknown = Ignore
  // Exceptions: ("Type.field", "wireName"), ("Type.Variant", "tag").
  renames: List<(Text, Text)> = []
  limits: DataLimits = DataLimits {}
}

fn Shape.default() -> Shape = Shape {}

// The first value a codec could not decode: where (`$.items[2].title`),
// what it expected and what it found.
type DecodeError {
  path: Text
  expected: Text
  found: Text
}

fn describe(error: DecodeError) -> Text = "{error.path}: expected {error.expected}, found {error.found}"

// Why a format could not read or write a document. For a read, the first
// bad byte: `line` and `column` 1-based, `column` in characters, `offset`
// in bytes, as `ignite check --json` gives positions. A write has no
// document to point into and gives 0 for all three.
type FormatError {
  message: Text
  line: Int
  column: Int
  offset: Int
}

// The error at byte `offset` of `text`, with its line and column.
fn format_error(text: Text, message: Text, offset: Int) -> FormatError {
  let bytes = text.to_bytes()
  var line = 1
  var column = 1
  var i = 0
  while i < offset && i < bytes.len() {
    let b = bytes.at(i)
    if b == b'\n' {
      line = line + 1
      column = 1
    } else if b < 0x80 || b >= 0xC0 {
      column = column + 1
    }
    i = i + 1
  }
  FormatError { message, line, column, offset }
}

test "format_error counts lines and characters up to the offset" {
  assert format_error("ab", "m", 0) == FormatError { message = "m", line = 1, column = 1, offset = 0 }
  assert format_error("a\nbc", "m", 3) == FormatError { message = "m", line = 2, column = 2, offset = 3 }
  assert format_error("é€x", "m", 5) == FormatError { message = "m", line = 1, column = 3, offset = 5 }
}

test "the default shape keeps names, tags externally, ignores unknown members and renames nothing" {
  let shape = Shape.default()
  assert shape.keys == Same
  assert shape.variants == Same
  assert shape.tagging == External
  assert shape.unknown == Ignore
  assert shape.renames == []
  assert shape.limits == DataLimits {}
  assert shape == Shape {}
}

test "a decode error describes its path, what was expected and what was found" {
  let error = DecodeError { path = "$.a[1].b", expected = "Int", found = "Text" }
  assert error.describe() == "$.a[1].b: expected Int, found Text"
}
