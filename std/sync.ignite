package std.sync

// Bounded channels between the tasks of one process (`docs/slice.md` 30):
// the substrate's waitable signal. A long-poll, a heartbeat, a ping interval
// or a drain window waits on a channel with a deadline instead of reading a
// loopback socket nobody writes to. The module declares nothing; it is the
// substrate's `Channel`, `Sender<T>` and `Receiver<T>`, and their tests.
//
//   Channel.bounded(capacity: Int) -> (Sender<T>, Receiver<T>)      T from the expected type or later use;
//                                                                   a capacity below 1 fails the task
//   sender.send(value: T) -> Bool                                  effect sender.send; waits while full,
//                                                                   false when the channel is closed
//   sender.try_send(value: T) -> Bool                              effect sender.send; false when full or closed
//   sender.close() -> Unit                                         effect sender.send
//   receiver.receive() -> Option<T>                                effect receiver.receive; waits for a value,
//                                                                   None once the channel is closed and empty
//   receiver.receive_within(timeout: Duration) -> Option<T>        effect receiver.receive; None at the deadline too
//   receiver.closed() -> Bool                                      effect receiver.receive
//   receiver.close() -> Unit                                       effect receiver.receive
//
// Both ends are handles: a copy shares the end, and a spawned task takes the
// end it is given. A value is moved into the channel by `send` and out of it
// by `receive`; no two tasks share it. `close` on either end, or the last
// handle of all senders or of all receivers going away, closes the channel:
// every waiting `send` returns false, and every waiting `receive` returns
// what was sent before, then `None`. An end is released with its last
// owner wherever it was moved: a second binding, an annotated tuple, a
// record field, a `Store` and back (case study gap G30, `docs/slice.md`
// 30.3); the soaks at the end hold each form flat.

import std.runtime.{soak}

test fn ring_after(bell: Sender<Text>, delay: Duration) -> Result<Unit, IoError> {
  Clock.sleep(delay)
  bell.send("ring")
  Ok(())
}

test fn take_after(values: Receiver<Int>, delay: Duration, taken: Sender<Int>) -> Result<Unit, IoError> {
  Clock.sleep(delay)
  match values.receive() {
    Some(value) => taken.send(value)
    None => taken.send(0 - 1)
  }
  Ok(())
}

test fn wait_and_report(values: Receiver<Int>, reports: Sender<Text>) -> Result<Unit, IoError> {
  let report = match values.receive() {
    Some(_) => "value"
    None => "ended"
  }
  reports.send(report)
  Ok(())
}

test fn send_and_report(values: Sender<Int>, reports: Sender<Text>) -> Result<Unit, IoError> {
  let report = if values.send(2) { "sent" } else { "refused" }
  reports.send(report)
  Ok(())
}

test fn produce(values: Sender<Int>, count: Int) -> Result<Unit, IoError> {
  var i = 0
  while i < count {
    values.send(i)
    i = i + 1
  }
  Ok(())
}

test "values arrive in order and a full channel refuses try_send" {
  let (tx, rx) = Channel.bounded(2)
  assert tx.try_send(1)
  assert tx.try_send(2)
  assert !tx.try_send(3)
  assert rx.receive() == Some(1)
  assert tx.send(3)
  assert rx.receive() == Some(2)
  assert rx.receive() == Some(3)
}

test "receive_within returns None at its deadline" {
  let (tx, rx) = Channel.bounded(1)
  let started = Clock.monotonic()
  assert rx.receive_within(50 ms) == None
  assert Clock.monotonic() - started >= 50 ms
  assert !rx.closed()
  assert tx.send(7)
  assert rx.receive_within(0 ms) == Some(7)
  assert rx.receive_within(0 ms - 1 seconds) == None
}

test "a send from another task wakes a waiting receiver" {
  let (bell, rings) = Channel.bounded(1)
  let started = Clock.monotonic()
  spawn ring_after(bell, 50 ms)
  assert rings.receive_within(5 seconds) == Some("ring")
  let waited = Clock.monotonic() - started
  assert waited >= 50 ms
  assert waited < 4 seconds
}

test "send waits while the channel is full" {
  let (tx, rx) = Channel.bounded(1)
  let (taken, took) = Channel.bounded(1)
  assert tx.send(1)
  let started = Clock.monotonic()
  spawn take_after(rx, 50 ms, taken)
  assert tx.send(2)
  assert Clock.monotonic() - started >= 50 ms
  assert took.receive_within(5 seconds) == Some(1)
  assert rx.receive() == Some(2)
}

test "closing a channel ends every waiter" {
  let (tx, rx) = Channel.bounded(1)
  let (report, reports) = Channel.bounded(8)
  spawn wait_and_report(rx, report)
  spawn wait_and_report(rx, report)
  spawn wait_and_report(rx, report)
  Clock.sleep(50 ms)
  tx.close()
  assert reports.receive_within(5 seconds) == Some("ended")
  assert reports.receive_within(5 seconds) == Some("ended")
  assert reports.receive_within(5 seconds) == Some("ended")
  assert rx.closed()
  assert !tx.send(1)
  assert !tx.try_send(1)
  let (full, sink) = Channel.bounded(1)
  assert full.send(1)
  spawn send_and_report(full, report)
  Clock.sleep(50 ms)
  sink.close()
  assert reports.receive_within(5 seconds) == Some("refused")
}

test "a closed channel still gives what was sent before" {
  let (tx, rx) = Channel.bounded(4)
  assert tx.send(1)
  assert tx.send(2)
  tx.close()
  assert rx.closed()
  assert rx.receive() == Some(1)
  assert rx.receive_within(1 seconds) == Some(2)
  assert rx.receive() == None
}

test "the last sender gone closes the channel" {
  let (tx, rx) = Channel.bounded(2)
  spawn produce(tx, 5)
  var sum = 0
  var count = 0
  loop {
    match rx.receive_within(5 seconds) {
      Some(value) => {
        sum = sum + value
        count = count + 1
      }
      None => break
    }
  }
  assert count == 5
  assert sum == 10
  assert rx.closed()
}

test "a value sent is the receiver's own" {
  let (tx, rx) = Channel.bounded(1)
  var items = [1, 2]
  assert tx.send(items)
  items.push(3)
  assert rx.receive() == Some([1, 2])
  assert items == [1, 2, 3]
}

test type Ends {
  tx: Sender<Int>
  rx: Receiver<Int>
}

test fn ends() -> Ends {
  let pair: (Sender<Int>, Receiver<Int>) = Channel.bounded(2)
  Ends { tx = pair.0, rx = pair.1 }
}

test fn ring(senders: Store<Sender<Int>>, id: Int, value: Int) -> Bool requires [senders.read, senders.send] {
  match senders.get(id) {
    Some(tx) => tx.try_send(value)
    None => false
  }
}

test "an end found in a Store needs no annotation" {
  let (tx, rx) = Channel.bounded(2)
  let senders: Store<Sender<Int>> = Store.new()
  let id = senders.next_id()
  senders.put(id, tx)
  assert ring(senders, id, 5)
  assert !ring(senders, id + 1, 6)
  assert rx.receive_within(1 seconds) == Some(5)
}

test "the ends of a returned record need no annotation" {
  let d = ends()
  assert d.tx.try_send(9)
  assert d.rx.receive_within(1 seconds) == Some(9)
}

// Case study gap G30 (`docs/leak-guard.md` 1.1, 6.1): the reproducer's
// four forms of a channel end moved out of its `let (tx, rx)` binding, each
// run 2,000 times. Until the LLVM lowering released a moved end, each kept
// a filled handle slot and a channel per run.

test type Waiter {
  id: Int
  wake: Receiver<Int>
}

test fn alias_end(run: Int) -> Unit {
  let (tx, rx) = Channel.bounded(1)
  let r: Receiver<Int> = rx
  let rung = tx.try_send(run)
  tx.close()
  let got = r.receive_within(0 ms)
}

test fn typed_ends(run: Int) -> Unit {
  let ends: (Sender<Int>, Receiver<Int>) = Channel.bounded(1)
  let rung = ends.0.try_send(run)
  ends.0.close()
  let got = ends.1.receive_within(0 ms)
}

test fn field_end(run: Int) -> Unit {
  let (tx, rx) = Channel.bounded(1)
  let w = Waiter { id = run, wake = rx }
  let rung = tx.try_send(run)
  tx.close()
  let got = w.wake.receive_within(0 ms)
}

test fn open_waiter(senders: Store<Sender<Int>>) -> Waiter {
  let (tx, rx) = Channel.bounded(1)
  let id = senders.next_id()
  senders.put(id, tx)
  Waiter { id, wake = rx }
}

test fn close_waiter(senders: Store<Sender<Int>>, w: Waiter) -> Unit {
  match senders.remove(w.id) {
    Some(found) => {
      let tx: Sender<Int> = found
      tx.close()
    }
    None => {}
  }
}

test fn stored_end(senders: Store<Sender<Int>>) -> Unit {
  let w: Waiter = open_waiter(senders)
  let got = w.wake.receive_within(0 ms)
  close_waiter(senders, w)
}

test "a channel end bound a second time is released (G30)" {
  assert soak(2000, alias_end).growth == []
}

test "a channel end kept in a record field is released (G30)" {
  assert soak(2000, field_end).growth == []
}

test "an annotated pair of channel ends is released (G30)" {
  assert soak(2000, typed_ends).growth == []
}

test "a channel end put in a store and taken out is released (G30)" {
  let senders: Store<Sender<Int>> = Store.new()
  assert soak(2000, |run| stored_end(senders)).growth == []
}
