fn total(items: List<Int>) -> Int {
  var sum = 0
  for item in items {
    sum = sum + item
  }
  return sum
}

fn pushed() -> Int {
  var xs = []
  xs.push(1)
  var ys = List.empty()
  ys.push("a")
  var zs = List.with_capacity(4)
  zs.push(true)
  return xs.len() + ys.len() + zs.len()
}

fn passed() -> Int {
  let xs = List.empty()
  return total(xs)
}

fn passed_with_capacity() -> Int {
  let xs = List.with_capacity(16)
  return total(xs) + Bytes.with_capacity(16).len()
}

fn returned() -> Option<Text> {
  let none = None
  return none
}

fn assigned(flag: Bool) -> Result<Int, Text> {
  var r = Ok(1)
  if flag {
    r = Err("no")
  }
  return r
}

test "later uses decide" {
  var seen = []
  seen.push(true)
  assert seen.len() == 1
}
