type Holder {
  handler: fn(TcpStream) -> Result<Unit, IoError>
}

fn send(stream: TcpStream) -> Result<Unit, IoError> requires [stream.write] {
  return stream.write_all("hi".to_bytes())
}

fn relay(stream: TcpStream) -> Result<Unit, IoError> = send(stream)

fn twice(n: Int) -> Int = n * 2

fn run(stream: TcpStream) -> Result<Unit, IoError> requires [stream.write] {
  let handler = send
  let inferred = relay
  let pure = twice
  let holder = Holder { handler = send }
  return send(stream)
}
