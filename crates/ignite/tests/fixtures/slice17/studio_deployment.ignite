package studio_deployment

import std.deploy.{Deployment, localSocket, nativeProcess}
import std.protocol.http.*

// `docs/slice.md` 15.6 and 21.3: the studio of row 26 under the standard
// `Deployment`. Its capability resources are no bindings keys: each is
// hosted by the process of the member that uses it, so the assembly binds
// only the listener and the server. The server is the standard
// `HttpServer`, whose `machine` hook (16.16) gives `ignite run` its
// supervisor; without the hook `nativeProcess` is E129.
//   GET /tool   200 with the setting's value
//   GET /root   200 with the root as resolved at launch

type Bench {
  files: Directory
  tools: Launcher
  entropy: Entropy
  tool: Setting
}

fn handle(state: Bench, request: Request) -> Response = match (request.method, request.segments()) {
  ("GET", ["tool"]) => Response.plain(200, state.tool.value())
  ("GET", ["root"]) => match state.files.absolute_path() {
    Ok(root) => Response.plain(200, root)
    Err(error) => Response.plain(500, error.message)
  }
  _ => status_response(404)
}

system Studio {
  resource ingress: TcpListener { address = "127.0.0.1", port = 8095 }
  resource files: Directory { path = "workspace", create = true, flag = "--root" }
  resource tools: Launcher
  resource entropy: Entropy
  resource tool: Setting { flag = "--tool", default = "/bin/sh" }

  component server: HttpServer {
    listener = ingress
    application = HttpApp { state = Bench { files = files, tools = tools, entropy = entropy, tool = tool }, handle }
    executable = "studiod"
  }
}

assembly local: Deployment {
  system = Studio
  bindings = {
    Studio.ingress = localSocket()
    Studio.server = nativeProcess(includes = [])
  }
}
