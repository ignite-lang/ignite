package studio

import std.fs.{read_text_file, write_text_file}
import std.process.Invocation
import std.protocol.http.*
import std.text.*

// P3 of `docs/slice.md` 21.3: a handler with no `requires` that reaches all
// four capabilities through its state.
//   POST /write   body `name\ncontent`: writes `content` to `name`; 204
//   POST /read    body `name`: 200 with the file's text
//   POST /run     runs `--tool` with `-c "cat a.ignite"` in the root; 200 with its stdout
//   GET /token    32 random bytes as 64 lowercase hex digits

type Bench {
  files: Directory
  tools: Launcher
  entropy: Entropy
  tool: Setting
}

fn hex_digit(n: Byte) -> Byte = if n < 10 { b'0' + n } else { b'a' + n - 10 }

fn hex(bytes: Bytes) -> Text {
  var out = Bytes.empty()
  for b in bytes {
    out.push(hex_digit(b / 16))
    out.push(hex_digit(b % 16))
  }
  out.to_text()
}

fn failed(error: IoError) -> Response = Response.plain(400, error.message)

fn write(state: Bench, body: Text) -> Response = match body.split_once("\n") {
  Some((name, content)) => match write_text_file(state.files, name, content) {
    Ok(_) => status_response(204)
    Err(error) => failed(error)
  }
  None => status_response(400)
}

fn read(state: Bench, body: Text) -> Response = match read_text_file(state.files, body) {
  Ok(text) => Response.plain(200, text)
  Err(error) => failed(error)
}

fn run(state: Bench) -> Response = match state.files.absolute_path() {
  Ok(root) => {
    let invocation = Invocation { program = state.tool.value(), arguments = ["-c", "cat a.ignite"], directory = root }
    match state.tools.execute(invocation) {
      Ok(exit) => Response.plain(200, exit.stdout.to_text())
      Err(error) => failed(error)
    }
  }
  Err(error) => failed(error)
}

fn token(state: Bench) -> Response = match state.entropy.random_bytes(32) {
  Ok(bytes) => Response.plain(200, hex(bytes))
  Err(error) => failed(error)
}

fn handle(state: Bench, request: Request) -> Response = match (request.method, request.segments()) {
  ("POST", ["write"]) => write(state, request.body)
  ("POST", ["read"]) => read(state, request.body)
  ("POST", ["run"]) => run(state)
  ("GET", ["token"]) => token(state)
  _ => status_response(404)
}

system Studio {
  resource ingress: TcpListener { address = "127.0.0.1", port = 8095 }
  resource files: Directory { path = "workspace", create = true, flag = "--root" }
  resource tools: Launcher
  resource entropy: Entropy
  resource tool: Setting { flag = "--tool" }

  component server: HttpServer {
    listener = ingress
    application = HttpApp { state = Bench { files = files, tools = tools, entropy = entropy, tool = tool }, handle }
    executable = "studiod"
  }
}
