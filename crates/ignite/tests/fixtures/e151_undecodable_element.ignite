package fixture_e151

import std.deploy.Member
import std.control.{Machine, Evaluator}
import std.sli.{MissingData, rolling}

// E151 (`docs/slice.md` 22.3, 22.10): a signal the assembly runs and a
// machine subscribes to must carry an outcome type. `S.p.beats` carries a
// fn, which no probe prints; `S.q.counts` carries an `Int` and passes.

type Ticker {
  interval: Duration = 10 seconds
  beats: Signal<fn() -> Int>
}

fn Ticker.main(self: Ticker) -> Result<Unit, IoError> = Ok(Unit)

type Counter {
  interval: Duration = 10 seconds
  counts: Signal<Int>
}

fn Counter.main(self: Counter) -> Result<Unit, IoError> = Ok(Unit)

type Watch {
  signal: Signal<fn() -> Int>
}

fn Watch.machine(self: Watch, id: Text) -> Machine = Machine.Evaluate(Evaluator {
  id = "{id}.evaluator"
  contract = id
  signal = self.signal.to_text()
  target = 99%
  window = rolling(1 hour)
  missing_data = MissingData.InsufficientEvidence
  minimum_completeness = 90%
})

fn Watch.classify(self: Watch, sample: fn() -> Int) -> Bool = sample() > 0

type Tally {
  signal: Signal<Int>
}

fn Tally.machine(self: Tally, id: Text) -> Machine = Machine.Evaluate(Evaluator {
  id = "{id}.evaluator"
  contract = id
  signal = self.signal.to_text()
  target = 99%
  window = rolling(1 hour)
  missing_data = MissingData.InsufficientEvidence
  minimum_completeness = 90%
})

fn Tally.classify(self: Tally, sample: Int) -> Bool = sample > 0

enum Host {
  Runner
}

fn runner() -> Host = Runner

fn admits(binding: Host, member: Member) -> Option<Text> = None

fn includes(binding: Host) -> List<Ref> = []

fn entries(binding: Host) -> List<Text> = match binding {
  Runner => ["main"]
}

type Plan {
  system: SystemRef
  bindings: Map<Ref, Host>
}

system S {
  component p: Ticker {}
  component q: Counter {}
  contract c: Watch { signal = p.beats }
  contract t: Tally { signal = q.counts }
}

assembly a: Plan {
  system = S
  bindings = {
    S.p = runner()
    S.q = runner()
  }
}
