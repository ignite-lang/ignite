package fixture_e129

import std.deploy.Member

type Worker {
  name: Text
  executable: Text
}

fn Worker.main(self: Worker) -> Result<Unit, IoError> = Ok(Unit)

type Watcher {
  name: Text
  attempts: Signal<Int>
}

enum Host {
  Shelf,
  Runner
}

fn shelf() -> Host = Shelf

fn runner() -> Host = Runner

fn admits(binding: Host, member: Member) -> Option<Text> = None

fn includes(binding: Host) -> List<Ref> = []

fn entries(binding: Host) -> List<Text> = match binding {
  Shelf => []
  Runner => ["main", "machine"]
}

type Plan {
  system: SystemRef
  bindings: Map<Ref, Host>
}

system S {
  component w: Worker { name = "w" }
  component v: Watcher { name = "v" }
  component shelved: Watcher { name = "s" }
}

assembly a: Plan {
  system = S
  bindings = {
    S.w = runner()
    S.v = runner()
    S.shelved = shelf()
  }
}
