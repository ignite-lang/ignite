package tests.http_owner

import std.protocol.http.*
import std.net.TcpStream

// Built for both targets and run by tests/stream_ownership.rs (story
// `llvm-http-connection-closes-its-socket`): an `HttpServer` whose
// application is the owner of a connection for a while. `/hold` holds the
// request until a request for `/release` answers every held one; `/take`
// takes the connection over, greets and echoes what it reads until the
// client ends it; any other path is answered at once.

// A held request: the end its answer is sent to, under its id in the
// store.
type Waiting {
  id: Int
  wake: Sender<Response>
}

fn echo(state: Store<Waiting>, request: Request, stream: TcpStream, early: Bytes) -> IoResult<Unit> requires [stream.read, stream.write] {
  stream.write_all(b"taken\n")?
  loop {
    match stream.read(4096)? {
      Eof => return Ok(())
      Data(bytes) => stream.write_all(bytes)?
    }
  }
}

// Answers every held request and forgets it; how many took their answer.
// An end is sent to once: a held request closes its receiver a moment
// after it has taken its answer (`wait_held`), and until then a second
// send would be taken too, counted, and answer nobody.
fn release(state: Store<Waiting>) -> Int {
  var released = 0
  for waiting in state.values() {
    if waiting.wake.send(Response.plain(200, "released")) {
      released = released + 1
    }
    _ = state.remove(waiting.id)
  }
  released
}

fn answer(state: Store<Waiting>, request: Request) -> Reply<Store<Waiting>, TcpStream> {
  if request.path == "/hold" {
    let (tx, rx) = Channel.bounded(1)
    let id = state.next_id()
    state.put(id, Waiting { id, wake = tx })
    return Hold(rx, 60 seconds, Response.plain(504, "not released"))
  }
  if request.path == "/take" {
    return Upgrade(Response { status = 101, headers = [("Upgrade", "echo"), ("Connection", "upgrade")] }, echo)
  }
  if request.path == "/release" {
    return Respond(Response.plain(200, "{release(state)}"))
  }
  Respond(Response.plain(200, "ok"))
}

system Owner {
  resource listener: TcpListener { address = "127.0.0.1", port = 0 }
  resource waiters: Store<Waiting>

  component server: HttpServer {
    listener = listener
    application = HttpApp { state = waiters, reply = Some(answer) }
    executable = "ownerd"
  }
}
