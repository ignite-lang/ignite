package std.rfc

// The requirement keywords of BCP 14 (RFC 2119, RFC 8174).
enum Level { Must, MustNot, Required, Shall, ShallNot, Should, ShouldNot, Recommended,
  NotRecommended, May, Optional }

// Whom a requirement addresses.
enum Party { Any, Sender, Recipient, Client, Server, Proxy }

// Bcp14: extracted from a <bcp14> mark; Prose: written by hand from an RFC that predates BCP 14,
// or from a specification that is no RFC.
enum Source { Bcp14, Prose }

// `rfc` is the RFC's number; 0, the default, for a specification that is no RFC.
type Requirement {
  rfc: Int = 0
  section: Text
  ordinal: Int
  level: Level
  party: Party = Any
  source: Source = Bcp14
  minimum: Option<Int> = None
  text: Text
}

// `id` names a specification that is no RFC ("jsonrpc-2.0"), whose `rfc` is 0; an RFC's is "".
type Spec {
  rfc: Int = 0
  title: Text
  url: Text
  digest: Text
  requirements: List<Requirement>
  id: Text = ""
}
