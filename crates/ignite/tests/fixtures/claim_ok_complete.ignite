package tests.claim_ok

import std.rfc.{Level, Party, Source, Requirement, Spec}

const RFC7001: Spec = Spec {
  rfc = 7001
  title = "A line echo whose every rule has a status"
  url = "https://example.invalid/rfc7001"
  digest = "sha256:7001"
  requirements = [R2_1, R2_2, R2_3, R2_4, R2_5, R2_6, R2_7]
}

const R2_1: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 1
  level = Must
  text = "A server MUST echo every line."
}

const R2_2: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 2
  level = MustNot
  text = "A server MUST NOT add bytes to a line."
}

const R2_3: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 3
  level = Required
  text = "A line end is REQUIRED."
}

const R2_4: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 4
  level = Shall
  text = "A server SHALL close on QUIT."
}

const R2_5: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 5
  level = ShallNot
  text = "A server SHALL NOT close before QUIT."
}

const R2_6: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 6
  level = Should
  text = "A server SHOULD answer within a second."
}

const R2_7: Requirement = Requirement {
  rfc = 7001
  section = "2"
  ordinal = 7
  level = May
  text = "A server MAY greet."
}

type Line satisfies [RFC7001.R2_3] {
  text: Text
}

fn echo(line: Line) -> Text satisfies [RFC7001.R2_1, RFC7001.R2_2] = line.text

protocol Echo conforms [RFC7001] {
  fn serve(stream: TcpStream, application: fn(Text) -> Text) -> Result<Unit, IoError> requires [stream.write] satisfies [RFC7001.R2_1] {
    return stream.write_all(b"ok")
  }

  unsupported RFC7001.R2_4 "a session ends only at the end of its input"
  not_applicable RFC7001.R2_5 "the fixture never closes"
  unsupported RFC7001.R2_6 "no answer is timed"
  not_applicable RFC7001.R2_7 "the fixture never greets"
}

test "a line is echoed as it was read" verifies [RFC7001.R2_1, RFC7001.R2_2] {
  assert echo(Line { text = "hi" }) == "hi"
}
