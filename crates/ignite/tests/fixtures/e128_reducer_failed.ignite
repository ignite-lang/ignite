// ignite run --fuel 1
package fixture_e128

import std.deploy.{Deployment, nativeProcess}
import std.control.{Machine, Supervisor}
import std.policy.{Restart, fixed}

// E128 (`docs/slice.md` 16.17): a reducer that fails at run time. With
// `--fuel 1` the first step of the supervisor exceeds its fuel: the run
// journals an `error` record, the machine stops, the run goes on and
// `stop` exits 1.

type Daemon {
  name: Text
}

fn Daemon.main(self: Daemon) -> Result<Unit, IoError> = Ok(Unit)

fn Daemon.machine(self: Daemon, id: Text) -> Machine = Machine.Supervise(Supervisor {
  id = "{id}.supervisor"
  member = id
  restart = Restart { backoff = fixed(100 ms), maximum_attempts = 1, interval = 1 minutes }
  has_listener = false
})

system S {
  component daemon: Daemon { name = "d" }
}

assembly local: Deployment {
  system = S
  bindings = {
    S.daemon = nativeProcess(includes = [])
  }
}
