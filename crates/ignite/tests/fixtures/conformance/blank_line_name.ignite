package tests.conformance.blank_line_name

import std.rfc.{Level, Party, Source, Requirement, Spec}

const RFC7306: Spec = Spec {
  rfc = 7306
  title = "Line Echo"
  url = "https://example.invalid/rfc7306"
  digest = "sha256:7306"
  requirements = [R2_1]
}

const R2_1: Requirement = Requirement {
  rfc = 7306
  section = "2"
  ordinal = 1
  level = Must
  text = "A server MUST echo every line."
}

fn echo(line: Text) -> Text satisfies [RFC7306.R2_1] = line

protocol Echo conforms [RFC7306] {
  fn serve(stream: TcpStream, application: fn(Text) -> Text) -> Result<Unit, IoError> requires [stream.write] {
    return stream.write_all(b"ok")
  }
}

test "a name\n\nwith a blank line" {
  assert true
}

test "a line is echoed" verifies [RFC7306.R2_1] {
  assert echo("hi") == "hi"
}
