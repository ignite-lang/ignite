// Adversary cases for slice 16 U4 (docs/slice.md 20.3.2): an argument that is
// evaluated first and copied only once every argument is evaluated (named
// arguments, variant payloads) keeps the value it had when it was evaluated,
// even when a later argument moves the same place into a fn that changes its
// parameter in place. With copies, each fn below returns what its test asserts.

type State {
  items: List<Int>
  count: Int
}

fn bump_count(x: State) -> Int {
  x.items.push(5)
  x.items.len()
}

fn weigh(first: State, second: Int) -> Int {
  first.items.push(0)
  first.items.len() * 10 + second
}

enum Pairing {
  Both(State, Int),
  Neither,
}

fn named_order() -> Int {
  let s = State { items = [1], count = 1 }
  weigh(first = s, second = bump_count(s))
}

fn payload_order() -> Int {
  let s = State { items = [1], count = 1 }
  match Both(s, bump_count(s)) {
    Both(st, n) => st.items.len() * 10 + n
    Neither => 0
  }
}

test "a named argument keeps its value when a later argument moves it" {
  assert named_order() == 22
}

test "a variant payload keeps its value when a later payload moves it" {
  assert payload_order() == 12
}
