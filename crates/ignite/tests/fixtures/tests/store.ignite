package fixtures.store

// `Store<T>` under `ignite test` on both targets (crates/ignite/tests/ignite_test.rs):
// a failure inside `update`'s `f`, which runs under the store's lock, ends
// its task with its report and leaves the store usable.

fn overflow(s: Store<Int>, done: PipeStream) -> Result<Unit, IoError> requires [s.write, done.write] {
  _ = s.update(1, |v| v + 1)
  done.write_all(b"not failed")?
  Ok(())
}

test fn end(stream: PipeStream) -> PipeStream = stream

// The read end of a pipe whose write end only the task `overflow` holds:
// it reads the end of the stream once the task has ended. The write end is
// bound by a call, not by the pattern, so that the LLVM target moves it to
// the task (`docs/llvm.md` section 4) and a failure of the task closes it.
test fn start_overflow(s: Store<Int>) -> PipeStream requires [s.write] {
  let (a, write) = Pipe.pair()
  let b = end(write)
  spawn overflow(s, b)
  a
}

test "an overflow in update in a task leaves the store usable" {
  let s: Store<Int> = Store.new()
  s.put(1, 9223372036854775807)
  let a = start_overflow(s)
  match a.read(16)? {
    Eof => {}
    Data(_) => {
      assert false, "the update did not fail"
    }
  }
  assert s.get(1) == Some(9223372036854775807)
  s.put(2, 5)
  assert s.update(2, |v| v * 2) == Some(10)
}

test "an overflow in update ends its test" {
  let s: Store<Int> = Store.new()
  s.put(1, 9223372036854775807)
  _ = s.update(1, |v| v + 1)
}
