package checker_names

type World {
  numbers: Store<Int>
}

fn set(o: List<(Text, Text)>, key: Text, raw: Text) -> List<(Text, Text)> {
  var out = o
  out.push((key, raw))
  out
}

fn len(items: List<Int>) -> Int = 100 + items.len()

test "a plain call of a user fn named like a builtin calls the user fn" {
  assert set([], "a", "1") == [("a", "1")]
  assert len([1, 2]) == 102
}

test "method syntax on a list still calls the builtin" {
  var pairs = [("x", "0")]
  pairs.set(0, ("y", "1"))
  assert pairs == [("y", "1")]
  assert [1, 2].len() == 2
}

test "an unannotated record binding calls a Store method" {
  let w = World { numbers = Store.new() }
  w.numbers.put(1, 2)
  assert w.numbers.get(1) == Some(2)
}
