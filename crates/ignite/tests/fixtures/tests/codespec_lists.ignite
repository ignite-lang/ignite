package fixtures.codespec_lists

// List element assignment, `List + List` and `Stderr` (story codespec-friction,
// `docs/slice.md` 25.3 to 25.5), run by `ignite test` on both targets in debug and
// release (crates/ignite/tests/ignite_test.rs `codespec_stderr_and_lists_on_both_targets`).
// Two tests fail on purpose: the out-of-range assignment and the one that shows
// what it wrote to each stream.

type Cell {
  name: Text
  rows: List<Int>
}

test "element assignment replaces one element" {
  var xs = [1, 2, 3]
  xs[0] = 10
  xs[2] = xs[0] + xs[1]
  assert xs == [10, 2, 12]
  var names = ["a", "b"]
  names[1] = names[0] + "!"
  assert names == ["a", "a!"]
}

test "element assignment through fields and nested lists" {
  var cell = Cell { name = "c", rows = [0, 0] }
  cell.rows[1] = 5
  assert cell.rows == [0, 5]
  var grid = [[1, 2], [3, 4]]
  grid[1][0] = 9
  grid[0] = [7]
  assert grid == [[7], [9, 4]]
  var cells = [Cell { name = "x", rows = [] }]
  cells[0] = Cell { name = "y", rows = [1] }
  assert cells[0].name == "y"
}

fn replaced(xs: List<Text>, i: Int, v: Text) -> List<Text> {
  var out = xs
  out[i] = v
  out
}

test "element assignment leaves the source list alone" {
  let xs = ["a", "b", "c"]
  assert replaced(xs, 1, "B") == ["a", "B", "c"]
  assert xs == ["a", "b", "c"]
}

test "element assignment out of range fails as indexing does" {
  var xs = [1, 2, 3]
  xs[3] = 4
}

test "List + List concatenates" {
  let a = [1, 2]
  let b = [3]
  assert a + b == [1, 2, 3]
  assert a + [] == a
  assert [] + b == b
  assert ["x"] + ["y", "z"] + ["w"] == ["x", "y", "z", "w"]
  assert b"ab" + b"c" == b"abc"
  var c = a + b
  c.push(4)
  assert a == [1, 2]
  assert c == [1, 2, 3, 4]
  let nested = [[1]] + [[2, 3]]
  assert nested == [[1], [2, 3]]
}

test "Stderr is a stream of its own" {
  Stdout.write_all(b"to out\n")?
  Stderr.write_all(b"to err\n")?
  assert false
}
