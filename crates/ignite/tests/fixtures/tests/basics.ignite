package fixtures.basics

// Tests of `ignite test` (crates/ignite/tests/ignite_test.rs): passing and
// failing asserts, `?`, panics, exits, captured output and a socket.

type Point { x: Int, y: Int }

fn to_text(point: Point) -> Text = "({point.x}, {point.y})"

fn parse(text: Text) -> Result<Int, IoError> = match Int.parse(text) {
  Some(n) => Ok(n)
  None => Err(IoError.new("not a number: {text}"))
}

fn echo(stream: TcpStream) -> Result<Unit, IoError> requires [stream.read, stream.write] {
  let input = stream.read(16)?
  match input {
    Data(bytes) => stream.write_all(bytes)?
    Eof => {}
  }
  return Ok(())
}

test fn origin() -> Point = Point { x = 0, y = 0 }

test "arithmetic passes" {
  assert 1 + 1 == 2
  assert origin() == Point { x = 0, y = 0 }
  assert parse("42")? == 42
}

test "int differs" {
  assert 1 + 1 == 3
}

test "text differs" {
  assert " ab ".trim() == "ab "
}

test "record differs" {
  assert Point { x = 1, y = 2 } == Point { x = 1, y = 3 }
}

test "custom message" {
  let n = 4
  assert n < 3, "n is {n}"
}

test "try on err fails" {
  let n = parse("x")?
  assert n == 0
}

test "try on none fails" {
  let n = Int.parse("x")?
  assert n == 0
}

test "index out of range panics" {
  let items = [1, 2]
  assert items[5] == 0
}

test "exit code 3" {
  Process.exit(3)
}

test "output shown on failure" {
  Stdout.write_all(b"captured out\n")?
  assert false
}

test "output hidden on success" {
  Stdout.write_all(b"hidden out\n")?
}

test "tcp echo through a task" {
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  let server = listener.accept()?
  spawn echo(server)
  client.write_all(b"hi")?
  match client.read(16)? {
    Data(bytes) => {
      assert bytes.to_text() == "hi"
    }
    Eof => {
      assert false, "unexpected end of stream"
    }
  }
}
