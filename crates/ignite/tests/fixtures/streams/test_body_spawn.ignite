package tests.streams

// Run on both targets by tests/stream_ownership.rs (story
// llvm-spawn-pattern-bound-streams): a pipe end bound by a pattern in a
// test body and spawned at its last use belongs to the task, so the task's
// failure closes it while the test body still runs. An end the test body
// uses after its spawn stays the body's too and outlives the task.

import std.net.{Pipe, PipeStream}
import std.io.IoError

type IoResult<T> = Result<T, IoError>

fn fails(stream: PipeStream) -> IoResult<Unit> requires [stream.write] {
  let values = [1, 2]
  assert values.len() == 3
  stream.write_all(b"never")?
  Ok(())
}

fn greets(stream: PipeStream) -> IoResult<Unit> requires [stream.write] {
  stream.write_all(b"hi")?
  Ok(())
}

test fn rest(client: PipeStream) -> IoResult<Bytes> {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
}

test fn exactly(client: PipeStream, count: Int) -> IoResult<Bytes> {
  var out = Bytes.empty()
  while out.len() < count {
    match client.read(count - out.len())? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
  Ok(out)
}

test "a failing task closes a pattern-bound pipe end spawned from the test body" {
  let (client, server) = Pipe.pair()
  spawn fails(server)
  assert rest(client)? == b""
}

test "a pipe end used after its spawn stays open for the test body" {
  let (client, server) = Pipe.pair()
  spawn greets(server)
  assert exactly(client, 2)? == b"hi"
  server.write_all(b"!")?
  assert exactly(client, 1)? == b"!"
}
