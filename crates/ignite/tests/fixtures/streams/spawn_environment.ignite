package tests.streams

// Run on both targets by tests/stream_ownership.rs: a spawned task gets
// the arguments the spawn saw, borrowed or owned, also when the spawning
// loop frees and reuses the memory they were built in at once. The LLVM
// target copies them into transfer memory and does not wait for the task
// (story spawn-without-handshake, docs/llvm.md section 4).

import std.net.{Pipe, PipeStream}
import std.io.IoError

type IoResult<T> = Result<T, IoError>

type Greeting {
  words: List<Text>
  count: Int
}

fn greets(stream: PipeStream, greeting: Greeting, tail: Text) -> IoResult<Unit> requires [stream.write] {
  var line = ""
  for word in greeting.words {
    line = "{line}{word}"
  }
  stream.write_all("{line}{greeting.count}{tail};".to_bytes())?
  Ok(())
}

test fn rest(client: PipeStream) -> IoResult<Text> {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out.to_text())
      Data(bytes) => out.append(bytes)
    }
  }
}

test "every task reads the arguments its spawn saw" {
  var clients: List<PipeStream> = []
  var expected: List<Text> = []
  var i = 0
  while i < 40 {
    let (client, server) = Pipe.pair()
    var words: List<Text> = []
    var j = 0
    while j < 8 {
      words.push("w{i}.{j}-")
      j = j + 1
    }
    let greeting = Greeting { words = words, count = i }
    let tail = "/{i * 7}"
    spawn greets(server, greeting, tail)
    clients.push(client)
    var line = ""
    for word in words {
      line = "{line}{word}"
    }
    expected.push("{line}{i}/{i * 7};")
    i = i + 1
  }
  var k = 0
  while k < 40 {
    assert rest(clients[k])? == expected[k]
    k = k + 1
  }
}
