package fixtures.bitwise.codecs

import std.digest.sha1
import std.encoding.{base64, hex}

// SHA-1 (RFC 3174) and base64 (RFC 4648) of std (`std.digest`,
// `std.encoding`), written there with the bitwise operators of
// docs/slice.md 29 on the 32-bit words of 32.
// crates/ignite/tests/bitwise.rs runs the tests below on both targets and
// times the executable `codecs` against the hand-written Rust of codecs.rs
// beside this file (29.5); the two print the same lines.

/// The low 8 bits of `n`.
fn byte(n: Int) -> Byte = n.wrap_byte()

fn repeated(text: Text, times: Int) -> Bytes {
  let piece = text.to_bytes()
  var out = Bytes.with_capacity(piece.len() * times)
  var i = 0
  while i < times {
    out.append(piece)
    i = i + 1
  }
  out
}

test "sha1 of RFC 3174 tests 1 and 2" {
  assert hex(sha1("abc".to_bytes())) == "a9993e364706816aba3e25717850c26c9cd0d89d"
  assert hex(sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes())) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1"
  assert hex(sha1(Bytes.empty())) == "da39a3ee5e6b4b0d3255bfef95601890afd80709"
}

test "sha1 of RFC 3174 test 3" {
  assert hex(sha1(repeated("a", 1000000))) == "34aa973cd4c4daa4f61eeb2bdbad27316534016f"
}

test "sha1 of RFC 3174 test 4" {
  assert hex(sha1(repeated("0123456701234567012345670123456701234567012345670123456701234567", 10))) == "dea356a2cddd90c7a7ecedc5ebb563934f460452"
}

test "base64 of RFC 4648 section 10" {
  assert base64(Bytes.empty()) == ""
  assert base64("f".to_bytes()) == "Zg=="
  assert base64("fo".to_bytes()) == "Zm8="
  assert base64("foo".to_bytes()) == "Zm9v"
  assert base64("foob".to_bytes()) == "Zm9vYg=="
  assert base64("fooba".to_bytes()) == "Zm9vYmE="
  assert base64("foobar".to_bytes()) == "Zm9vYmFy"
  assert base64(Bytes.of([0xFF, 0xEF, 0x00])) == "/+8A"
}

// The timed program: 16 rounds over 1 MiB, each with its first byte
// changed, so no round repeats the one before.

fn show(text: Text) -> Result<Unit, IoError> requires [stdout.write] {
  var bytes = text.to_bytes()
  bytes.push(10)
  return Stdout.write_all(bytes)
}

type Bench {
  executable: Text
}

fn Bench.main(self: Bench) -> Result<Unit, IoError> {
  var data = Bytes.with_capacity(1048576)
  var i = 0
  while i < 1048576 {
    data.push(byte(i * 31 + 7))
    i = i + 1
  }
  var digest = ""
  var encoded = 0
  var round = 0
  while round < 16 {
    data.set(0, byte(round))
    digest = hex(sha1(data))
    encoded = encoded + base64(data).len()
    round = round + 1
  }
  show(digest)?
  show(Int.to_text(encoded))?
  Ok(Unit)
}

system Codecs {
  component codecs: Bench { executable = "codecs" }
}
