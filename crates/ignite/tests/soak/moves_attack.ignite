package moves_attack

// Adversary cases (pass 2) against the move of an end to a task
// (`own::moves_fresh`, `region::moved_to_task`, `docs/llvm.md` section 4):
// a `spawn` whose argument is a binding the rule calls fresh passes the
// binding's owner to the task without an owner of its own. Each case lets
// the task end and then uses the end through a holder the rule does not
// see (an alias, a closure, a list, an arm's own binding, a later
// statement, a field), so a task that took that holder's owner
// closed the end under it. Three count growth over rounds instead (the
// `over_pipe` shape, an outer block's end, a role call's stream): an owner
// nobody releases. `crates/ignite/tests/leak.rs` runs them on both targets.

import std.runtime.{soak}

test fn is(got: Option<Int>, want: Int) -> Bool = match got {
  Some(v) => v == want
  None => false
}

test fn next(r: Option<Receiver<Int>>) -> Option<Int> = match r {
  Some(rx) => {
    let x: Receiver<Int> = rx
    x.receive_within(0 ms)
  }
  None => None
}

test fn ring_end(t: Sender<Int>, go: Receiver<Int>, done: Sender<Int>) -> Result<Unit, IoError> {
  let g = go.receive_within(5 seconds)
  let ok = t.try_send(3)
  let d = done.send(if ok { 1 } else { 0 })
  Ok(())
}

test fn same(t: Sender<Int>) -> Sender<Int> = t

// A fresh end whose receiver goes back on `back`.
test fn made(back: Sender<Receiver<Int>>) -> Sender<Int> {
  let (tx, rx) = Channel.bounded(2)
  let sent = back.send(rx)
  tx
}

test fn fresh_sender() -> Sender<Int> {
  let (tx, rx) = Channel.bounded(1)
  tx
}

test type Holder {
  end: Sender<Int>
}

// Runs the task to its end; `both` then checks the end still sent through
// the holder the caller kept: the task's 3 and the holder's 4 arrive.
test fn run_task(tasks: Int, brx: Receiver<Receiver<Int>>, gtx: Sender<Int>, drx: Receiver<Int>) -> Option<Receiver<Int>> {
  let r = brx.receive_within(1 seconds)
  let g = gtx.send(1)
  assert is(drx.receive_within(5 seconds), 1)
  assert Runtime.settle(tasks, 5 seconds)
  r
}

test fn both(r: Option<Receiver<Int>>, poked: Bool) -> Unit {
  assert poked
  assert is(next(r), 3)
  assert is(next(r), 4)
}

// `let keep = a` before `let u = same(a)`: `a` is not mentioned after the
// `let u`, so `u` counts as fresh, but `keep` still names the end.
test fn alias_before() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  let keep = a
  let u = same(a)
  spawn ring_end(u, grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, keep.try_send(4))
}

test "an end aliased before a call moves it to a task stays open for the alias" {
  let runs = soak(5, |run| alias_before())
}

// A record built before the call holds the end.
test fn record_before() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  let h = Holder { end = a }
  let u = same(a)
  spawn ring_end(u, grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, h.end.try_send(4))
}

test "an end held by a record built before a call moves it to a task stays open for the record" {
  let runs = soak(5, |run| record_before())
}

// A closure made before the call captures the end; its later call does not
// name `a`.
test fn captured_before() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  let poke = |n: Int| a.try_send(n)
  let u = same(a)
  spawn ring_end(u, grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, poke(4))
}

test "an end captured by a closure before a call moves it to a task stays open for the closure" {
  let runs = soak(5, |run| captured_before())
}

// An owned binding spawned as its last mention after an alias was made:
// no handover (the alias), but the binding still counts as moved.
test fn owned_alias() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  let keep = a
  spawn ring_end(a, grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, keep.try_send(4))
}

test "an owned end aliased before it is spawned stays open for the alias" {
  let runs = soak(5, |run| owned_alias())
}

// An arm's own `let a` shadows the block's `a`: the arm's `same(a)` returns
// the parameter, not the block's fresh end.
test fn launch_shadow(t: Sender<Int>, go: Receiver<Int>, done: Sender<Int>, n: Int) -> Unit {
  let a = fresh_sender()
  let u = match n {
    0 => {
      let a = t
      same(a)
    }
    _ => same(a)
  }
  spawn ring_end(u, go, done)
}

test fn shadowed() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let t = made(btx)
  launch_shadow(t, grx, dtx, 0)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, t.try_send(4))
}

test "a parameter bound by an arm's own let is not taken for the block's fresh end of that name" {
  let runs = soak(5, |run| shadowed())
}

// The binding the call reads is mentioned after the spawn.
test fn used_after() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  let u = same(a)
  spawn ring_end(u, grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, a.try_send(4))
}

test "an end used after a call moves the call's result to a task stays open" {
  let runs = soak(5, |run| used_after())
}

// A match binding taken from a parameter, with a fresh other arm.
test fn launch_opt(o: Option<Sender<Int>>, go: Receiver<Int>, done: Sender<Int>) -> Unit {
  let u = match o {
    Some(e) => e
    None => fresh_sender()
  }
  spawn ring_end(u, go, done)
}

test fn from_option() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  launch_opt(Some(a), grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, a.try_send(4))
}

test "a match binding of a parameter moved to a task stays open for the caller" {
  let runs = soak(5, |run| from_option())
}

// The shape of `over_pipe` in the golden `bounds.program.ll`: a parameter
// passed through a call and spawned gets a retain; the task's release and
// the caller's must balance it on every round.
test fn same_pipe(end: PipeStream) -> PipeStream = end

test fn drain(end: PipeStream) -> Result<Unit, IoError> requires [end.read, end.write] {
  let got = end.read(16)?
  Ok(())
}

test fn over_pipe(end: PipeStream) -> Result<Int, IoError> requires [end.read, end.write] {
  let moved = same_pipe(end)
  spawn drain(moved)
  return Ok(end.received_batches())
}

test fn pipe_once() -> Result<Unit, IoError> {
  let tasks = Runtime.census().tasks
  let (client, server) = Pipe.pair()
  let n = over_pipe(server)?
  client.close()?
  assert Runtime.settle(tasks, 5 seconds)
  Ok(())
}

test fn pipe_run(run: Int) -> Unit {
  let ok = match pipe_once() {
    Ok(_) => true
    Err(_) => false
  }
  assert ok
}

test "a parameter a callee passes through a call to a task is released once per round" {
  assert soak(100, pipe_run).growth == []
}

// An end of an outer block that a call in an inner block passes to a task
// and nothing mentions after: the task needs no owner of its own, or the
// end's one owner is never released.
test fn inner_block(c: Bool) -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  if c {
    let u = same(a)
    spawn ring_end(u, grx, dtx)
  }
  let r = brx.receive_within(1 seconds)
  let g = gtx.send(1)
  assert is(drx.receive_within(5 seconds), 1)
  assert Runtime.settle(tasks, 5 seconds)
  assert is(next(r), 3)
}

test "an end of an outer block a call passes to a task in an inner block is released" {
  assert soak(100, |run| inner_block(true)).growth == []
}

// A role call whose argument is a closure: the closure may hold a handle,
// so the result is not fresh and the task gets an owner of its own; the
// accepted stream the role returns is no temporary the call releases, so
// its own owner must still go somewhere.
protocol Pass {
  fn serve(stream: TcpStream, application: fn(Text) -> Text) -> TcpStream requires [stream.write] {
    return stream
  }
}

test fn write_end(s: TcpStream, go: Receiver<Int>, done: Sender<Int>) -> Result<Unit, IoError> {
  let g = go.receive_within(5 seconds)
  let ok = match s.write_all(b"ok") {
    Ok(_) => 1
    Err(_) => 0
  }
  let d = done.send(ok)
  Ok(())
}

test fn role_temporary() -> Result<Unit, IoError> {
  let tasks = Runtime.census().tasks
  let listener = TcpListener.bind("127.0.0.1", 0)?
  let client = TcpStream.connect("127.0.0.1", listener.local_port())?
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let u = Pass.serve(listener.accept()?, |x| x)
  spawn write_end(u, grx, dtx)
  let g = gtx.send(1)
  assert is(drx.receive_within(5 seconds), 1)
  assert Runtime.settle(tasks, 5 seconds)
  Ok(())
}

test fn role_temporary_run(run: Int) -> Unit {
  let ok = match role_temporary() {
    Ok(_) => true
    Err(_) => false
  }
  assert ok
}

test "a stream a role call returns from an accepted temporary and a task takes is released" {
  assert soak(50, role_temporary_run).growth == []
}

// A field of a parameter passed to a call: the argument is no temporary.
test fn launch_held(h: Holder, go: Receiver<Int>, done: Sender<Int>) -> Unit {
  let u = same(h.end)
  spawn ring_end(u, go, done)
}

test fn held() -> Unit {
  let tasks = Runtime.census().tasks
  let (btx, brx) = Channel.bounded(1)
  let (gtx, grx) = Channel.bounded(1)
  let (dtx, drx) = Channel.bounded(1)
  let a = made(btx)
  launch_held(Holder { end = a }, grx, dtx)
  let r = run_task(tasks, brx, gtx, drx)
  both(r, a.try_send(4))
}

test "a field of a parameter a call passes to a task stays open for the caller" {
  let runs = soak(5, |run| held())
}
