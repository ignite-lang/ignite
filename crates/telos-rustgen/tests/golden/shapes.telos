package golden.shapes

enum Shape {
  Circle(Int),
  Rect(Int, Int),
  Empty
}

type Labelled {
  label: Text
  shape: Shape
}

fn area(shape: Shape) -> Int {
  match shape {
    Circle(r) => 3 * r * r
    Rect(w, h) => w * h
    Empty => 0
  }
}

fn describe(item: Labelled) -> Text {
  let size = area(item.shape)
  match item.shape {
    Shape.Empty => item.label.concat(" is empty")
    _ => item.label.concat(": ").concat(Int.to_text(size))
  }
}

fn unit_square() -> Labelled {
  Labelled { label = "unit", shape = Shape.Rect(1, 1) }
}

fn largest(items: List<Labelled>) -> Option<Labelled> {
  var best = None
  var best_area = 0 - 1
  for item in items {
    let a = area(item.shape)
    if a > best_area {
      best_area = a
      best = Some(item)
    }
  }
  return best
}
