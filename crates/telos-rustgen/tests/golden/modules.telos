package golden.modules

import std.text.{Handler, Mode, shout}
import std.protocol.line.Line
import std.net.TcpStream
import std.io.IoError

fn quiet(line: Text) -> Text {
  return line.trim()
}

fn pick(mode: Mode) -> fn(Text) -> Text {
  match mode {
    Loud => shout
    Quiet => quiet
  }
}

fn apply_twice(f: fn(Text) -> Text, line: Text) -> Text {
  return f(f(line))
}

fn relay(stream: TcpStream, handler: Handler) -> Result<Unit, IoError> requires [stream.read, stream.write] {
  let copy = handler
  spawn Line.serve(stream, copy)
  spawn relay_log(stream, handler.name)
  return Line.serve(stream, handler)
}

fn relay_log(stream: TcpStream, name: Text) -> Result<Unit, IoError> requires [stream.write] {
  log(name)
  return Ok(Unit)
}

system Echo {
  resource front: TcpListener { address = "127.0.0.1", port = 7000 }
  component server: Service {
    listener = front
    protocol = Line
    application = Handler { name = "shout", apply = pick(Loud) }
    executable = "echod"
  }
  component client: Client { target = front, protocol = Line, executable = "echo" }
}
