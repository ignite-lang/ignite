protocol Answer {
  fn serve(stream: TcpStream, application: Int) -> Result<Unit, IoError> requires [stream.*] {
    return Ok(Unit)
  }
}

protocol Ask {
  fn connect(stream: TcpStream) -> Result<Unit, IoError> requires [stream.*] {
    return Ok(Unit)
  }
}

system Pair {
  resource ingress: TcpListener {
    address = "127.0.0.1"
    port = 7070
  }

  component server: Service {
    listener = ingress
    protocol = Ask
    application = 1
    executable = "answerd"
  }

  component client: Client {
    target = ingress
    protocol = Answer
    executable = "ask"
  }
}
