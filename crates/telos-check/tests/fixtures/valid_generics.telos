package fixtures.generics

type Pair<A, B> {
  first: A
  second: B
}

enum Tree<T> {
  Leaf,
  Node(T, List<Tree<T>>),
}

type Named<T> = Pair<Text, T>

type Handler<S> {
  state: S
  handle: fn(state: S, n: Int) -> Int requires [state.*]
}

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
  return Pair { first = p.second, second = p.first }
}

fn depth<T>(tree: Tree<T>) -> Int {
  return match tree {
    Leaf => 0,
    Node(_, children) => {
      var most = 0
      for child in children {
        let d = depth(child)
        if d > most {
          most = d
        }
      }
      1 + most
    }
  }
}

fn label<T>(named: Named<T>) -> Text = named.first

fn run<S>(h: Handler<S>, n: Int) -> Int requires [h.*] {
  let handle = h.handle
  return handle(h.state, n) + h.handle(h.state, n)
}

fn count(stream: TcpStream, n: Int) -> Int requires [stream.write] {
  return n
}

fn handler(stream: TcpStream) -> Handler<TcpStream> {
  return Handler { state = stream, handle = count }
}

fn bump(stream: TcpStream) -> Int requires [stream.*] {
  return run(handler(stream), 1)
}
