package std.greeting

import std.net.{TcpStream}

enum Mood { Happy, Grumpy(Int) }

type Greeting {
  text: Text
  mood: Mood
}

fn greet(name: Text) -> Greeting {
  return Greeting { text = "hello ".concat(name), mood = Happy }
}

fn send(stream: TcpStream, greeting: Greeting) -> Result<Unit, IoError> requires [stream.write] {
  return stream.write_all(greeting.text.to_bytes())
}

const DEFAULT_NAME: Text = "world"

const LOUDNESS: Int = BASE_LOUDNESS * 2

const BASE_LOUDNESS: Int = 1

test fn sample() -> Greeting = greet("test")

test "greet says hello" {
  assert greet("a").text == "hello a"
  assert sample().text == "hello test", "sample greets test"
}
