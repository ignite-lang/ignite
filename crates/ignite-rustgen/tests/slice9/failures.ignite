// Failing asserts show both values as debug text (`docs/slice.md` section
// 13.6); each test here fails.

type Todo {
  id: Int
  title: Text
  done: Bool = false
}

enum Tree {
  Leaf,
  Node(Tree, Int),
}

test "list" {
  assert [1, 2] == [1, 3]
}

test "record" {
  assert Todo { id = 1, title = "milk" } == Todo { id = 1, title = "eggs\n" }
}

test "option" {
  let a: Option<Int> = None
  assert a == Some(3)
}

test "tree" {
  assert Node(Leaf, 1) != Node(Leaf, 1), "same trees"
}

test "tuple" {
  assert (1, [true]) == (1, [false])
}
