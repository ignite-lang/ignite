type Sender {
  send: fn(c: PipeStream) -> Int requires [c.write]
}

fn via_index(conn: PipeStream, hs: List<fn(c: PipeStream) -> Int requires [c.write]>) -> Int requires [conn.read] {
  return hs[0](conn)
}

fn via_field(conn: PipeStream, h: Sender) -> Int requires [conn.read] {
  return (h.send)(conn)
}

fn ambient(fs: List<fn() -> Int requires [stdout.write]>) -> Int requires [stdin.read] {
  return fs[0]()
}

fn inferred(conn: PipeStream, h: Sender) -> Int {
  return (h.send)(conn)
}

fn caller(conn: PipeStream, h: Sender) -> Int requires [conn.read] {
  return inferred(conn, h)
}
