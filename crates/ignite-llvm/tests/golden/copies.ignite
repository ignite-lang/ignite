package tests.copies

test fn letter(i: Int) -> Text = if i % 2 == 0 { "A" } else { "B" }

test "one-byte texts that fill arena chunks to the last byte keep their bytes" {
  var kept: List<Text> = []
  var i = 0
  while i < 200000 {
    kept.push(letter(i))
    i = i + 1
  }
  assert kept.len() == 200000
  var j = 0
  while j < 200000 {
    assert kept[j] == letter(j), "text {j} changed"
    j = j + 1
  }
}

test fn shout(t: Text) -> Text = t.concat("!")

test fn four(a: Text, b: Text, c: Text, d: Text) -> Text = a + b + c + d

test fn noisy(log: List<Text>, t: Text) -> Text {
  var l = log
  l.push(t)
  return Int.to_text(l.len()).concat(t)
}

test "an empty concatenation as a task's first allocation is empty" {
  let e = "" + ""
  assert e.len() == 0
  assert e == ""
  assert e.to_bytes().len() == 0
  let f = e.concat(e) + e
  assert f == ""
  assert (f + "x").len() == 1
}

test "concatenation copies empty, multibyte and long operands in order" {
  let e = ""
  let m = "héllo, wörld ✓"
  assert e + m + e == m
  assert (m + e).len() == m.len()
  assert m.concat(m) == "héllo, wörld ✓héllo, wörld ✓"
  assert (m + "é" + m).len() == 2 * m.len() + 2
  var long = "x"
  var i = 0
  while i < 15 {
    long = long + long
    i = i + 1
  }
  assert long.len() == 32768
  let both = long + m + long
  assert both.len() == 65536 + m.len()
  assert both.to_bytes().at(32768) == 104
  assert both.to_bytes().at(65535 + m.len()) == 120
  assert both.to_bytes().at(32767) == 120
}

test "a concatenation does not alias or change its operands" {
  let base = "ab".concat("cd")
  let s = base + "e"
  let t = base + "1" + base
  assert s == "abcde"
  assert t == "abcd1abcd"
  assert base == "abcd"
  var acc = "x"
  var i = 0
  while i < 5 {
    let before = acc
    acc = acc + "y" + ""
    assert before.len() == i + 1
    i = i + 1
  }
  assert acc == "xyyyyy"
  var self_twice = "ab"
  self_twice = self_twice + self_twice + self_twice
  assert self_twice == "ababab"
}

test "concat and plus chains, mixed and nested, keep the order of their operands" {
  assert four("a", "b", "c", "d") == "abcd"
  assert four("", "é", "", "z") == "éz"
  let a = "p"
  let b = a.concat("q").concat("r")
  assert a == "p"
  assert b == "pqr"
  let c = (a + "1").concat(b + "2") + "3".concat(shout(a))
  assert c == "p1pqr23p!"
  assert ("a" + "b" + "c") == "abc"
  assert ("a" + ("b" + "c") + "d") == "abcd"
  assert "a" + "b" == "ab"
  assert "a" + "b" != "a"
}

test "operands are evaluated once each, left to right" {
  let log = ["x"]
  let t = noisy(log, "a") + noisy(log, "b") + noisy(log, "c")
  assert t == "2a2b2c"
  assert log == ["x"]
}

test "a chain of more operands than one batch keeps every operand" {
  let n = Int.to_text(7)
  let t = n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + "-" + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + "é"
  assert t.len() == 38
  assert t == "77777777777777777-777777777777777777é"
}

test "concatenation in a released loop keeps the texts that are carried" {
  var kept: List<Text> = []
  var i = 0
  while i < 20000 {
    let t = Int.to_text(i) + ":" + Int.to_text(i).concat("é")
    if i % 1000 == 0 {
      kept.push(t)
    }
    i = i + 1
  }
  assert kept.len() == 20
  assert kept[0] == "0:0é"
  assert kept[19] == "19000:19000é"
}

type Holder {
  name: Text
  items: List<Int>
}

const GREETING: Text = "hello, world".concat("!")
const TAGS: List<Text> = ["a", "b", "c"]
const NESTED: List<List<Text>> = [["é"], [], ["x", "yz"]]
const HOLDER: Holder = Holder { name = "h".concat("é"), items = [1, 2] }
const EMPTY: List<Text> = []
const LIMIT: Int = 6 * 7

test fn count_constants(n: Int) -> Int {
  var total = 0
  var i = 0
  while i < n {
    total = total + GREETING.len() + TAGS.len() + NESTED[2][1].len() + HOLDER.items.len() + EMPTY.len()
    i = i + 1
  }
  return total
}

test fn send_constants(stream: PipeStream) -> Result<Unit, IoError> requires [stream.write] {
  var tags = TAGS
  tags.push(GREETING)
  stream.write_all((HOLDER.name + tags[3] + Int.to_text(tags.len() + count_constants(3))).to_bytes())?
  stream.close()
}

test fn all_of(client: PipeStream) -> Result<Bytes, IoError> requires [client.read] {
  var out = Bytes.empty()
  loop {
    match client.read(4096)? {
      Eof => return Ok(out)
      Data(bytes) => out.append(bytes)
    }
  }
}

test "a constant mentioned in a loop keeps its value" {
  assert count_constants(1000) == 20000
  assert count_constants(1000) == 20000
  assert LIMIT == 42
}

test "a change to a copy of a constant leaves the constant as it was" {
  var tags = TAGS
  tags.push("d")
  assert tags == ["a", "b", "c", "d"]
  assert TAGS == ["a", "b", "c"]
  var holder = HOLDER
  holder.items.push(3)
  holder.name = holder.name + "!"
  assert HOLDER.items == [1, 2]
  assert HOLDER.name == "hé"
  assert holder.name == "hé!"
  var i = 0
  while i < 3 {
    var nested = NESTED
    nested[0].push(Int.to_text(i))
    assert nested[0].len() == 2
    i = i + 1
  }
  assert NESTED == [["é"], [], ["x", "yz"]]
  let g = GREETING + GREETING
  assert g == "hello, world!hello, world!"
  assert GREETING == "hello, world!"
}

test "in-place builtins on a constant change a copy" {
  TAGS.push("z")
  TAGS.clear()
  assert TAGS == ["a", "b", "c"]
  let n = match GREETING {
    "hello, world!" => 1
    _ => 0
  }
  assert n == 1
}

test "tasks that read constants at once see the same values" {
  var ends: List<PipeStream> = []
  var i = 0
  while i < 24 {
    let (client, server) = Pipe.pair()
    client.set_idle_timeout(5000)?
    spawn send_constants(server)
    ends.push(client)
    i = i + 1
  }
  for client in ends {
    assert all_of(client)?.to_text() == "héhello, world!64"
  }
  assert TAGS.len() == 3
}

const HELLO: Text = "hel".concat("lo")

test "a constant pattern compares with the constant" {
  let n = match "he".concat("llo") {
    HELLO => 1
    _ => 0
  }
  assert n == 1
  let m = match "help" {
    HELLO => 1
    _ => 0
  }
  assert m == 0
}

test fn pattern(n: Int, seed: Int) -> Bytes {
  var out = Bytes.empty()
  var i = 0
  while out.len() < n {
    out.append(Int.to_text(seed * 1000003 + i).to_bytes())
    i = i + 1
  }
  return out.slice(0, n)
}

test fn send_large(stream: PipeStream) -> Result<Unit, IoError> requires [stream.write] {
  stream.write_all(pattern(40000, 1))?
  stream.write_all(pattern(70000, 2))?
  stream.write_all(pattern(17, 3))?
  stream.close()
}

test "reads over 16 KiB keep their bytes and the texts made between them" {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  spawn send_large(server)
  var got = Bytes.empty()
  var notes: List<Text> = []
  var reads = 0
  loop {
    let maximum = if reads % 2 == 0 { 65536 } else { 20000 }
    match client.read(maximum)? {
      Eof => break
      Data(bytes) => {
        assert bytes.len() <= maximum
        assert bytes.len() > 0
        got.append(bytes)
        notes.push("read ".concat(Int.to_text(reads)).concat(" é"))
        reads = reads + 1
      }
    }
  }
  var want = pattern(40000, 1)
  want.append(pattern(70000, 2))
  want.append(pattern(17, 3))
  assert got.len() == 110017
  assert got == want
  assert notes.len() == reads
  assert notes[0] == "read 0 é"
}

test "map keys of multibyte and prefix texts sort bytewise" {
  let odd = "a".concat(Bytes.of([255]).to_text())
  var m: Map<Text, Int> = Map.empty()
  m.put("zz", 1)
  m.put("é", 2)
  m.put("", 3)
  m.put(odd, 4)
  m.put("ab", 5)
  m.put("a", 6)
  m.put("e", 7)
  m.put("aa", 8)
  m.put("z", 9)
  assert m.keys() == ["", "a", "aa", "ab", odd, "e", "z", "zz", "é"]
  assert m.get("é") == Some(2)
  assert m.get(odd) == Some(4)
  assert m.get("a") == Some(6)
  assert m.get("") == Some(3)
  assert m.get("aaa") == None
  assert m.get("é".concat("")) == Some(2)
  m.put("a", 60)
  m.put("é", 20)
  assert m.len() == 9
  assert m.get("a") == Some(60)
  assert m.get("é") == Some(20)
  m.remove("aa")
  assert m.keys() == ["", "a", "ab", odd, "e", "z", "zz", "é"]
}

test "join, trim and their edge cases" {
  assert ["a", "b", "c"].join("-") == "a-b-c"
  assert ["é", "", "ü"].join("→") == "é→→ü"
  assert ["a"].join("-") == "a"
  let none: List<Text> = []
  assert none.join("-") == ""
  assert ["", ""].join("") == ""
  assert " \t a b \n".trim() == "a b"
  let nbsp = Bytes.of([194, 160]).to_text()
  assert nbsp.concat("x").concat(nbsp).trim() == "x"
  assert Bytes.of([11, 97, 12]).to_text().trim() == "a"
  assert Bytes.of([31, 97, 31]).to_text().trim().len() == 3
  assert "é ".trim() == "é"
  assert " ".trim() == ""
  assert "".trim() == ""
}

test fn grow(l: List<Int>) -> Int {
  l.push(0)
  l.len()
}

test fn total(l: List<Int>) -> Int {
  var sum = 0
  for x in l {
    sum = sum + x
  }
  sum
}

test fn drain(l: List<Int>) -> Int {
  l.clear()
  l.len()
}

test fn lengths(lists: List<List<Int>>) -> List<Int> = lists.map(|l| l.len())

test fn sums(lists: List<List<Int>>) -> List<Int> = lists.map(total)

test fn measured(lists: List<List<Int>>) -> Int {
  let f = |l: List<Int>, k: Int| l.len() + k
  f(lists[0], 1)
}

test fn start(xs: List<Int>, s: PipeStream) {
  spawn report(xs, "n:", s)
}

test "fn values borrow what they only read and copy what they change" {
  var lists = [[1], [2, 3]]
  assert lists.map(|l| l.len()) == [1, 2]
  assert lengths(lists) == [1, 2]
  assert sums(lists) == [1, 5]
  assert measured(lists) == 2
  assert lists.map(|l| {
    l.push(9)
    l.len()
  }) == [2, 3]
  assert lists == [[1], [2, 3]]
  assert lists.map(grow) == [2, 3]
  assert lists.map(total) == [1, 5]
  assert lists == [[1], [2, 3]]
  var same = lists.map(|l| l)
  same[0].push(7)
  lists[1].push(8)
  assert same == [[1, 7], [2, 3]]
  assert lists == [[1], [2, 3, 8]]
  let f = |a: List<Int>, n: Int| a.len() + n
  var xs = [1]
  assert f(xs, if xs.len() > 0 {
    xs.push(2)
    0
  } else {
    0
  }) == 1
  assert xs == [1, 2]
  assert f(xs, drain(xs)) == 2
  let g = grow
  assert g(xs) == 3
  assert xs == [1, 2]
  let words = ["a", "bb"]
  let stamped = words.map(|w| w.concat("!"))
  assert stamped == ["a!", "bb!"]
  assert words == ["a", "bb"]
  var ys = [5, 6]
  assert f(ys, drain(ys)) == 2
}

test fn report(xs: List<Int>, label: Text, s: PipeStream) -> Result<Unit, IoError> requires [s.write] {
  s.write_all(label.concat(Int.to_text(xs.len())).to_bytes())?
  s.close()
}

test type Bag {
  items: List<Int>
  name: Text
}

test "a spawned task gets the borrowed arguments as they were at the spawn" {
  var xs = [1, 2, 3]
  var bag = Bag { items = [4, 5], name = "bag:" }
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  spawn report(xs, bag.name, server)
  xs.push(4)
  bag.name = "changed:"
  var got = Bytes.empty()
  loop {
    match client.read(100)? {
      Eof => break
      Data(bytes) => got.append(bytes)
    }
  }
  assert got.to_text() == "bag:3"
  let (c2, s2) = Pipe.pair()
  c2.set_idle_timeout(5000)?
  spawn report(bag.items, "items:", s2)
  bag.items.clear()
  var got2 = Bytes.empty()
  loop {
    match c2.read(100)? {
      Eof => break
      Data(bytes) => got2.append(bytes)
    }
  }
  assert got2.to_text() == "items:2"
  assert xs.len() == 4
  let (c3, s3) = Pipe.pair()
  c3.set_idle_timeout(5000)?
  start(xs, s3)
  xs.clear()
  var got3 = Bytes.empty()
  loop {
    match c3.read(100)? {
      Eof => break
      Data(bytes) => got3.append(bytes)
    }
  }
  assert got3.to_text() == "n:4"
}

test type Greeting {
  words: List<Text>
  count: Int
}

test fn greets(s: PipeStream, greeting: Greeting, tail: Text) -> Result<Unit, IoError> requires [s.write] {
  var line = ""
  for word in greeting.words {
    line = "{line}{word}"
  }
  s.write_all("{line}{greeting.count}{tail};".to_bytes())?
  s.close()
}

// Story spawn-without-handshake: `spawn` copies its arguments into the
// task's transfer memory and does not wait for the task, and the loop
// frees and reuses the memory it built them in at each iteration (the
// debug runtime overwrites it), so a shallow environment fails here.
test "every task reads the arguments its spawn saw after the loop freed them" {
  var clients: List<PipeStream> = []
  var expected: List<Text> = []
  var i = 0
  while i < 40 {
    let (client, server) = Pipe.pair()
    client.set_idle_timeout(5000)?
    var words: List<Text> = []
    var j = 0
    while j < 8 {
      words.push("w{i}.{j}-")
      j = j + 1
    }
    let greeting = Greeting { words = words, count = i }
    let tail = "/{i * 7}"
    spawn greets(server, greeting, tail)
    clients.push(client)
    var line = ""
    for word in words {
      line = "{line}{word}"
    }
    expected.push("{line}{i}/{i * 7};")
    i = i + 1
  }
  var k = 0
  while k < 40 {
    assert all_of(clients[k])?.to_text() == expected[k], "task {k}"
    k = k + 1
  }
}
