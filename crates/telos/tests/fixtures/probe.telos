package tests.probe

// Built with `--target llvm` by tests/llvm.rs. The `probe` client prints
// one line per check to standard output; `crash` indexes out of range.

type Point { x: Int, y: Int }

type Named {
  name: Text
  tags: List<Text>
}

type Flags { on: Bool, level: Byte }

enum Shape {
  Dot,
  Circle(Int),
  Rect(Point, Point)
}

const ORIGIN: Point = Point { x = 0, y = 0 }
const GREETING: Text = "hello"
const LIMIT: Int = 3

fn area(shape: Shape) -> Int {
  return match shape {
    Shape.Dot => 0
    Circle(r) => 3 * r * r
    Shape.Rect(a, b) => (b.x - a.x) * (b.y - a.y)
  }
}

fn describe(n: Int) -> Text {
  return match n {
    0 => "zero"
    1 => "one"
    _ => "many"
  }
}

fn word(t: Text) -> Int {
  return match t {
    "a" => 1
    "b" => 2
    _ => 0
  }
}

fn half(n: Int) -> Result<Int, IoError> {
  if n % 2 != 0 {
    return Err(IoError.new("odd: ".concat(Int.to_text(n))))
  }
  return Ok(n / 2)
}

fn quarter(n: Int) -> Result<Int, IoError> {
  let h = half(n)?
  return half(h)
}

fn sum(values: List<Int>) -> Int {
  var total = 0
  for v in values {
    total = total + v
  }
  return total
}

fn show(text: Text) -> Result<Unit, IoError> requires [stdout.write] {
  var bytes = text.to_bytes()
  bytes.push(10)
  return Stdout.write_all(bytes)
}

fn greet(stream: TcpStream, who: Text) -> Result<Unit, IoError> requires [stream.write] {
  return stream.write_all("spawned ".concat(who).to_bytes())
}

protocol Probe {
  fn connect(stream: TcpStream) -> Result<Unit, IoError> requires [stdout.write, stream.read, stream.write] {
    spawn greet(stream, GREETING)
    let input = stream.read(16)?
    match input {
      Data(bytes) => {
        show("got ".concat(bytes.to_text()))?
      }
      Eof => {
        show("eof")?
      }
    }
    show(Int.to_text(area(Circle(2))))?
    show(Int.to_text(area(Shape.Rect(ORIGIN, Point { x = 3, y = 4 }))))?
    show(Int.to_text(area(Dot)))?
    show(describe(LIMIT - 2))?
    let d = describe
    show(d(7))?
    show(Int.to_text(word("b")))?
    var a = Named { name = "a", tags = ["x"] }
    var b = a
    b.tags.push("y")
    b.name = "b"
    show(a.name.concat(Int.to_text(a.tags.len())).concat(b.name).concat(Int.to_text(b.tags.len())))?
    show(b.tags.join(","))?
    var bytes = Bytes.empty()
    var i = 0
    while i < 300 {
      bytes.push(65)
      i = i + 1
    }
    show(Int.to_text(bytes.len()))?
    show(bytes.slice(1, 4).to_text())?
    show(Int.to_text(sum([1, 2, 3, LIMIT])))?
    match quarter(12) {
      Ok(q) => show(Int.to_text(q))?
      Err(e) => show(e.message)?
    }
    match quarter(6) {
      Ok(q) => show(Int.to_text(q))?
      Err(e) => show(e.message)?
    }
    show("  hi  ".trim())?
    if "abc".starts_with("ab") && !("abc" == "abd") {
      show("text ok")?
    }
    match "prefix-rest".strip_prefix("prefix-") {
      Some(rest) => show(rest)?
      None => show("no prefix")?
    }
    let flags = Flags { on = true, level = 7 }
    if flags.on && flags.level == 7 {
      show("flags ok")?
    }
    var loops = 0
    loop {
      loops = loops + 1
      if loops == 5 {
        break
      }
      continue
    }
    show(Int.to_text(loops))?
    let last = quarter(2)?
    show(Int.to_text(last))?
    return Ok(Unit)
  }
}

protocol Crash {
  fn connect(stream: TcpStream) -> Result<Unit, IoError> requires [stdout.write] {
    let values = [1, 2]
    show(Int.to_text(values.at(5)))?
    return Ok(Unit)
  }
}

system Probes {
  resource target: TcpListener { address = "127.0.0.1", port = 1 }
  component probe: Client { target = target, protocol = Probe }
  component crash: Client { target = target, protocol = Crash }
}
