import std.text.*

// Slice 9 on the Rust target (`docs/slice.md` section 13): every test here
// passes; `failures.telos` holds the ones that must fail.

type Todo {
  id: Int
  title: Text
  done: Bool = false
}

type Empty {}

enum Shape {
  Dot,
  Circle(Int),
  Rect(Int, Int),
}

enum Tree<T> {
  Leaf,
  Node(Tree<T>, T, Tree<T>),
}

type Chain {
  value: Int
  next: Option<Chain>
}

type Outer {
  inner: Inner
}

enum Inner {
  Wrap(Outer),
  Stop,
}

const LOW: Byte = 48
const HIGH: Byte = 57
const LIMIT: Int = 100

fn Todo.new(id: Int, title: Text) -> Todo = Todo { id = id, title = title }

fn Shape.unit() -> Shape = Circle(1)

fn Todo.title_of(todo: Todo) -> Text = todo.title

fn title(id: Int) -> Text = "free {id}"

fn insert(tree: Tree<Int>, value: Int) -> Tree<Int> = match tree {
  Leaf => Node(Leaf, value, Leaf)
  Node(left, v, right) => if value < v {
    Node(insert(left, value), v, right)
  } else {
    Node(left, v, insert(right, value))
  }
}

fn walk(tree: Tree<Int>) -> List<Int> = match tree {
  Leaf => []
  Node(left, v, right) => {
    var out = walk(left)
    out.push(v)
    out.append(walk(right))
    out
  }
}

fn depth(tree: Tree<Int>) -> Int = match tree {
  Node(Node(_, _, _), _, _) => 2
  Node(Leaf, _, _) => 1
  Leaf => 0
}

fn length(chain: Chain) -> Int = match chain.next {
  Some(rest) => 1 + length(rest)
  None => 1
}

fn class(b: Byte) -> Text = match b {
  LOW..=HIGH => "digit"
  b'a'..=b'f' | b'A'..=b'F' => "hex"
  0..=31 => "control"
  _ => "other"
}

fn half(b: Byte) -> Int = match b {
  0..=127 => 0
  128..=255 => 1
}

fn sign(n: Int) -> Int = match n {
  -1000..=-1 => -1
  0 => 0
  1..=LIMIT => 1
  _ => 2
}

fn first_even(items: List<Int>) -> Option<Int> {
  var found = None
  for item in items {
    found = match item % 2 {
      0 => Some(item)
      _ => continue
    }
    if found != None { break }
  }
  return found
}

fn count_until(items: List<Int>, stop: Int) -> Int {
  var count = 0
  for item in items {
    let next = if item == stop { break } else { count + 1 }
    count = next
  }
  return count
}

fn apply(f: fn(Int) -> Int, value: Int) -> Int = f(value)

fn compose(f: fn(Int) -> Int, g: fn(Int) -> Int) -> fn(Int) -> Int = |x| g(f(x))

fn adder(n: Int) -> fn(Int) -> Int = |x: Int| x + n

fn bump(n: Int) -> Int = n + 1

test "structural equality" {
  assert [1, 2] == [1, 2]
  assert [1, 2] != [2, 1]
  assert Some(3) == Some(3)
  assert Some(3) != None
  let none: Option<Int> = None
  assert none == None
  let ok: Result<Int, Text> = Ok(1)
  assert ok == Ok(1)
  assert ok != Err("x")
  assert (1, "a") == (1, "a")
  assert Todo.new(1, "milk") == Todo { id = 1, title = "milk", done = false }
  assert Todo.new(1, "milk") != Todo.new(1, "eggs")
  assert Rect(1, 2) == Rect(1, 2)
  assert Rect(1, 2) != Rect(2, 1)
  assert Circle(1) != Dot
  let a = [Some([1]), None]
  let b = [Some([1]), None]
  assert a == b
  let same = a == b
  assert same
  assert if a != b { false } else { true }
  assert Empty {} == Empty {}
}

test "debug text" {
  assert 3.debug() == "3"
  assert (-3).debug() == "-3"
  assert b'a'.debug() == "97"
  assert true.debug() == "true"
  assert "a\"b\\c\n\t\u{1b}é".debug() == r#""a\"b\\c\n\t\u{1b}é""#
  assert [1, 2].debug() == "[1, 2]"
  let empty: List<Int> = []
  assert empty.debug() == "[]"
  assert b"hi".debug() == "[104, 105]"
  assert (1, "a").debug() == r#"(1, "a")"#
  assert Some(3).debug() == "Some(3)"
  let none: Option<Int> = None
  assert none.debug() == "None"
  let err: Result<Int, Text> = Err("x")
  assert err.debug() == r#"Err("x")"#
  assert Todo.new(1, "milk").debug() == r#"Todo { id: 1, title: "milk", done: false }"#
  assert Empty {}.debug() == r"Empty {}"
  assert Shape.Dot.debug() == "Shape.Dot"
  assert Rect(1, 2).debug() == "Shape.Rect(1, 2)"
  assert insert(Leaf, 5).debug() == "Tree.Node(Tree.Leaf, 5, Tree.Leaf)"
  assert bump.debug() == "<fn>"
}

test "range patterns" {
  assert class(b'5') == "digit"
  assert class(b'c') == "hex"
  assert class(b'C') == "hex"
  assert class(10) == "control"
  assert class(b'z') == "other"
  assert sign(-5) == -1
  assert sign(0) == 0
  assert sign(100) == 1
  assert sign(101) == 2
  assert half(5) == 0
  assert half(200) == 1
  let pair = (b'7', 3)
  let shown = match pair {
    (b'0'..=b'9', 0..=5) => "both"
    _ => "no"
  }
  assert shown == "both"
}

test "break and continue expressions" {
  assert first_even([1, 3, 4, 6]) == Some(4)
  assert first_even([1, 3]) == None
  assert count_until([1, 2, 3, 4], 3) == 2
}

test "closures capture by copy" {
  var base = 10
  let add = |x: Int| x + base
  base = 20
  assert add(1) == 11
  assert apply(|x| x * 2, 4) == 8
  assert apply(adder(3), 4) == 7
  let composed = compose(bump, adder(10))
  assert composed(1) == 12
  let names = ["a", "b"]
  let prefix = "x-"
  assert names.map(|n| prefix + n) == ["x-a", "x-b"]
  assert [1, 2, 3].map(bump) == [2, 3, 4]
  let nothing = || 7
  assert nothing() == 7
  let block: fn(Int) -> Int = |x| {
    let y = x + 1
    if y > 3 { return 0 }
    y * 2
  }
  assert block(1) == 4
  assert block(5) == 0
  let todo = Todo.new(1, "milk")
  let rename = |t: Todo| Todo { title = t.title + "!", ..t }
  assert rename(todo).title == "milk!"
  assert todo.title == "milk"
}

test "record update and tuple fields" {
  let todo = Todo.new(1, "milk")
  let done = Todo { done = true, ..todo }
  assert done == Todo { id = 1, title = "milk", done = true }
  assert todo.done == false
  let pair = (1, ("a", [2]))
  assert pair.0 == 1
  assert pair.1.0 == "a"
  assert pair.1.1 == [2]
}

test "store update with a closure is atomic" {
  let store: Store<Todo> = Store.new()
  let id = store.next_id()
  store.put(id, Todo.new(id, "milk"))
  let flag = true
  let updated = store.update(id, |t| Todo { done = flag, ..t })
  assert updated == Some(Todo { id = id, title = "milk", done = true })
  assert store.get(id) == updated
  assert store.update(99, |t| t) == None
}

test "boxed recursion" {
  var tree: Tree<Int> = Leaf
  for v in [5, 2, 8, 1] {
    tree = insert(tree, v)
  }
  assert walk(tree) == [1, 2, 5, 8]
  assert depth(tree) == 2
  assert depth(insert(Leaf, 1)) == 1
  let chain = Chain { value = 1, next = Some(Chain { value = 2, next = None }) }
  assert length(chain) == 2
  assert chain.next.debug() == r"Some(Chain { value: 2, next: None })"
  var changed = chain
  changed.next = None
  assert length(changed) == 1
  assert chain != changed
  let outer = Outer { inner = Wrap(Outer { inner = Stop }) }
  assert outer == Outer { inner = Wrap(Outer { inner = Stop }) }
  assert outer.debug() == r"Outer { inner: Inner.Wrap(Outer { inner: Inner.Stop }) }"
}

test "associated fns" {
  assert Todo.new(2, "x").id == 2
  assert Shape.unit() == Circle(1)
  let make = Todo.new
  assert make(3, "y").title == "y"
  assert Todo.title_of(Todo.new(1, "z")) == "z"
  assert title(4) == "free 4"
}

test "glob import" {
  assert "hello".contains("ell")
  assert ends_with("index.html", ".html")
}
