    use crate::modes::{level, pick};

    pub fn describe(loud: &bool) -> String {
        let mut loud = loud.clone();
        match pick(&loud) {
            crate::modes::Mode::Loud => String::from("loud"),
            crate::modes::Mode::Quiet(_) => String::from("quiet"),
        }
    }
