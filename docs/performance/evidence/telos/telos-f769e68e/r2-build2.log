pub mod modes {

    #[derive(Clone)]
    pub enum Mode {
        Loud,
        Quiet(i64),
    }

    pub fn level(mode: &Mode) -> i64 {
        match mode.clone() {
            Mode::Loud => 10,
            Mode::Quiet(n) => n,
        }
    }

    pub fn pick(loud: &bool) -> Mode {
        let mut loud = loud.clone();
        if loud {
            Mode::Loud
        } else {
            Mode::Quiet(1)
        }
    }
}



