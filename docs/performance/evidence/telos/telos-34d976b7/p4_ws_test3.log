#[derive(Clone)]
pub struct Runner {
    pub address: String,
    pub port: i64,
}

#[allow(non_snake_case)]
pub fn Runner__main(self_: &Runner) -> Result<(), telos_io::IoError> {
    let stream = match telos_io::TcpStream::connect(self_.address.clone(), self_.port.clone()) {
        Ok(stream) => stream,
        Err(error) => return Err(error.clone().with_exit_code((3) as i32)),
    };
    match Syntax::connect(stream.clone()) {
        Ok(_) => Ok(()),
        Err(error) => Err(error.clone().with_exit_code((4) as i32)),
    }
}


