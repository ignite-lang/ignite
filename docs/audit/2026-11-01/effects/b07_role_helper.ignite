fn chat(s: TcpStream) -> Result<Unit, IoError> = s.write_all("hi".to_bytes())

protocol Echo {
  fn serve(stream: TcpStream, application: Int) -> Result<Unit, IoError> requires [] {
    return chat(stream)
  }

  fn connect(stream: TcpStream) -> Result<Unit, IoError> requires [stream.write] {
    stream.chat()?
    spawn chat(stream)
    return Ok(())
  }
}

fn caller(s: TcpStream) -> Result<Unit, IoError> requires [] {
  Echo.serve(s, 1)?
  return Echo.connect(s)
}
