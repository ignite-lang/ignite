type App {
  n: Result<Input, IoError>
}

protocol P {
  fn serve(stream: TcpStream, app: App) -> Result<Unit, IoError> requires [] {
    return Ok(())
  }
}

fn noisy() -> Result<Input, IoError> requires [stdin.read] = Stdin.read(1)

system S {
  resource ingress: TcpListener {
    address = "127.0.0.1"
    port = 0
  }
  component Svc: Service {
    executable = "svc"
    listener = ingress
    protocol = P
    application = App { n = noisy() }
  }
}
